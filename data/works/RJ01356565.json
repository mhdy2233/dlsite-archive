 "introductions": [
  {
   "type": "image_list",
   "title": "✅ゲームの遊び方✅",
   "body": [
    {
     "intro": "左右に移動してトラップを回避<br />\r\n方向キーで左右に移動し、トラップを回避しましょう！",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01357000/RJ01356565/8a966183b69bae4af8ca2a3386d2c94b.jpg",
      "alt": "最下層を目指せ！天空塔のフローヴィア [スノーチュール/ F Project]",
      "title": "最下層を目指せ！天空塔のフローヴィア [スノーチュール/ F Project]"
     }
    },
    {
     "intro": "スキルを使って危険を回避<br />\r\n対応するボタンを押すと、キャラクターのスキルを使用し、ボスの攻撃を回避します。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01357000/RJ01356565/c1ac68e8174294c1fff079c841682f06.jpg",
      "alt": "最下層を目指せ！天空塔のフローヴィア [スノーチュール/ F Project]",
      "title": "最下層を目指せ！天空塔のフローヴィア [スノーチュール/ F Project]"
     }
    },
    {
     "intro": "必殺技を放ち、ボスを攻撃<br />\nさらに全部ゲージを消費して必殺技を放ち、敵を攻撃することも可能です。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01357000/RJ01356565/7f7fb9e12d9b1fd576fe4bcf3ca7fa10.jpg",
      "alt": "最下層を目指せ！天空塔のフローヴィア [スノーチュール/ F Project]",
      "title": "最下層を目指せ！天空塔のフローヴィア [スノーチュール/ F Project]"
     }
    },
    {
     "intro": "スキルの使用にはチャージが必要ですが、発動中は無敵状態になります。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01357000/RJ01356565/3ef7c78fe1bdf3a178efebb2d73820ce.jpg",
      "alt": "最下層を目指せ！天空塔のフローヴィア [スノーチュール/ F Project]",
      "title": "最下層を目指せ！天空塔のフローヴィア [スノーチュール/ F Project]"
     }
    }
   ]
  },
  {
   "type": "image_list",
   "title": "✅ヒロイン✅",
   "body": [
    {
     "intro": "フローヴィア <br />\r\n(cv:伊ヶ崎綾香)<br />\r\n天宮塔の女王<br />\r\n<br />\r\n空塔を支配する女王。強力な魔力を持つ「氷の宝珠」を持ち、性格は素直で優しい。<br />\r\n<br />\r\n人間に対して嫌悪感はなく、時々自信過剰になることも。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01357000/RJ01356565/8089231e60a145386f26a76d98453eee.jpg",
      "alt": "最下層を目指せ！天空塔のフローヴィア [スノーチュール/ F Project]",
      "title": "最下層を目指せ！天空塔のフローヴィア [スノーチュール/ F Project]"
     }
    }
   ]
  },
  {
   "type": "image_list",
   "title": "✅登場する魔物の主たち✅",
   "body": [
    {
     "intro": "ドクス・ティニー<br />\n(cv:花城かざり)<br />\nギャンブル好きなハレキン<br />\n<br />\nけには非常に強い意志を持ち、勝つまで決して諦めない。<br />\nいたずら好きで、時には冷酷な一面も見せる。カジノの管理者としての顔も持つ。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01357000/RJ01356565/464614a11702e046eeb5b247bd349769.jpg",
      "alt": "最下層を目指せ！天空塔のフローヴィア [スノーチュール/ F Project]",
      "title": "最下層を目指せ！天空塔のフローヴィア [スノーチュール/ F Project]"
     }
    },
    {
     "intro": "マドラ<br />\n(cv:大宗たゆゆ)<br />\n人を世話するのが好きなスライム<br />\n<br />\n見は優しい姉のようで、体は半透明。好意を持つ相手には非常に世話を焼く。<br />\n体型は普通の人に似ているが、水を吸うと無限に大きくなる。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01357000/RJ01356565/629701dffebbdf658b56d09ccacb6316.jpg",
      "alt": "最下層を目指せ！天空塔のフローヴィア [スノーチュール/ F Project]",
      "title": "最下層を目指せ！天空塔のフローヴィア [スノーチュール/ F Project]"
     }
    },
    {
     "intro": "琉<br />\r\n(cv:財木 桜)<br />\r\n神社を守る巫女<br />\r\n<br />\r\n家族の使命を持ち、華楓庭園を守る。厳しい性格に見えるが、心は純真で、子供が好き。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01357000/RJ01356565/d902774d572c381b0ad51561874057a4.jpg",
      "alt": "最下層を目指せ！天空塔のフローヴィア [スノーチュール/ F Project]",
      "title": "最下層を目指せ！天空塔のフローヴィア [スノーチュール/ F Project]"
     }
    },
    {
     "intro": "ディノス<br />\r\n(cv:園宮さつき)<br />\r\n反抗期のメタルティラノサウルス<br />\r\n<br />\r\nフード付きのコートを着て、普段は帽子で頭を隠している。反抗的で、恥ずかしがり屋。金属の尾が嫌い。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01357000/RJ01356565/494704180f9448d37090d18eab5cd6cc.jpg",
      "alt": "最下層を目指せ！天空塔のフローヴィア [スノーチュール/ F Project]",
      "title": "最下層を目指せ！天空塔のフローヴィア [スノーチュール/ F Project]"
     }
    }
