 "introductions": [
  {
   "type": "image",
   "title": "★☆★Ver.3へのアップデートでモーション/衣装/REC機能追加！！★☆★",
   "body": [
    {
     "intro": "",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01384000/RJ01383565/39d749dd0463dfcc72b7ba351c8e228c.jpg",
