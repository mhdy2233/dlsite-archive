 "introductions": [
  {
   "type": "image_list",
   "title": "登場人物",
   "body": [
    {
     "intro": "◆ユニヴェール<br />\n<br />\nネージュとともに旅する冒険者。<br />\n金欠を脱するべく武闘大会に挑む。<br />\n口数が少なく表情の変化に乏しい、しかし食べ物に目が無く、ご馳走の前ではその限りではないようだ……。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01438000/RJ01437802/1d9372a7863a9156de151c6a995ba58b.jpg",
      "alt": "SelobusArena [ラストロジー]",
      "title": "SelobusArena [ラストロジー]"
     }
    },
    {
     "intro": "◆ネージュ<br />\n<br />\nユニと共に旅する冒険者。ユニと共に<br />\n武闘大会に出場することに。<br />\n賑やかな元気っ娘だが、調子に乗りすぎて、ユニに制裁されることもしばしば……。<br />\nそのせいか妙に打たれ強い。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01438000/RJ01437802/30329b4cc15a1662c9eff86c837b9313.jpg",
      "alt": "SelobusArena [ラストロジー]",
      "title": "SelobusArena [ラストロジー]"
     }
    },
    {
     "intro": "◆フラン<br />\n<br />\nリースバルンで出会うことになる女剣士、剣の腕には自信があり、腕試しの為、武闘大会に出場しているようだ。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01438000/RJ01437802/1c81d301395a4a3fbba60fabe0e280af.jpg",
      "alt": "SelobusArena [ラストロジー]",
      "title": "SelobusArena [ラストロジー]"
     }
    },
    {
     "intro": "◆ホノカ<br />\n<br />\n遥か東の国からやって来た侍娘。<br />\n何か事情があって武闘大会に出場しているようだが、酒場に入り浸っている……。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01438000/RJ01437802/f6d55c1988fa0792d4dda2275cb85608.jpg",
      "alt": "SelobusArena [ラストロジー]",
      "title": "SelobusArena [ラストロジー]"
     }
    }
   ]
  },
  {
