    },
    {
     "intro": "鍛え上げたステータスやスキルを駆使してたくさん発射しよう！",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01574000/RJ01573967/04e838e2e0dd6554ffc2c635925728dc.jpg",
