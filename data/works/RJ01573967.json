 "introductions": [
  {
   "type": "image",
   "title": "風俗嬢(風俗むすめ)を育成し東京制覇を目指すゲーム",
   "body": [
    {
     "intro": "東京23区の全てに店を構える巨大風俗コンツェルンの御曹司である主人公は、弟に奪われた経営権を取り戻すため、風俗むすめを講習し東京全店制圧を目指す。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01574000/RJ01573967/457d34ba9aafba565ce6162f6da255ed.jpg",
      "alt": "風俗むすめ S●Xワーカー [東京なおみ]",
      "title": "風俗むすめ S●Xワーカー [東京なおみ]"
     },
     "position": "over"
