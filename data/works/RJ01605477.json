 "introductions": [
  {
   "type": "image",
   "title": "クラスメイトの彼氏持ち女子と、学園祭おっぱぶ特訓",
   "body": [
    {
     "intro": "あなたのクラスは、学園祭でおっぱぶをやることになりました。<br />\n<br />\n女子と男子はペアになって、おっぱぶの特訓をする決まりです。<br />\n<br />\nあなたのパートナーは、クラスメイトの彼氏持ち女子。<br />\n<br />\n20日の特訓期間の間、一緒に学園生活を送りながら信頼を育んでいきましょう。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01606000/RJ01605477/9bbdfd0001b8e773b9880b735a6059d8.jpg",
      "alt": "学園祭おっぱぶパートナー特訓with彼氏持ち女子 [イヌのすみか]",
      "title": "学園祭おっぱぶパートナー特訓with彼氏持ち女子 [イヌのすみか]"
     },
     "position": "left"
    }
   ]
  },
  {
   "type": "image",
   "title": "自由度の高いおさわりシミュで、おっぱぶの特訓！",
   "body": [
    {
     "intro": "放課後は毎日、おっぱぶの特訓です。<br />\n<br />\nおさわりしたい場所をクリックして、自由に行動を選べます。<br />\n<br />\n最初は恥ずかしがってほとんど何もできませんが、一緒の時間を過ごすことで、少しずつできることが増えていくことでしょう。<br />\n<br />\nおっぱいを揉む以外にも、ちんちんをしごいてもらったり、ま〇こをさわったりと、いろいろなことができます。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01606000/RJ01605477/aba985ad54ba61c47f0ff5c29a499dd6.jpg",
      "alt": "学園祭おっぱぶパートナー特訓with彼氏持ち女子 [イヌのすみか]",
      "title": "学園祭おっぱぶパートナー特訓with彼氏持ち女子 [イヌのすみか]"
     },
     "position": "left"
    }
   ]
  },
  {
   "type": "image",
   "title": "あなたがさわるだけじゃない、新インタラクティブシステム",
   "body": [
    {
     "intro": "おっぱぶの特訓は、1人ではなく2人でするもの。<br />\n<br />\nあなたが一方的に触るだけでなく、女の子の方からもリアクションをしてきます。<br />\n<br />\n恥ずかしそうに顔を隠したり、時には自分からまたがって腰を振り出したり……。<br />\n<br />\n臨場感のあるインタラクティブえっちをお楽しみください。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01606000/RJ01605477/92fc75f069131490b41a05ee69417b52.jpg",
      "alt": "学園祭おっぱぶパートナー特訓with彼氏持ち女子 [イヌのすみか]",
