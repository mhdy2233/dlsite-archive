 "introductions": [
  {
   "type": "image",
   "title": "☆あらすじ☆",
   "body": [
    {
     "intro": "突如飛ばされた異世界、アダルトグッズ大好きなあなたはこれで商売をするのに決めた。<br />\nツンデレお嬢様、異種族店員などの美少女たちと一緒にアダルトショップを経営して、唯一無二の店を作ろう！",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01619000/RJ01618602/0a934b0e7796a3ff6f5427f322f64acc.jpg",
      "alt": "異世界アダルトショップ [Mango Party]",
      "title": "異世界アダルトショップ [Mango Party]"
     },
     "position": "under"
    }
   ]
  },
  {
   "type": "image_list",
   "title": "☆メインキャラクター☆　(※Hシーンはメインキャラクターのみ！)",
   "body": [
    {
     "intro": "『超真面目純情ツンデレお嬢様』<br />\nエリーノ・リベルティ・ジキル<br />\n　CV.蒼乃むすび(日本語)<br />\n　CV.伊橙/Kurihara Risako(中国語)<br />\n貿易事業を営む両親が陥れられ、投獄された。<br />\n絶望していた時に主人公と出会い、二人はビジネスパートナーとしてアダルトグッズ店を開業した。<br />\n<br />\n「もっとひどいことされたいですの?」<br />\n「す、好きにしろ！変態！」<br />\n「いただきまーす！」",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01619000/RJ01618602/909736b366db2b605aa2191875f7ac86.jpg",
      "alt": "異世界アダルトショップ [Mango Party]",
      "title": "異世界アダルトショップ [Mango Party]"
     }
    },
    {
     "intro": "『元気いっぱい羊角娘』<br />\n羊飼いのクロエ<br />\n　CV.夕季鈴(日本語)<br />\n　CV.釀釀/Niang Niang(中国語)<br />\n羊角族の女性は適齢期になると部族を離れ、結婚相手として認められる男性を探す。<br />\n所持金を騙し取られたため、主人公の店で働いている。<br />\n<br />\n「じ、じっと見ないでください……恥ずかしい……」<br />\n「あなたの体で俺がガチガチになったからよ、もっと自信をもって！クロエ。」<br />\n「なんか……クロエがなんかおかしい……」",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01619000/RJ01618602/739f92375d511d96ad0d9ff68a35128c.jpg",
      "alt": "異世界アダルトショップ [Mango Party]",
      "title": "異世界アダルトショップ [Mango Party]"
     }
    },
    {
     "intro": "『清楚千年痴女エルフ』<br />\nシルヴィア・オークレイ<br />\n　CV.柊香礼(日本語)<br />\n　CV.霏筱雨/Rain(中国語)<br />\n吟遊詩人として各地を放浪するエルフ。<br />\n優しく美しい歌聲と優雅で感動的な立ち居振る舞いは、民衆に深く愛されている。<br />\nしかし実態は、裏で淫乱すぎたために一族に恥をかかせ、父親に女王の地位を剥奪され追放された。<br />\n<br />\n「はあ……男の指……素敵……」<br />\n「むふふ、気持ちよさそうな顔しているよ。」<br />\n「だって……かき混ぜられるのが気持ちいいもん。」",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01619000/RJ01618602/049ba4f33f423bd20be067b47c2d5e89.jpg",
      "alt": "異世界アダルトショップ [Mango Party]",
      "title": "異世界アダルトショップ [Mango Party]"
     }
    },
    {
     "intro": "『無慈悲で毒舌な小悪魔女神』<br />\nニコ<br />\n　CV.東シヅ(日本語)<br />\n　CV.水曜日/Suiyobi(中国語)<br />\n勇者と魔王の戦争が終わって数百年後、毎日何もすることがない半引退状態の女神。<br />\n当初魔王討伐の過程があまりにもスムーズだったため、普段からあちこちで崇拝され敬仰されている。<br />\n自分が強すぎるからこそ天神から与えられた任務を順調にこなせるのだと思い始め、<br />\n数百年の時を経て、性格が徐々に悪趣味になった。<br />\n恭しくひれ伏す雑魚のような人間にはもう何も感じなくなり、<br />\nあまりにも退屈だったので、異世界人を召喚して観察日記をつけ始めた。<br />\n<br />\n「っ感じるなんて！思いあがるな！」<br />\n「だ、だまれ！わしがそんな……んんっ！」<br />\n「まさか……わし、本当は淫乱だったの?」",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01619000/RJ01618602/c0f1d7058bbf5b59940ecf4d0375379a.jpg",
      "alt": "異世界アダルトショップ [Mango Party]",
      "title": "異世界アダルトショップ [Mango Party]"
     }
    }
   ]
