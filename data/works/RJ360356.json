     "intro": "アミィ<br />\n<br />\n元気で明るい魔法少女。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ361000/RJ360356/c97f336ecbe964ffbe5511e4f7e2b526.jpg",
