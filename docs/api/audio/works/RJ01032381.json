ite.jp/modpub/images2/work/doujin/RJ01033000/RJ01032381_img_smp2.jpg","https://img.dlsite.jp/modpub/images2/work/doujin/RJ01033000/RJ01032381_img_smp3.jpg"],"sample_thumbs":["https://img.dlsite.jp/resize/images2/work/doujin/RJ01033000/RJ01032381_img_smp1_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ01033000/RJ01032381_img_smp2_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ01033000/RJ01032381_img_smp3_100x100.jpg"],"alt":"ギャルちゃんと!放課後のお付き合い♪音声Ver [3Dライブ]"},"introductions":[{"type":"text","title":"◆はじめに","body":[{"intro":"【マンガ×同人誌コラボ作品】<br />\r\n<br />\r\nギャルマンガで人気の「やまこんぶ」先生と<br />\r\n音声サークル「3Dライブ」がコラボしました!<br />\r\n<br />\r\nマンガと音声で見て聞いて楽しむ「マンガ×音声」<br />\r\n原作のアナザーストーリーを音声で楽しむ「ボリュームUP音声」<br />\r\n以上の2部構成となっています。<br />\r\n<br />\r\nマンガ、音声それぞれ単体でも楽しめますが、両方お買い求め頂くことで、<br />\r\nより一層楽しんでいただける作品となっております!"}]},{"type":"image","title":"◆コラボ作品","body":[{"intro":"","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ01033000/RJ01032381/d7c628484b1f91007865ad043c80e98d.jpg","alt":"ギャルちゃんと!放課後のお付き合い♪音声Ver [3Dライブ]","title":"ギャルちゃんと!放課後のお付き合い♪音声Ver [3Dライブ]"},"position":"over"}]},{"type":"image","title":"◆ストーリー","body":[{"intro":"","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ01033000/RJ01032381/32206a819081ca39b29dc54345791732.jpg","alt":"ギャルちゃんと!放課後のお付き合い♪音声Ver [3Dライブ]","title":"ギャルちゃんと!放課後のお付き合い♪音声Ver [3Dライブ]"},"position":"over"}]},{"type":"text","title":"◆トラックリスト","body":[{"intro":"【アナザーストーリー 音声Ver】<br />\r\n<br />\r\n◆01_ラブホは初めてかな?オナホで気持ちよくなろっ♪(09:14)<br />\r\n<br />\r\n  面倒な課題が出て、しばらくは凝ったプレイができないということで、<br />\r\n  今のうちにとラブホに訪れる二人。<br />\r\n  はじめてのラブホに戸惑う主人公とは裏腹に、慣れた感じの「あいり」。<br />\r\n  せっかくだからとSM器具で主人公を拘束し、オナホを使ってペニスを扱く。<br />\r\n  途中から調子に乗ったヒロインが加減を誤り、そのまま後は…。<br />\r\n<br />\r\n「なに?  きみは拘束されて女の子にアレコレされるの、イヤ?」<br />\r\n「ね、せっかくだし騙されたと思ってやってみよ。これも経験ってやつ。」<br />\r\n<br />\r\n◆02_1回射精したくらいじゃ…物足りないでしょ?(06:33)<br />\r\n<br />\r\n  「本番で楽しみたかったのに…。」とぼやきつつ、ベッドに移動。<br />\r\n    寝かせた主人公に覆いかぶさり、耳舐めを始める。<br />\r\n  「もうガマン出来ない」とあいりの方から挿入。<br />\r\n    始めはあいりが腰を振っていたが、主人公も興奮して下から突き上げる。<br />\r\n  「君の方からこんな激しく…めずらしいね。ラブホって場所だからコーフンしちゃった?  くすっ」<br />\r\n<br />\r\n◆03_今夜は中出しSEXで思いっきり楽しもうね♪(08:18)<br />\r\n<br />\r\n  数日後。なんとか課題をこなした2人。達成感と解放感に身を投げ出す。<br />\r\n  しばらくはのんびりと話をしていたが、<br />\r\n  ここ数日まともにセックスできてなかったことを思い出すと、<br />\r\n  急にムラムラし始める。<br />\r\n  ガマンできずにあいりが主人公に跨り、早くも濡れ始めた秘裂を<br />\r\n  擦りつけてくる。<br />\r\n<br />\r\n◆04_マンガVer<br />\r\n<br />\r\n  ※こちらの作品は、ギャルちゃんと!放課後のお付き合い♪の同人誌と<br />\r\n    一緒に視聴していただけますと、より一層楽しめる作品となっております。<br />\r\n<br />\r\n※効果音ありVerの時間表記です。"}]},{"type":"text","title":"◆クレジット","body":[{"intro":"〇声優　逢坂成美様<br />\r\n<a href=\"https://twitter.com/narumiaisaka?lang=ja\" target=\"_blank\">https://twitter.com/narumiaisaka?lang=ja</a><br />\r\n<br />\r\n〇イラスト　やまこんぶ様<br />\r\n<a href=\"https://twitter.com/14kkk3\" target=\"_blank\">https://twitter.com/14kkk3</a><br />\r\n<br />\r\n〇制作　3Dライブ<br />\r\n<a href=\"https://twitter.com/3dlive_asmr\" target=\"_blank\">https://twitter.com/3dlive_asmr</a>"}]}],"description":"ある日の放課後、教室に残って作業していると何やら考え込むクラスメイトのギャル「あいり」の姿が目に入る。あいりは今描いているエロ漫画で童貞の反応がわからず悩んでいるようだった。童貞の反応が知りたいあいりに誘われて、特別な関係に…。","short_introduction":"ある日の放課後、教室に残って作業していると何やら考え込むクラスメイトのギャル「あいり」の姿が目に入る。あいりは今描いているエロ漫画で童貞の反応がわからず悩んでいるようだった。童貞の反応が知りたいあいりに誘われて、特別な関係に…。","options":["SND","DLP","REV","ORW","RegionHiddenFilter"],"url":"https://www.dlsite.com/maniax/work/=/product_id/RJ01032381.html","site_id":"maniax","fetched_at":1795523542}