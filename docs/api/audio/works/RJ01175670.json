count":6502,"ranking":[{"category":"all","period":"day","rank":5,"date":"2024-05-07"},{"category":"all","period":"week","rank":8,"date":"2024-05-10"},{"category":"all","period":"month","rank":7,"date":"2024-05-30"},{"category":"voice","period":"day","rank":2,"date":"2024-05-06"},{"category":"voice","period":"week","rank":2,"date":"2024-05-10"},{"category":"voice","period":"month","rank":3,"date":"2024-05-27"},{"category":"voice","period":"year","rank":64,"date":"2024"},{"category":"voice","period":"total","rank":445,"date":"2026-05-18"}],"images":{"main":"https://img.dlsite.jp/modpub/images2/work/doujin/RJ01176000/RJ01175670_img_main.jpg","thumb":"https://img.dlsite.jp/resize/images2/work/doujin/RJ01176000/RJ01175670_img_main_240x240.jpg","samples":["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01176000/RJ01175670_img_smp1.jpg","https://img.dlsite.jp/modpub/images2/work/doujin/RJ01176000/RJ01175670_img_smp2.jpg","https://img.dlsite.jp/modpub/images2/work/doujin/RJ01176000/RJ01175670_img_smp3.jpg","https://img.dlsite.jp/modpub/images2/work/doujin/RJ01176000/RJ01175670_img_smp4.jpg","https://img.dlsite.jp/modpub/images2/work/doujin/RJ01176000/RJ01175670_img_smp5.jpg"],"sample_thumbs":["https://img.dlsite.jp/resize/images2/work/doujin/RJ01176000/RJ01175670_img_smp1_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ01176000/RJ01175670_img_smp2_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ01176000/RJ01175670_img_smp3_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ01176000/RJ01175670_img_smp4_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ01176000/RJ01175670_img_smp5_100x100.jpg"],"alt":"【脳舐め催○】ブレインリッカー【脳イキ/ドライオーガズム】 [逢縁喜縁]"},"introductions":[{"type":"image","title":"★+☆+★【脳イキ】へ誘う【3つの支配】★+☆+★","body":[{"intro":"逢縁喜縁初の催○作品「ヒプノパラサイト」から早数年……<br />\r\n「ドライ逝きが初めてできた」<br />\r\n「音圧が強くて本当に舐められているようだった」<br />\r\n「下垂体をイメージできた時フっとべた」<br />\r\nなど、たくさんのご好評をいただきました。<br />\r\n<br />\r\nあまりの編集の大変さに、正直当時は「もう2度と作らない、作れない…」と溢したヒプノパラサイト。<br />\r\nしかし多くのご好評を頂いた「脳舐め」「脳フェラ」という表現は、私にとっても特別なアイデアでした。<br />\r\nあるときふと、「脳を舐める」ことを目的とするのではなく、<br />\r\nそれを「使って」なにかできないか…と考えつきました。<br />\r\n<br />\r\n脳は部位によって、人間の様々な機能を司っています。<br />\r\nならば脳を「舐める」事によってそれらの機能をバグらせ、<br />\r\n現実ではありえない、一風変わった体験をお届けできるのではないか……?<br />\r\n<br />\r\n普段からストレスの多いみなさまは、<br />\r\n現実離れした、受動的に享受できる、新しい刺激に常に飢えているのではないか……?<br />\r\n<br />\r\nそしてそれを叶えるのは、誰かに心身ともに【支配】され、<br />\r\n【強○的に】絶頂を与え続けられるようなとびきりの経験ではないだろうか……?<br />\r\n<br />\r\nということで、本作のテーマは<br />\r\n脳舐めによる「3つの支配」となり<br />\r\nかつてのヒプノパラサイトの製作陣が一丸となって制作をいたしました。","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ01176000/RJ01175670/4515db566fa7954ac4661ae769762c74.jpg","alt":"【脳舐め催○】ブレインリッカー【脳イキ/ドライオーガズム】 [逢縁喜縁]","title":"【脳舐め催○】ブレインリッカー【脳イキ/ドライオーガズム】 [逢縁喜縁]"},"position":"under"}]},{"type":"image","title":"★+☆+★【脳舐め】とは?★+☆+★","body":[{"intro":"脳とは言うまでもありませんが人間の全てを司る器官です。<br />\r\n大きく分けて「感情」　「肉体」　「理性」という要素。<br />\r\n本作は脳を犯されることによって、この三大要素を支配される――「3つの支配」をテーマとしています。<br />\r\n<br />\r\n心を司る脳領域を舌によって刺激され、<br />\r\n脈絡なく嬉しくなり、悲しくなり、幸せになってしまう、<br />\r\n「感情の支配」<br />\r\n<br />\r\n身体を司る脳領域を舐め回され、<br />\r\n皮膚や乳首、全身の性感帯、挙句存在しないはずのクリトリスまでもを舐め回されているような触覚に対する錯覚。<br />\r\nそして運動野への介入により、肉体の動きさえもコントロールされてしまう。<br />\r\n「肉体の支配」<br />\r\n<br />\r\n高次の意識活動を制御する脳領域を舌に侵食され、<br />\r\n言語を理解する能力が損なわれ、言葉を意味不明な音の連なりとしてしか認識できなくなる。<br />\r\nそして普段は貴方の行動を押さえつけている「理性」という枷を取り払い、獣のように快楽を求めてしまうようになる。<br />\r\n「理性の支配」<br />\r\n<br />\r\n人間として、生物として決して手放してはいけないそれらの制御権を少女たちに奪われたなら、<br />\r\n後はもう脳本来の本能……つまり「幸福」と「快楽」を求めるだけの生き物の出来上がり。<br />\r\n<br />\r\n脳の仕組みを知り尽くした二匹の「脳舐め」による、<br />\r\n限度を超えた寸止めオナニー地獄や、<br />\r\n発狂するほど気持ちいい連続脳アクメ地獄など、<br />\r\n自分一人では決してたどり着けない脳の深奥……その奥深さを心行くまでご堪能下さい。","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ01176000/RJ01175670/fa33cecd85f1278c54143f0945344641.jpg","alt":"【脳舐め催○】ブレインリッカー【脳イキ/ドライオーガズム】 [逢縁喜縁]","title":"【脳舐め催○】ブレインリッカー【脳イキ/ドライオーガズム】 [逢縁喜縁]"},"position":"under"}]},{"type":"image","title":"★+☆+★【注意事項】★+☆+★","body":[{"intro":"","image_info":{"url":"//img.