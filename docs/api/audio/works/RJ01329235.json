ng":["CHI_HANT"]}],"rating":{"average":4.78,"count":274},"review_count":36,"dl_count":2463,"wishlist_count":944,"ranking":[{"category":"voice","period":"day","rank":30,"date":"2025-01-29"},{"category":"voice","period":"month","rank":89,"date":"2025-02-27"}],"images":{"main":"https://img.dlsite.jp/modpub/images2/work/doujin/RJ01330000/RJ01329235_img_main.jpg","thumb":"https://img.dlsite.jp/resize/images2/work/doujin/RJ01330000/RJ01329235_img_main_240x240.jpg","samples":["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01330000/RJ01329235_img_smp1.jpg","https://img.dlsite.jp/modpub/images2/work/doujin/RJ01330000/RJ01329235_img_smp2.jpg","https://img.dlsite.jp/modpub/images2/work/doujin/RJ01330000/RJ01329235_img_smp3.jpg","https://img.dlsite.jp/modpub/images2/work/doujin/RJ01330000/RJ01329235_img_smp4.jpg"],"sample_thumbs":["https://img.dlsite.jp/resize/images2/work/doujin/RJ01330000/RJ01329235_img_smp1_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ01330000/RJ01329235_img_smp2_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ01330000/RJ01329235_img_smp3_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ01330000/RJ01329235_img_smp4_100x100.jpg"],"alt":"【祝・童貞卒業】友達のお姉ちゃんが「パパ活黙秘」を条件におちんちんを抜いてくれた話。【KU100】 [こおろぎショート個展]"},"introductions":[{"type":"text","title":"トラックリスト","body":[{"intro":"●track1:地雷系のパパ活お姉ちゃんにからかわれて…  　【再生時間 8:37秒】<br />\n(キス、手コキ、乳首舐め、射精)<br />\n 友達の家を訪ねるとその姉であるひいろと遭遇した。<br />\n前々から知ってはいたがあまり接点のない関係性。<br />\n彼女は「パパ活」に行くらしくゴシック衣装で身を固めていた。<br />\n<br />\nパパ活とはどんなものなのか……肉体関係を想像してしまう。<br />\n妄想の末につい勃起すると、それを発見したひいろは──<br />\n<br />\n<br />\n●track2:えっちがしたくて地雷お姉ちゃんにパパ活提案!　【再生時間 11:42】<br />\n(相互鑑賞オナニー、バイブ、同時絶頂)<br />\n<br />\n一度抜いたもらったことでひいろを忘れられない日々を過ごす。<br />\nパパ活──ようは金を払えば気持ちよくなれるのでは?<br />\nそう思い、財布を持ってひいろのもとを訪ねた。<br />\nするとひいろは──<br />\n<br />\n●track3:キミのシタいえっちを叶えてあげるお姉ちゃんと　【再生時間 9:19】<br />\n(咥えフェラ、騎乗位、乳首舐め、ゴム着用、ゴム内射精)<br />\n<br />\n精液まみれになったペニスを咥えるひいろ<br />\n綺麗にし終えるとひいろはゴムを取り出して挿入を提案!<br />\n童貞は友達の姉に奪われることに…<br />\n<br />\n ●track4:パパ活失敗で慰めてくれたあなたへのご褒美は…　【再生時間 13:42】<br />\n(キス、耳舐め、乳首責め、立ちバック、正常位、生ハメ、連続中出し)<br />\n<br />\n後日、下校中に再びひいろと遭遇<br />\nパパ活帰りで失敗したらしくちょっとイライラしている<br />\n家に上げられると、廊下で挿入を催促されて初めてのナマで立ちバック!<br />\nそこから、ひいろに誘導されながら激しいオトナの快感を味わうことに…<br />\n<br />\n全4トラック"}]},{"type":"text","title":"クレジット","body":[{"intro":"・声優:山田じぇみ子様 @gemiko_voice<br />\r\n・イラスト:jfjf様 @jfjf000_018<br />\r\n・企画/シナリオ/編集:こおろぎアトリエ @ScenarioKoa<br />\r\n・サークル:こおろぎショート個展 @KohrogiShort<br />\r\n・収録:代々木バイノーラルスタジオ様"}]}],"description":"【KU100作品】地雷系お姉ちゃんとショタの経験を描いた今作!パパ活女子な友達のお姉ちゃんが経験させてくれる数々の興奮をその耳で感じてください","short_introduction":"【KU100作品】地雷系お姉ちゃんとショタの経験を描いた今作!パパ活女子な友達のお姉ちゃんが経験させてくれる数々の興奮をその耳で感じてください","options":["SND","DLP","REV","TRI","ORW"],"url":"https://www.dlsite.com/maniax/work/=/product_id/RJ01329235.html","site_id":"maniax","fetched_at":1795507453}