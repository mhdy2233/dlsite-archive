2530_img_smp2.jpg","https://img.dlsite.jp/modpub/images2/work/doujin/RJ01483000/RJ01482530_img_smp3.jpg","https://img.dlsite.jp/modpub/images2/work/doujin/RJ01483000/RJ01482530_img_smp4.jpg"],"sample_thumbs":["https://img.dlsite.jp/resize/images2/work/doujin/RJ01483000/RJ01482530_img_smp1_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ01483000/RJ01482530_img_smp2_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ01483000/RJ01482530_img_smp3_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ01483000/RJ01482530_img_smp4_100x100.jpg"],"alt":"縁魔 欲 [近未来のふわふわ]"},"introductions":[{"type":"image","title":"【セールスポイント】","body":[{"intro":"♪色香を求めて、道を誤った先に待っているのは、この世の物とは思えない魔性の女♪<br />\n♪KU100ダミーヘッドマイク収録によるささやきボイスで主さんのお相手を致します♪<br />\n♪フォーリーサウンドによるリアル演出、暗闇の奥にある恐怖を感じて下さい♪<br />\n<br />\n※注意:本作付属のイラストは、NovelAIにより出力された画像を合成して制作されております※","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ01483000/RJ01482530/264bf916b59f93b68d1b51668c1bdadd.jpg","alt":"縁魔 欲 [近未来のふわふわ]","title":"縁魔 欲 [近未来のふわふわ]"},"position":"over"}]},{"type":"image","title":"トラック内容","body":[{"intro":"トラック1『くびり殺す』(17:16)<br />\n「ん?懲りぬお方でございますねえ。んふふふ、さて」<br />\n「如何でございましょうか。花街のはずれで、細々と命をつないでいる」<br />\n「名もない女であるのか。あるいは、人の世に紛れ込み、夜の闇に潜み」<br />\n「男の性を搾り取る、人外の化け物であるのか」<br />\n(正常位、キス、射精)<br />\n<br />\nトラック2『金は天下の回り物』(12:50)<br />\n「あん、ん、んふふ、ご容赦、下さるのでございますか?」<br />\n「惨めな化け物は、命乞いをせねばなりません。んふふ、あなた様のお体に」<br />\n「ご満足いただけるよう、精一杯、哀願いたしましょう」<br />\n「んふふ、何卒、お情けを下さいませ。この通りでございます」<br />\n(フェラチオ、入浴、洗体)<br />\n<br />\nトラック3『恐ろしや』(13:34)<br />\n「少しばかり、体を入れ替えて、こちらの側から、腹の下を探ってみましょう」<br />\n「ゆったりと、指を這わせて、下へ、下へ、潜ってゆく。んー?ああ」<br />\n「なんとなんと、これはこれは、んっふっふっふ。主さんの強直は、真」<br />\n「逞しくございますねえ。んふふ、今しがた、この硬い肉で、鬼退治を」<br />\n(手コキ、射精)<br />\n<br />\nトラック4『僥倖』(15:26)<br />\n「失礼致します。んふふ、湯あたりでございますか?」<br />\n「随分と、あったまってございましたからねえ。体の水が」<br />\n「風呂の湯気に混じって、流れ出てしまったのでしょう。さあ、主さん」<br />\n「すーっと、喉の奥へ滑り落ちて、体の肉の隅々まで潤して行くます」<br />\n(背面・睾丸マッサージ)<br />\n<br />\nトラック5『豪儀』(14:32)<br />\n「私に、何か失態がございましたか?」<br />\n「ん、ああん、ちゅ、ちゅう、ん、あえあ、ちゅ、んああ」<br />\n「玉を、強く握りこみすぎてございましたでしょうか」<br />\n「按摩をするのでしたら、ほとよりも、この手のほうが、あん、ん」<br />\n(正常位、キス、射精)<br />\n<br />\nトラック6『人を恐れて闇に潜む者共』(15:00)<br />\n「主さん。如何いたしましょう。このまま、お休みになられますか?」<br />\n「んちゅう、ちゅ、んちゅう、ああん、ちゅ、ちゅう、えあ、ん、ああ」<br />\n「私のほとでは、飲み尽くせませんので、一度引き抜いて下さいませ」<br />\n「腰を打たれるのは、いくらでも、喜んでお受けいたします」<br />\n(添い寝)","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ01483000/RJ01482530/c045fa23e5c9182a8bca29de8f56c805.jpg","alt":"縁魔 欲 [近未来のふわふわ]","title":"縁魔 欲 [近未来のふわふわ]"},"position":"over"}]},{"type":"image","title":"作品詳細","body":[{"intro":"総再生時間　88:38(BGM有/無)<br />\nwav、m4a同梱<br />\n高解像度イメージイラスト<br />\n<br />\n声の出演:園宮さつき　satsuki sonomiya<br />\n <a href=\"https://twitter.com/sonomiya5gatsu\" target=\"_blank\">https://twitter.com/sonomiya5gatsu</a><br />\nAIイラスト合成:ミシェル・ウマリ　michel umari<br />\nシナリオ:林　千秋　chiaki hayashi<br />\n効果・編集:フェリペ・デイビス felipe davis<br />\n制作:近未来のふわふわ<br />\n <a href=\"https://twitter.com/Fuwahuwa2057\" target=\"_blank\">https://twitter.com/Fuwahuwa2057</a><br />\n <a href=\"https://www.pixiv.net/users/64461827\" target=\"_blank\">https://www.pixiv.net/users/64461827</a>","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ01483000/RJ01482530/1415188afd57306bafd8eff1495a06bf.jpg","alt":"縁魔 欲 [近未来のふわふわ]","title":"縁魔 欲 [近未来のふわふわ]"},"position":"over"}]},{"type":"image","title":"","body":[{"intro":"","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ01483000/RJ01482530/4d42f0ec147d190eb205b72daa786322.jpg","alt":"縁魔 欲 [近未来のふわふわ]","title":"縁魔 欲 [近未来のふわふわ]"},"position":"over"}]}],"description":"人が欲するこの幻","short_introduction":"人が欲するこの幻","options":["SND","AIP","TRI","DLP","REV","ORW"],"url":"https://www.dlsite.com/maniax/work/=/product_id/RJ01482530.html","site_id":"maniax","fetched_at":1795502170}