s2/work/doujin/RJ060000/RJ059625_img_smp4.jpg"],"sample_thumbs":["https://img.dlsite.jp/resize/images2/work/doujin/RJ060000/RJ059625_img_smp1_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ060000/RJ059625_img_smp2_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ060000/RJ059625_img_smp4_100x100.jpg"],"alt":"ナイショ～ネットカフェ編～ [lambskin]"},"introductions":[{"type":"image","title":"隣り合う二組のカップルのナイショ。","body":[{"intro":"","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ060000/RJ059625/25f38becf379fea1bb45f602653691ac.jpg","alt":"ナイショ～ネットカフェ編～ [lambskin]","title":"ナイショ～ネットカフェ編～ [lambskin]"},"position":"over"}]},{"type":"image","title":"あなたのカワイイ彼女、アイリ。","body":[{"intro":"","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ060000/RJ059625/bf6c707862103b16889fab6ab3611192.jpg","alt":"ナイショ～ネットカフェ編～ [lambskin]","title":"ナイショ～ネットカフェ編～ [lambskin]"},"position":"over"}]},{"type":"image","title":"あなたのクールな彼女、ユズカ。","body":[{"intro":"","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ060000/RJ059625/205e12cbe4fb07fb24299f0b993dfc72.jpg","alt":"ナイショ～ネットカフェ編～ [lambskin]","title":"ナイショ～ネットカフェ編～ [lambskin]"},"position":"over"}]},{"type":"image","title":"制作にご協力いただいたクリエイターの皆様。","body":[{"intro":"","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ060000/RJ059625/33cce47c61845ce3769d158cd0fa549c.jpg","alt":"ナイショ～ネットカフェ編～ [lambskin]","title":"ナイショ～ネットカフェ編～ [lambskin]"},"position":"over"}]},{"type":"text","title":"ネットカフェで、「ナイショ」しちゃう?","body":[{"intro":"※こちらは、2010年にサークルlambの作品として発売されたもののリマスター版になります。<br />\n旧バージョンをベースに、イラストを新たに作成。<br />\n収録音源もリマスターし、デザインを刷新した作品になります。<br />\n<br />\n<br />\n<br />\nどこにでもあるような、ネットカフェ。<br />\nペアブースで、たまたま隣り合った二組のカップル。<br />\nそれぞれ事情は知らないけど、お互いが醸し出す雰囲気と声が、イケナイ気持ちを刺激する！?<br />\n<br />\n<br />\n・アイリ編<br />\n<br />\n久しぶりのデートで、あなたは彼女のアイリと一緒に、ネットカフェに遊びに行きます。<br />\nイチャイチャしたくてたまらないアイリですが、そんな彼女をほっといて、あなたはマンガに夢中。<br />\nかまってほしいアイリは、あの手この手であなたの興味をひこうとします。<br />\nそれがだんだんエスカレートしていって……。<br />\n<br />\n<br />\n・ユズカ編<br />\n<br />\nあなたはバイト先の社員であるユズカの恋人。<br />\n休憩時間になって、ユズカが仕事をしているブースに遊びに行きます。<br />\n二人だけの時間をまったり過ごしていると、隣のブースからエッチな声が……。<br />\nだんだん我慢できなくなってきたあなたは、ユズカに迫りますが、彼女にその気はない様子。<br />\nでも、大好きなあなたに迫られ続けると……。<br />\n<br />\n<br />\nイタズラ好きで元気なアイリと、<br />\nクールで大人なユズカ――<br />\n<br />\nあなたの彼女を選んでね♪<br />\n<br />\n<br />\n今回リマスター版のリリースに際しまして、<br />\n2010年当時の旧バージョンも同梱しています。<br />\n聞き比べることで、あの頃といまの違いを感じられる……かも。<br />\n<br />\n<br />\n<br />\nアイリ:貴坂理緒<br />\nユズカ:分倍川原シホ<br />\n<br />\n☆リマスター版<br />\nイラスト:モカヒ<br />\n音声編集:Mobius￡<br />\nデザイン:夜伽ポルカ<br />\n<br />\n☆旧バージョン<br />\nイメージイラスト:じゅんきち<br />\n<br />\n※敬称略<br />\n<br />\nその他全部:ギハラ"}]}],"description":"ネットカフェで、「ナイショ」しちゃう?","short_introduction":"ネットカフェで、「ナイショ」しちゃう?","options":["REV","DLP","SND","TRI","ORW","RegionHiddenFilter"],"url":"https://www.dlsite.com/maniax/work/=/product_id/RJ059625.html","site_id":"maniax","fetched_at":1795543250}