work/=/product_id/RJ01150302.html","lang":["KO_KR"]}],"rating":{"average":4.79,"count":3449},"review_count":28,"dl_count":8312,"wishlist_count":1612,"ranking":[{"category":"all","period":"day","rank":9,"date":"2020-06-26"},{"category":"all","period":"week","rank":32,"date":"2020-07-01"},{"category":"all","period":"month","rank":66,"date":"2020-07-22"},{"category":"voice","period":"day","rank":3,"date":"2020-06-26"},{"category":"voice","period":"week","rank":15,"date":"2020-07-01"},{"category":"voice","period":"month","rank":31,"date":"2020-07-22"}],"images":{"main":"https://img.dlsite.jp/modpub/images2/work/doujin/RJ291000/RJ290942_img_main.jpg","thumb":"https://img.dlsite.jp/resize/images2/work/doujin/RJ291000/RJ290942_img_main_240x240.jpg","samples":["https://img.dlsite.jp/modpub/images2/work/doujin/RJ291000/RJ290942_img_smp1.jpg","https://img.dlsite.jp/modpub/images2/work/doujin/RJ291000/RJ290942_img_smp2.jpg","https://img.dlsite.jp/modpub/images2/work/doujin/RJ291000/RJ290942_img_smp3.jpg"],"sample_thumbs":["https://img.dlsite.jp/resize/images2/work/doujin/RJ291000/RJ290942_img_smp1_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ291000/RJ290942_img_smp2_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ291000/RJ290942_img_smp3_100x100.jpg"],"alt":"【シェイカー・耳かき】BAR『Envelop』マスター・朱里【CV.櫻川めぐ】 [RaRo]"},"introductions":[{"type":"text","title":"概要","body":[{"intro":"★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★<br />\n<br />\n本作では、人気声優の「櫻川めぐ」さんをCVに迎えて制作致しました!<br />\n<br />\n<a href=\"https://twitter.com/sakuragawa_megu\" target=\"_blank\">https://twitter.com/sakuragawa_megu</a><br />\n<br />\nSEはプロのバーテンダーによる実演をそのまま収録しており、<br />\nリアルなバーの「音」をお楽しみいただけます。<br />\n<br />\n★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★"}]},{"type":"image","title":"【本作品のポイント】","body":[{"intro":"・ポイント1<br />\n　本作品はバーの中での、大人の時間をお届け致します。<br />\n　カクテルを作るシェーカーの音、そっと響く氷の音……<br />\n　そんな落ちついた時間の、バーテンダーの女の子が、<br />\n　あなたの耳元でやさしく囁いてくれます。<br />\n　心地よい癒やしの時間、どうぞお楽しみください。<br />\n<br />\n<br />\n・ポイント2<br />\n　もちろん今回も、ただおしゃべりをして終わるわけではありません。<br />\n　寄り添うようにして肩を揉んでくれたり、そっと髪を撫でてくれたり……<br />\n　それだけじゃなく、頭や耳をやさしく揉んでくれて、幸せな時間を過ごしてくれます。<br />\n　普通のバーでは味わえない一時を、どうぞ味わってください。<br />\n<br />\n<br />\n・ポイント3<br />\n　バーテンダー・朱里の声をご担当されたのは、櫻川めぐさん。<br />\n　ふんわりとした普段のおしゃべりも、ちょっとだけからかうような、だけどやさしい囁きも、しっかりと収録しています。<br />\n　2人きりの大人の時間を、たっぷりとお過ごしください。","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ291000/RJ290942/95db4cf0ff034c1ed2eeed654cedcb5d.jpg","alt":"【シェイカー・耳かき】BAR『Envelop』マスター・朱里【CV.櫻川めぐ】 [RaRo]","title":"【シェイカー・耳かき】BAR『Envelop』マスター・朱里【CV.櫻川めぐ】 [RaRo]"},"position":"over"}]},{"type":"image","title":"【ヒロイン紹介】","body":[{"intro":"朱里(あかり)<br />\n　CV:櫻川めぐ<br />\n　<br />\n　バー『Envelop(エンベローブ)』のマスター。<br />\n　どこかおっとりした雰囲気を持つお姉さん。<br />\n　だけど、仲のいい人のことは、ほんの少しからかいたくなったりする。<br />\n　趣味はマッサージで、素人ながら独学で勉強したりしている。","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ291000/RJ290942/f37944bf635ac7daeb23f543f8316f41.jpg","alt":"【シェイカー・耳かき】BAR『Envelop』マスター・朱里【CV.櫻川めぐ】 [RaRo]","title":"【シェイカー・耳かき】BAR『Envelop』マスター・朱里【CV.櫻川めぐ】 [RaRo]"},"position":"over"}]},{"type":"track_list","title":"【トラックリスト】","body":[{"duration":"04分37秒","name":"オープニング　Bar Envelopにようこそ"},{"duration":"07分36秒","name":"朱里の作るカクテル"},{"duration":"46分50秒","name":"2人きりで乾杯～肩揉み"},{"duration":"09分09秒","name":"個室に入ってヘッドマッサージ"},{"duration":"28分11秒","name":"個室に入って綿棒で耳掃除～右側"},{"duration":"20分06秒","name":"引き続き綿棒で耳掃除～左側"},{"duration":"04分47秒","name":"エピローグ　秘密のキス"}]},{"type":"image","title":"【スペック・スタッフ】","body":[{"intro":"【収録環境】<br />\n高品質ダミーヘッドマイク「NEUMANN / KU100」で収録しているため<br />\nヘッドフォンもしくはイヤホンを使用して視聴することをオススメ致します。<br />\n※本作品は全編バイノーラル録音です。<br />\n<br />\n【収録時間】<br />\n計8トラック:総収録時間　約02時間02分<br />\n<br />\n【ファイル形式】<br />\nWAV:96kHz / 24Bit　ハイレゾ音質<br />\nMP3:44.1kHz / 256kbps<br />\n高解像度イラスト&amp;テキスト同梱<br />\n<br />\n&lt;キャスト&gt;<br />\n櫻川めぐ<br />\n<br />\n&lt;イラスト&gt;<br />\nはすみ<br />\n<br />\n&lt;シナリオ&gt;<br />\n中島大河<br />\n<br />\n<br />\n<br />\n〇収録スタジオ<br />\n「Studio Unshakable」<br />\n<a href=\"https://unshakable.co.jp/\" targ