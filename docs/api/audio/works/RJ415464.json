464_img_smp2.jpg","https://img.dlsite.jp/modpub/images2/work/doujin/RJ416000/RJ415464_img_smp3.jpg","https://img.dlsite.jp/modpub/images2/work/doujin/RJ416000/RJ415464_img_smp4.jpg","https://img.dlsite.jp/modpub/images2/work/doujin/RJ416000/RJ415464_img_smp5.jpg"],"sample_thumbs":["https://img.dlsite.jp/resize/images2/work/doujin/RJ416000/RJ415464_img_smp1_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ416000/RJ415464_img_smp2_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ416000/RJ415464_img_smp3_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ416000/RJ415464_img_smp4_100x100.jpg","https://img.dlsite.jp/resize/images2/work/doujin/RJ416000/RJ415464_img_smp5_100x100.jpg"],"alt":"田舎のサセ子さん。 [US耳]"},"introductions":[{"type":"image","title":"■キャンペーン情報","body":[{"intro":"","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ416000/RJ415464/140ed8fbd34babe9722f53ea9ebcf1d4.jpg","alt":"田舎のサセ子さん。 [US耳]","title":"田舎のサセ子さん。 [US耳]"},"position":"over"}]},{"type":"image","title":"■イントロダクション","body":[{"intro":"","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ416000/RJ415464/5bb931c20cda3377f61815f102b21577.jpg","alt":"田舎のサセ子さん。 [US耳]","title":"田舎のサセ子さん。 [US耳]"},"position":"over"}]},{"type":"image","title":"■キャラクター紹介","body":[{"intro":"","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ416000/RJ415464/e9b687e15a33188e6d9cee437ecb39d9.jpg","alt":"田舎のサセ子さん。 [US耳]","title":"田舎のサセ子さん。 [US耳]"},"position":"over"}]},{"type":"image","title":"■トラックリスト","body":[{"intro":"ーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーー<br />\ntr01　田舎のサセ子さん[1:04:20]<br />\nーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーー<br />\n<br />\n帰省先のバス停で雨宿りをしていると、ノーブラ白ワンピースの少女。<br />\n雨で濡れ、透ける肌色にあなたがドギマギしていると…彼女は悪戯っぽい笑みを浮かべて囁いてくる。<br />\n<br />\n「雨も全然止む気配ないしさ。このままおねーさんとエッチなこと…シちゃう?」<br />\n<br />\nまろび出るIカップの乳房。甘酸っぱい汗の匂い。<br />\n濡れた肌の吸い付く感触があなたを狂わせ…流されるまま、待合所のベンチでセックス。<br />\n<br />\n「いよいよだね、童貞卒業の瞬間…♪」<br />\n<br />\n初めて体験する膣内の快楽。<br />\n絡みつく肉ヒダに、そして甘いキスの味に、あなたは我を忘れ目の前の女体をむさぼる。<br />\n<br />\nーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーー<br />\ntr02　一夏のカンケイ[49:35]<br />\nーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーー<br />\n<br />\n翌日。約束の場所に行ってみると…本当に彼女は待っていた。<br />\n<br />\n「ふふ、やっぱり来た。ヘンターイ♪」<br />\n<br />\nからかうように言った後、彼女は上気した声であなたに頼み事をする。<br />\n<br />\n「今だけでイイから…私のこと、好きになってくれる?」<br />\n「シてみたいんだ。恋人同士のエッチ。…ダメかな?」<br />\n<br />\n優しく舌を絡ませ、ねっとりと甘いディープキス。<br />\nIカップパイズリ奉仕の気持ち良さはまさに天国のよう。<br />\n<br />\nそしてセックスの前、彼女の口から明かされた事実とは。<br />\n<br />\n「うん…シよ、エッチ。生で」<br />\n「フリなんかじゃなくてさ。本当の…恋人同士の、気持ちを伝え合うエッチ――」<br />\n<br />\nーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーー<br />\ntr03　エピローグ[03:18]<br />\nーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーー","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ416000/RJ415464/ecf0ff65697ac99d6b764fe113590a5d.jpg","alt":"田舎のサセ子さん。 [US耳]","title":"田舎のサセ子さん。 [US耳]"},"position":"over"}]},{"type":"image","title":"","body":[{"intro":"","image_info":{"url":"//img.dlsite.jp/modpub/images2/parts/RJ416000/RJ415464/54cb53bb01196db5eb79f3f5671e60be.jpg","alt":"田舎のサセ子さん。 [US耳]","title":"田舎のサセ子さん。 [US耳]"},"position":"over"}]},{"type":"text","title":"","body":[{"intro":"■収録内容詳細<br />\n・本編(WAV/mp3同梱)<br />\n・ロゴなしジャケットイラスト<br />\n<br />\n■クレジット<br />\nCV　柚木つばめ様<br />\nイラスト　けそシロウ様<br />\n<br />\n制作　US耳<br />\n<br />\nTwitter( <a href=\"https://twitter.com/US_usamimi\" target=\"_blank\">https://twitter.com/US_usamimi</a> )<br />\nCi-en( <a href=\"https://ci-en.dlsite.com/creator/3763\" target=\"_blank\">https://ci-en.dlsite.com/creator/3763</a> )"}]}],"description":"『エッチなこと、シちゃおっか?w』帰省先の田舎のバス停。雨宿りの最中出会ったノーブラ白ワンピースの少女に誘惑され、汗に濡れた肌を密着させての濃厚なセックス。これは、あなたが『彼女』のことを思い出すまでのノスタルジック青姦ASMR。","short_introduction":"『エッチなこと、シちゃおっか?w』帰省先の田舎のバス停。雨宿りの最中出会ったノーブラ白ワンピースの少女に誘惑され、汗に濡れた肌を密着させての濃厚なセックス。これは、あなたが『彼女』のことを思い出すまでのノスタルジック青姦ASMR。","options":["SND","TRI","DLP","REV","OLY"],"url":"https://www.dlsite.com/maniax/work/=/product_id/RJ415464.html","site_id":"maniax","fetched_at":1795528081}