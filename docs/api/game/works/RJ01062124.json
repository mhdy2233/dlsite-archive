 "introductions": [
  {
   "type": "image",
   "title": "犇女学園、新学期開幕…!!",
   "body": [
    {
     "intro": "催○術で生意気バディの牛女たちをカンタン操作で催○術にかけよう♪<br />\n<br />\n前作「もおれつ!!催○学園」の牛っ子たちが帰ってきたよ♪<br />\n<br />\n前作を知らなくてもお気軽にプレイできます",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01063000/RJ01062124/23481f39befe532f705d0e3be4bbc33f.jpg",
