 "introductions": [
  {
   "type": "image",
   "title": "〚ストーリー〛",
   "body": [
    {
     "intro": "聖剣戦隊のレンジャー・ピンク、天羽綾音は邪悪な組織ナイトゴーストを調査するため、<br />\r\n戦闘員の全身タイツを着てエロ雑魚になる、さらに個性が消されて消耗品として扱う?！<br />\r\nエロ巨乳戦隊隊員は服従と見せかけ、邪悪組織の幹部の目をそらし、密かに反抗する時を待つ。<br />\r\nただデカチンとマインドコントロールのダブルパンチで、レンジャー・ピンク天羽綾音ははたしてその日まで凌げるのか…",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01450000/RJ01449418/ad720c268bf75d7ad8393cae2747252f.jpg",
      "alt": "聖剣戦隊-戦闘員が潜入する洗脳の罠 [Mango Party]",
      "title": "聖剣戦隊-戦闘員が潜入する洗脳の罠 [Mango Party]"
     },
     "position": "under"
    }
   ]
  },
  {
   "type": "image",
   "title": "〚コンテンツ〛",
   "body": [
    {
     "intro": "ゲーム中は聖剣戦隊のレンジャー・ピンク-天羽綾音として、<br />\r\n危機迫る地下アジトでお母さんと妹の手掛かりを探す！<br />\r\nしかし…ナイトゴーストに潜入するには、強力なバトルスーツが着れない。<br />\r\n情報と知恵うまく使って突破せよ！<br />\r\nバレたら…待ってるのは\"死\"だけじゃない！",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01450000/RJ01449418/a267f103ad41fe04dcf670000a9904be.jpg",
      "alt": "聖剣戦隊-戦闘員が潜入する洗脳の罠 [Mango Party]",
