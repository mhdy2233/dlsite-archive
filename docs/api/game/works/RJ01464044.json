 "introductions": [
  {
   "type": "image_list",
   "title": "登場キャラクター",
   "body": [
    {
     "intro": "【雨宮 花見月】　cv:片栗ねぇね<br />\r\n<br />\r\n優しくて頼りになる(?)巫女のお姉さん。<br />\r\nちょっとお姉さんに甘えてみたくならない?<br />\r\nさらに、妖狐の力を借りて“ふわふわの耳としっぽ”を持つ戦闘モードへと変化することもできるんです！",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01465000/RJ01464044/5d7c7c9484d14ab0c35505b1701bc7d2.jpg",
      "alt": "霊縁 ～穢れを祓い、交わる欲縁～ [MONRA]",
      "title": "霊縁 ～穢れを祓い、交わる欲縁～ [MONRA]"
     }
    },
    {
     "intro": "【小豆 奈奈】　cv:柊木めぐ<br />\r\n<br />\r\n内気で人見知りな、フードをかぶった少女。<br />\r\n神様のお嫁さんになるのが夢だとか。<br />\r\nけれど今は、何かに追われているようで……。<br />\r\n彼女を助けてあげられるのは、あなたかもしれません。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01465000/RJ01464044/ee256eca94eb6074190d5c590e87cd31.jpg",
      "alt": "霊縁 ～穢れを祓い、交わる欲縁～ [MONRA]",
      "title": "霊縁 ～穢れを祓い、交わる欲縁～ [MONRA]"
     }
    },
    {
     "intro": "【神様?】　cv:海音ミヅチ<br />\r\n<br />\r\n質素な服装に、長いウサギ耳を揺らす小さな少女。<br />\r\n自らを「神様」と名乗る彼女には、何か不思議な秘密が隠されているようです。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01465000/RJ01464044/2639697f4871b3727732b7d10ab29dd8.jpg",
      "alt": "霊縁 ～穢れを祓い、交わる欲縁～ [MONRA]",
      "title": "霊縁 ～穢れを祓い、交わる欲縁～ [MONRA]"
     }
    },
    {
     "intro": "【小豆 鈴】　cv:雪宮あかね<br />\r\n<br />\r\n若く見えるが、実は経験豊富な本殿の巫女。<br />\r\nその知恵と落ち着いた物腰は、まさに大和撫子。<br />\r\n歳月を感じさせないその姿には、誰も知らない秘密が眠っているのかもしれません。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01465000/RJ01464044/6e6bc91a0bfa714bfb17490c6148785d.jpg",
      "alt": "霊縁 ～穢れを祓い、交わる欲縁～ [MONRA]",
      "title": "霊縁 ～穢れを祓い、交わる欲縁～ [MONRA]"
     }
    }
   ]
