 "introductions": [
  {
   "type": "image",
   "title": "概要",
   "body": [
    {
     "intro": "このゲームはロジックに従い自動行動するキャラクターで戦闘するダンジョン攻略RPGです。ロジックに、スキル、装備を駆使してダンジョンの踏破を目指します<br />\n<br />\nスキルを習得し、ロジックを編集する事で様々な戦術が実現でき、プレイヤーは思うがままの戦術でダンジョンを攻略できます<br />\n<br />\nダンジョンでは様々な特性をもったランダム装備を取得できます。より強力な武具を装備してキャラクターを強化したり、武具を合成してより強力な装備を得る事もできます",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01468000/RJ01467479/b5798c4ae385f57684a0af77ef18ad95.jpg",
      "alt": "デ=ヴァルン迷宮探求記 [機世語堂]",
      "title": "デ=ヴァルン迷宮探求記 [機世語堂]"
     },
     "position": "left"
    }
   ]
  },
  {
   "type": "image",
   "title": "バトルロジック",
   "body": [
    {
     "intro": "戦闘中のキャラクターの行動はバトルロジックで設定できます。<br />\n最初はごくごく少数のスキル、ロジックしか使えず、ロジック枠も限られています<br />\n<br />\nゲームが進行すると、より多数のスキルとロジックが解放<br />\nスキルの数は80種以上、ロジックの数は200種以上にもなります<br />\n貴方の思い描く戦術でダンジョンを攻略してください",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01468000/RJ01467479/7f9c5d79ecc38ed7cf003e910aed9f4f.jpg",
      "alt": "デ=ヴァルン迷宮探求記 [機世語堂]",
      "title": "デ=ヴァルン迷宮探求記 [機世語堂]"
     },
     "position": "left"
    }
   ]
  },
  {
   "type": "image",
   "title": "アクティブタイムオートバトル",
   "body": [
    {
     "intro": "敵に近づくとマップ上でシームレスに戦闘に入ります<br />\n<br />\n本作の戦闘はアクティブタイムかつバトルロジックによるオートバトルであり、<br />\nリアルタイムで進行していきます。<br />\n<br />\n他にも自動回復するMPの管理や、ヘイト、弱点を突く事による防御無視など、戦術的な要素が楽しめます。",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01468000/RJ01467479/a9949849a2a46c5f0a20b95faebca4ef.jpg",
      "alt": "デ=ヴァルン迷宮探求記 [機世語堂]",
      "title": "デ=ヴァルン迷宮探求記 [機世語堂]"
     },
     "position": "left"
    }
   ]
  },
  {
   "type": "image_list",
   "title": "ハクスラ×ランダムダンジョン",
   "body": [
    {
     "intro": "ダンジョンはランダムで生成されます<br />\nミニマップを頼りに、入るたびに変化するダンジョンを進みましょう<br />\n<br />\nまたランダムでオーラ敵という特殊な敵やレア宝箱が配置されている事もあります",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01468000/RJ01467479/f6084e799eced9842b0f5131f6fa8a78.jpg",
      "alt": "デ=ヴァルン迷宮探求記 [機世語堂]",
      "title": "デ=ヴァルン迷宮探求記 [機世語堂]"
     }
    },
    {
     "intro": "装備には強化値や特性が付与されます<br />\n特性の効果量にも差異があり、ダンジョンの奥深くに行くほどに強力な特性が付与されます<br />\n<br />\n装備同士を合成し、強化する事もできます",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01468000/RJ01467479/f92774beb0db5d1e3111b26b83a1b944.jpg",
      "alt": "デ=ヴァルン迷宮探求記 [機世語堂]",
      "title": "デ=ヴァルン迷宮探求記 [機世語堂]"
     }
    },
    {
     "intro": "ダンジョンを進むたびに様々な要素がアンロックされます<br />\n<br />\n中にはダンジョン内を高速移動する手段も",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01468000/RJ01467479/c7b1f90a649bf445dce840a3f3d5a67f.jpg",
      "alt": "デ=ヴァルン迷宮探求記 [機世語堂]",
      "title": "デ=ヴァルン迷宮探求記 [機世語堂]"
     }
    },
    {
     "intro": "1度のダンジョン踏破で終わりではありません<br />\n<br />\n迷宮を踏破後にはより強力な迷宮に挑む事ができます",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01468000/RJ01467479/07f5e6b607b0f8590b28880a8024c135.jpg",
      "alt": "デ=ヴァルン迷宮探求記 [機世語堂]",
      "title": "デ=ヴァルン迷宮探求記 [機世語堂]"
     }
    }
   ]
  },
  {
   "type": "image_list",
   "title": "ストーリー&amp;キャラクター",
   "body": [
    {
     "intro": "【ストーリー】<br />\n迷宮都市デ=ヴァルンは魔法を抑制する力に満ちた不思議な都市<br />\nそしてその名の通り都市には巨大な迷宮があった<br />\nとある噂曰く、その迷宮の最奥には、魔法を抑える力の源泉たる秘宝が眠るという<br />\n主人公達は秘宝を求めて迷宮に挑む",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01468000/RJ01467479/fb4c1acd2483de48ab140ae5adef7aa9.jpg",
      "alt": "デ=ヴァルン迷宮探求記 [機世語堂]",
      "title": "デ=ヴァルン迷宮探求記 [機世語堂]"
     }
    },
    {
     "intro": "【ハジェラ】<br />\n主人公<br />\n狂化の魔法を解くために仲間達と共にデ=ヴァルンにやってきた",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01468000/RJ01467479/09ea2649004419e3f0ad4732e0a68307.jpg",
      "alt": "デ=ヴァルン迷宮探求記 [機世語堂]",
      "title": "デ=ヴァルン迷宮探求記 [機世語堂]"
     }
    },
    {
     "intro": "【ルピューサ】<br />\nハジェラの学友。とある事変からハジェラに付き添う形で、その旅に同行している<br />\n<br />\n【トルナ】<br />\n元帝国兵士。ハジェラが狂化を受けた事変に関わっており、軍を抜けて同行した",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01468000/RJ01467479/e8d5ff2d28d2419a5031c97bd2809ab6.jpg",
      "alt": "デ=ヴァルン迷宮探求記 [機世語堂]",
      "title": "デ=ヴァルン迷宮探求記 [機世語堂]"
     }
    },
    {
     "intro": "【アスネ】<br />\n呪血に縛られた少女。都市や秘宝が解放の糸口になると期待してハジェラに同行した<br />\n<br />\n【ラフラエレ】<br />\n氷獄の魔法を受けたために故郷に帰れなくなった踊り子<br />\nハジェラ同様に己の魔法を消し去るために迷宮に挑む",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01468000/RJ01467479/b402873a5db749ca98c4527733588f41.jpg",
      "alt": "デ=ヴァルン迷宮探求記 [機世語堂]",
      "title": "デ=ヴァルン迷宮探求記 [機世語堂]"
     }
    }
   ]
  },
