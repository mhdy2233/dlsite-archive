 "introductions": [
  {
   "type": "image",
   "title": "■あらすじ■",
   "body": [
    {
     "intro": "魔王が支配する街『ヴェルティア』<br />\r\nここは魔族も人間も平等に扱われる街<br />\r\n<br />\r\nそこに引っ越して来た主人公 レックスは、<br />\r\n人間より魔族が好きなちょっぴり変わったヒト種！<br />\r\n<br />\r\nヴェルティアでのレックスの30日間の生活を楽しもう！<br />\r\n<br />\r\nレックスはエッチしたモンスター娘の記事を書いて、酒場で売る事が出来るぞ！<br />\r\n街ではモンスター娘の娼館が多数存在するので、記事を書いてお金を稼いで次の娼館へ！",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01625000/RJ01624141/4e571f0d43d1205cd34cee0fc4199312.jpg",
      "alt": "異世界モン娘悦楽記 [ぺぺろーん]",
      "title": "異世界モン娘悦楽記 [ぺぺろーん]"
     },
     "position": "under"
    }
   ]
  },
  {
   "type": "image",
   "title": "■アニメーション■",
   "body": [
    {
     "intro": "・Hシーンはぜーんぶアニメーション化！<br />\r\n・ぬるぬる動くドット絵Live2D系アニメーションエッチなアニメーションの総数はなんと200枚以上！<br />\r\n・Hシーンはもちろん、静止画になりがちな挿入シーンや射精や余韻までしっかりアニメーション化！<br />\r\n・総合アニメーションフレーム数は30000枚超え！",
     "image_info": {
      "url": "//img.dlsite.jp/modpub/images2/parts/RJ01625000/RJ01624141/cecde7a341962d989e737cf7838a8428.jpg",
      "alt": "異世界モン娘悦楽記 [ぺぺろーん]",
      "title": "異世界モン娘悦楽記 [ぺぺろーん]"
     },
     "position": "over"
    }
