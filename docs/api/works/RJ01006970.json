ank": 4, "date": "2023-04-10"}, {"category": "game", "period": "week", "rank": 6, "date": "2023-04-16"}, {"category": "game", "period": "month", "rank": 21, "date": "2023-05-01"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01007000/RJ01006970_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01007000/RJ01006970_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01007000/RJ01006970_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01007000/RJ01006970_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01007000/RJ01006970_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01007000/RJ01006970_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01007000/RJ01006970_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01007000/RJ01006970_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01007000/RJ01006970_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01007000/RJ01006970_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01007000/RJ01006970_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01007000/RJ01006970_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01007000/RJ01006970_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01007000/RJ01006970_img_smp6_100x100.jpg"], "alt": "VS乳魔 エナノ編 [壁SIN]"}, "introductions": [{"type": "text", "title": "パイズリオンリーバトルファックRPG!", "body": [{"intro": "爆乳で男の精を搾り取る乳魔。<br />\nそんな乳魔であるエナノと熾烈な戦いを繰り広げよう。<br />\n<br />\nこの作品のHは全てパイズリです。<br />\n(ほぼ着衣パイズリ)<br />\n<br />\n基本CG 25枚 <br />\n<br />\n画面サイズ 816*624<br />\n本ゲームは、RPGツクールMZ製です。"}]}, {"type": "image_list", "title": "戦闘システム", "body": [{"intro": "戦闘は完全オート!<br />\n<br />\n50種類以上のレリックを組み合わせて、戦略を練よう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01007000/RJ01006970/b11f48af3aa4204457055ba7ca78e0c9.jpg", "alt": "VS乳魔 エナノ編 [壁SIN]", "title": "VS乳魔 エナノ編 [壁SIN]"}}, {"intro": "レリックガチャでレアレリックを手に入れよう!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01007000/RJ01006970/6e9ef83cecbbdc23cf9dbdb23e5d95f3.jpg", "alt": "VS乳魔 エナノ編 [壁SIN]", "title": "VS乳魔 エナノ編 [壁SIN]"}}, {"intro": "あなたは戦闘に敗北しても、何度でも蘇る。<br />\n<br />\nまた、敗北するたびに戦闘の経験からEP(エナジーポイント)を得る。<br />\nEPを使用してショップで買い物やレリックガチャを回そう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01007000/RJ01006970/9f7e63ec06d0b9e66f27dd2ac4d5cf15.jpg", "alt": "VS乳魔 エナノ編 [壁SIN]", "title": "VS乳魔 エナノ編 [壁SIN]"}}]}, {"type": "image_list", "title": "キャラクター紹介", "body": [{"intro": "乳魔<br />\n【エナノ】<br />\n<br />\n人懐っこい雰囲気をした爆乳美少女。<br />\nしかし、これまで数多の男性がその爆乳で精を搾り取られる被害にあっている。<br />\nこのエナノを討伐することがあなたの目標である。<br />\n<br />\n────────────<br />\n<br />\nB:115 W:55 H:83", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01007000/RJ01006970/6baf1514c306152cfa2dab18e77bb97c.jpg", "alt": "VS乳魔 エナノ編 [壁SIN]", "title": "VS乳魔 エナノ編 [壁SIN]"}}, {"intro": "【店員さん】<br />\n<br />\n露出の多いメイド服を着た爆乳お姉さん。<br />\nショップであなたのエナノ討伐をサポートしてくれる。<br />\nもしかしたら、パイズリしてくれるかも…?<br />\n<br />\n────────────<br />\n<br />\nB:116 W:60 H:89", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01007000/RJ01006970/610482c165cec77edfad72b317eb97d5.jpg", "alt": "VS乳魔 エナノ編 [壁SIN]", "title": "VS乳魔 エナノ編 [壁SIN]"}}]}, {"type": "text_list", "title": "シチュエーション", "body": [{"intro": "着衣パイズリ"}, {"intro": "亀頭責め着衣パイズリ"}, {"intro": "縦パイズリ"}, {"intro": "横パイズリ"}, {"intro": "抱きしめパイズリ"}, {"intro": "逆バニーパイズリ など"}]}, {"type": "text", "title": "", "body": [{"intro": "※不具合報告などの情報は、Ci-enにてお願いいたします。<br />\n<br />\n　　Ci-en : <a href=\"https://ci-en.dlsite.com/creator/13242\" target=\"_blank\">https://ci-en.dlsite.com/creator/13242</a><br />\n　　Twitter : <a href=\"https://twitter.com/Sintaro_Okabe\" target=\"_blank\">https://twitter.com/Sintaro_Okabe</a>"}]}], "description": "乳魔エナノとのパイズリオンリーバトルファックRPG。", "short_introduction": "乳魔エナノとのパイズリオンリーバトルファックRPG。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01006970.html", "site_id": "maniax", "fetched_at": 1794953350}