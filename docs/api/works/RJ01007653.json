ples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01008000/RJ01007653_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01008000/RJ01007653_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01008000/RJ01007653_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01008000/RJ01007653_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01008000/RJ01007653_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01008000/RJ01007653_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01008000/RJ01007653_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01008000/RJ01007653_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01008000/RJ01007653_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01008000/RJ01007653_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01008000/RJ01007653_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01008000/RJ01007653_img_smp6_100x100.jpg"], "alt": "妖花の戦  妖花・瑠魔VS見習い巫女 [そるでいあ]"}, "introductions": [{"type": "text", "title": "妖花の戦　　妖花・瑠魔VS見習い巫女", "body": [{"intro": "妖花の戦　　妖花・瑠魔VS見習い巫女<br />\n<br />\n<br />\nそるでいあ　初のビジュアルノベルゲームです。<br />\n<br />\n若さと美貌のために、母乳と排泄液を搾乳していく妖花一族・瑠魔。<br />\n<br />\nその瑠魔と、見習い巫女・音無美羽との戦いを描いた作品です。<br />\n<br />\n<br />\n<br />\n音無美羽(おとなしみわ)とテニス部の部員達は、合宿のためにある場所にやってきた。<br />\n<br />\n<br />\nだが、ここは妖花一族の一人・瑠魔という妖怪が住み着いている場所だったのだ。<br />\n巫女の能力で、ただ一人操り人形にされずにいた美羽だが、戦い敗北して囚われる。<br />\n瑠魔は、美羽達を操り人形にして、良質の母乳を搾取するために、恥辱の絶頂・排泄行為を要求。<br />\n肉体に恥辱と我慢のプレイをされてしまうテニス部部員達。<br />\n<br />\nはたして見習い巫女の音無美羽は、仲間を救うことが出来るのか?<br />\n<br />\n<br />\nプレイ内容<br />\n<br />\n※リモコンバイブでテニスをレッスン。<br />\n<br />\n※テニスウェア姿の美羽が、バックから瑠魔に犯され、浣腸排泄行為。<br />\n<br />\n※再び正面から瑠魔に犯される。<br />\n<br />\n※良質の母乳のために、テニス部部員達を浣腸したままレッスン、搾乳プレイ<br />\n<br />\n※搾乳した母乳をアナルに挿入して循環排泄プレイ等<br />\n<br />\n<br />\n<br />\n※音楽あり、触手音、排泄等の効果音あり。<br />\n　一部音声の喘ぎ声あり。<br />\n<br />\n※回想モードはありませんが、セーブ機能はあります。<br />\n<br />\n<br />\n※排泄描写は、苦手なユーザーのために、牛乳タイプの白い液で表現しています。<br />\n<br />\n<br />\n画像枚数 基本24枚　差分63<br />\n<br />\n<br />\n*当ゲームはティラノビルダーで製作されています。<br />\nWindowsの32bit環境では動作しません。 ご確認をよろしくお願いします。<br />\n<br />\n<br />\nサイトでの紹介はこちら<br />\n<a href=\"http://sol.x0.com/mein.html\" target=\"_blank\">http://sol.x0.com/mein.html</a>"}]}, {"type": "image_list", "title": "キャラクター紹介", "body": [{"intro": "主人公　音無　美羽 <br />\n(おとなし　みわ)<br />\n<br />\nテニス部のキャプテンであり、<br />\n見習い巫女。<br />\n母は優秀な退魔師。<br />\n妖花一族・瑠魔と戦うが……", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01008000/RJ01007653/dc4ed80777577586fdea114b39696d38.jpg", "alt": "妖花の戦  妖花・瑠魔VS見習い巫女 [そるでいあ]", "title": "妖花の戦  妖花・瑠魔VS見習い巫女 [そるでいあ]"}}, {"intro": "妖花一族・瑠魔<br />\n(ようかいちぞく　るま)<br />\n<br />\n淫を身体に刻ませて、<br />\n人を淫紋で操る妖怪。<br />\n見習い巫女の音無美羽と<br />\n対決する。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01008000/RJ01007653/08433cd49ef10f317003e7e829d04ada.jpg", "alt": "妖花の戦  妖花・瑠魔VS見習い巫女 [そるでいあ]", "title": "妖花の戦  妖花・瑠魔VS見習い巫女 [そるでいあ]"}}, {"intro": "磯村　加恋　<br />\n(いそむら　かれん)<br />\n<br />\n美羽の同級生。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01008000/RJ01007653/2996df1ed8bbe11c37c79146828c7583.jpg", "alt": "妖花の戦  妖花・瑠魔VS見習い巫女 [そるでいあ]", "title": "妖花の戦  妖花・瑠魔VS見習い巫女 [そるでいあ]"}}, {"intro": "中西　春菜 <br />\n(なかにし　はるな)<br />\n<br />\n主人公の同級生。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01008000/RJ01007653/2d5c2a62f660b681b5f02111facacc29.jpg", "alt": "妖花の戦  妖花・瑠魔VS見習い巫女 [そるでいあ]", "title": "妖花の戦  妖花・瑠魔VS見習い巫女 [そるでいあ]"}}]}, {"type": "image_list", "title": "", "body": [{"intro": "仲森　日奈　<br />\n(なかもり　ひな)<br />\n<br />\n音無　美羽の後輩。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01008000/RJ01007653/f60800bada8204a7a82b3b3f3a6b0bc2.jpg", "alt": "妖花の戦  妖花・瑠魔VS見習い巫女 [そるでいあ]", "title": "妖花の戦  妖花・瑠魔VS見習い巫女 [そるでいあ]"}}]}], "description": "妖力と若さのために、女を操り人形にして母乳と排泄液を搾乳していく妖花一族・瑠魔。  妖怪・瑠魔と、見習い巫女・音無美羽との戦いを描いたビジ