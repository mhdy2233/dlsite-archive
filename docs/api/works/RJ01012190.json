0_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01013000/RJ01012190_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01013000/RJ01012190_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01013000/RJ01012190_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01013000/RJ01012190_img_smp4.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01013000/RJ01012190_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01013000/RJ01012190_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01013000/RJ01012190_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01013000/RJ01012190_img_smp4_100x100.jpg"], "alt": "Counter Insurgent! [ドープオブラヴラブ]"}, "introductions": [{"type": "image", "title": "作品内容", "body": [{"intro": "主人公は工作員のブラスト<br />\n敵の本部へ侵入し基地を破壊せよ!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01013000/RJ01012190/33399c0ec9202223af0d86d31dd66b46.jpg", "alt": "Counter Insurgent! [ドープオブラヴラブ]", "title": "Counter Insurgent! [ドープオブラヴラブ]"}, "position": "left"}]}, {"type": "image", "title": "", "body": [{"intro": "敵は強大かつ残忍<br />\n捕まればただではすまないだろう・・・", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01013000/RJ01012190/fee8f95705106d664cd46c0445a16808.jpg", "alt": "Counter Insurgent! [ドープオブラヴラブ]", "title": "Counter Insurgent! [ドープオブラヴラブ]"}, "position": "right"}]}, {"type": "image", "title": "", "body": [{"intro": "任務中に選択を迫られる時がくる。<br />\n選んだ選択肢でブラストの運命も変わってくる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01013000/RJ01012190/c8a622c119751f27601a4dcd9ad5d126.jpg", "alt": "Counter Insurgent! [ドープオブラヴラブ]", "title": "Counter Insurgent! [ドープオブラヴラブ]"}, "position": "left"}]}, {"type": "image", "title": "", "body": [{"intro": "任務達成のためにはレジスタンスの協力が不可欠だ。<br />\nブラストはレジスタンスの要求にどこまで応じるのか・・・", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01013000/RJ01012190/9e5c7f3fb770c46d0fe19c65f51434cc.jpg", "alt": "Counter Insurgent! [ドープオブラヴラブ]", "title": "Counter Insurgent! [ドープオブラヴラブ]"}, "position": "right"}]}, {"type": "image_list", "title": "キャラクター紹介", "body": [{"intro": "【ブラスト】<br />\nとある国からやってきた工作員。<br />\n命令の為ならどんなこともためらわない性格。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01013000/RJ01012190/fd52e9c9244e7ca3eb381f75978cf613.jpg", "alt": "Counter Insurgent! [ドープオブラヴラブ]", "title": "Counter Insurgent! [ドープオブラヴラブ]"}}, {"intro": "【ハイド】<br />\n国境の村に住んでいる女の子。<br />\nレジスタンスと関係があるみたいだが・・・?", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01013000/RJ01012190/5b8d79edabc9b3a0ad924ca3e4b8bb6e.jpg", "alt": "Counter Insurgent! [ドープオブラヴラブ]", "title": "Counter Insurgent! [ドープオブラヴラブ]"}}, {"intro": "【メディカル】<br />\nレジスタンスの医療兵。<br />\n医療用ドローンを駆使し他の隊員を助けている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01013000/RJ01012190/fb852f69e8e046d7d47b851348d89da9.jpg", "alt": "Counter Insurgent! [ドープオブラヴラブ]", "title": "Counter Insurgent! [ドープオブラヴラブ]"}}, {"intro": "【リーサル】<br />\nレジスタンスの突撃兵。<br />\nパワードスーツを着用し得意の格闘術で敵を倒す。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01013000/RJ01012190/5aad0f76d105a1ecf264227e3cab84c8.jpg", "alt": "Counter Insurgent! [ドープオブラヴラブ]", "title": "Counter Insurgent! [ドープオブラヴラブ]"}}]}, {"type": "text", "title": "おわりに", "body": [{"intro": "このゲームはRPGツクールMZで作成されています。<br />\n<br />\n【 操作方法 】<br />\n<br />\nマウスで操作が可能です。<br />\nメッセージはマウス右クリックで消去できます。<br />\n<br />\n「矢印」キャラクターの操作。(オプションで自動で走るにONにしておくことを推奨します。)<br />\n「SHIFT」会話中、メッセージログを消すことができます。再表示の際も同じキーです。<br />\n「Z」キーで決定。<br />\n「X」でステータス画面、キャンセル。<br />\n<br />\n【クレジット】<br />\n★3Dモデル★<br />\n<br />\nYSSS.様<br />\nしらとりこはね様<br />\ndeltastar様<br />\nもち屋様<br />\nドージィ様<br />\nEagle様<br />\nOFUJI STORE様<br />\nノノダノダ様<br />\n三鬼稲荷神社様<br />\nbu-tang様<br />\nふらーれ工房様<br />\nYUHEI様<br />\nカンパニューラの道具店様<br />\n<br />\n★BGM・音声・効果音・コード★<br />\n<br />\nMITライセンス様<br />\nVoiceBloom様　　<a href=\"http://voicebloom.seesaa.net/\" target=\"_blank\">http://voicebloom.seesaa.net/</a><br />\n<br />\n<br />\n©Gotcha Gotcha Games Inc./YOJI OJIMA 2020"}]}], "description": "スパイRPG", "short_introduction": "スパイRPG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01012190.html", "site_id": "maniax", "fetched_at": 1794954427}