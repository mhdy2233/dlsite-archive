{"id": "RJ01015086", "title": "Just Futanari", "title_romaji": "jasutofutanari", "circle": {"id": "RG55072", "name": "あーぷXR", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG55072.html"}, "type": {"code": "SLN", "name": "シミュレーション", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 2310, "official_jpy": 2310, "currencies": {"USD": 14.476142252224532, "EUR": 13.15507729035021, "GBP": 10.975967857044433, "TWD": 477.2431460859864, "CNY": 96.6668759023288, "KRW": 19330.543933054396, "IDR": 264604.8109965636, "VND": 372580.64516129036, "THB": 490.56042812546457, "SEK": 146.12946691211357, "HKD": 113.59612887997167, "SGD": 18.65665614571252, "CAD": 20.69623570414238, "MYR": 59.276518543799185, "BRL": 82.36938568840839, "AUD": 21.462577070163118, "PHP": 925.2583513578467, "MXN": 268.54532138248527, "NZD": 26.2938629440931, "INR": 1359.9434828682442}}, "point": {"point_amount": 126, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1673881200, "file": {"type": "EXE", "size": 700194774}, "tags": [{"key": "509", "name": "3D作品"}, {"key": "432", "name": "女主人公"}, {"key": "250", "name": "女体化"}, {"key": "124", "name": "手コキ"}, {"key": "128", "name": "中出し"}, {"key": "190", "name": "フタナリ"}], "languages": ["CHI_HANS", "KO_KR", "JPN", "ENG", "CHI"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 4.28, "count": 325}, "review_count": 9, "dl_count": 2141, "wishlist_count": 3269, "ranking": [{"category": "game", "period": "day", "rank": 20, "date": "2023-01-18"}, {"category": "game", "period": "week", "rank": 34, "date": "2023-01-23"}, {"category": "game", "period": "month", "rank": 49, "date": "2023-02-13"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01016000/RJ01015086_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01016000/RJ01015086_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01016000/RJ01015086_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01016000/RJ01015086_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01016000/RJ01015086_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01016000/RJ01015086_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01016000/RJ01015086_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01016000/RJ01015086_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01016000/RJ01015086_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01016000/RJ01015086_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01016000/RJ01015086_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01016000/RJ01015086_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01016000/RJ01015086_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01016000/RJ01015086_img_smp6_100x100.jpg"], "alt": "Just Futanari [あーぷXR]"}, "introductions": [{"type": "text", "title": "フタナリのカップルになってイチャイチャ、癒しの時間", "body": [{"intro": "・本作<br />\r\nフタナリのカップルになってラブホテルでエンジョイしましょう。<br />\r\n大人のおもちゃを相手や自分に使用したり。<br />\r\n各場所にはいくつかのシーンが用意されていて、切り替えて楽しむことができます。<br />\r\n<br />\r\n・多彩な環境で動作<br />\r\nMetaQuest2<br />\r\nMetaQuest2(OculusLink)<br />\r\nHtcVive　<br />\r\n全て実機確認済み<br />\r\n<br />\r\n・VRコントローラー動作連動<br />\r\nハンドモードを変更すると、コントローラーの振る動作に連動し女の子も動きます。<br />\r\nこの機能を使って、ゲーム中、相手のものをこすり合うシーンがありますが、リアルでは自分でしているはずが、<br />\r\nVRでは相手にしてもらえてるような感覚でプレイできます。<br />\r\n<br />\r\n・VRコントローラーの振動機能<br />\r\n女の子の動きに合わせて、振動します。<br />\r\n<br />\r\n・電動オナホール対応<br />\r\n女の子の動きや、コントローラーの動きに連動して動きます。<br />\r\nA10サイクロンSAでの動作確認済みです。<br />\r\n( 現状PC専用の機能になります。A10サイクロンSAにて動作確認済みです。 )"}]}, {"type": "image_list", "title": "オンラインプレイ", "body": [{"intro": "オンライン専用、ガラスに隔てられた部屋<br />\n<br />\n体験版でも遊べるオンラインモードを収録しました。<br />\nガラスに隔てられた部屋にそれぞれ入り。<br />\nお互いに接触することができず、オナニーを見せ合うことしかできません。<br />\nモニターを使ってオナニー道具を部屋に出現させてください。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01016000/RJ01015086/85cb52471a59233f080e8078ee5c7168.jpg", "alt": "Just Futanari [あーぷXR]", "title": "Just Futanari [あーぷXR]"}}, {"intro": "性別、年齢、国籍を問わず。ユーザーネームもないので、誰でも手軽に始められます。<br />\n買い切りで、使用料金もありません。<br />\nクロスプレイに対応。Quest2ユーザーとPCVRユーザー間でも遊べます。<br />\nVRコントローラーのバイブレーションや電動玩具と連動して、<br />\n手軽に相手に刺激を与えられます。<br />\n<br />\nゲームを起動し部屋にある電話で、オンラインにアクセスできます。<br />\nマッチした人と気軽なセックスを楽しもう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01016000/RJ01015086/b126f0656f71a3f3235e1a4dba3bbdbf.jpg", "alt": "Just Futanari [あーぷXR]", "title": "Just Futanari [あーぷXR]"}}, {"intro": "ハンドモードの設定を変えると、自分のコントローラーの振りの動きが相手の連動機能に伝わり、<br />\nお互いを刺激しあって、疑似セックスを体験可能<br />\n[ハンドモード]<br />\nAutoMove  自動で相手に刺激を与える。4段階に調整可能<br />\nHandMove  コントローラーの振りの速さに応じて自動で4段階に刺激を調整する<br />\nHandMoveDirect コントローラーの振りの動きを直接刺激に変換する", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01016000/RJ01015086/d8b62ffb61178b08ccc2e5a183137c9d.jpg", "alt": "Just Futanari [あーぷXR]", "title": "Just Futanari [あーぷXR]"}}, {"intro": "オンラインにボイス機能はないので、声を出すコミュニケーションの必要はありません。<br />\n代わりに簡易的な会話システムがあります。<br />\n国籍が違くても、自分の設定した言語で表示されます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01016000/RJ01015086/8ad6a5e7dd479c425204371be40cfe93.jpg", "alt": "Just Futanari [あーぷXR]", "title": "Just Futanari [あーぷXR]"}}]}, {"type": "image_list", "title": "シングルプレイ", "body": [{"intro": "ベロチュー機能搭載<br />\r\nこちらの舌を出し、顔を近づけると相手も舌を出してくれます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01016000/RJ01015086/763b686930d2df1630b406da6f5b1e3c.jpg", "alt": "Just Futanari [あーぷXR]", "title": "Just Futanari [あーぷXR]"}}, {"intro": "大人の玩具を自分や相手に使うことができます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01016000/RJ01015086/4781367570ba0a74661ca37f26f5edcb.jpg", "alt": "Just Futanari [あーぷXR]", "title": "Just Futanari [あーぷXR]"}}, {"intro": "メニューから洋服の付け替え、表情の設定、シーンへの移動などを行えます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01016000/RJ01015086/2447cdebb299034b84745daa1fa47c60.jpg", "alt": "Just Futanari [あーぷXR]", "title": "Just Futanari [あーぷXR]"}}, {"intro": "エッチシーン以外では、お相手の姿勢を、手で持って変更できます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01016000/RJ01015086/ad55a1ba99e3e0e04ce5f8e5c8fd3266.jpg", "alt": "Just Futanari [あーぷXR]", "title": "Just Futanari [あーぷXR]"}}]}, {"type": "image_list", "title": "ホテル設備紹介", "body": [{"intro": "照明、音楽コントローラー<br />\r\n<br />\r\n照明は9種類、音楽は3種類からお選びいただけます。<br />\r\n<br />\r\nベッドに設置されてますが、お風呂からも設定いただけます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01016000/RJ01015086/23aeaa19496e09918ea67c74b0bfe8bd.jpg", "alt": "Just Futanari [あーぷXR]", "title": "Just Futanari [あーぷXR]"}}, {"intro": "モニター<br />\r\n<br />\r\n当ホテルのインフォメーション、コントローラー説明、言語切り替えなどできます。<br />\r\nイラストのスライドシューも上映しております。<br />\r\n<br />\r\nお風呂に備え付けのモニターでは、自然のスライドショーを上映しております。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01016000/RJ01015086/f0fb3038867eb358853f0cac047a2a51.jpg", "alt": "Just Futanari [あーぷXR]", "title": "Just Futanari [あーぷXR]"}}, {"intro": "大型の鏡はメニューから選択後、アナログスティックでいつでも移動可能です。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01016000/RJ01015086/d638112ed00e0a647dac5455e9076b4d.jpg", "alt": "Just Futanari [あーぷXR]", "title": "Just Futanari [あーぷXR]"}}, {"intro": "オナホールにディルドもご用意しております。<br />\r\nエッチシーン以外でご利用なれます。　使う際は一つづつご利用ください。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01016000/RJ01015086/ff0b3a5e0393507800ed8abd8ae415d6.jpg", "alt": "Just Futanari [あーぷXR]", "title": "Just Futanari [あーぷXR]"}}]}, {"type": "image_list", "title": "シーン紹介", "body": [{"intro": "トイレ、洗面台では計8シーン", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01016000/RJ01015086/5a97d4112f94e80d817afbc975c98b2f.jpg", "alt": "Just Futanari [あーぷXR]", "title": "Just Futanari [あーぷXR]"}}, {"intro": "ソファーでは5シーンを用意", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01016000/RJ01015086/9879ca62724faa024c05fc5639c4e427.jpg", "alt": "Just Futanari [あーぷXR]", "title": "Just Futanari [あーぷXR]"}}, {"intro": "ベッドでは5シーンを用意", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01016000/RJ01015086/392ecd7a0ad532ef284c8ccb82343153.jpg", "alt": "Just Futanari [あーぷXR]", "title": "Just Futanari [あーぷXR]"}}, {"intro": "お風呂では5シーンを用意<br />\r\n<br />\r\nくつろぎの時間をお楽しみください。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01016000/RJ01015086/43c52ca8642de3f113612dc79ec2571a.jpg", "alt": "Just Futanari [あーぷXR]", "title": "Just Futanari [あーぷXR]"}}]}, {"type": "text", "title": "", "body": [{"intro": "■操作方法<br />\r\n〇通常操作<br />\r\n「アナログスティック」　移動<br />\r\n「アナログスティック + トリガーキー」　旋回、上下<br />\r\n「トリガーキー」　使う<br />\r\n「グリップキー」　掴む<br />\r\n「1、2、3、4ボタン　タップ」　メニュー(現在)<br />\r\n「1、2、3、4ボタン　長押し」　メニュー(メイン)<br />\r\n<br />\r\n〇鏡移動<br />\r\n「アナログスティック」　移動<br />\r\n「アナログスティック + トリガーキー」　回転<br />\r\n「アナログスティック + トリガーキー+ グリップキー」　上下<br />\r\n<br />\r\n※本ソフトウェアはMetaQuest2(Oculus Link)、HTC VIVEにて開発・動作確認を行っております。<br />\r\n　他VR機器では操作が異なる可能性があります。<br />\r\n<br />\r\n■動作環境<br />\r\n〇PCVR<br />\r\nwin10GamingPC<br />\r\n・Meta Quest  (OculusLink)　実機動作確認済み<br />\r\n・HtcVive　実機動作確認済み<br />\r\n<br />\r\n〇オールインワンVR<br />\r\nMeta Quest 2<br />\r\n<br />\r\nMeta Quest 2ユーザーの方はMetaquestフォルダーにあるapkファイルを<br />\r\nSideQuest等を利用し、本体にインストールしてお楽しみください。<br />\r\n<br />\r\nその他の環境では動作確認していませんので、<br />\r\nDemo版を遊んで確認していただければ幸いです。"}]}], "description": "VR専用 フタナリのカップルになってイチャイチャ、癒しの時間", "short_introduction": "VR専用 フタナリのカップルになってイチャイチャ、癒しの時間", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01015086.html", "site_id": "maniax", "fetched_at": 1794954267}