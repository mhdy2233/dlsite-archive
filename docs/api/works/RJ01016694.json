/img.dlsite.jp/modpub/images2/work/doujin/RJ01017000/RJ01016694_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01017000/RJ01016694_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01017000/RJ01016694_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01017000/RJ01016694_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01017000/RJ01016694_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01017000/RJ01016694_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01017000/RJ01016694_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01017000/RJ01016694_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01017000/RJ01016694_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01017000/RJ01016694_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01017000/RJ01016694_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01017000/RJ01016694_img_smp6_100x100.jpg"], "alt": "Abyss Rebirth [すずりん]"}, "introductions": [{"type": "text", "title": "●ゲーム概要", "body": [{"intro": "深度4000層を超える『アビスの迷宮』──。<br />\r\nその迷宮に挑戦する冒険者がひとり。中央都市ミッドガルドを訪れます。"}]}, {"type": "image", "title": "●ゲーム概要", "body": [{"intro": "あなたはこのゲームの世界の中央都市『ミッドガルド』を訪れた冒険者です。<br />\r\n依頼をこなすもよし、酒場で仲間を集うもよし。<br />\r\n各地に点在する魔物を倒して冒険者としての経験を積みましょう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01017000/RJ01016694/3262b97299b4b9cd0c5ca6c6a3226d53.jpg", "alt": "Abyss Rebirth [すずりん]", "title": "Abyss Rebirth [すずりん]"}, "position": "over"}]}, {"type": "image", "title": "●各地を探索", "body": [{"intro": "王都から様々な場所を探索してみましょう。<br />\r\n探索では魔物との戦闘に加えて様々なイベントが発生します。<br />\r\n経験値を積みながら冒険者としての実力を上げていきましょう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01017000/RJ01016694/f59200a171bd50c50ceefa10039077a8.jpg", "alt": "Abyss Rebirth [すずりん]", "title": "Abyss Rebirth [すずりん]"}, "position": "over"}]}, {"type": "image", "title": "●アビスの迷宮", "body": [{"intro": "未だ最奥まで踏み込んだ者はいないとされる未踏の迷宮です。<br />\r\n見たことのない金銀財宝が眠るとされています。<br />\r\n冒険者としての腕に自信が出てきたら、アビスの迷宮に挑戦してみましょう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01017000/RJ01016694/522ae439027125503970839d4e620411.jpg", "alt": "Abyss Rebirth [すずりん]", "title": "Abyss Rebirth [すずりん]"}, "position": "over"}]}, {"type": "image", "title": "●豊富なカスタマイズ性", "body": [{"intro": "数多あるクラスや装備を自由に選択してキャラクターを育成しましょう。<br />\r\n本作では豊富なカスタマイズを用意しています。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01017000/RJ01016694/ab9c7b7541f8c10ed84d647564e008a4.jpg", "alt": "Abyss Rebirth [すずりん]", "title": "Abyss Rebirth [すずりん]"}, "position": "over"}]}, {"type": "image", "title": "●美麗なイラスト", "body": [{"intro": "仲間にできるキャラクターは様々です。<br />\n本作では美麗なイラストの立ち絵を採用しています。<br />\n<br />\n【絵師様】<br />\n・moff様<br />\n・有里ユイ様<br />\n・丹羽坂様<br />\n・わたおきば様<br />\n<br />\n【背景グラフィック】<br />\n・七三ゆき様<br />\n<br />\n【製作者】<br />\n・すずりん<br />\n<br />\n【製作者経歴】<br />\n・フリーゲーム大賞2022 金賞 受賞<br />\n・フリーゲーム大賞2020 入賞 受賞<br />\n<br />\n【注意事項】<br />\n・当作品は背景の一部にAIの商用素材を使用しております。<br />\n・この物語はフィクションであり、<br />\n　実在の人物・団体・事件などには一切関係がありません。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01017000/RJ01016694/6165ea164de1ff3081c1c788a5eff897.jpg", "alt": "Abyss Rebirth [すずりん]", "title": "Abyss Rebirth [すずりん]"}, "position": "over"}]}], "description": "探索型ハクスラRPG", "short_introduction": "探索型ハクスラRPG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01016694.html", "site_id": "home", "fetched_at": 1794952023}