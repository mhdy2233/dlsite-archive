2023-03-24"}, {"category": "game", "period": "week", "rank": 20, "date": "2023-03-24"}, {"category": "game", "period": "month", "rank": 24, "date": "2023-03-27"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01024000/RJ01023407_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01024000/RJ01023407_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01024000/RJ01023407_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01024000/RJ01023407_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01024000/RJ01023407_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01024000/RJ01023407_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01024000/RJ01023407_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01024000/RJ01023407_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01024000/RJ01023407_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01024000/RJ01023407_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01024000/RJ01023407_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01024000/RJ01023407_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01024000/RJ01023407_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01024000/RJ01023407_img_smp6_100x100.jpg"], "alt": "紫森リチュアル [Topyu_u]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "誰かからの依頼を受けたフレヤ、その依頼を達成するため森にはいることになる。<br />\n<br />\n責任を持ってそこで儀式を行わなければならない状況に置かれたフレヤは<br />\nこれからどうやって凶暴な紫のモンスターを上手く封印させるか…<br />\n<br />\n全ては彼女の意識を動かせるプレイヤーにかかっている。<br />\n<br />\n---<br />\n<br />\n紫森リチュアルは サイドスクロール + タワーディフェンスの要素が特徴で<br />\n<br />\n基本的に『タワー』を設置し、画面の右側から押しかけて来るモンスターを打ち倒すシステムに出来ています。<br />\n<br />\n<br />\n50Wave(体験版は5Wave)のモンスターの攻撃から祭壇を守ってみせよう!<br />\n<br />\n<br />\nドットHの動作数:　25(フォルダー数)<br />\nエンディング・イベントシーンのドットアニメーション数:　14(フォルダー数)"}]}, {"type": "image", "title": "祭壇ショップ", "body": [{"intro": "モンスターを倒しながら得られる「マナ」と「精子」を使って「祭壇ショップ」から購入出来る様々なアイテムを使用・発動しながら楽しむこともできます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01024000/RJ01023407/777047cdeda4fecbda2ece762e863099.jpg", "alt": "紫森リチュアル [Topyu_u]", "title": "紫森リチュアル [Topyu_u]"}, "position": "over"}]}, {"type": "image_list", "title": "精子はどこから?", "body": [{"intro": "1. 裸の状態で青く・赤く光るモンスターの攻撃を受けます", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01024000/RJ01023407/c85d00bc17d38689face70c3cbed9e0d.jpg", "alt": "紫森リチュアル [Topyu_u]", "title": "紫森リチュアル [Topyu_u]"}}, {"intro": "2. モンスターと交尾モードに入って精液を引き出せます", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01024000/RJ01023407/ed13cbaa760748c0d393df42b3cac237.jpg", "alt": "紫森リチュアル [Topyu_u]", "title": "紫森リチュアル [Topyu_u]"}}, {"intro": "3. 貰った精液を祭壇まで運ぶと", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01024000/RJ01023407/f1fa2a84a0cca76f676576759fb408f0.jpg", "alt": "紫森リチュアル [Topyu_u]", "title": "紫森リチュアル [Topyu_u]"}}, {"intro": "4. 精子Get!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01024000/RJ01023407/e0cccd165d8612924caf444c2dd6d5b4.jpg", "alt": "紫森リチュアル [Topyu_u]", "title": "紫森リチュアル [Topyu_u]"}}]}, {"type": "text", "title": "基本操作(ゲームファイルのReadme.txtからも参考出来ます)", "body": [{"intro": "ESC\t=　　　オプション<br />\n←,→\t=　　　移動<br />\nZ\t=　　　決定<br />\nX\t=　　　キャンセル<br />\nC\t=　　　ムッシュー設置<br />\nQ,W,E,R=　　アイテム発動<br />\nA\t=　　　Wave速度up<br />\nS\t=　　　Wave開始<br />\nV\t=　　　フレヤ全身スイッチ"}]}], "description": "森の真ん中で魔物を封印するために儀式を行うフレヤと、魔力を奪いに来る紫のモンスターの戦い。", "short_introduction": "森の真ん中で魔物を封印するために儀式を行うフレヤと、魔力を奪いに来る紫のモンスターの戦い。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01023407.html", "site_id": "maniax", "fetched_at": 1794953742}