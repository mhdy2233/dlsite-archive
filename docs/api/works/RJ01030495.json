{"id": "RJ01030495", "title": "The Fun of Asmodeus Iroha 2", "title_romaji": "fwanobuasumodeusuirohatsuu", "circle": {"id": "RG36724", "name": "As-key", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG36724.html"}, "type": {"code": "SLN", "name": "シミュレーション", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 1100, "official_jpy": 1100, "currencies": {"USD": 6.8934010724878725, "EUR": 6.264322519214385, "GBP": 5.226651360497349, "TWD": 227.25864099332685, "CNY": 46.03184566777561, "KRW": 9205.020920502093, "IDR": 126002.29095074456, "VND": 177419.3548387097, "THB": 233.60020386926882, "SEK": 69.5854604343398, "HKD": 54.09339470474841, "SGD": 8.88412197414882, "CAD": 9.855350335305896, "MYR": 28.226913592285324, "BRL": 39.223516994480185, "AUD": 10.22027479531577, "PHP": 440.599214932308, "MXN": 127.87872446785012, "NZD": 12.52088711623481, "INR": 647.5921346991639}}, "point": {"point_amount": 60, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1676646000, "file": {"type": "EXE", "size": 2629400289}, "tags": [{"key": "509", "name": "3D作品"}, {"key": "057", "name": "淡白/あっさり"}, {"key": "048", "name": "寝取られ"}, {"key": "016", "name": "ファンタジー"}, {"key": "157", "name": "トランス/暗示"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 4, "count": 23}, "review_count": 0, "dl_count": 79, "wishlist_count": 93, "ranking": [], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01031000/RJ01030495_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01031000/RJ01030495_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01031000/RJ01030495_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01031000/RJ01030495_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01031000/RJ01030495_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01031000/RJ01030495_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01031000/RJ01030495_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01031000/RJ01030495_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01031000/RJ01030495_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01031000/RJ01030495_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01031000/RJ01030495_img_smp9.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01031000/RJ01030495_img_smp10.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01031000/RJ01030495_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01031000/RJ01030495_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01031000/RJ01030495_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01031000/RJ01030495_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01031000/RJ01030495_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01031000/RJ01030495_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01031000/RJ01030495_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01031000/RJ01030495_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01031000/RJ01030495_img_smp9_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01031000/RJ01030495_img_smp10_100x100.jpg"], "alt": "The Fun of Asmodeus Iroha 2 [As-key]"}, "introductions": [{"type": "text", "title": "The Fun of Asmodeus Iroha の続編がSRPGとなって登場", "body": [{"intro": "Tale of Legends 伝想記 Iroha End から後の世界、<br />\nThe Fun of Asmodeus Iroha にてAsmodeusの手により凌○の限りを尽くされてしまった<br />\nイロハ、ルナ、ルイセの3人が東国ーアマノイワヤトによる戦争を阻止する為に立ち上がる?<br />\n<br />\n------<br />\n東国ーアマノイワヤトに戻り、アスランとの婚約を宣言したイロハだったが、<br />\n将軍達によるアスラン暗殺未遂を逃れ商業都市ガルダに潜伏していた。<br />\n<br />\nしかし・・・<br />\n<br />\nガルダは対峙した女性を支配する能力を持つ悪魔、アスモデウスによって支配されてしまっていた。<br />\nアスモデウスの計略により、凌○され、力を奪われてしまったイロハ達だったが、<br />\n回復したアスランの助力により、辛くもアスモデウスの討伐に成功する。<br />\n<br />\nそして数日後・・・<br />\n将軍達が傭兵を集め帝国との戦争を計画しているーという情報を入手したイロハ達は、<br />\n戦争を阻止する為に、ある計画を実行しようとしていた。<br />\n<br />\nその計画とは、<br />\n将軍達と面識のない、ルナとルイセが傭兵として軍に潜入、<br />\n軍内部の情報を集め、最悪の事態となった場合は傭兵部隊による攪乱を行うというもの。<br />\n<br />\n傭兵として潜入した2人は、<br />\n情報収集を重ね、アスラン暗殺計画の実行犯達の摘発に成功、<br />\n将軍達が開戦と不戦に揺れているとの情報を基にイロハに東国に戻るように連絡する。<br />\n<br />\nかくして、イロハとアスランはガルダから東国へと再び戻ったのだが・・・<br />\n帰国翌日、アスランはイロハから信じられない言葉を聞かされる。<br />\n<br />\n「東国ーアマノイワヤトは、準備が整い次第帝国へ宣戦する」・・・と。<br />\n<br />\n-----<br />\nジャンル:<br />\nSRPG(マルチエンド)<br />\n<br />\nシークレットキャラ:<br />\nTale of Legends から「聖女サラ」<br />\n伝想記IV -if- から「クロエ」<br />\n魔法少女ケンブリッジVから「キム・フィルビー」<br />\n(解放には、ゲームクリア、各CG、設定集のシークレットコードが必要です。)<br />\n<br />\n-----<br />\n<br />\n本作品に含まれる内容<br />\n・The Fun of Asmodeus Iroha 2 ゲーム本体<br />\n・マニュアル (PDF 16P)<br />\n・ガイドブック(キャラ紹介、ユニット、装備品、スキル一覧)(PDF 49P)<br />\n・CGブック(PDF 118P-うち表紙1p、裏表紙1p)<br />\n<br />\nゲーム本体は、Ci-enにて無料DL可能です。<br />\nゲーム本体の動作確認は、Ci-enより取得してください。<br />\n同梱のCG Bookは、DL Site販売品限定となります。<br />\n<br />\n現在の最新バージョン:Ver1.0.1"}]}, {"type": "image_list", "title": "キャラクター紹介1", "body": [{"intro": "アスラン<br />\r\n<br />\r\n現在のイロハの婚約者、<br />\r\n一時期、聖剣(ルナ)の魂が身体を宿していた事があり、ほんの僅かだが聖剣の力を扱う事が出来る。<br />\r\n自身に対する暗殺計画から逃げる為ガルダに身を隠していた。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01031000/RJ01030495/4a177107e325989ef87eebbab165117c.jpg", "alt": "The Fun of Asmodeus Iroha 2 [As-key]", "title": "The Fun of Asmodeus Iroha 2 [As-key]"}}, {"intro": "イロハ<br />\r\n<br />\r\n東国ーアマノイワヤトの姫君<br />\r\n聖獣青龍の加護を受けている。<br />\r\n曲ったことが嫌いで、民の為に国を取り戻す事を目標にアスランと共にガルダに身を隠していた。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01031000/RJ01030495/8eb57559b81453aaae43b805c01b62e8.jpg", "alt": "The Fun of Asmodeus Iroha 2 [As-key]", "title": "The Fun of Asmodeus Iroha 2 [As-key]"}}, {"intro": "ルナ<br />\r\n<br />\r\n神々の時代から存在する聖剣ーその魂そのもの。<br />\r\nアスランとイロハの婚約を認めていたものの、アスランの身体から新たな器に転生した事により気持ちが揺らいでいる。<br />\r\nアスランとイロハの幸せの為と自分に言い聞かせ、ルイセと共に東国に傭兵として潜入する。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01031000/RJ01030495/1eda9e0c794288fd438e10c80cd395a7.jpg", "alt": "The Fun of Asmodeus Iroha 2 [As-key]", "title": "The Fun of Asmodeus Iroha 2 [As-key]"}}, {"intro": "ルイセ<br />\r\n<br />\r\n武の都コンロンの総師範であり代表。<br />\r\n聖獣白虎の加護を受けている。<br />\r\n暗殺計画から逃れるアスラン達を助け、共にガルダに身を隠していた。<br />\r\nルナと共に東国に傭兵として潜入する。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01031000/RJ01030495/2fefaa81d9a79671254fe711d3432c1a.jpg", "alt": "The Fun of Asmodeus Iroha 2 [As-key]", "title": "The Fun of Asmodeus Iroha 2 [As-key]"}}]}, {"type": "image_list", "title": "キャラクター紹介2", "body": [{"intro": "戦女神カーラ<br />\r\n<br />\r\n記憶と力をひきついで転生する能力を持った戦女神。<br />\r\n前作でアスモデウスに力の大半を奪われてしまったが徐々に回復してきている。<br />\r\nルナとは旧知の仲のようでアスラン達にも力を貸してくれている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01031000/RJ01030495/514ff499c4fe5ab01a6705a10258c0c3.jpg", "alt": "The Fun of Asmodeus Iroha 2 [As-key]", "title": "The Fun of Asmodeus Iroha 2 [As-key]"}}, {"intro": "アヤメ<br />\r\n<br />\r\n東国の近衛部隊長。その剣技は東国の3将軍と1人で渡り合えるほどで、イロハの信頼も厚い……<br />\r\nのだが、カエデの裏切りによって捕えられ、調教されてしまっている。<br />\r\nその事を知らないアスランはアヤメと共に再度東国を脱出する事となる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01031000/RJ01030495/8adc1a08a107c4f44fff5e5ce6825a85.jpg", "alt": "The Fun of Asmodeus Iroha 2 [As-key]", "title": "The Fun of Asmodeus Iroha 2 [As-key]"}}, {"intro": "カエデ<br />\r\n<br />\r\n王族直轄のくノ一。<br />\r\nイロハの命で将軍達の動向を探り、傭兵として潜入したルナやルイセとの連絡役もこなす。<br />\r\nのは表の顔……<br />\r\n一年以上前からオベドの性奴○としてイロハ達を欺いている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01031000/RJ01030495/1ca3e1f7436feedc3492ef9bf7b85d84.jpg", "alt": "The Fun of Asmodeus Iroha 2 [As-key]", "title": "The Fun of Asmodeus Iroha 2 [As-key]"}}, {"intro": "モミジ<br />\r\n<br />\r\nイロハの護衛役のくノ一<br />\r\nカエデの妹。<br />\r\n陸軍に潜入したルナと海軍に占有したルイセの連絡役を担うが・・・<br />\r\nカエデ同様、オベドの性奴○にされてしまっている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01031000/RJ01030495/4b4dddb79e7b6df5027d3dc07fdcfa54.jpg", "alt": "The Fun of Asmodeus Iroha 2 [As-key]", "title": "The Fun of Asmodeus Iroha 2 [As-key]"}}]}, {"type": "image_list", "title": "キャラクター紹介3", "body": [{"intro": "プリシラ<br />\r\n<br />\r\n聖獣朱雀の加護を受けた女性。<br />\r\n聖女サラ亡き後、新たな聖女として封印の神殿を治めている。<br />\r\nアスランからイロハ達の状況を聞き、帝国の防衛に参画する事となる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01031000/RJ01030495/6464c483cc4041d0f5911a9365df7f40.jpg", "alt": "The Fun of Asmodeus Iroha 2 [As-key]", "title": "The Fun of Asmodeus Iroha 2 [As-key]"}}, {"intro": "イシス<br />\r\n<br />\r\n神々の時代から存在する聖剣ーその魂そのもの。ルナの実の姉。<br />\r\nアスランがイロハと婚約した事に納得していないようだが……<br />\r\n東国が戦争を開始した事によりホズル帝国の皇帝として立ち向かう事になる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01031000/RJ01030495/659e899d8907f9ad338233ee20c6d5fc.jpg", "alt": "The Fun of Asmodeus Iroha 2 [As-key]", "title": "The Fun of Asmodeus Iroha 2 [As-key]"}}, {"intro": "オベド<br />\r\n<br />\r\nイロハの理解者であり、アスランとイロハの婚約を認めるように、将軍達を説得していたはずだが……<br />\r\n実際にはイロハを陥れる為の計画を着々と進めていた。<br />\r\n何も知らないイロハは……", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01031000/RJ01030495/511e82ddc3a98b431bbb92009fe5b956.jpg", "alt": "The Fun of Asmodeus Iroha 2 [As-key]", "title": "The Fun of Asmodeus Iroha 2 [As-key]"}}, {"intro": "アルプ<br />\r\n<br />\r\nオベドに協力している青年。<br />\r\n女性を支配する特別な力を持っているようだが……", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01031000/RJ01030495/866bbaf39ce619ed2822317c40d53689.jpg", "alt": "The Fun of Asmodeus Iroha 2 [As-key]", "title": "The Fun of Asmodeus Iroha 2 [As-key]"}}]}, {"type": "image_list", "title": "シークレットキャラ紹介", "body": [{"intro": "聖女サラ<br />\r\n<br />\r\nこの世界線では故人。<br />\r\nアスランと惹かれ合っていたものの、魔神バルドルを消滅させるため自らを魔神の器として命を落とした。<br />\r\n四神全ての加護を受けており、回復魔法も使いこなす。<br />\r\n<br />\r\nシークレットキャラとして参戦", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01031000/RJ01030495/4e2d780b49ee0e1f16d6b2e1bec41f02.jpg", "alt": "The Fun of Asmodeus Iroha 2 [As-key]", "title": "The Fun of Asmodeus Iroha 2 [As-key]"}}, {"intro": "クロエ<br />\r\n<br />\r\n別の世界線、1000年以上後の時代だがプリシラの子孫にあたる。<br />\r\n朱雀、玄武の加護に加え、攻撃魔法、回復魔法、物理攻撃も可能なオールラウンダー。<br />\r\nとある事情で、アルプの支配を受け付けない。<br />\r\n<br />\r\nシークレットキャラとして参戦", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01031000/RJ01030495/2e10e07dae0b596607b6a0f5f979188c.jpg", "alt": "The Fun of Asmodeus Iroha 2 [As-key]", "title": "The Fun of Asmodeus Iroha 2 [As-key]"}}, {"intro": "キム・フィルビー<br />\r\n<br />\r\n極東地域対策魔法少女部隊隊長、パイロキネシスの能力者。<br />\r\n魔法少女ケンブリッジVよりシークレットキャラとして参戦", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01031000/RJ01030495/af30aed7159e9f16d3b6408b191b3f23.jpg", "alt": "The Fun of Asmodeus Iroha 2 [As-key]", "title": "The Fun of Asmodeus Iroha 2 [As-key]"}}]}], "description": "The Fun of Asmodeus Irohaの続編が、SRPGとなって登場!", "short_introduction": "The Fun of Asmodeus Irohaの続編が、SRPGとなって登場!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01030495.html", "site_id": "maniax", "fetched_at": 1794953836}