www.dlsite.com/maniax/work/=/product_id/RJ01341984.html", "lang": ["KO_KR"]}], "rating": {"average": 4.63, "count": 8619}, "review_count": 96, "dl_count": 35073, "wishlist_count": 39152, "ranking": [{"category": "all", "period": "day", "rank": 1, "date": "2025-02-17"}, {"category": "all", "period": "week", "rank": 1, "date": "2025-02-18"}, {"category": "all", "period": "month", "rank": 1, "date": "2025-03-02"}, {"category": "all", "period": "year", "rank": 28, "date": "2025"}, {"category": "all", "period": "total", "rank": 195, "date": "2026-01-18"}, {"category": "game", "period": "day", "rank": 1, "date": "2025-02-17"}, {"category": "game", "period": "week", "rank": 1, "date": "2025-02-18"}, {"category": "game", "period": "month", "rank": 1, "date": "2025-03-02"}, {"category": "game", "period": "year", "rank": 20, "date": "2025"}, {"category": "game", "period": "total", "rank": 169, "date": "2026-01-18"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01035000/RJ01034814_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01035000/RJ01034814_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01035000/RJ01034814_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01035000/RJ01034814_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01035000/RJ01034814_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01035000/RJ01034814_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01035000/RJ01034814_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01035000/RJ01034814_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01035000/RJ01034814_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01035000/RJ01034814_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01035000/RJ01034814_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01035000/RJ01034814_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01035000/RJ01034814_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01035000/RJ01034814_img_smp6_100x100.jpg"], "alt": "洗脳学園 ~呪人の壺~ [U-ROOM]"}, "introductions": [{"type": "text", "title": "洗脳の力で学園をエロく染めていくシミュレーションRPG!!", "body": [{"intro": "洗脳の呪いの力を使って、<br />\n学園を軍師としてエロく染めていくシミュレーションRPG!!<br />\n<br />\n・あらすじ<br />\n主人公は、謎の男から洗脳の力を授かり、<br />\n男の姪である『正光 叶』と共に、<br />\n学園に潜伏しつつ会長を堕とす事を依頼される。<br />\n<br />\n<br />\n▲学園を崩壊させて欲望のままに振る舞うか・・・・・・。<br />\n<br />\n△学園の謎を探り、真相を探すか・・・・・・。<br />\n<br />\n<br />\n★★★★★★★★★★★★★★★★★★★★★<br />\nシチュエーション等<br />\n<br />\n・Hな事が常識になり、体を触れあう生徒達!<br />\n・セックスしながら授業を行う淫乱教師!<br />\n・体育教師に性処理玩具にされるアイドル生徒!<br />\n・洗脳された生徒達に輪○される○リ少女!<br />\n・用務員のおじさんに種付されまくる少女達!<br />\n<br />\n<br />\n★一部シチュエーションはSpineアニメーションを採用。<br />\n<br />\n※主人公は軍師ポジションであり、Hシーンにはあまり参加しません。<br />\n※エロ変化していく学園を楽しむ『用務員おじさんモード』があります。<br />\n<br />\n★★★★★★★★★★★★★★★★★★★★★<br />\n<br />\nHCG基本HCG 59<br />\n<br />\nHシーン数 74(内、アニメーション数 13)"}]}, {"type": "image", "title": "学園崩壊を目指す『崩壊ルート』　/　真相を究明する『真実ルート』", "body": [{"intro": "主人公の中にはもう一つの人格が・・・・・・?<br />\n行動によって分岐する2つのルート。<br />\n<br />\n学園をエロく暴力的に染め上げる『崩壊ルート』<br />\n<br />\n呪いの力の真相を探り、協力者『正光　叶』他と共に頑張る『真実ルート』", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01035000/RJ01034814/78cd936fd40aba66d7fdee96ae221766.jpg", "alt": "洗脳学園 ~呪人の壺~ [U-ROOM]", "title": "洗脳学園 ~呪人の壺~ [U-ROOM]"}, "position": "left"}]}, {"type": "image_list", "title": "▲崩壊ルート", "body": [{"intro": "洗脳の力を拡大させていき、<br />\nエロと暴力と取引で生徒達を狂わせ、学園を崩壊させるルートです。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01035000/RJ01034814/a4d34effb1c082a3de008168fd0d631a.jpg", "alt": "洗脳学園 ~呪人の壺~ [U-ROOM]", "title": "洗脳学園 ~呪人の壺~ [U-ROOM]"}}, {"intro": "・用務員のおじさんに力を渡し、好き放題にハメさせる!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01035000/RJ01034814/16053296620b6321df918f2a8965aab9.jpg", "alt": "洗脳学園 ~呪人の壺~ [U-ROOM]", "title": "洗脳学園 ~呪人の壺~ [U-ROOM]"}}, {"intro": "・壁尻の刑を受ける女子たち", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01035000/RJ01034814/070317ef7687714f912b868c67d0f326.jpg", "alt": "洗脳学園 ~呪人の壺~ [U-ROOM]", "title": "洗脳学園 ~呪人の壺~ [U-ROOM]"}}, {"intro": "生徒達をレ○プして強化・・・・・・!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01035000/RJ01034814/c1186da7f63d1b74bc472c64ad8d5390.jpg", "alt": "洗脳学園 ~呪人の壺~ [U-ROOM]", "title": "洗脳学園 ~呪人の壺~ [U-ROOM]"}}]}, {"type": "image_list", "title": "△真実ルート", "body": [{"intro": "非道な事を行わない程度に学園を穏やかにエロくしつつ、<br />\nヒロイン『正光　叶』と共に学園と呪いの真実を究明するルートです。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01035000/RJ01034814/8a70c69a1172292364f35b8b124bbe77.jpg", "alt": "洗脳学園 ~呪人の壺~ [U-ROOM]", "title": "洗脳学園 ~呪人の壺~ [U-ROOM]"}}, {"intro": "真実に向かおうとする主人交の前には、奇怪な呪い達が立ち塞がる・・・・・・!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01035000/RJ01034814/f75323c405fc0a77d0b3a71c5f649759.jpg", "alt": "洗脳学園 ~呪人の壺~ [U-ROOM]", "title": "洗脳学園 ~呪人の壺~ [U-ROOM]"}}, {"intro": "崩壊ルートでは分からない、生徒達の過去。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01035000/RJ01034814/24166acbc59ff0e83aeeb0201bd706f6.jpg", "alt": "洗脳学園 ~呪人の壺~ [U-ROOM]", "title": "洗脳学園 ~呪人の壺~ [U-ROOM]"}}, {"intro": "学園や生徒達の記憶に散らばっているモブ呪い達。<br />\n<br />\n意味不明な言葉を吐く謎の個体も存在。彼ら(?)が目指すところとは・・・・・・。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01035000/RJ01034814/9fcfc86e391a2c92e0f89b90722ec26a.jpg", "alt": "洗脳学園 ~呪人の壺~ [U-ROOM]", "title": "洗脳学園 ~呪人の壺~ [U-ROOM]"}}]}, {"type": "image_list", "title": "ダンジョン・戦闘", "body": [{"intro": "ダンジョンボスを撃破すると、<br />\nその場所(体育用具室など)に応じた命令やHシーンが解放!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01035000/RJ01034814/f62ea2dc8e872e052cb3f586b4f9a217.jpg", "alt": "洗脳学園 ~呪人の壺~ [U-ROOM]", "title": "洗脳学園 ~呪人の壺~ [U-ROOM]"}}, {"intro": "戦闘は高速タイムプログレス戦闘!<br />\n洗脳した生徒達を連れて戦わせる事も!<br />\n<br />\nクリティカル連鎖・行動遅延・必殺技キャンセルなどを使いこなして有利に進めよう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01035000/RJ01034814/e271d64626a6d15506e11bcf7f582dd0.jpg", "alt": "洗脳学園 ~呪人の壺~ [U-ROOM]", "title": "洗脳学園 ~呪人の壺~ [U-ROOM]"}}]}, {"type": "image_list", "title": "Hシーンいろいろ", "body": [{"intro": "体育教師のオナホ化催○!<br />\n強い呪いを持つ人間が混ざると、呪いが高まる・・・・・・", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01035000/RJ01034814/5577b2a255e693921f49f66ab9ff3e89.jpg", "alt": "洗脳学園 ~呪人の壺~ [U-ROOM]", "title": "洗脳学園 ~呪人の壺~ [U-ROOM]"}}, {"intro": "エロ化した学園ではえっちな宿題も要求される・・・・・・ヒロインの好感度が高ければ、協力してもらえます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01035000/RJ01034814/5badd96216556e7063d130c0f22ec371.jpg", "alt": "洗脳学園 ~呪人の壺~ [U-ROOM]", "title": "洗脳学園 ~呪人の壺~ [U-ROOM]"}}, {"intro": "用務員おじさんモード(1)<br />\n<br />\n力を渡した用務員おじさんがハメまくる!<br />\nパンツも回収して装備可能!!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01035000/RJ01034814/90eefcc64c346086f4fecb45cd44dec3.jpg", "alt": "洗脳学園 ~呪人の壺~ [U-ROOM]", "title": "洗脳学園 ~呪人の壺~ [U-ROOM]"}}, {"intro": "用務員おじさんモード(2)<br />\n深い催○で眠らせたまま、<br />\nむちむち女子に悪戯・・・・・・!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01035000/RJ01034814/fd21df59454b7f4dffa5e25b181b6462.jpg", "alt": "洗脳学園 ~呪人の壺~ [U-ROOM]", "title": "洗脳学園 ~呪人の壺~ [U-ROOM]"}}]}], "description": "学園をエロく染めていく軍師として頑張るゲームです。", "short_introduction": "学園をエロく染めていく軍師として頑張るゲームです。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01034814.html", "site_id": "maniax", "fetched_at": 1794949236}