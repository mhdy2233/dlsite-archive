", "period": "day", "rank": 1, "date": "2023-07-11"}, {"category": "game", "period": "week", "rank": 2, "date": "2023-07-15"}, {"category": "game", "period": "month", "rank": 2, "date": "2023-07-31"}, {"category": "game", "period": "total", "rank": 181, "date": "2024-06-08"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01039000/RJ01038533_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01039000/RJ01038533_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01039000/RJ01038533_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01039000/RJ01038533_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01039000/RJ01038533_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01039000/RJ01038533_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01039000/RJ01038533_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01039000/RJ01038533_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01039000/RJ01038533_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01039000/RJ01038533_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01039000/RJ01038533_img_smp9.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01039000/RJ01038533_img_smp10.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01039000/RJ01038533_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01039000/RJ01038533_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01039000/RJ01038533_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01039000/RJ01038533_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01039000/RJ01038533_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01039000/RJ01038533_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01039000/RJ01038533_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01039000/RJ01038533_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01039000/RJ01038533_img_smp9_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01039000/RJ01038533_img_smp10_100x100.jpg"], "alt": "異世界の創造者 [くえたろう]"}, "introductions": [{"type": "image", "title": "ゲームの概要", "body": [{"intro": "『異世界の創造者』は、自由度の高いローグライクRPGです。<br />\r\n冒険やダンジョン攻略、町の住人との交流、結婚、盗み、農業、釣り、鍛冶、錬成、調合、町作り等々、目的に囚われない自由なプレイが可能!<br />\r\n旅先で出会った人と仲良くなり一緒に冒険したり、ダンジョンに繰り返し挑んで最強を目指したりと、思い思いに行動できます。<br />\r\nまた、フィールドや町、住人、冒険者、ダンジョンはゲーム毎にランダム生成され、毎回新鮮なゲーム体験を得られます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01039000/RJ01038533/ae4916ce4fcf8cfe1be8fbcbe0b23859.jpg", "alt": "異世界の創造者 [くえたろう]", "title": "異世界の創造者 [くえたろう]"}, "position": "left"}]}, {"type": "image", "title": "すべてのキャラクターに意志がある", "body": [{"intro": "ゲームに登場するすべてのキャラクターにはステータスがあり、皆思い思いに行動します。<br />\r\nそしてその大半のキャラクターとは、一緒に冒険したり結婚したりできます。<br />\r\nさらに本作ではオリジナルの冒険者を登録できるので、自分だけの冒険者をゲーム内に登場させることもできます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01039000/RJ01038533/759e510a8f3e98ca840b11591b364735.jpg", "alt": "異世界の創造者 [くえたろう]", "title": "異世界の創造者 [くえたろう]"}, "position": "left"}]}, {"type": "image", "title": "豊富なランダム要素", "body": [{"intro": "フィールドや町、住人、冒険者、ダンジョンはゲーム毎にランダム生成されます。<br />\r\nさらに、登場する多彩な装備品はランダムな性能を持っており、同じ装備品でも性能は様々。<br />\r\nまた、敵からドロップするスキル書を読むことで敵のスキルを覚えることもできます。<br />\r\n本作ではそれらのように、毎回新鮮なゲーム体験ができるランダム要素が満載です。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01039000/RJ01038533/d80ea1b3815d1b05a6e50cd0ef6f1493.jpg", "alt": "異世界の創造者 [くえたろう]", "title": "異世界の創造者 [くえたろう]"}, "position": "left"}]}, {"type": "image", "title": "戦略性の高い戦い", "body": [{"intro": "敵との戦いでは、キャラクター同士の立ち位置や視界、天気、時刻などにより、刻一刻と状況が変化します。<br />\r\n様々な特徴を持つ装備やスキル、アイテムを駆使して、難局を切り抜け敵を打破しましょう!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01039000/RJ01038533/ebe0228b4ee177727a4d0258a9ccf9d1.jpg", "alt": "異世界の創造者 [くえたろう]", "title": "異世界の創造者 [くえたろう]"}, "position": "left"}]}, {"type": "text", "title": "ゲームの動作環境", "body": [{"intro": "お使いのPCで正常に動くかどうか、体験版で動作確認をお願いいたします。<br />\r\n<br />\r\n本作はWindowsアプリでの提供ですがブラウザ版も同梱していますので、<br />\r\nChromeもしくはChroniumを使用すればMacやLinuxなどでもプレイできます。<br />\r\n※ただし、仕様上一部使用できない機能などがあります。"}]}, {"type": "text", "title": "その他", "body": [{"intro": "▼プレイ時間<br />\r\n20時間～<br />\r\n<br />\r\n▼開発期間<br />\r\n5年<br />\r\n<br />\r\n▼ホームページ<br />\r\n<a href=\"https://kuetaro.skr.jp/game1/\" target=\"_blank\">https://kuetaro.skr.jp/game1/</a><br />\r\n※問い合わせフォームなどのリンクをまとめています。<br />\r\n<br />\r\n▼AIの利用<br />\r\n顔グラフィック、背景の一部にAIを使用しています。"}]}], "description": "自由度の高いローグライクRPGです。冒険、交流、結婚、盗み、農業、釣り、鍛冶、錬成、調合、町作り等々、目的に囚われない自由なプレイが可能!", "short_introduction": "自由度の高いローグライクRPGです。冒険、交流、結婚、盗み、農業、釣り、鍛冶、錬成、調合、町作り等々、目的に囚われない自由なプレイが可能!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01038533.html", "site_id": "home", "fetched_at": 1794952878}