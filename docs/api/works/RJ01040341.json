{"id": "RJ01040341", "title": "ヒビコレマッサージ", "title_romaji": "hibikoremassaaji", "circle": {"id": "RG43715", "name": "お茶の子サイダー", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG43715.html"}, "type": {"code": "SLN", "name": "シミュレーション", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 1430, "official_jpy": 1430, "currencies": {"USD": 8.961421394234234, "EUR": 8.143619274978702, "GBP": 6.794646768646554, "TWD": 295.4362332913249, "CNY": 59.8413993681083, "KRW": 11966.52719665272, "IDR": 163802.97823596792, "VND": 230645.16129032258, "THB": 303.6802650300495, "SEK": 90.46109856464173, "HKD": 70.32141311617293, "SGD": 11.549358566393467, "CAD": 12.811955435897666, "MYR": 36.69498766997092, "BRL": 50.99057209282424, "AUD": 13.2863572339105, "PHP": 572.7789794120004, "MXN": 166.24234180820514, "NZD": 16.277153251105254, "INR": 841.8697751089131}}, "point": {"point_amount": 78, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1703833200, "file": {"type": "EXE", "size": 328973671}, "tags": [{"key": "056", "name": "癒し"}, {"key": "311", "name": "おさわり"}, {"key": "065", "name": "おっぱい"}, {"key": "071", "name": "断面図"}, {"key": "659", "name": "マッサージ"}, {"key": "114", "name": "命令/無理矢理"}, {"key": "119", "name": "ゲイ/男同士"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 4.28, "count": 152}, "review_count": 6, "dl_count": 345, "wishlist_count": 458, "ranking": [{"category": "game", "period": "month", "rank": 99, "date": "2024-01-28"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01041000/RJ01040341_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01041000/RJ01040341_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01041000/RJ01040341_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01041000/RJ01040341_img_smp2.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01041000/RJ01040341_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01041000/RJ01040341_img_smp2_100x100.jpg"], "alt": "ヒビコレマッサージ [お茶の子サイダー]"}, "introductions": [{"type": "text", "title": "更新履歴", "body": [{"intro": "2024/04/24　　　　ver 1.3.2　公開<br />\n<br />\n・一部の環境において発生するアイテムを取得・売るときのフリーズ回避のためにこれらの処理にかけるウエイトを増やしました<br />\n<br />\n<br />\n2024/03/13　　　　ver 1.3.1　公開<br />\n<br />\n・アロマキャンドル《オレンジスイート》の効果が表記と異なる不具合を修正<br />\n<br />\n<br />\n※これ以前の更新情報については付属の更新履歴をご確認ください。"}]}, {"type": "text", "title": "購入の前に", "body": [{"intro": "※※必ず体験版で動作確認をした上で購入を考えてください※※"}]}, {"type": "text", "title": "あらすじ", "body": [{"intro": "自堕落な日々を送っていたあなたは、ある日家を追い出され、遠く離れた小さな田舎町《ヒビコレタウン》で<br />\n生活することになりました。<br />\n<br />\n荷を解き通りに出ると、となりの雑貨屋さんがにこやかに声をかけてきました。<br />\n<br />\n「あなたが来ること、みんな楽しみにしてたのよ。<br />\nマッサージ屋さんをしてるんでしょう?……お父さんと一緒に!」<br />\n<br />\n<br />\n……さて。<br />\n父の策略にまんまとハマったあなたですが、これからはなにをするも自由です。<br />\n<br />\n父と同じように、マッサージ屋で生計を立てるもよし、アルバイトに勤しむもよし。<br />\n<br />\n町の住人と仲良くなって、一途に愛を育むもことも、複数と関係を持つことも、<br />\n愛のない関係になることも……すべてあなた次第です。<br />\n<br />\n<br />\n……毎月の家賃を払いさえすれば。"}]}, {"type": "text", "title": "体験版について", "body": [{"intro": "・体験版では季節が《春》のあいだの一カ月がプレイできます。<br />\n<br />\n・住人の親密度イベントが2段階目まで発生します。<br />\n<br />\n・タイトル画面にて住人マッサージをお試しできます。<br />\nプレイ次第で脱がせたりエッチしたりできます。<br />\n<br />\n・タイトル画面にてエッチイベントをお試しできます。<br />\n<br />\n・体験版のセーブデータを引き継ぐことはできません。あらかじめ、ご了承ください。"}]}, {"type": "image_list", "title": "住人紹介", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01041000/RJ01040341/7c47d559d0211f2ad3c9b7dce43ebe26.jpg", "alt": "ヒビコレマッサージ [お茶の子サイダー]", "title": "ヒビコレマッサージ [お茶の子サイダー]"}}, {"intro": "", "image_info": {"u