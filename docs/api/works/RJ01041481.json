d": "month", "rank": 3, "date": "2023-10-03"}, {"category": "all", "period": "total", "rank": 350, "date": "2024-05-04"}, {"category": "game", "period": "day", "rank": 1, "date": "2023-09-23"}, {"category": "game", "period": "week", "rank": 1, "date": "2023-09-25"}, {"category": "game", "period": "month", "rank": 3, "date": "2023-10-03"}, {"category": "game", "period": "total", "rank": 289, "date": "2024-06-01"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01042000/RJ01041481_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01042000/RJ01041481_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01042000/RJ01041481_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01042000/RJ01041481_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01042000/RJ01041481_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01042000/RJ01041481_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01042000/RJ01041481_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01042000/RJ01041481_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01042000/RJ01041481_img_smp7.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01042000/RJ01041481_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01042000/RJ01041481_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01042000/RJ01041481_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01042000/RJ01041481_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01042000/RJ01041481_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01042000/RJ01041481_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01042000/RJ01041481_img_smp7_100x100.jpg"], "alt": "戦令姫レイシアと失落の要塞 [くろと雑貨]"}, "introductions": [{"type": "image", "title": "あらすじ", "body": [{"intro": "士官学院を卒業し、晴れて軍人となった優等生レイシア。<br />\n新米軍人として配属された職場は首都セントラルから遠く離れた「クレイスト要塞」。<br />\nしかしそこはある人物のせいで地に堕ちた\"失落の要塞\"であった。<br />\n<br />\nその人物はクレイスト要塞の総督を務める\"グスタフ\"という男。<br />\n小太りでいやらしい顔つきをし、ロクに仕事もしないこの男は<br />\nレイシアに対し、セクハラやパワハラはもちろんのこと、<br />\n性的な行為もしてくる始末・・・。<br />\n<br />\nこの男が街の人たちをないがしろにし続けてきた結果、<br />\nクレイスト要塞の評判は最悪であり、街の人たちは軍人を<br />\n全く信用していなかった。<br />\n<br />\n街の人たちの信用を取り戻し、この腐敗しきった失落の要塞を<br />\n改革するためレイシアは今日も一人、奮闘する──!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01042000/RJ01041481/71c83d6b18d5b50c208cb4d0b13b4ffc.jpg", "alt": "戦令姫レイシアと失落の要塞 [くろと雑貨]", "title": "戦令姫レイシアと失落の要塞 [くろと雑貨]"}, "position": "over"}]}, {"type": "image", "title": "概要・仕様", "body": [{"intro": "前作「閃紅のアリエス」で好評だったドットアニメーションや<br />\nアクションバトルなどを継承し、パワーアップした本作!<br />\n等身の高いドット絵によるアニメーションが没入感を高め、<br />\nより濃密なファンタジーRPG体験を楽しめます!<br />\n<br />\n・解像度:1280×960<br />\n・CG枚数:75枚(基本CG60枚・カットインCG15枚)<br />\n・クリア時間目安:8～10時間<br />\n・体験版のセーブデータ引き継ぎ可<br />\n・ゲームパッド完全対応<br />\n・制作ツール:WOLF RPG エディターPRO", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01042000/RJ01041481/6f4fedb77f317b416312942d185e7dd0.jpg", "alt": "戦令姫レイシアと失落の要塞 [くろと雑貨]", "title": "戦令姫レイシアと失落の要塞 [くろと雑貨]"}, "position": "over"}]}, {"type": "text", "title": "Hシーン・シチュエーションなど", "body": [{"intro": "本作は真面目な優等生レイシアが、街の不良たちやスケベなおじさんたちに<br />\nセクハラされたりHなことをされてしまったりなシチュエーションがいっぱい!<br />\n<br />\n◆シチュエーション<br />\n・職場の先輩や上司からお尻を触られたり胸を揉まれたりなセクハラ<br />\n・スラムの不良たちに拘束され無理やり膣内だし<br />\n・スケベなおじさんが集まる街の酒場でアルバイト<br />\n・お約束なスケベオイルマッサージ<br />\n・催○医者による催○健康診断<br />\n・バニーコスでお客様と売春<br />\n・ヒロインのことが好きなショタくんにおっぱいをむしゃぶり付かれ・・・<br />\n・凶悪なボスに屈服しバッドエンド<br />\nなどなどバラエティ豊富なシチュエーションを用意しております!"}]}, {"type": "image_list", "title": "", "body": [{"intro": "上司のおじさんに胸を揉まれたり・・・。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01042000/RJ01041481/d1d559a5a8cc5e9d2665b9469593d19a.jpg", "alt": "戦令姫レイシアと失落の要塞 [くろと雑貨]", "title": "戦令姫レイシアと失落の要塞 [くろと雑貨]"}}, {"intro": "戦闘中でもお構いなしに<br />\n手を出してくる不良たち・・・。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01042000/RJ01041481/2206bfa6695f64dab54deac1cd0ca3e9.jpg", "alt": "戦令姫レイシアと失落の要塞 [くろと雑貨]", "title": "戦令姫レイシアと失落の要塞 [くろと雑貨]"}}, {"intro": "酒場でお客様を怒らせてしまうと・・・。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01042000/RJ01041481/520c8cc29be259857029ae356c8a7202.jpg", "alt": "戦令姫レイシアと失落の要塞 [くろと雑貨]", "title": "戦令姫レイシアと失落の要塞 [くろと雑貨]"}}, {"intro": "淫欲度が上がるとエッチなお店で働くことも・・・。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01042000/RJ01041481/fd972677155c2ccc7d03960ac063b94a.jpg", "alt": "戦令姫レイシアと失落の要塞 [くろと雑貨]", "title": "戦令姫レイシアと失落の要塞 [くろと雑貨]"}}]}, {"type": "image", "title": "戦闘システム", "body": [{"intro": "エロ同人ゲームとは思えない本格的なアクションバトルを搭載!<br />\n簡単な操作で爽快なコンボを決め、敵をなぎ倒していこう!<br />\n<br />\nアクション苦手な方からガチ勢の方まで幅広く楽しめるように<br />\n5段階の難易度を用意しました!<br />\nゲーム中いつでも自由に設定できますので、<br />\nご自身にあった難易度で遊べます!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01042000/RJ01041481/4e0cefd4ff3a30fb0b12af525b3c350c.jpg", "alt": "戦令姫レイシアと失落の要塞 [くろと雑貨]", "title": "戦令姫レイシアと失落の要塞 [くろと雑貨]"}, "position": "over"}]}, {"type": "image_list", "title": "", "body": [{"intro": "スキル・カウンター・空中コンボなどアクション性豊富な戦闘システム!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01042000/RJ01041481/06a8039d05d01a869a56209c38b84a65.jpg", "alt": "戦令姫レイシアと失落の要塞 [くろと雑貨]", "title": "戦令姫レイシアと失落の要塞 [くろと雑貨]"}}, {"intro": "剣と銃を使い分けて戦おう!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01042000/RJ01041481/af701731d934bfc0e12fa6ea880c068e.jpg", "alt": "戦令姫レイシアと失落の要塞 [くろと雑貨]", "title": "戦令姫レイシアと失落の要塞 [くろと雑貨]"}}, {"intro": "爽快感抜群の演出!<br />\nきっとザコ敵を倒すことにすら夢中になれるはず!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01042000/RJ01041481/0214870f4c5402917daaf02264afc076.jpg", "alt": "戦令姫レイシアと失落の要塞 [くろと雑貨]", "title": "戦令姫レイシアと失落の要塞 [くろと雑貨]"}}, {"intro": "秘奥義で大ダメージを与えよう!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01042000/RJ01041481/1d93de7e0e5d747550829d4ea07f56c3.jpg", "alt": "戦令姫レイシアと失落の要塞 [くろと雑貨]", "title": "戦令姫レイシアと失落の要塞 [くろと雑貨]"}}]}], "description": "士官学院を卒業し、晴れて軍人となったレイシアに待ち受けていたのはセクハラの数々──!?本格爽快アクション×HRPG第二弾!", "short_introduction": "士官学院を卒業し、晴れて軍人となったレイシアに待ち受けていたのはセクハラの数々──!?本格爽快アクション×HRPG第二弾!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01041481.html", "site_id": "maniax", "fetched_at": 1794952425}