te": "2023-06-03"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01057000/RJ01056287_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01057000/RJ01056287_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01057000/RJ01056287_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01057000/RJ01056287_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01057000/RJ01056287_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01057000/RJ01056287_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01057000/RJ01056287_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01057000/RJ01056287_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01057000/RJ01056287_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01057000/RJ01056287_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01057000/RJ01056287_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01057000/RJ01056287_img_smp6_100x100.jpg"], "alt": "ドット淫魔の巣 [犬の卵焼き屋さん]"}, "introductions": [{"type": "image", "title": "画面いっぱいに動くHドットアニメ", "body": [{"intro": "全シーンが極大サイズのエロドットアニメです。<br />\r\n<br />\r\n全25シーンで　内5つは乳サイズや褐色等差分です。<br />\r\n<br />\r\n※体験版では画像に大きな黒塗りの加工がされておりますが<br />\r\nドットアニメの動きのイメージを確認する事ができます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01057000/RJ01056287/945e8da50f54a0b168e0187ce2d3e596.jpg", "alt": "ドット淫魔の巣 [犬の卵焼き屋さん]", "title": "ドット淫魔の巣 [犬の卵焼き屋さん]"}, "position": "over"}]}, {"type": "image", "title": "エッチ重視のアクションRPG", "body": [{"intro": "テキスト少な目で　メニュー画面等を開く場面も少ない<br />\r\nサクサクと遊べるアクションRPGです。<br />\r\n回復アイテムは触れるだけでその場で使用されます。<br />\r\n<br />\r\n決定キーで　光魔法を身体にまとう事ができます。<br />\r\nその状態だと　触れるだけで淫魔を倒す事ができます。<br />\r\n<br />\r\nしかし・・・", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01057000/RJ01056287/77310b45b4e1f8b2b90ed3be1130c8bb.jpg", "alt": "ドット淫魔の巣 [犬の卵焼き屋さん]", "title": "ドット淫魔の巣 [犬の卵焼き屋さん]"}, "position": "over"}]}, {"type": "image", "title": "MPが切れると無防備に・・・", "body": [{"intro": "MPが切れると赤いモヤが画面にかかり<br />\r\n光魔法がつかえなくなる。<br />\r\n<br />\r\nこうなった主人公に<br />\r\n淫魔に抵抗する術はありません・・・", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01057000/RJ01056287/9da31fa4c4b5a28319882d306eea1663.jpg", "alt": "ドット淫魔の巣 [犬の卵焼き屋さん]", "title": "ドット淫魔の巣 [犬の卵焼き屋さん]"}, "position": "over"}]}, {"type": "image", "title": "Hシーンの全ては　淫魔による搾精", "body": [{"intro": "淫魔に惑わされ　捕まっていても<br />\r\n振りほどく事ができます。<br />\r\n<br />\r\nしかし快楽に身を任せ射精し続けると　どんどんHPがなくなります。<br />\r\nそのまま死んでしまうと搾精されたままゲームオーバーとなります。<br />\r\n<br />\r\nまた　他のギミックなどでやられてしまいゲームオーバーとなった後でも<br />\r\n近くに淫魔がいる場合は　<br />\r\nゲームオーバー状態のまま　淫魔に搾り取られます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01057000/RJ01056287/4b164ab8e6a659484603cfbca81bb47f.jpg", "alt": "ドット淫魔の巣 [犬の卵焼き屋さん]", "title": "ドット淫魔の巣 [犬の卵焼き屋さん]"}, "position": "over"}]}, {"type": "image", "title": "体験版でゲーム性を確認してみてください。", "body": [{"intro": "エッチ重視のゲームですが<br />\r\n主人公の強化や　恐ろしいギミックの数々・・・<br />\r\nボス戦もあります。<br />\r\n<br />\r\n是非　体験版で　ゲーム性を確認してみてください。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01057000/RJ01056287/c0146fb896d03c237cb7dd1ed3e72abb.jpg", "alt": "ドット淫魔の巣 [犬の卵焼き屋さん]", "title": "ドット淫魔の巣 [犬の卵焼き屋さん]"}, "position": "over"}]}, {"type": "image", "title": "Hドットアニメの詰め合わせとしても是非!", "body": [{"intro": "ゲーム開始から約10秒で　全Hシーンを閲覧可能です!<br />\r\n<br />\r\nゲームを遊ぶ気分ではない人でも<br />\r\n<br />\r\n1つ　約70円　の<br />\r\nエロドットアニメ集としてお楽しみいただけます!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01057000/RJ01056287/deafaf92cc43cfbdb9fc6a38a4f78488.jpg", "alt": "ドット淫魔の巣 [犬の卵焼き屋さん]", "title": "ドット淫魔の巣 [犬の卵焼き屋さん]"}, "position": "over"}]}], "description": "画面いっぱいに動く HドットアニメのアクションRPG", "short_introduction": "画面いっぱいに動く HドットアニメのアクションRPG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01056287.html", "site_id": "maniax", "fetched_at": 1794953105}