79391.html", "lang": ["CHI_HANT"]}], "rating": {"average": 4.13, "count": 1181}, "review_count": 7, "dl_count": 4109, "wishlist_count": 5239, "ranking": [{"category": "all", "period": "day", "rank": 22, "date": "2023-07-14"}, {"category": "game", "period": "day", "rank": 12, "date": "2023-07-14"}, {"category": "game", "period": "week", "rank": 18, "date": "2023-07-20"}, {"category": "game", "period": "month", "rank": 34, "date": "2023-08-01"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01060000/RJ01059988_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01060000/RJ01059988_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01060000/RJ01059988_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01060000/RJ01059988_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01060000/RJ01059988_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01060000/RJ01059988_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01060000/RJ01059988_img_smp5.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01060000/RJ01059988_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01060000/RJ01059988_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01060000/RJ01059988_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01060000/RJ01059988_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01060000/RJ01059988_img_smp5_100x100.jpg"], "alt": "南国の楽園へ お嬢様との性活週間 [Madsug]"}, "introductions": [{"type": "text", "title": "あらすじ", "body": [{"intro": "主人公のアメンは借金を負って孤島に派遣された執事で、島で二人のメイドと屋敷や古代エジプト出土品の管理を任されている。<br />\n<br />\nある日、その屋敷の主人であるお嬢様「アスタルト」とその専属の執事長「アイ」が、その島で休暇を過ごすことになった。<br />\n<br />\nアスタルトは一見普通の少女に見えるが、実は○女の皮を被っている色魔で、彼女に狙われた獲物は誘惑に勝つことはなかった。<br />\n二人の初めての出会いから、アスタルトはアメンを獲物としている。<br />\nそして○リコンであるアメンも、その誘惑に負けて、やがてアスタルトの虜となった。<br />\n<br />\nしかしアスタルトの専属執事長アイは真面目でルールに厳しく、執事とお嬢様の間での淫行を厳重に取り締まっている。<br />\nアスタルトに手を出したら、すぐに解雇にすると、アイはアメンにそう警告した。<br />\n<br />\nアスタルトと自分を満足させるために、アメンはアイの監視を避けながら、アスタルトとエッチなことをすることに……<br />\n<br />\nエッチでラブラブな7日間が始まろうとしている……<br />\n<br />\n<br />\n開発進捗の確認・不具合報告などは、Ci-enまたはDiscordからお願いいたします。<br />\n<br />\nCi-en :  <a href=\"https://ci-en.dlsite.com/creator/19318\" target=\"_blank\">https://ci-en.dlsite.com/creator/19318</a><br />\nDiscord:<a href=\"https://discord.gg/3h553fRh6g\" target=\"_blank\">https://discord.gg/3h553fRh6g</a>"}]}, {"type": "image_list", "title": "主要キャラクタ", "body": [{"intro": "◇アスタルト     <br />\nCV:御崎ひより<br />\n<br />\nエジプト○リ、本名不詳、なぜか周りからそう呼ばれている。<br />\n数千年前の古代エジプト豪族のアスタルト家の子孫なので、アスタルトとも呼ばれている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01060000/RJ01059988/9b3378b8fbc41498b739fe0570eb0d93.jpg", "alt": "南国の楽園へ お嬢様との性活週間 [Madsug]", "title": "南国の楽園へ お嬢様との性活週間 [Madsug]"}}, {"intro": "◇アイ・マート・エドマン<br />\nCV:逢坂成美<br />\n<br />\nアスタルトの専属執事長、アスタルトと共に島で休暇を過ごすことになった。<br />\nドイツの中流階級家庭の出身で、子供の頃はやんちゃだったせいで、執事専門学院に送られた。<br />\n12年の厳しいエリート教育で、彼女を文武両道な執事に仕立てた。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01060000/RJ01059988/5e1b30f9e842731a878f8857e12e0c72.jpg", "alt": "南国の楽園へ お嬢様との性活週間 [Madsug]", "title": "南国の楽園へ お嬢様との性活週間 [Madsug]"}}, {"intro": "◇ネフティス<br />\nCV:箱河ノア<br />\n<br />\n幼い頃は姉とインドのスラム街に住んでいたが、何らかの原因でアスタルト財団に拾われメイドとして養成された。<br />\n一人でいることが好きで、よく一人でオカルト本を読む、瞑想などをしている。<br />\nテーブルゲームが好きで、チャトランガや他色々なサイコロゲームを好んでいる、<br />\nアスタルトから貰った古代エジプトの二十面サイコロを大事にしている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01060000/RJ01059988/5021815650b5e257e78a791ca120d2d9.jpg", "alt": "南国の楽園へ お嬢様との性活週間 [Madsug]", "title": "南国の楽園へ お嬢様との性活週間 [Madsug]"}}, {"intro": "◇ハトホル<br />\nCV:陽向葵ゅか<br />\n<br />\n幼い頃は妹とインドのスラム街に住んでいたが、何らかの原因でアスタルト財団に拾われメイドとして養成された。<br />\n<br />\n完璧なメイドとも言える彼女だが、高難易度なダンスを踊るのが趣味で、インドの伝統的なダンスはすべてできるぐらいだった<br />\n。アスタルトの頼みでシヴァ・ナタ披露したことで、アスタルトの専属メイドとして選ばれた。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01060000/RJ01059988/7ffaf6fd4e922ce561f6436d03e7bc04.jpg", "alt": "南国の楽園へ お嬢様との性活週間 [Madsug]", "title": "南国の楽園へ お嬢様との性活週間 [Madsug]"}}]}, {"type": "text_list", "title": "ゲーム紹介", "body": [{"intro": "多様な遊び方 ゲーム中の7日間に、毎日ごとに違うメイン、サブクエスト、ミニゲームなどが遊べます。"}, {"intro": "高自由度 行動範囲は屋敷だけでなく、島全体にも広がります、探索できる隠し要素もたくさん用意しております。"}, {"intro": "豊富なCG 基本CG計33枚、全135枚。"}, {"intro": "回想: あり"}, {"intro": "画面サイズ :1024X720"}]}, {"type": "text_list", "title": "注意事項", "body": [{"intro": "本作はRPGツクールMVで開発されています、体験版をダウンロードして頂いて、動作確認をしてからご購入頂けると幸いです。"}, {"intro": "体験版のセーブデータは製品版でも使用できます。"}, {"intro": "本作は同人誌エジプト○リシリーズの派生作品になります。 原作者すりお様の監修下で制作しております。"}]}], "description": "えっちな○リっ子お嬢様と真面目な執事のラブラブ(えちえち)ゲーム", "short_introduction": "えっちな○リっ子お嬢様と真面目な執事のラブラブ(えちえち)ゲーム", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01059988.html", "site_id": "maniax", "fetched_at": 1794952858}