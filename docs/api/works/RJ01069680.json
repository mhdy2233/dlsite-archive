gory": "game", "period": "day", "rank": 1, "date": "2023-07-27"}, {"category": "game", "period": "week", "rank": 4, "date": "2023-07-29"}, {"category": "game", "period": "month", "rank": 13, "date": "2023-08-22"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01070000/RJ01069680_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01070000/RJ01069680_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01070000/RJ01069680_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01070000/RJ01069680_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01070000/RJ01069680_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01070000/RJ01069680_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01070000/RJ01069680_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01070000/RJ01069680_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01070000/RJ01069680_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01070000/RJ01069680_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01070000/RJ01069680_img_smp9.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01070000/RJ01069680_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01070000/RJ01069680_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01070000/RJ01069680_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01070000/RJ01069680_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01070000/RJ01069680_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01070000/RJ01069680_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01070000/RJ01069680_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01070000/RJ01069680_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01070000/RJ01069680_img_smp9_100x100.jpg"], "alt": "綾子さんの奔走 [男爵トマト]"}, "introductions": [{"type": "text", "title": "あらすじ", "body": [{"intro": "夫の不倫が原因で離婚し、<br />\n愛する息子と共に新天地に引っ越してきた、<br />\nこの物語の主人公である『永辻綾子』<br />\n<br />\n心の傷も癒えはじめ、平和に暮らしていたそんなある日、<br />\n突如息子が倒れ、原因不明の昏睡状態に陥ってしまう。<br />\n<br />\n途方に暮れ、さびれた神社を訪れた綾子の前に、<br />\n息子を助ける手がかりを持った謎の幽霊が現れる。<br />\n<br />\n<br />\nそして・・・・この奇妙な幽霊との出会いが、<br />\n綾子の奔走の始まりであった・・・・・・"}]}, {"type": "text", "title": "ゲーム概要", "body": [{"intro": "◆目的◆<br />\nエッチなことを沢山して息子を助けましょう!<br />\n<br />\n◆システム◆<br />\nNPCに話しかけ、感謝の結晶体である<br />\n『信仰』を集めましょう!<br />\n戦闘やミニゲームは無し!抜き特化RPGとなっています!!<br />\n<br />\n◆画像枚数・イベント数◆<br />\n基本CG枚数 :90枚以上<br />\n差分           :3000枚以上<br />\nHイベント数:190以上<br />\n<br />\n豊富な差分でイラストの変化がとても多いです!<br />\n<br />\n◆H段階あり◆<br />\n段階に応じてエロステータスや<br />\n一部キャラクターの会話内容、<br />\n独り言やイベント内容が変わります。<br />\n<br />\n◆回想モード搭載◆<br />\nほぼすべてのHイベントは回想部屋で見ることができます。<br />\n全開放スイッチも搭載!お急ぎの方はどうぞ。<br />\n<br />\n◆プレイ内容◆<br />\n・キス　・フェラ　・セックス(正常位、バック、駅弁、騎乗位その他いろいろ)　<br />\n・盗撮　・オナニー(角オナ、指オナ、バイブ、アナルオナニー)　・エッチ配信　・ボーイッシュ褐色レズ　<br />\n・アナルセックス　・浣腸　・スカトロ、食ザー(事前に閲覧確認あり)　・ふたなり　・ごっくん　<br />\n・露出　・ボディペイント　・母乳プレイ　・ポールダンス　・獣○　・放尿　・壁穴　・ショタ　・眠姦　<br />\n・ローションプレイ　・BSS　・ボテ腹セックス　　・・・・・・などなどその他色々<br />\n<br />\n安定の性癖からマニアックな性癖まで多数のイベントが用意されています!<br />\n<br />\n◆想定プレイ時間◆<br />\nエンディング一つに到達:5~7時間<br />\n全てのイベントを回収　:10~13時間以上<br />\n<br />\n※本作は「RPGツクールMV」にて製作されています。<br />\n　ご購入の前に、体験版での動作確認をお願いします。<br />\n<br />\n※体験版からセーブデータは引き継げません。"}]}, {"type": "image_list", "title": "キャラクター紹介", "body": [{"intro": "名前:永辻綾子<br />\n<br />\n<br />\n年齢:37歳<br />\n<br />\n<br />\n息子と二人暮らし中の<br />\nシングルマザー", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01070000/RJ01069680/1d9224af738988c2e0689a351656c14c.jpg", "alt": "綾子さんの奔走 [男爵トマト]", "title": "綾子さんの奔走 [男爵トマト]"}}, {"intro": "名前:レイ<br />\n<br />\n<br />\n年齢:???<br />\n<br />\n<br />\n神社に居た変な幽霊", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01070000/RJ01069680/6e1826b1b5c7879da62959e19d074a52.jpg", "alt": "綾子さんの奔走 [男爵トマト]", "title": "綾子さんの奔走 [男爵トマト]"}}, {"intro": "見た目通りの優しい性格。<br />\n<br />\n大人しそうな見た目に反し、<br />\n意外と好奇心旺盛。<br />\n<br />\n恋愛経験が乏しく、<br />\n別れた夫とも<br />\n夜の営みが少なかった為、<br />\n自分の身体の魅力に<br />\nあまり自覚がない。<br />\n<br />\nエッチなことには<br />\n内心、興味津々。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01070000/RJ01069680/f4edbcfc2977b07cafcdb755dfcf209d.jpg", "alt": "綾子さんの奔走 [男爵トマト]", "title": "綾子さんの奔走 [男爵トマト]"}}, {"intro": "色々と怪しい人物。<br />\n綾子が住む地域の守護神。<br />\n<br />\n様々な超能力を扱え、<br />\n息子の治療を<br />\nサポートしてくれる。<br />\n<br />\n性格は明るく自由奔放。<br />\n綾子をイジって<br />\n遊ぶことが楽しみ。<br />\n<br />\n普通にゲームやネット<br />\n関係に詳しい。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01070000/RJ01069680/2043594e1e701b9a375d320b94cb4f44.jpg", "alt": "綾子さんの奔走 [男爵トマト]", "title": "綾子さんの奔走 [男爵トマト]"}}]}], "description": "ママが不思議でエッチな目にあうエロ特化抜きRPG", "short_introduction": "ママが不思議でエッチな目にあうエロ特化抜きRPG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01069680.html", "site_id": "maniax", "fetched_at": 1794952790}