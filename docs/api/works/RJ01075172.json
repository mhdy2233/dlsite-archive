nk": 6, "date": "2023-10-16"}, {"category": "game", "period": "day", "rank": 1, "date": "2023-09-22"}, {"category": "game", "period": "week", "rank": 3, "date": "2023-09-27"}, {"category": "game", "period": "month", "rank": 5, "date": "2023-10-16"}, {"category": "game", "period": "total", "rank": 465, "date": "2024-12-07"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01076000/RJ01075172_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01076000/RJ01075172_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01076000/RJ01075172_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01076000/RJ01075172_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01076000/RJ01075172_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01076000/RJ01075172_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01076000/RJ01075172_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01076000/RJ01075172_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01076000/RJ01075172_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01076000/RJ01075172_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01076000/RJ01075172_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01076000/RJ01075172_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01076000/RJ01075172_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01076000/RJ01075172_img_smp6_100x100.jpg"], "alt": "戦甲機ソルガンテ [GapTax]"}, "introductions": [{"type": "text", "title": "あらすじ", "body": [{"intro": "舞台は人型ロボットが正式採用された時代。<br />\r\nラダルタという国で軍人としてロボットのパイロットを務める主人公と<br />\r\n上官であり戦場での指示・サポートを行うヒロインである妻。<br />\r\n<br />\r\nこれは、主人公が何者かに陥れられながらも<br />\r\nテロ行為を行う組織と戦いを繰り広げていく物語。<br />\r\n<br />\r\nそしてその裏で夫の為に動く妻に男達の魔の手が……。<br />\r\n<br />\r\nGapTaxが贈るロボット物NTRRPG第2弾。<br />\r\n<br />\r\nエロCG基本枚数は45枚以上<br />\r\nエロシーン数は70以上に加え、何かが起こっている通信シーンもあります。"}]}, {"type": "text", "title": "仕様・注意事項", "body": [{"intro": "・現在の本体バージョンは【1.10】です。<br />\n<br />\n#仕様<br />\n・エロシーンの回想部屋有り<br />\n・戦闘時の通信の回想部屋もアリ<br />\n・女性キャラBGV有り<br />\n・周回システム有り<br />\n・2週目以降、戦闘のスキップ機能有り<br />\n・回想フルオープン有り<br />\n<br />\n#注意事項<br />\n・本作はRPGツクールMZで製作しており、遊んでいただくにはRPGツクールMZが動作する環境が必要です。<br />\n・体験版のデータは製品版へ移行できません、ご注意ください。<br />\n<br />\n・不具合などあった場合の連絡先は下記リンク先にございます。<br />\n<a href=\"https://ci-en.dlsite.com/creator/734/article/962739\" target=\"_blank\">https://ci-en.dlsite.com/creator/734/article/962739</a>"}]}, {"type": "image_list", "title": "女性キャラクター紹介(ボイスはBGVのみです)", "body": [{"intro": "エレノア/CV.篠守ゆきこ<br />\r\n主人公の妻であり上官、本作のメインヒロイン。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01076000/RJ01075172/e58a3a2e143002907f7cece7facbb6fe.jpg", "alt": "戦甲機ソルガンテ [GapTax]", "title": "戦甲機ソルガンテ [GapTax]"}}, {"intro": "カーラ/CV.涼貴涼<br />\r\n主人公とエレノアのいる基地で整備士をしている女性。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01076000/RJ01075172/04fc4a3b08f54b1cd168cfba3b6c61fa.jpg", "alt": "戦甲機ソルガンテ [GapTax]", "title": "戦甲機ソルガンテ [GapTax]"}}]}, {"type": "image_list", "title": "ゲームの紹介", "body": [{"intro": "ゲームの流れは午前と午後の探索パートと出撃しロボットを動かす戦闘パートを繰り返していきます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01076000/RJ01075172/87e1e026de56380c3f374208f6fa39cf.jpg", "alt": "戦甲機ソルガンテ [GapTax]", "title": "戦甲機ソルガンテ [GapTax]"}}, {"intro": "戦闘パートでは当サークルの過去作『爆災雷鋼ライオウガー』で好評だった通信システムをパワーアップさせ、より楽しみやすくしました。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01076000/RJ01075172/755b164aeb526bdcb34364253f5452e8.jpg", "alt": "戦甲機ソルガンテ [GapTax]", "title": "戦甲機ソルガンテ [GapTax]"}}, {"intro": "探索パート中、エレノアがマップにいるが接触できず何が起こっているか分からない事があります。<br />\r\nその際、何が起こっていたかは回想部屋からエレノア視点で見る事ができます。<br />\r\nまた、回想は日にちの経過でも自動的に登録されていきます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01076000/RJ01075172/19521dd4cfe01806eece23e134ff8548.jpg", "alt": "戦甲機ソルガンテ [GapTax]", "title": "戦甲機ソルガンテ [GapTax]"}}, {"intro": "プレイヤーの進め方次第で後半にルートが分岐します。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01076000/RJ01075172/cd7701dfc83934d0facb88ade0d73406.jpg", "alt": "戦甲機ソルガンテ [GapTax]", "title": "戦甲機ソルガンテ [GapTax]"}}]}, {"type": "text", "title": "スペシャルサンクス", "body": [{"intro": "・浦瀬ヒガタ 様<br />\r\n　HP:<a href=\"http://nenokuni.com\" target=\"_blank\">http://nenokuni.com</a><br />\r\n　ツイッター:<a href=\"https://twitter.com/higat_00\" target=\"_blank\">https://twitter.com/higat_00</a><br />\r\n<br />\r\n・Shade 様<br />\r\n　ツイッター:<a href=\"https://twitter.com/Shade0123\" target=\"_blank\">https://twitter.com/Shade0123</a><br />\r\n<br />\r\n・篠守ゆきこ 様<br />\r\n　HP:<a href=\"https://ooyukikooo.com\" target=\"_blank\">https://ooyukikooo.com</a><br />\r\n　ツイッター:<a href=\"https://twitter.com/oOYuKiKoOo\" target=\"_blank\">https://twitter.com/oOYuKiKoOo</a><br />\r\n<br />\r\n・涼貴涼 様<br />\r\n　HP:<a href=\"http://kingpanda.sakura.ne.jp\" target=\"_blank\">http://kingpanda.sakura.ne.jp</a><br />\r\n　ツイッター:<a href=\"https://twitter.com/bee_ryo\" target=\"_blank\">https://twitter.com/bee_ryo</a>"}]}], "description": "ヒロインである妻が夫以外の男達に堕とされてしまうロボット物NTRRPG", "short_introduction": "ヒロインである妻が夫以外の男達に堕とされてしまうロボット物NTRRPG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01075172.html", "site_id": "maniax", "fetched_at": 1794952445}