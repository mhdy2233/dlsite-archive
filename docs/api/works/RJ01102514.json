eriod": "month", "rank": 66, "date": "2023-10-29"}, {"category": "game", "period": "day", "rank": 6, "date": "2023-09-30"}, {"category": "game", "period": "week", "rank": 19, "date": "2023-10-04"}, {"category": "game", "period": "month", "rank": 26, "date": "2023-10-29"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01103000/RJ01102514_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01103000/RJ01102514_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01103000/RJ01102514_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01103000/RJ01102514_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01103000/RJ01102514_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01103000/RJ01102514_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01103000/RJ01102514_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01103000/RJ01102514_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01103000/RJ01102514_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01103000/RJ01102514_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01103000/RJ01102514_img_smp9.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01103000/RJ01102514_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01103000/RJ01102514_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01103000/RJ01102514_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01103000/RJ01102514_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01103000/RJ01102514_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01103000/RJ01102514_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01103000/RJ01102514_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01103000/RJ01102514_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01103000/RJ01102514_img_smp9_100x100.jpg"], "alt": "Embrace 寝取らせプレイで解る彼女の淫望 [唐揚げトマト]"}, "introductions": [{"type": "text", "title": "「仕方なく!　仕方なくですからね!?」と言っていた巨乳人妻が快楽の沼に――寝取らせプレイから始まる淫蕩RPG!", "body": [{"intro": "※　発売予告作品に掲載していた体験版セーブデータは<br />\n　　本ゲームに使用しないようお願いします<br />\n　　変更・調整を行った箇所がありますので不具合の原因となります<br />\n<br />\n<br />\n～前書き～(必ずご一読ください)<br />\n<br />\n・本作はRPGツクールMV製です、体験版での動作確認を推奨いたします<br />\n・画面解像度は1280×720となっております<br />\n・マップ移動中にXキー or 右クリックでメニューを開けます<br />\n・イベント発生中にWキーでロード画面に移行できます<br />\n・Qキー入力でメッセージウィンドウを一時消去、再入力で一時消去を解除<br />\n・Aキー入力でオートテキストモードになります<br />\n・必要であればオプションにて音量、音声の調整を行ってください<br />\n・使用したVroidStudioデータ、BGM素材、プラグイン等はread meにて<br />\n　クレジット記載させていただきました<br />\n<br />\n<br />\n～あらすじ～<br />\n<br />\n人気の官能小説家として生計を立てている虎瀬楽語(とらせ らくご)は<br />\n親友であり祖父から継いだ温泉旅館のオーナーである鳥祢五郎(とりね ごろう)の元に<br />\nとある相談をしにやって来ていた。<br />\n<br />\nなんと現在執筆中の小説に寝取られのシーンがあるため、<br />\n「寝取られる側の心境について知見を深めたい。ついては君に僕の妻を抱いて欲しいんだ」<br />\nと言い出したのだ。<br />\n<br />\n思いも寄らぬ寝取らせプレイの申し出に五郎はやや呆れたものの<br />\nスマホで見せてもらった楽語の奥さん――虎瀬晴夏(とらせ はるか)をいたく気に入り、<br />\n「どうなっても俺は責任を取らない」「やるからには本気で寝取りに行く」という<br />\n条件付きで頼みを引き受けることに。<br />\n<br />\n時はほんの少しだけ流れて世間は夏休みに。<br />\n勤務している幼稚園も長期休暇へ入り、休養も兼ねて温泉旅館へやってきた虎瀬夫妻。<br />\n<br />\n寝取らせプレイについて難色を示していた晴夏だったが、<br />\n旅館にやって来たその夜に楽語も五郎も予想だにしなかった事実が判明する。<br />\n<br />\n温泉旅館で過ごす40日間。巨乳人妻を取り巻く淫らな日々の結末とは――<br />\n<br />\n<br />\n～簡単な操作説明～<br />\n・昼フェイズは五郎を操作してマップ内を探索。<br />\n　アイテムや資金を集めたりフラグを建てるために奔走します。<br />\n・夜フェイズは晴夏の精神世界に入ってフラグを建てたり<br />\n　寝取らせプレイや調教、楽語とのラブラブエッチをお愉しみください。<br />\n<br />\n<br />\n～Hイベント一部お品書き～<br />\n・楽語との甘い夜を過ごしつつ、寝取らせについて協力を求める<br />\n・初めての夫以外の肉棒に戸惑いつつも胸を高鳴らせてしまう<br />\n・寝取らせに慣れてきたら五郎以外との男とも淫蕩の時を過ごす<br />\n・エロマッサージ、ラブホセックス、露出撮影などなど<br />\n・理性の箍が徐々に緩み、複数プレイでアヘ顔を晒してしまうことに……<br />\n<br />\n柔和な人妻、幼稚園で人気の先生でもある巨乳ピンク髪ヒロインが<br />\n胸の内に押し込めて秘匿していた本当の欲望。<br />\nその欲望を暴かれた上で心身共に快楽漬けにされる様を愉しんでいただければ幸いです。<br />\n<br />\n<br />\n※<br />\nゲーム内使用画像は主にVroidStudioで作成いたしました"}]}], "description": "「仕方なく! 仕方なくですからね!?」と言っていた巨乳人妻が快楽の沼に――寝取らせプレイから始まる淫蕩RPG!", "short_introduction": "「仕方なく! 仕方なくですからね!?」と言っていた巨乳人妻が快楽の沼に――寝取らせプレイから始まる淫蕩RPG!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01102514.html", "site_id": "maniax", "fetched_at": 1794952376}