amples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01106000/RJ01105758_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01106000/RJ01105758_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01106000/RJ01105758_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01106000/RJ01105758_img_smp4.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01106000/RJ01105758_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01106000/RJ01105758_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01106000/RJ01105758_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01106000/RJ01105758_img_smp4_100x100.jpg"], "alt": "リリンちゃんと課外授業! [softensoft]"}, "introductions": [{"type": "text", "title": "「先生ってゲーム下手なんだねぇー♪」", "body": [{"intro": "【メ○ガキなリリンちゃんを躾けるかもしれないSLG】<br />\r\n<br />\r\n　あなたは新学期から、クラスの担任の先生です。<br />\r\n　生徒の中には謎のメ○ガキがいるとの噂。<br />\r\n<br />\r\n　課外授業の内容を選択して、<br />\r\n　リリンちゃんを立派なメ○ガキに育てましょう!<br />\r\n<br />\r\n※「リリンちゃん」は、「Lusty*Kis〇 Production」様が提供されるキャラクターです。<br />\r\n　本作品は「リリンちゃん」の二次創作ゲームです。<br />\r\n※本作品は性的表現を含みます!<br />\r\n<br />\r\n<br />\r\n●イベント内容<br />\r\n　・ゲームの話<br />\r\n　・体を拭く<br />\r\n　・上着を脱ぐ<br />\r\n　・キスする<br />\r\n　……全42個<br />\r\n<br />\r\n<br />\r\n★クレジット★<br />\r\nCV:リリンちゃん@COEIROINK 様<br />\r\n立ち絵:ぱるとねる 様<br />\r\n<br />\r\n他素材はゲームフォルダ内の「readme」および<br />\r\nゲーム内スタッフロールでご確認ください。"}]}, {"type": "image_list", "title": "リリンちゃんと課外授業をしよう!", "body": [{"intro": "あなたは先生。<br />\r\nクラスのメ○ガキである『リリンちゃん』とお話することで、ステータスを上昇させましょう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01106000/RJ01105758/a6482978ef873fd96754e88f0676f3d6.jpg", "alt": "リリンちゃんと課外授業! [softensoft]", "title": "リリンちゃんと課外授業! [softensoft]"}}, {"intro": "ステータスは<br />\r\n『メ○ガキ度』<br />\r\n『露出度』<br />\r\n『淫乱度』の3つ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01106000/RJ01105758/6cc606a915f6ca92ea41b3b9e9a42d6b.jpg", "alt": "リリンちゃんと課外授業! [softensoft]", "title": "リリンちゃんと課外授業! [softensoft]"}}, {"intro": "基本はリリンちゃんとの会話シーンです。<br />\r\n進行するにつれて、Hなイベントが起きるかも!?", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01106000/RJ01105758/c5319a9a06a909f1372b55c3c11b5954.jpg", "alt": "リリンちゃんと課外授業! [softensoft]", "title": "リリンちゃんと課外授業! [softensoft]"}}, {"intro": "「この……っ、メ○ガキのくせに……!」<br />\r\n的な展開が見られるかも。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01106000/RJ01105758/bc83853e4f4008dc5408d900c3089a9e.jpg", "alt": "リリンちゃんと課外授業! [softensoft]", "title": "リリンちゃんと課外授業! [softensoft]"}}]}], "description": "【メ○ガキなリリンちゃんを躾けるかもしれないSLG】", "short_introduction": "【メ○ガキなリリンちゃんを躾けるかもしれないSLG】", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01105758.html", "site_id": "maniax", "fetched_at": 1794952300}