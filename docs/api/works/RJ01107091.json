ite.com/maniax/work/=/product_id/RJ01137621.html", "lang": ["ENG"]}, {"product_id": "RJ01140774", "edition_id": 18984, "display_label": "繁体中文", "dl_count": 156, "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01140774.html", "lang": ["CHI_HANT"]}], "rating": {"average": 4.16, "count": 406}, "review_count": 2, "dl_count": 1461, "wishlist_count": 4211, "ranking": [{"category": "all", "period": "day", "rank": 7, "date": "2023-10-26"}, {"category": "all", "period": "week", "rank": 32, "date": "2023-11-01"}, {"category": "all", "period": "month", "rank": 95, "date": "2023-11-13"}, {"category": "game", "period": "day", "rank": 5, "date": "2023-10-26"}, {"category": "game", "period": "week", "rank": 19, "date": "2023-11-01"}, {"category": "game", "period": "month", "rank": 36, "date": "2023-11-02"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01108000/RJ01107091_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01108000/RJ01107091_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01108000/RJ01107091_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01108000/RJ01107091_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01108000/RJ01107091_img_smp3.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01108000/RJ01107091_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01108000/RJ01107091_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01108000/RJ01107091_img_smp3_100x100.jpg"], "alt": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]"}, "introductions": [{"type": "text", "title": "怪獣×抵抗組織SLG", "body": [{"intro": "◆注意事項<br />\nこのゲームはDirectX 9.0が必要となります。<br />\n<a href=\"https://www.microsoft.com/ja-JP/download/details.aspx?id=35\" target=\"_blank\">https://www.microsoft.com/ja-JP/download/details.aspx?id=35</a><br />\n必ず体験版での動作確認をお願いします。<br />\n不具合の修正やバージョンアップなどで、内容を差し替える可能性があります。<br />\n再ダウンロードができるように、会員登録してからのご購入をできる限りお願いします。<br />\n<br />\n<br />\n◆あらすじ<br />\n核戦争後、数多くの水源と農地が放射線に汚染された。<br />\n財団と政治家たちは残された資源をコントロール、法令や税金制度などを利用して民衆から権利を奪い取る中、膨大な財力と権力を握った「カンパニー」は実質的に人類を支配していた。<br />\nそこな中とある自由の理想を抱く若いサイエンティストが率いる抵抗組織「解放戦線」は現実に屈せず「カンパニー」から人類を解放しようとしていた。<br />\n<br />\n◆ゲームの内容<br />\n怪獣×抵抗組織SLG<br />\nプレイヤーは抵抗組織のリーダーとして組織を指揮して、怪獣を捕獲・育成・改造をして<br />\n政府軍やカンパニーと戦います。<br />\nサイコキネシスを持つ謎の少女、改造人間の幼馴染、スーパーハッカーのお姉さんなど魅力的な女性キャラクターも次々と登場します。<br />\n<br />\nテキスト量　4万文字程度<br />\n基本CG35程度+戦闘中の服破れ<br />\n一部のシーンはアニメーションで演出<br />\n<br />\n<br />\n――キャスト――<br />\nフブキ:そらまめ。<br />\nアイリス:森野めぐむ<br />\n柚香:涼貴涼<br />\nシャドウ:暁鞠子<br />\nアミ―:口谷亜夜<br />\nレディア:本多未季<br />\nタリナ:篠守ゆきこ"}]}, {"type": "image_list", "title": "エロシーンの半分以上はアニメーションで演出", "body": [{"intro": "搾取", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01108000/RJ01107091/79a28758cf9925c393cf17fbe399330c.jpg", "alt": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]", "title": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]"}}, {"intro": "エッチな日常", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01108000/RJ01107091/5419c6be9a4ae3bff1296c302403ce69.jpg", "alt": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]", "title": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]"}}, {"intro": "敵撃破", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01108000/RJ01107091/071fbf7d7d01cad4c35ecf899a677284.jpg", "alt": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]", "title": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]"}}, {"intro": "ワクチン作戦", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01108000/RJ01107091/b6993a5399f0104aebef30ec454dbe00.jpg", "alt": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]", "title": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]"}}]}, {"type": "image_list", "title": "メインキャラクター", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01108000/RJ01107091/ead9a4529055b3d0bf9ea2d53ed3f947.jpg", "alt": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]", "title": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]"}}, {"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01108000/RJ01107091/a3c6f7088abfe9ff1245c1bd1925b589.jpg", "alt": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]", "title": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]"}}, {"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01108000/RJ01107091/15ea7de4b3234ec65d67bf11ceb58502.jpg", "alt": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]", "title": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]"}}, {"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01108000/RJ01107091/f648cdd57fb3b8b1582c4b24a9217bb8.jpg", "alt": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]", "title": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]"}}]}, {"type": "image", "title": "ヴァルキュリア部隊", "body": [{"intro": "ヴァルキュリアは防衛軍に属する特殊戦闘ユニット。<br />\n彼女たちはサイコエネルギーで大型念写体を作り出し、<br />\n怪獣と戦う力を持っている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01108000/RJ01107091/756de007cf5c179d7fa8c5179ee2ae52.jpg", "alt": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]", "title": "DxR-明日が良い日になりますように- v1.03 [MaraStudio]"}, "position": "left"}]}], "description": "怪獣×抵抗組織SLG", "short_introduction": "怪獣×抵抗組織SLG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01107091.html", "site_id": "maniax", "fetched_at": 1794952234}