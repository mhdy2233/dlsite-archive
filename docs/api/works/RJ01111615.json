/img.dlsite.jp/modpub/images2/parts/RJ01112000/RJ01111615/d8326a742ff667b147046279f8f5e9b3.jpg", "alt": "エロガキ学級の使いっぱしりクソ雑魚せんせーRPG [ethyl alcohol]", "title": "エロガキ学級の使いっぱしりクソ雑魚せんせーRPG [ethyl alcohol]"}, "position": "under"}]}, {"type": "image", "title": "♦白崎沙羅", "body": [{"intro": "外面は良いが実際の性格はかなりの天邪鬼<br />\r\n成績はとても良く大人達からの信頼も厚い<br />\r\n好きな子にちょっかいかけるタイプ", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01112000/RJ01111615/32554716f6f5ec12e2284a33bab13a48.jpg", "alt": "エロガキ学級の使いっぱしりクソ雑魚せんせーRPG [ethyl alcohol]", "title": "エロガキ学級の使いっぱしりクソ雑魚せんせーRPG [ethyl alcohol]"}, "position": "under"}]}, {"type": "image", "title": "♦南花燐", "body": [{"intro": "自由奔放で少しアホだと思われがち<br />\r\n実際は関心が余りにもないのが原因<br />\r\n運動が好きで人懐っこいが難しい話などが右の耳から左の耳", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01112000/RJ01111615/1305f60aa949a7b4cc6a5f1fa38e7a6e.jpg", "alt": "エロガキ学級の使いっぱしりクソ雑魚せんせーRPG [ethyl alcohol]", "title": "エロガキ学級の使いっぱしりクソ雑魚せんせーRPG [ethyl alcohol]"}, "position": "under"}]}, {"type": "image", "title": "♦一瀬陽葵", "body": [{"intro": "何考えてるかわからないと言われがち<br />\r\n少し静か目な性格で良識持ちだが常識が外れてる<br />\r\n1人でフラフラとどこかへ行く事が多い", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01112000/RJ01111615/0e8e6d225af10a60caf556613bb1848c.jpg", "alt": "エロガキ学級の使いっぱしりクソ雑魚せんせーRPG [ethyl alcohol]", "title": "エロガキ学級の使いっぱしりクソ雑魚せんせーRPG [ethyl alcohol]"}, "position": "under"}]}], "description": "学校探索型メ○ガキ逆転無し判らせられRPG", "short_introduction": "学校探索型メ○ガキ逆転無し判らせられRPG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01111615.html", "site_id": "maniax", "fetched_at": 1794952243}