umb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01123000/RJ01122226_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01123000/RJ01122226_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01123000/RJ01122226_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01123000/RJ01122226_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01123000/RJ01122226_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01123000/RJ01122226_img_smp5.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01123000/RJ01122226_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01123000/RJ01122226_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01123000/RJ01122226_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01123000/RJ01122226_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01123000/RJ01122226_img_smp5_100x100.jpg"], "alt": "エルフと秘密のオーク村 [きょうりゅうらんど]"}, "introductions": [{"type": "image", "title": "ゲームのながれ", "body": [{"intro": "とあることをきっかけに、オーク村に通うことになったレイラ。<br />\n平日はバイトをしてお金を稼ぎ、週末にオーク村へ向かうのがこのゲームのながれとなります。<br />\nオーク村に通い、さまざまなことをすることでエッチなステータスが上昇。<br />\nこのステータスをあげることで、さまざまなイベントが解放されていきます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01123000/RJ01122226/48c1c2b112d41879909bb878c8c9f83a.jpg", "alt": "エルフと秘密のオーク村 [きょうりゅうらんど]", "title": "エルフと秘密のオーク村 [きょうりゅうらんど]"}, "position": "left"}]}, {"type": "image", "title": "バイトで資金調達!", "body": [{"intro": "オーク村に通うには結構な額のお金が必要です。<br />\nそのため、さまざまな手段でお金を手に入れる必要があります。<br />\nこのゲームの基本的な金策として平日のバイトがあります。<br />\n平日に指定の場所やメニュー画面からバイトを選択し、必要な資金をサクッと稼ぎましょう!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01123000/RJ01122226/f0432166d15cd4790932518b12d89b55.jpg", "alt": "エルフと秘密のオーク村 [きょうりゅうらんど]", "title": "エルフと秘密のオーク村 [きょうりゅうらんど]"}, "position": "left"}]}, {"type": "image", "title": "冒険やカジノで勝負!", "body": [{"intro": "金策はバイトだけではありません。<br />\nエルフの村には、魔法により仮想空間で冒険(クエスト)をできる施設とギャンブルができる施設があります。<br />\nクエストで手に入れたアイテムを売ったり、ギャンブルで一攫千金を夢みたりと、バイトでは得られない金額を手に入れるチャンスもあります。<br />\n「手堅くバイト」「クエストやカジノで遊びながら稼ぐ」あなたのスタイルにあった稼ぎ方でお金をどんどん稼いでみてください!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01123000/RJ01122226/02bf38dd2aea87706fb6f108e1756eee.jpg", "alt": "エルフと秘密のオーク村 [きょうりゅうらんど]", "title": "エルフと秘密のオーク村 [きょうりゅうらんど]"}, "position": "left"}]}, {"type": "image", "title": "どんどん過激になるプレイ内容", "body": [{"intro": "•ギャラリーモード搭載(各イベント終了後解放)<br />\n•ギャラリーでは「イベント回想」、「静止画(擬音あり)」「静止画(擬音なし)」の閲覧が可能!<br />\n•Hイベント1つにつき、平均差分30枚超えのボリューム(+オノマトペ差分も有り)<br />\n•総差分枚数は450枚超(※オノマトペ差分をいれれば900枚超)", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01123000/RJ01122226/0a3ae85a26fc3fc08dfe08efa7fd5290.jpg", "alt": "エルフと秘密のオーク村 [きょうりゅうらんど]", "title": "エルフと秘密のオーク村 [きょうりゅうらんど]"}, "position": "left"}]}, {"type": "image", "title": "基本CG情報", "body": [{"intro": "•Hイベントの基本CG14枚<br />\n•どんどん過激になるプレイ内容<br />\nはじめはエッチなマッサージから始まり、レイラが成長することにより緊縛や三角木馬、まんぐりがえしでのレズプレイ、触手責めとどんどん過激によりエッチなプレイをすることに。純粋無垢な少女レイラが強烈な刺激の快感に堕ちていく姿を是非チェックしてみてください!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01123000/RJ01122226/fa0ad097b81deb34f09811bfdd708852.jpg", "alt": "エルフと秘密のオーク村 [きょうりゅうらんど]", "title": "エルフと秘密のオーク村 [きょうりゅうらんど]"}, "position": "left"}]}, {"type": "image", "title": "知るべきではなかった村", "body": [{"intro": "【ストーリー】<br />\r\nエルフのレイラは、レイラが住むエルフ村のトップ、ラナがオークにさらわれる現場を目撃する。救出のためにオーク達を追いかけるとオークの村に辿り着いた。ラナを発見し救出しようとするが、その救出劇はレイラの思いもしない結果となった……。<br />\r\n<br />\r\nレイラはそこに足を踏み入れるべきではなかった。その村の存在を知ってから、彼女は少しづつ道を踏み外すことになる……。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01123000/RJ01122226/3c49dc73bb4354cf5108da116b54d9f2.jpg", "alt": "エルフと秘密のオーク村 [きょうりゅうらんど]", "title": "エルフと秘密のオーク村 [きょうりゅうらんど]"}, "position": "left"}]}], "description": "オークの村で純粋なエルフのレイラが寝とられ、いけない快感に染まり溺れていくRPG", "short_introduction": "オークの村で純粋なエルフのレイラが寝とられ、いけない快感に染まり溺れていくRPG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01122226.html", "site_id": "maniax", "fetched_at": 1794951878}