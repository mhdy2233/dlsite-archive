ttps://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136594_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136594_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136594_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136594_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136594_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136594_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136594_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136594_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136594_img_smp9.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136594_img_smp10.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136594_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136594_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136594_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136594_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136594_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136594_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136594_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136594_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136594_img_smp9_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136594_img_smp10_100x100.jpg"], "alt": "無限ダンジョン無限レベルアップ [しろよもぎ工房]"}, "introductions": [{"type": "text", "title": "ゲーム概要", "body": [{"intro": "『無限ダンジョン無限レベルアップ』は、ひたすらレベルを上げるゲームです。<br />\n好みのキャラをパーティに入れて、思う存分、強化してあげてください。<br />\nレベル上げに疲れたら、ペット育成やマイホーム購入、結婚などのスローライフも可能です。"}]}, {"type": "image", "title": "無限に続くダンジョンとキャラの成長", "body": [{"intro": "ダンジョンは自動生成され、進むごとに敵の強さや貰える経験値が上がって行きます。<br />\n比較的、単純構造の為サクサク進めて、レベルもサクサク上がります。<br />\n一部の装備はダンジョンの到達階層とリンクして強化されて行くので、楽しく進めるでしょう。<br />\n<br />\n※厳密には上限があり、キャラレベルは10億・各ステータスは9.999,999、ダンジョン階層も何れはオーバーフローしてしまうのですが、一気に飛ばして上がることはないので、恐らく一生かかっても上限には辿り着けないはずです。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136594/a97f5506befa919202701dce294e46db.jpg", "alt": "無限ダンジョン無限レベルアップ [しろよもぎ工房]", "title": "無限ダンジョン無限レベルアップ [しろよもぎ工房]"}, "position": "left"}]}, {"type": "image", "title": "変えれる難易度・ストレスフリーな設計", "body": [{"intro": "標準の難易度としては、雑魚は楽勝、ボスは少し歯ごたえ有りの難易度になっていますが、物足りない方の為に、ハードモード・ベリーハードをご用意しました。<br />\n※難易度は町で、いつでも変更可<br />\n<br />\n全滅してもペナルティなし。すぐに探索していた階層に戻れます。<br />\nダンジョン内でもセーブが可能なので、ちょっとした合間でも気軽に楽しめます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136594/21f54efa23a200ada3ea8be3d49a932b.jpg", "alt": "無限ダンジョン無限レベルアップ [しろよもぎ工房]", "title": "無限ダンジョン無限レベルアップ [しろよもぎ工房]"}, "position": "left"}]}, {"type": "image", "title": "スローライフも送れる", "body": [{"intro": "マイホームを持ち、仲良くなった仲間と結婚して、家庭を持つことも出来ます。<br />\n※結婚は同性同士でも可能。<br />\n<br />\n離婚もできる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136594/2940b8d5628499f9cc71637a09482759.jpg", "alt": "無限ダンジョン無限レベルアップ [しろよもぎ工房]", "title": "無限ダンジョン無限レベルアップ [しろよもぎ工房]"}, "position": "left"}]}, {"type": "image", "title": "ペットの育成", "body": [{"intro": "トレーニングによるレベル上げ。<br />\n強くなったら、自分の代わりにダンジョンへ派遣することも。<br />\n単なるオマケ要素ではなく、こちらも無限に遊べます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136594/2811890d2b5c745cc975220ea04dc415.jpg", "alt": "無限ダンジョン無限レベルアップ [しろよもぎ工房]", "title": "無限ダンジョン無限レベルアップ [しろよもぎ工房]"}, "position": "left"}]}, {"type": "text", "title": "", "body": [{"intro": "▼ながら遊び推奨<br />\n無限に遊べるとは言っても、何事にも飽きは来ます。<br />\n特に本作品は作業ゲーの為、テレビやネット動画を見ながらなど、片手間にプチプチを潰すのと同じ感覚でプレイすると長く楽しめます。<br />\n<br />\n<br />\n■ゲームの動作環境■<br />\nOSが対応しているならスペックが低くても遊べますが、念の為に体験版で動作確認をお願いします。<br />\n<br />\n■AIの利用■<br />\nタイトルの背景にのみAI商用素材を使用しております。"}]}], "description": "無限に続くダンジョンと無限に成長するキャラで、無限に遊べる!!", "short_introduction": "無限に続くダンジョンと無限に成長するキャラで、無限に遊べる!!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01136594.html", "site_id": "home", "fetched_at": 1794951616}