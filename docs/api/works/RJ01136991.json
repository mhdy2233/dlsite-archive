{"id": "RJ01136991", "title": "きらめきForteen-2D", "title_romaji": "kiramekifwoothiintsuudhii", "circle": {"id": "RG43700", "name": "megabi", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG43700.html"}, "type": {"code": "ADV", "name": "アドベンチャー", "category": "game"}, "category": "doujin", "age": "all", "sex": 1, "price": {"jpy": 1650, "official_jpy": 1650, "currencies": {"USD": 10.340101608731809, "EUR": 9.396483778821578, "GBP": 7.839977040746024, "TWD": 340.8879614899903, "CNY": 69.04776850166343, "KRW": 13807.531380753138, "IDR": 189003.43642611685, "VND": 266129.03225806454, "THB": 350.4003058039033, "SEK": 104.37819065150968, "HKD": 81.14009205712263, "SGD": 13.32618296122323, "CAD": 14.783025502958845, "MYR": 42.34037038842799, "BRL": 58.835275491720274, "AUD": 15.330412192973654, "PHP": 660.8988223984619, "MXN": 191.81808670177517, "NZD": 18.781330674352215, "INR": 971.3882020487459}}, "point": {"point_amount": 90, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1705503600, "file": {"type": "EXE", "size": 1009862830}, "tags": [{"key": "073", "name": "アニメ"}, {"key": "240", "name": "魔法少女"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": null, "count": null}, "review_count": 0, "dl_count": 1, "wishlist_count": 9, "ranking": [], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136991_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136991_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136991_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136991_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136991_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136991_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136991_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136991_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136991_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136991_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136991_img_smp9.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01137000/RJ01136991_img_smp10.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136991_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136991_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136991_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136991_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136991_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136991_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136991_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136991_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136991_img_smp9_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01137000/RJ01136991_img_smp10_100x100.jpg"], "alt": "きらめきForteen-2D [megabi]"}, "introductions": [{"type": "image", "title": "クスミときらめきの力～ごあいさつ～", "body": [{"intro": "ようこそお越しくださいました。作者でMegabiの代表せんけんと申します。<br />\r\n<br />\r\n僕は大学時代に夢を抱き、一人北海道から関東圏(千葉)に住み、様々な体験を味わった後、身内や心の問題など複数の事情から都落ちしました。<br />\r\n<br />\r\n劣等感と自己否定と絶望に苦しみながらも、己の進路を振り返り、あらゆる勉強をやり直して心の土台を築き上げていくうち、<br />\r\n<br />\r\n「脳内にある作品を形にし、みんなと面白さを分かち合いたい」<br />\r\n<br />\r\n気持ちを抱いたのです。<br />\r\nかつてサウンドノベルで作った未完成の物語を、2Dアクションゲームという形で完成させました。<br />\r\n<br />\r\nきらめきForteenはキラメキの力を授かった4人の少女たちが、力を合わせてクスミを浄化していく2D魔法少女アクションゲームです。<br />\r\n<br />\r\n時に罠にかかりながら、時に変なイベントが起きても、決して止めることなく進んでいただき、言葉で表現しがたい世界を味わってください。<br />\r\n<br />\r\nまずは体験版をダウンロードし、エラーなく気軽にできるかどうかを確かめていただきたい。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136991/defb384db1742434025d02f470c7af0a.jpg", "alt": "きらめきForteen-2D [megabi]", "title": "きらめきForteen-2D [megabi]"}, "position": "over"}]}, {"type": "image_list", "title": "ゲームの展開～物語の進み方～", "body": [{"intro": "キラメキForteenは1話形式となっています。各話ごとに物語のOP/EDがあり、事件が起きたり何事もなく始まるのです。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136991/7fff037b4bee50990263d95e9f005bcb.jpg", "alt": "きらめきForteen-2D [megabi]", "title": "きらめきForteen-2D [megabi]"}}, {"intro": "OPが終わりますと、マップでの移動シーンとなります。マップでは本編につながる扉をはじめ、本編に関係ない小話など、ステージとお話が詰まっています。<br />\r\n部屋に入って誰かと話をしたり、隠し部屋を見つけたりと、何かあるかも?", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136991/8be360c0850b8372df5cd117ba001f3b.jpg", "alt": "きらめきForteen-2D [megabi]", "title": "きらめきForteen-2D [megabi]"}}, {"intro": "鍵を使って扉を開けると、話が始まった後、ステージが始まります。ステージには変な敵、落とし穴、そして意地悪な仕掛けに注意しながら進みましょう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136991/6744ead1afaed51bb8ded475fdf3df55.jpg", "alt": "きらめきForteen-2D [megabi]", "title": "きらめきForteen-2D [megabi]"}}, {"intro": "本編にてステージの終わりにはボスが控えています。変な攻撃をしてくるので、交わしながらキラメキの力を与え、クスミを浄化だ!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136991/aea1b1206fa1953b183f45643d9bec8d.jpg", "alt": "きらめきForteen-2D [megabi]", "title": "きらめきForteen-2D [megabi]"}}]}, {"type": "image", "title": "物語のあらすじ", "body": [{"intro": "「夜空を見てみて。虹がかかっているよ。<br />\r\n夜空に虹が見えたら、キラメキの力を持った時だよ」<br />\r\n<br />\r\n「本当だ、夜なのに虹が見える」<br />\r\n「虹なんて見えねーよ」<br />\r\n<br />\r\n翌日、声に導かれるまま、少女たちはキラメキの力を得た少女たち。<br />\r\n想いをゆがめる存在クスミを浄化し、きらめきの力で中和していく。<br />\r\n<br />\r\nここからは登場人物などの紹介を、<br />\r\nラムリ(語尾が「のら」)、ハルヒ(語尾が「なの～」)に任せるね。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136991/c480ce14723a261e77ba616ee664b9d0.jpg", "alt": "きらめきForteen-2D [megabi]", "title": "きらめきForteen-2D [megabi]"}, "position": "over"}]}, {"type": "image_list", "title": "登場人物と特徴-メイン-", "body": [{"intro": "シルフェン(明日谷萌香)<br />\r\nシルフェンは4人の中で最も早く移動でき、幅広く飛べるのら。ただブレーキをかけないと、いつまでも止まらないのら。<br />\r\n<br />\r\n明日谷萌香ちゃんは優しくて、お姉ちゃんにのみつっかかってくるの～。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136991/4578aa27efdf085adab4ad20e9b03276.jpg", "alt": "きらめきForteen-2D [megabi]", "title": "きらめきForteen-2D [megabi]"}}, {"intro": "ウンディーヌ(明日谷沙良)<br />\r\nウンディーヌは威力の高い魔法ボールを繰り出し、敵の砲弾すら無効化できるのら(ただし、魔法は時々失敗するのら)<br />\r\n<br />\r\n明日谷沙良ちゃんは萌香ちゃんの二つ上のお姉さんで、優しいけど、時々一人笑いを浮かべて怖いところがあるの～", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136991/11f461a2770866158d1083b25fb4f28e.jpg", "alt": "きらめきForteen-2D [megabi]", "title": "きらめきForteen-2D [megabi]"}}, {"intro": "サラマンジュ(古谷澪)<br />\r\nサラマンジュは4人の中で足が遅いけど、攻撃力が最も高いの～。また最も高く飛べるの～<br />\r\n<br />\r\n澪ちゃんは澄ちゃんと双子でお姉さんなのら。ポニーテール以外特徴ないのら。澄ちゃんとそろってにぎやかな子なのら。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136991/6faa7c2e726d4bdad14a8da33af1711c.jpg", "alt": "きらめきForteen-2D [megabi]", "title": "きらめきForteen-2D [megabi]"}}, {"intro": "ノーマン(古谷澄)<br />\r\nノーマンは銃を放ち、歩く速さ本部力も平均なの～。4人の中で攻撃力が最も低いの～。<br />\r\n<br />\r\n澄ちゃんは澪ちゃんと双子で妹なのら。ツインテール以外特徴ないのら。澪ちゃんと一緒に同じセリフを発するの、さすが双子なのら。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136991/0d0f7e0a7c9b04d6c7ff3acee7c27f72.jpg", "alt": "きらめきForteen-2D [megabi]", "title": "きらめきForteen-2D [megabi]"}}]}, {"type": "image_list", "title": "登場人物と特徴-サブ-", "body": [{"intro": "ラムリ:小鳥の妖精<br />\r\nラムリなの～。ボーナスステージで空を飛ぶの～<br />\r\nラムリは時々皮肉を言うところがあるの～この前萌香ちゃんの友達に「嫌いなのら」いったら、殴られたの～<br />\r\nラムリ「あの時は本当、痛かったのら」", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136991/661c3d9eb6d67d5bce1c0af31b996091.jpg", "alt": "きらめきForteen-2D [megabi]", "title": "きらめきForteen-2D [megabi]"}}, {"intro": "ハルヒ:リスの妖精<br />\r\nハルヒはボーナスステージにて走るのら。<br />\r\nハルヒは子供っぽいところがあって、古谷家で飼ってる犬「清(きよし)」と仲良し、普通に喋っているのら。<br />\r\nハルヒ「恵麻おばあちゃんといつも散歩にいってるの～」", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136991/2c2d5e0c9724ff5b3843c9dce809a11a.jpg", "alt": "きらめきForteen-2D [megabi]", "title": "きらめきForteen-2D [megabi]"}}, {"intro": "明日谷奈々子<br />\r\n明日谷家の次女でセーブ担当。奈々子にはきらめきの力などないのら。明日谷家で唯一、ラムリやハルヒが見えないのら。萌香ちゃんにはからかわれて、沙良ちゃんには優しくしてもらっているのら。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136991/f6587882eeffc727b8f00a06f87f0968.jpg", "alt": "きらめきForteen-2D [megabi]", "title": "きらめきForteen-2D [megabi]"}}, {"intro": "ヒサイン<br />\r\nクスミを出す、きらめきの敵なの～。なんか奈々子(隣)に似てるの～<br />\r\nヒサイン「ちょっと、それだけ?　もっとこう美人でセクシーで……とにかく私は敵よ、きらめきフォーティーンの敵!!」", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136991/f8a192961a9d2c9b76ce4549ab21ed7b.jpg", "alt": "きらめきForteen-2D [megabi]", "title": "きらめきForteen-2D [megabi]"}}]}, {"type": "image_list", "title": "収録しているお話の一部", "body": [{"intro": "明日谷姉妹の母親はアイドルなのら。4人を鍛えようとしたとき、ああ、クスミが現れたのら。みんな無理やりスポーツさせているのら。健康になった人もいれば、運転中に動かされて事故が起きてしまったのら!<br />\r\nあ、あ、ああああ、怖いものを見てしまったのら、決してこの画像の人をバ……", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136991/effaeb7932c423574ec72c4bc9efc952.jpg", "alt": "きらめきForteen-2D [megabi]", "title": "きらめきForteen-2D [megabi]"}}, {"intro": "夢の国、アルムの世界にはいろんな人がいるの～。この子がいきなりステージを作って、キラメキフォーティーンに挑んできたの～。って「この子」なんて書くの、失礼なの～だってこの人……<br />\r\nあ、そうそう、あんな最後の最後に罠を仕掛けるなんて、本当にひどいの～", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136991/ae58906e3b497b38c1adf32b6bc84cc9.jpg", "alt": "きらめきForteen-2D [megabi]", "title": "きらめきForteen-2D [megabi]"}}, {"intro": "夢の国、アルムの世界にはいろんなものがあるの～。そこに一冊の本があって、本から「勇者、賢者、魔王の子、ついでに大怪獣」も現れたの～って、ひいい、飲み込まれたの～そして本当の怖い出来事は怪獣の前に現れた……", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136991/3ba755c70c17c47bfe70161e6c87dc8d.jpg", "alt": "きらめきForteen-2D [megabi]", "title": "きらめきForteen-2D [megabi]"}}, {"intro": "「大きな存在」から、きらめきの力を授かろうとしたとき、ヘンテコ仮面野郎が邪魔をしてきたのら。<br />\r\n???「誰がへんてこ仮面だ。おい、僕の名前は……」<br />\r\n今ラムリがしゃべってるから黙ってろ……痛いのら!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01137000/RJ01136991/d72ba12881efe2346cf5df552f929f25.jpg", "alt": "きらめきForteen-2D [megabi]", "title": "きらめきForteen-2D [megabi]"}}]}], "description": "クスミに染められた世をキラメキの力で浄化だ!", "short_introduction": "クスミに染められた世をキラメキの力で浄化だ!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01136991.html", "site_id": "home", "fetched_at": 1794951739}