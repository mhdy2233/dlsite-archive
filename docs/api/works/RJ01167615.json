ll", "period": "month", "rank": 5, "date": "2025-05-24"}, {"category": "all", "period": "year", "rank": 79, "date": "2025"}, {"category": "game", "period": "day", "rank": 1, "date": "2025-04-26"}, {"category": "game", "period": "week", "rank": 4, "date": "2025-04-29"}, {"category": "game", "period": "month", "rank": 4, "date": "2025-05-24"}, {"category": "game", "period": "year", "rank": 46, "date": "2025"}, {"category": "game", "period": "total", "rank": 410, "date": "2026-06-09"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01168000/RJ01167615_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01168000/RJ01167615_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01168000/RJ01167615_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01168000/RJ01167615_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01168000/RJ01167615_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01168000/RJ01167615_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01168000/RJ01167615_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01168000/RJ01167615_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01168000/RJ01167615_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01168000/RJ01167615_img_smp8.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01168000/RJ01167615_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01168000/RJ01167615_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01168000/RJ01167615_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01168000/RJ01167615_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01168000/RJ01167615_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01168000/RJ01167615_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01168000/RJ01167615_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01168000/RJ01167615_img_smp8_100x100.jpg"], "alt": "PIXEL CALL GIRLS -REI- [Milk Engine]"}, "introductions": [{"type": "text", "title": "爆乳風俗巫女ぬるぬるエッチアニメ風俗シミュレータ！", "body": [{"intro": "[English/Japanese]<br />\r\n<br />\r\nMilkEngine謹製のぬるぬる動くドット絵ループアニメーション閲覧を主軸としたえっちゲームです。<br />\r\nアニメプレイヤーと若干のノベルゲーム要素を備えた「ピクセルコールガールエンジン」による第一弾アプリケーションとなります。<br />\r\n<br />\r\n今回は無愛想ながらもお仕事に忠実な爆乳風俗嬢「レイ」による多彩なプレイアニメーションを収録しています。"}]}, {"type": "image", "title": "キャラクター紹介", "body": [{"intro": "レイ<br />\r\n<br />\r\nダウナーで塩対応な印象を受けるデリヘル嬢。<br />\r\nバスト131cmの超乳だが店では中堅レベル。<br />\r\nしかし仕事には忠実で金額分はちゃんと働く。<br />\r\nキス以外なら意外といろいろなプレイを了承してくれる。<br />\r\n最初はお店のルールを突きつける冷淡な態度が目立つものの、何度も指名すると徐々に変化が……?", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01168000/RJ01167615/874bf23bb98c858ed8b279f33ea54750.jpg", "alt": "PIXEL CALL GIRLS -REI- [Milk Engine]", "title": "PIXEL CALL GIRLS -REI- [Milk Engine]"}, "position": "left"}]}, {"type": "image", "title": "風俗の雰囲気体験とシンプルなプレイヤー、どちらも楽しめる！", "body": [{"intro": "「コールモード」では、限られた時間の中で希望するプレイを選択し、彼女と会話しながらプレイアニメを楽しむことに主眼を置いたモードです。<br />\r\n「フリーモード」では、コールモードで見たことのあるアニメーションを楽しめます。<br />\r\n<br />\r\n(手っ取り早く全部見たければチートも……)", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01168000/RJ01167615/ee25a982723b23477557969f7bfd804d.jpg", "alt": "PIXEL CALL GIRLS -REI- [Milk Engine]", "title": "PIXEL CALL GIRLS -REI- [Milk Engine]"}, "position": "over"}]}, {"type": "image", "title": "こだわりのドットアニメーションと、レトロな雰囲気を盛り上げるフィルター！", "body": [{"intro": "本作では、MilkEngine藤原がライフワークとして制作している「ドット仕上げのLive2D風ぬるぬるえっちアニメ」をこれでもかと搭載。<br />\nメインループとカットイン演出をあわせてプレイ開始から射精、事後までを演出。<br />\n256x224ピクセルというレトロな解像度にこだわり、ブラウン管やGB風、デジタル8色、1bit化など様々なフィルターとともに「レトロな表現」「最新のアニメ技法」の融合に努めました。<br />\nもちろんくっきりとした本来の画質でじっくり鑑賞するも自由！<br />\n<br />\n現在収録済のアニメ<br />\n<br />\n・立ち絵<br />\n・横視点蹲踞手コキ・亀頭キス・フェラ(口内射精)<br />\n・主観皮ひっぱり先っぽ舐めフェラ(ぶっかけ)<br />\n・主観パイズリ(狭射・ぶっかけ)<br />\n・背面側位(中出し)<br />\n・主観バック(中出し)<br />\n・お風呂抱き手コキ(射精)<br />\n・事後(中出し・ぶっかけ・口内射精・狭射、お風呂)<br />\n<br />\n★2025/8/20追加<br />\n・パイズリフェラ(口内射精)<br />\n・馬乗りパイズリ(狭射・ぶっかけ)<br />\n・種付けプレス(中出し)<br />\n<br />\n★2025/10/30追加<br />\n・騎乗位(中出し)<br />\n・サナのフェラ(口内射精)<br />\n・サナとのダブルパイズリ(挟射・ぶっかけ)<br />\n<br />\n★2025/11/30追加(サナ体験版分)<br />\n・サナのお風呂手コキ<br />\n・サナの手コキ<br />\n・サナの寝バック<br />\n<br />\n★2026/06/16追加<br />\n・主観フェラ(4日目)<br />\n・おまけアート<br />\n<br />\n★2026/09/06追加<br />\n・おさわり機能付き立ち絵<br />\n<br />\n★2026/10/26追加<br />\n・立ち絵にぶっかけ可能(クリア後)", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01168000/RJ01167615/5e6f30846c1b35ecdedaca224a39a1d1.jpg", "alt": "PIXEL CALL GIRLS -REI- [Milk Engine]", "title": "PIXEL CALL GIRLS -REI- [Milk Engine]"}, "position": "under"}]}, {"type": "image", "title": "アップデートによりサナが顔見せ！", "body": [{"intro": "2025年10月末アップデートにより次回作の主役となる嬢「サナ」もちらっと登場。<br />\n2輪車キャンペーンでレイに付いてきた彼女によるシーンを少しだけ先取り！<br />\n(レイ5日目として実装されています。)<br />\n<br />\n2025年11月末アップデートにより、サナ本編の体験版も付属してさらにボリュームアップしました！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01168000/RJ01167615/7eee106f6f05c32d2fc11028afcc1210.jpg", "alt": "PIXEL CALL GIRLS -REI- [Milk Engine]", "title": "PIXEL CALL GIRLS -REI- [Milk Engine]"}, "position": "left"}]}, {"type": "image", "title": "アップデート・キャラ追加も予定中！", "body": [{"intro": "アニメーション追加や、演出・機能面のさらなる充実を予定しています！<br />\n<br />\n・プレイ追加(ゴム系プレイetc...)<br />\n・プレイリスト編集機能<br />\n・レイの追加シナリオ<br />\n・ボイス演出<br />\n・Mac、Android対応<br />\n・モバイル用動画形式バージョンの収録<br />\n<br />\nそして、さらなるキャラクター追加もいずれ……！<br />\n<br />\n★実現済み<br />\n・プレイ追加第一弾(パイズリフェラ・馬乗りパイズリ・種付けプレス)<br />\n・プレイ追加第二弾(騎乗位・サナフェラ・サナとのダブルパイズリ)<br />\n・Android版APK(ベータ)追加", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01168000/RJ01167615/f33bce8b9e70f337196bf4d52ec0d2fd.jpg", "alt": "PIXEL CALL GIRLS -REI- [Milk Engine]", "title": "PIXEL CALL GIRLS -REI- [Milk Engine]"}, "position": "left"}]}], "description": "ぬるぬるドット絵アニメで表現される爆乳えっちアニメ集。どこかで見た巫女さんとのデリヘル体験ゲーム風味を添えて。", "short_introduction": "ぬるぬるドット絵アニメで表現される爆乳えっちアニメ集。どこかで見た巫女さんとのデリヘル体験ゲーム風味を添えて。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01167615.html", "site_id": "maniax", "fetched_at": 1794948741}