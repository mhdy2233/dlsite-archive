y": "all", "period": "month", "rank": 1, "date": "2026-07-05"}, {"category": "all", "period": "total", "rank": 247, "date": "2026-11-17"}, {"category": "game", "period": "day", "rank": 1, "date": "2026-06-13"}, {"category": "game", "period": "week", "rank": 1, "date": "2026-06-14"}, {"category": "game", "period": "month", "rank": 1, "date": "2026-07-05"}, {"category": "game", "period": "total", "rank": 216, "date": "2026-11-17"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01178000/RJ01177942_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01178000/RJ01177942_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01178000/RJ01177942_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01178000/RJ01177942_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01178000/RJ01177942_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01178000/RJ01177942_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01178000/RJ01177942_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01178000/RJ01177942_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01178000/RJ01177942_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01178000/RJ01177942_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01178000/RJ01177942_img_smp9.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01178000/RJ01177942_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01178000/RJ01177942_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01178000/RJ01177942_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01178000/RJ01177942_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01178000/RJ01177942_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01178000/RJ01177942_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01178000/RJ01177942_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01178000/RJ01177942_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01178000/RJ01177942_img_smp9_100x100.jpg"], "alt": "復讐の夜霧 [beebee工房]"}, "introductions": [{"type": "text", "title": "本作について", "body": [{"intro": "【R-18表現】<br />\n・エネミーに捕縛されてからの、腹パン、スパンキング、首絞め、プロレス技、触手攻め、産卵、妊娠、出産など、主人公　を辱める表現がメインです。<br />\n・主人公の状態異常により、多彩にHシーンが分岐するのが本作の特徴となっております。<br />\n<br />\n【2Dアクション】<br />\n・キーボードで遊べる、シンプル操作と爽快感を両立させたアクションとして設計しています。<br />\n・「キーを押しっぱなしででるコンボ&amp;空中コンボ」「出かかり無敵ダッシュ」「高威力のダッシュ攻撃」「2種の特殊攻撃」を駆使し道を切り開きます。<br />\n・是非、体験版にて手触りをお確かめください。<br />\n<br />\n【アップデート計画】<br />\n・各種調整<br />\n・エネミー追加<br />\n・エリア拡張<br />\n・断面図追加(ONOFF機能込み)<br />\n～予定"}]}, {"type": "image_list", "title": "Hシーンの流れ", "body": [{"intro": "敵の攻撃を受け続けると・・・", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01178000/RJ01177942/c0d462661fa7d5242b9e9989bb12b5e9.jpg", "alt": "復讐の夜霧 [beebee工房]", "title": "復讐の夜霧 [beebee工房]"}}, {"intro": "忍衣が破壊され脱衣状態に。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01178000/RJ01177942/8f4796b53026bb6dc686aa2b35987a76.jpg", "alt": "復讐の夜霧 [beebee工房]", "title": "復讐の夜霧 [beebee工房]"}}, {"intro": "脱衣状態はつかみ攻撃に無防備です。<br />\r\nこの状態で敵と接触すると、様々な辱めを受けることに。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01178000/RJ01177942/bfd826b1ef3a10faa73202554e6ed888.jpg", "alt": "復讐の夜霧 [beebee工房]", "title": "復讐の夜霧 [beebee工房]"}}, {"intro": "エロステータスで、「屈辱の経験」「初めての相手」は永遠に刻まれてしまいます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01178000/RJ01177942/333d191cd874056b96cef048ec466307.jpg", "alt": "復讐の夜霧 [beebee工房]", "title": "復讐の夜霧 [beebee工房]"}}]}, {"type": "image", "title": "Hシーンの分岐", "body": [{"intro": "同じエネミーでも、主人公の状態によりHシーンが分岐します。<br />\r\n30種類以上のエネミーそれぞれに、複数の固有Hシーンがあります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01178000/RJ01177942/02b9008602f84f3528870cb45fd25e27.jpg", "alt": "復讐の夜霧 [beebee工房]", "title": "復讐の夜霧 [beebee工房]"}, "position": "over"}]}, {"type": "image_list", "title": "状態異常・シチュエーション", "body": [{"intro": "膨乳、妊娠、出産をはじめ、多彩な状態異常が主人公を襲います。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01178000/RJ01177942/877d925ddce99720aa06028ad4ee52a5.jpg", "alt": "復讐の夜霧 [beebee工房]", "title": "復讐の夜霧 [beebee工房]"}}, {"intro": "復讐を果たせぬまま、魔物の体内で旅は終わってしまうかもしれない・・・<br />\r\n<br />\r\n出産や丸呑み、苗床エンドなど多彩なシーンを用意してます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01178000/RJ01177942/360632e898ac69d8d0b557df7fba35c4.jpg", "alt": "復讐の夜霧 [beebee工房]", "title": "復讐の夜霧 [beebee工房]"}}, {"intro": "敵の前で出産・・・復讐のためにはこんな辱めも耐えなければならない。<br />\r\n時には産卵させられることも・・・", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01178000/RJ01177942/e87dbee56374933c01f14de86e1c1296.jpg", "alt": "復讐の夜霧 [beebee工房]", "title": "復讐の夜霧 [beebee工房]"}}, {"intro": "やられるだけじゃない?<br />\r\nくノ一相手の時は攻め側になることも。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01178000/RJ01177942/c67ad927fe6ef26d4cab54e312be4b4e.jpg", "alt": "復讐の夜霧 [beebee工房]", "title": "復讐の夜霧 [beebee工房]"}}]}, {"type": "image", "title": "ストーリー・キャラクター", "body": [{"intro": "【ストーリー】主人公の夜霧が、忍びの里に帰還する所から物語は始まります。<br />\r\n何者かの襲撃で里は滅ぼされており、仕えていた主の訃報を聞く夜霧。<br />\r\n最後の忠心として復習の旅に身を投じることを決意します。<br />\r\n<br />\r\n【夜霧(ヤギリ)】<br />\r\n・里の次期後継者候補である「陽郎」に使えるくノ一。<br />\r\n　主従の関係を越え愛し合う間柄。生涯守り抜くと決意していた。<br />\r\n<br />\r\n【陽郎(ヨウロウ)】<br />\r\n・夜霧の主。若年ながら人徳者で、里の次期後継者と目されている。<br />\r\n　夜霧を正妻に迎えようとしていた矢先、何者かに殺害される。<br />\r\n<br />\r\n【陰郎】(インロウ)<br />\r\n・陽郎の兄で里の後継者候補の一人。陰湿で欲深い性格。<br />\r\n　忍の里が襲撃されてから行方がわからなくなっている。<br />\r\n<br />\r\n【那凪】(ナナギ)<br />\r\n・執着心の強いくノ一。小柄な体を活かした素早い動きで敵を翻弄する。<br />\r\n<br />\r\n【紫焔】(シエン)<br />\r\n・スタイル抜群かつ里で最強のくノ一。捉えどころのない性格で、何故か陰郎に付き従っている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01178000/RJ01177942/06ea1ea00de2603bc1c12517efc936fa.jpg", "alt": "復讐の夜霧 [beebee工房]", "title": "復讐の夜霧 [beebee工房]"}, "position": "over"}]}, {"type": "image", "title": "※ご注意事項・サポート", "body": [{"intro": "※ご購入前に「体験版」にて、必ず動作確認をお願いします。<br />\n※stage2以降はエネミーの登場が増えるため、要求スペックもご確認ください。<br />\n※Ci-enにて活動を行っております。バグ報告ご要望などはこちらにお願いします。<br />\n　<a href=\"https://ci-en.dlsite.com/creator/10842\" target=\"_blank\">https://ci-en.dlsite.com/creator/10842</a><br />\n<br />\n■DLL不足のエラーが出た場合<br />\n・公式ページの案内<br />\n<a href=\"https://rpgmakerofficial.com/support/faq/faq_actmv/\" target=\"_blank\">https://rpgmakerofficial.com/support/faq/faq_actmv/</a><br />\n<br />\n・dlMicrosoft Visual C++パッケージのインストールが必要になります。<br />\n・ダウンロードする際は、32bit「x86」をご選択ください。<br />\n・アクツクMV体験版をインストールすると解決したという情報もございます。<br />\n<br />\n<br />\n■セーブデータの引継ぎが上手くいかない場合<br />\n・Ci-enにて、クリアデータを配布しておりますのでお試しください。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01178000/RJ01177942/afca63ae166a789d78a8c5c3a3f7880f.jpg", "alt": "復讐の夜霧 [beebee工房]", "title": "復讐の夜霧 [beebee工房]"}, "position": "left"}]}], "description": "主人公の状態によりHシーンに分岐する、シンプル操作の2Dアクションゲームです。エネミーに捕縛されてからの産卵、妊娠、出産、リョナ表現などがメインになりますので、苦手な方はご注意ください。", "short_introduction": "主人公の状態によりHシーンに分岐する、シンプル操作の2Dアクションゲームです。エネミーに捕縛されてからの産卵、妊娠、出産、リョナ表現などがメインになりますので、苦手な方はご注意ください。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01177942.html", "site_id": "maniax", "fetched_at": 1794944002}