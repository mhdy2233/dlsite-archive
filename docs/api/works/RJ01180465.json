: "day", "rank": 1, "date": "2024-11-20"}, {"category": "game", "period": "week", "rank": 2, "date": "2024-11-21"}, {"category": "game", "period": "month", "rank": 5, "date": "2024-12-15"}, {"category": "game", "period": "year", "rank": 158, "date": "2024"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01181000/RJ01180465_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01181000/RJ01180465_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01181000/RJ01180465_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01181000/RJ01180465_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01181000/RJ01180465_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01181000/RJ01180465_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01181000/RJ01180465_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01181000/RJ01180465_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01181000/RJ01180465_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01181000/RJ01180465_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01181000/RJ01180465_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01181000/RJ01180465_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01181000/RJ01180465_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01181000/RJ01180465_img_smp6_100x100.jpg"], "alt": "ドラゴンコンキスタ [BanameiR]"}, "introductions": [{"type": "image", "title": "ゲーム内容", "body": [{"intro": "ハイテンポなコマンドバトルRPG", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01181000/RJ01180465/31897227314e63bba0363b081f117520.jpg", "alt": "ドラゴンコンキスタ [BanameiR]", "title": "ドラゴンコンキスタ [BanameiR]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "戦闘エロ、売春、和姦など様々なシチュエーションで基本HCG70枚以上!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01181000/RJ01180465/6c7415d79bfa160c681bca9ded74dc86.jpg", "alt": "ドラゴンコンキスタ [BanameiR]", "title": "ドラゴンコンキスタ [BanameiR]"}, "position": "over"}]}, {"type": "text", "title": "あらすじ", "body": [{"intro": "ドラゴンが人間によって狩られ、絶滅した世界。<br />\n剣聖の弟子レイリは15年前の悪夢に囚われ続けていた。<br />\n「石になった故郷」「黒いドラゴン」「笛を吹く男」…<br />\n最早真相を確かめるすべもないと諦めかけていた彼女のもとに、「黒いドラゴン」が姿を現したという報せが届く。<br />\nいてもいられなくなったレイリは住み慣れた家を飛び出し、旅に出る。<br />\n因縁と陰謀、そして自分自身と向き合うための旅に―"}]}, {"type": "image_list", "title": "キャラクター紹介", "body": [{"intro": "レイリ:<br />\n主人公。生真面目で正義感が強い。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01181000/RJ01180465/2beb1f350b7c13cab05543466c374f46.jpg", "alt": "ドラゴンコンキスタ [BanameiR]", "title": "ドラゴンコンキスタ [BanameiR]"}}, {"intro": "スズリカ:<br />\n主人公の師匠。<br />\n一国に一人の「剣聖」という称号を持つ達人。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01181000/RJ01180465/10eaa4065aa7d682cd0b583962c35b6d.jpg", "alt": "ドラゴンコンキスタ [BanameiR]", "title": "ドラゴンコンキスタ [BanameiR]"}}, {"intro": "メルメイア:<br />\n大商会「パル・カタナス商会」のNo.3。<br />\n常に怪しげな笑みを絶やさない。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01181000/RJ01180465/913db696df2271586af7e61d13a4c65b.jpg", "alt": "ドラゴンコンキスタ [BanameiR]", "title": "ドラゴンコンキスタ [BanameiR]"}}, {"intro": "ヘーゼル:<br />\nレイリが旅の途中で出会った行商人。<br />\n母親の店を買い戻すために商売の旅をしている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01181000/RJ01180465/9027ad16a79c35a16b714005d5a015e5.jpg", "alt": "ドラゴンコンキスタ [BanameiR]", "title": "ドラゴンコンキスタ [BanameiR]"}}]}, {"type": "text", "title": "注意事項", "body": [{"intro": "・本作は前作「ゴブリンコンキスタ」とシナリオの直接的な繋がりはございませんが、同一世界観であり、ゲストヒロイン「カナメ」が登場する一部サブイベントについては前作プレイ済の方がよりお楽しみいただけるようになっています。<br />\n・この作品はRPGツクールMZで製作されています。<br />\n・体験版は原則動作環境及びゲーム内容の確認にのみご利用ください(セーブデータを製品版に移植した場合の動作確認はしておりますが、固有の不具合が発生しないという保証はできかねます)。"}]}], "description": "後に剣聖と呼ばれる女剣士が、その旅の途中で色々大変な目に合う話", "short_introduction": "後に剣聖と呼ばれる女剣士が、その旅の途中で色々大変な目に合う話", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01180465.html", "site_id": "maniax", "fetched_at": 1794949873}