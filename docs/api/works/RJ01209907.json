oductions": [{"type": "text", "title": "最重要事項", "body": [{"intro": "◆必ず体験版にて動作確認の上、ご購入をお願いします。<br />\n<br />\n◆ゲームが動かない場合<br />\n<br />\n本作はアクションゲームツクールMVで作成されております。<br />\nゲームが起動しない場合下記の方法をお試しください。<br />\n<a href=\"https://tkool.jp/support/faq_actmv.html\" target=\"_blank\">https://tkool.jp/support/faq_actmv.html</a><br />\n<br />\nまたアクションゲームツクールMVの体験版をインストールすることで動くことで解決することもあります。<br />\n上手く起動しない場合は試してみてください。<br />\n<a href=\"https://store.steampowered.com/app/837510/MV/\" target=\"_blank\">https://store.steampowered.com/app/837510/MV/</a>"}]}, {"type": "image", "title": "あらすじ", "body": [{"intro": "前作「Dominating eyes ～呪淫洗脳の邪眼～」の外伝<br />\n<br />\n魔導士兼神官である主人公「桃崎みのり」はその戦闘力を買われ、<br />\nとある城を占拠したとされる低級の魔物「イビルアイ」の討伐を依頼される。<br />\nしかし、かの「イビルアイ」は凄まじく狡猾な特異個体であった…", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01210000/RJ01209907/8f166d4c42724ad01209f20501243317.jpg", "alt": "Arena of sacrifice [UNDER HILL]", "title": "Arena of sacrifice [UNDER HILL]"}, "position": "under"}]}, {"type": "image_list", "title": "ゲーム概要", "body": [{"intro": "ADVパートでストーリーを展開!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01210000/RJ01209907/96e64b3eed137696684aa78b520d4432.jpg", "alt": "Arena of sacrifice [UNDER HILL]", "title": "Arena of sacrifice [UNDER HILL]"}}, {"intro": "イビルアイの策略で身体を改造、弱体化されてしまう…", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01210000/RJ01209907/ea557c3931897710a3a3f4eb7e89e7a2.jpg", "alt": "Arena of sacrifice [UNDER HILL]", "title": "Arena of sacrifice [UNDER HILL]"}}, {"intro": "奪われた魔力を取り戻し、イビルアイを討伐するため、様々な闘技結界で魔物を殲滅せよ!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01210000/RJ01209907/a6d0954f80874903ba7fb2861f0be474.jpg", "alt": "Arena of sacrifice [UNDER HILL]", "title": "Arena of sacrifice [UNDER HILL]"}}, {"intro": "敗北したみのりに待ち受ける様々な末路…", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01210000/RJ01209907/5b561e8f90cff8a4201aa5d801a4162d.jpg", "alt": "Arena of sacrifice [UNDER HILL]", "title": "Arena of sacrifice [UNDER HILL]"}}]}, {"type": "image", "title": "拠点は謎の魔人が経営するマッサージ屋", "body": [{"intro": "拠点ではマッサージを受けたり、お風呂に入ることが出来る!<br />\n※体験版ではお風呂に入れません。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01210000/RJ01209907/454dd41e9ad306fe34677e58d0d63e69.jpg", "alt": "Arena of sacrifice [UNDER HILL]", "title": "Arena of sacrifice [UNDER HILL]"}, "position": "over"}]}, {"type": "image", "title": "フルボッコ乱闘バトル!", "body": [{"intro": "闘技結界では次々と湧いてくる魔物を様々な技で殲滅しよう!<br />\nストーリーが進むとより強力な技が習得出来るらしい!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01210000/RJ01209907/515e5f82090dcfee4127fd55ec1d14e1.jpg", "alt": "Arena of sacrifice [UNDER HILL]", "title": "Arena of sacrifice [UNDER HILL]"}, "position": "over"}]}, {"type": "image", "title": "敗者の末路", "body": [{"intro": "敗北時はドットアニメとCGイラストで敗北エロを描写!<br />\n様々な魔物がみのりに襲いかかる!<br />\n<br />\nCG28枚<br />\nドットアニメ28種類+α(おまけ)", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01210000/RJ01209907/491c1b328e39a320753564f8b45bfc48.jpg", "alt": "Arena of sacrifice [UNDER HILL]", "title": "Arena of sacrifice [UNDER HILL]"}, "position": "over"}]}], "description": "多彩な技で敵を殲滅するフルボッコドットアクション!", "short_introduction": "多彩な技で敵を殲滅するフルボッコドットアクション!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01209907.html", "site_id": "maniax", "fetched_at": 1794949039}