y": "all", "period": "month", "rank": 27, "date": "2025-08-31"}, {"category": "game", "period": "day", "rank": 3, "date": "2025-08-02"}, {"category": "game", "period": "week", "rank": 8, "date": "2025-08-08"}, {"category": "game", "period": "month", "rank": 18, "date": "2025-08-31"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01221000/RJ01220958_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01221000/RJ01220958_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01221000/RJ01220958_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01221000/RJ01220958_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01221000/RJ01220958_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01221000/RJ01220958_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01221000/RJ01220958_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01221000/RJ01220958_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01221000/RJ01220958_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01221000/RJ01220958_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01221000/RJ01220958_img_smp9.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01221000/RJ01220958_img_smp10.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01221000/RJ01220958_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01221000/RJ01220958_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01221000/RJ01220958_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01221000/RJ01220958_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01221000/RJ01220958_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01221000/RJ01220958_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01221000/RJ01220958_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01221000/RJ01220958_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01221000/RJ01220958_img_smp9_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01221000/RJ01220958_img_smp10_100x100.jpg"], "alt": "NTRRPG2～異種街と蝕まれる心～ [ATN]"}, "introductions": [{"type": "text", "title": "竿役は異種オンリーのファンタジー寝取られゲーム", "body": [{"intro": "※竿役に人間は登場しませんのでご注意ください。<br />\r\n主人公の大切な母親と幼馴染が、異種たちに寝取られていくファンタジーRPGです。<br />\r\n主人公視点オプションがありますので、主人公と同じ視点になって、知らない間に変わっていくヒロインたちの変化を楽しむことができます。<br />\r\n面倒くさい戦闘・レベル上げ等はありません。<br />\r\n<br />\r\n寝取られは堕ちるまでの過程が大切です。<br />\r\n積み重ねてきた関係が壊れていく時、ヒロインたちの裏切りの瞬間に向けて感情を高められるようにゲームを制作しました。<br />\r\nタイトルに2とつけていますが、物語上の繋がりはありませんので、シリーズをプレイしていなくてもお楽しみいただけます。"}]}, {"type": "image_list", "title": "ヒロイン紹介", "body": [{"intro": "・セレスティナ<br />\r\nいつも通りの母親ヒロイン枠です。主人公のことを大好きな母親が魔物たちに寝取られて、最終的には最愛の主人公の敵となります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01221000/RJ01220958/0deeec7b66ce9234b07632c923d3f14b.jpg", "alt": "NTRRPG2～異種街と蝕まれる心～ [ATN]", "title": "NTRRPG2～異種街と蝕まれる心～ [ATN]"}}, {"intro": "・ベアトリス<br />\r\n主人公の姉ですが、血縁関係はありません。幼馴染ヒロイン枠です。主人公と関係を持つよりも先に魔物たちに犯されます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01221000/RJ01220958/46451ecc4ec21e10bdd08be0d6a21e8e.jpg", "alt": "NTRRPG2～異種街と蝕まれる心～ [ATN]", "title": "NTRRPG2～異種街と蝕まれる心～ [ATN]"}}]}, {"type": "image", "title": "堕ち段階は8種類", "body": [{"intro": "堕ち段階は8種類、物語が進行していくと、立ち絵、キャラチップ、シーン一枚絵など全てにおいて衣装が反映されます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01221000/RJ01220958/aa0c350c7181913850a21b39a72a82c5.jpg", "alt": "NTRRPG2～異種街と蝕まれる心～ [ATN]", "title": "NTRRPG2～異種街と蝕まれる心～ [ATN]"}, "position": "over"}]}, {"type": "image", "title": "竿役は全部で21体", "body": [{"intro": "竿役は21体登場します。<br />\r\n全員が異種族です。<br />\r\n蟲や蟲人、獣人、ゴブリン、ミノタウロスなど様々な種族が登場します。<br />\r\nまた、各竿役に対応したエロステータスも閲覧することができます。<br />\r\nこちらもヒロインのものと同様に、物語中に更新されていきます。<br />\r\nもちろん全ての竿役には専用キャラチップを制作しております。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01221000/RJ01220958/1ff068364707b1e2959a5c7e82b9bba2.jpg", "alt": "NTRRPG2～異種街と蝕まれる心～ [ATN]", "title": "NTRRPG2～異種街と蝕まれる心～ [ATN]"}, "position": "over"}]}, {"type": "image", "title": "物語の各段階でエロステータスを更新", "body": [{"intro": "各堕ち段階でヒロインと竿役のエロステータスが更新されます。<br />\r\nヒロインの各部位の開発度や竿役の配合表、生殖器情報など、物語が進行するにつれて新たな情報が明らかになっていきます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01221000/RJ01220958/4341e18520476067fbb46c2f66d6fbab.jpg", "alt": "NTRRPG2～異種街と蝕まれる心～ [ATN]", "title": "NTRRPG2～異種街と蝕まれる心～ [ATN]"}, "position": "over"}]}, {"type": "image", "title": "ルートは2種類、エンディングは21種類", "body": [{"intro": "竿役全21体のうち、1体を除く20体に個別エンディングを用意しています。<br />\r\nトゥルーエンドクリアをすることで、全回想とエロステータス閲覧部屋(追加エロステもありです)が開放されます。<br />\r\n※トゥルーエンドクリアのセーブデータは、当サークルのci-enページ(このページの上部にリンクがあります)にて配布しております。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01221000/RJ01220958/65ab0f1b0bbfbf8d4167c31e2fa6a817.jpg", "alt": "NTRRPG2～異種街と蝕まれる心～ [ATN]", "title": "NTRRPG2～異種街と蝕まれる心～ [ATN]"}, "position": "over"}]}], "description": "虫えっち・異種えっちによるNTRゲームです。主人公の大切な母親と幼馴染が寝取られます。シーン数135、一枚絵1,227枚(立ち絵除く)、異種竿役21体です。", "short_introduction": "虫えっち・異種えっちによるNTRゲームです。主人公の大切な母親と幼馴染が寝取られます。シーン数135、一枚絵1,227枚(立ち絵除く)、異種竿役21体です。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01220958.html", "site_id": "maniax", "fetched_at": 1794948068}