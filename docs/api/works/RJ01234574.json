025-03-30"}, {"category": "game", "period": "day", "rank": 1, "date": "2025-03-15"}, {"category": "game", "period": "week", "rank": 9, "date": "2025-03-16"}, {"category": "game", "period": "month", "rank": 17, "date": "2025-03-30"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01235000/RJ01234574_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01235000/RJ01234574_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01235000/RJ01234574_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01235000/RJ01234574_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01235000/RJ01234574_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01235000/RJ01234574_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01235000/RJ01234574_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01235000/RJ01234574_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01235000/RJ01234574_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01235000/RJ01234574_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01235000/RJ01234574_img_smp9.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01235000/RJ01234574_img_smp10.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01235000/RJ01234574_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01235000/RJ01234574_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01235000/RJ01234574_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01235000/RJ01234574_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01235000/RJ01234574_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01235000/RJ01234574_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01235000/RJ01234574_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01235000/RJ01234574_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01235000/RJ01234574_img_smp9_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01235000/RJ01234574_img_smp10_100x100.jpg"], "alt": "蛇蝎 [ブラックメガネ研究所]"}, "introductions": [{"type": "text", "title": "ショタが異形や触手や人外娘に搾られるゲームです。", "body": [{"intro": "極限まで嫌な事をされてみたい…<br />\n異形の化け物の粘液にまみれ、未知の快感を与えられ、丸呑みされ…<br />\n死ぬまで無理矢理搾り尽くされてみたい…　<br />\nそんな事を思った事はありませんか?<br />\n<br />\n「蛇蝎」(だかつ)　…そんなゲームをプレイしてみませんか?<br />\n<br />\n<br />\n3/24　アップデート情報<br />\n・誤字脱字、その他不具合修正<br />\n・回想部屋に直行できる機能を実装<br />\n<br />\n<br />\n<br />\n※注意※<br />\nこのゲームの主人公は女の子ではありません。♂です。<br />\nサンプル画像や紹介動画をよく見てご購入を検討ください。<br />\n<br />\n◆ショタが触手や異形のモンスター、人外娘などに無理矢理されてしまうゲームです。<br />\n女の子が責められる描写などは有りません。<br />\n主人公が死亡する描写が多数有ります。<br />\n(リョナ描写有り、流血や過度なグロ描写はありません。)<br />\n<br />\n◆システム<br />\nオーソドックスな一本道のRPGです。<br />\n戦闘中に拘束有り、搾られて射精する描写有り。<br />\nボイスON.OFF機能あり<br />\n<br />\n■体験版までのシチュエーション<br />\n・触手生物に襲われて搾精<br />\n・巨大ワームに締め付けられて丸呑み<br />\n・ろくろ首に舌責めされまくった後丸呑み<br />\n製品版以降に出てくる敵はサンプル画像やPVでご覧ください。<br />\n<br />\n<br />\n◇話のあらすじ<br />\n遥か未来、地上に現れた化け物の襲撃により人類は滅んでしまった。<br />\n閉ざされた地下シェルターの中で次々に現れる異形たち。<br />\n果たして主人公は目的地までたどり着く事ができるのか…?"}]}, {"type": "image_list", "title": "戦闘中には拘束あり。抜け出すかどうかはプレイヤー次第…", "body": [{"intro": "容赦なく化け物に襲われて搾精されます。そして丸呑みされます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01235000/RJ01234574/7b3356d80040cddaa1fac2cf7a88597c.jpg", "alt": "蛇蝎 [ブラックメガネ研究所]", "title": "蛇蝎 [ブラックメガネ研究所]"}}, {"intro": "容赦なく丸呑みされます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01235000/RJ01234574/b66b51dab73bdaa20008c19d6715929d.jpg", "alt": "蛇蝎 [ブラックメガネ研究所]", "title": "蛇蝎 [ブラックメガネ研究所]"}}, {"intro": "触手にも容赦なく搾り取られます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01235000/RJ01234574/a63c843f2560636fe05bcc1381cdd64f.jpg", "alt": "蛇蝎 [ブラックメガネ研究所]", "title": "蛇蝎 [ブラックメガネ研究所]"}}, {"intro": "雑魚敵も搾ってきます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01235000/RJ01234574/41a67f39c70fb122ff21b973170d10ab.jpg", "alt": "蛇蝎 [ブラックメガネ研究所]", "title": "蛇蝎 [ブラックメガネ研究所]"}}]}], "description": "ショタが異形の生物とか人外のお姉さんに搾られるPRGです。", "short_introduction": "ショタが異形の生物とか人外のお姉さんに搾られるPRGです。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01234574.html", "site_id": "maniax", "fetched_at": 1794949049}