month", "rank": 9, "date": "2024-12-21"}, {"category": "game", "period": "day", "rank": 1, "date": "2024-11-27"}, {"category": "game", "period": "week", "rank": 4, "date": "2024-12-03"}, {"category": "game", "period": "month", "rank": 7, "date": "2024-12-21"}, {"category": "game", "period": "year", "rank": 172, "date": "2024"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01235000/RJ01234994_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01235000/RJ01234994_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01235000/RJ01234994_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01235000/RJ01234994_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01235000/RJ01234994_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01235000/RJ01234994_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01235000/RJ01234994_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01235000/RJ01234994_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01235000/RJ01234994_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01235000/RJ01234994_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01235000/RJ01234994_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01235000/RJ01234994_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01235000/RJ01234994_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01235000/RJ01234994_img_smp6_100x100.jpg"], "alt": "プリンセスコロシアム2 [ふらむそふと]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "現在のver2.05<br />\n<br />\n■ ストーリー概要 ■<br />\n多くの人々が集い栄える混沌の国ディンリウム。<br />\nかの国では有名な闘技場が存在する。<br />\n　<br />\n勝者には全てが与えられ、<br />\n敗者は全てを失い慰み者になるという。<br />\n<br />\n今、男たちは栄光を求めて闘技場へと挑む!<br />\n<br />\n<br />\n■ ゲーム内容 ■<br />\n男主人公の育成シミュレーション+カードバトルRPGです。<br />\n<br />\n対戦相手の女性は男を見下しており、戦闘中でも構わずに、<br />\n誘惑、色仕掛け、セクハラ攻撃をしかけてきます。<br />\n<br />\n女尊男卑が根付いた国の中で、<br />\n女性達に馬鹿にされ、玩具にされたりしながらも、<br />\n逆境に負けず、自らを鍛えて闘技場を勝ち進みましょう。<br />\n<br />\n<br />\n■ ボリューム ■<br />\n基本CG48枚(Hシーン46)<br />\n基本カットイン54枚<br />\n他、立ち絵、アニメーション多数<br />\n<br />\nイラスト:えんとつ、ウロコヅキ、卜部ねむこ<br />\nドット:すみせんち<br />\nマップ:なすー<br />\nアイコン:ケースヶ<br />\n　<br />\nゲーム解像度 1280x800<br />\nメッセージスキップ、バックログ有り<br />\nシーン回想、CGモード有り<br />\n<br />\n※戦闘敗北時に確認できるHシーンは、勝利した場合でも<br />\n　CGモードやシーン回想に登録されます。<br />\n<br />\n<br />\n■ 注意事項 ■<br />\n必ず体験版で動作確認、内容確認をお願い致します。<br />\nまた、不具合修正などのアップデートがある場合もございますので、<br />\n会員登録してからのご購入がお勧めです。"}]}, {"type": "image_list", "title": "バージョン2.0にアップデートしました！", "body": [{"intro": "あの姉妹が淫魔になって帰ってきました！<br />\nきっとろくでもないことを考えていることでしょう……", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01235000/RJ01234994/05ab1a9995e0bdf017da89f6ef6a9544.jpg", "alt": "プリンセスコロシアム2 [ふらむそふと]", "title": "プリンセスコロシアム2 [ふらむそふと]"}}, {"intro": "彼女のイベントも追加しました。<br />\nその強い決意に打ち勝つことができるでしょうか。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01235000/RJ01234994/473a987995b06362a3bbdd5b1316218b.jpg", "alt": "プリンセスコロシアム2 [ふらむそふと]", "title": "プリンセスコロシアム2 [ふらむそふと]"}}, {"intro": "他にもサブキャラのイベントなども勿論追加！<br />\nカジノでブラックジャックを遊べるようになりました(思わぬ誘惑があるかもしれません)", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01235000/RJ01234994/61eafed197547b872a7c3111e76d6901.jpg", "alt": "プリンセスコロシアム2 [ふらむそふと]", "title": "プリンセスコロシアム2 [ふらむそふと]"}}, {"intro": "Ver2.0にてHシーンを10以上、カットイン多数追加！<br />\n各キャラの表情差分も追加しました！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01235000/RJ01234994/96175a53059fb6ee2292f91e97a89ee7.jpg", "alt": "プリンセスコロシアム2 [ふらむそふと]", "title": "プリンセスコロシアム2 [ふらむそふと]"}}]}], "description": "男の運命は栄光か。それとも奴○か。強い女の子と闘技場で戦うRPG第2弾!", "short_introduction": "男の運命は栄光か。それとも奴○か。強い女の子と闘技場で戦うRPG第2弾!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01234994.html", "site_id": "maniax", "fetched_at": 1794949820}