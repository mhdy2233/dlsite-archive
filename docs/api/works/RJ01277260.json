, {"category": "game", "period": "week", "rank": 16, "date": "2024-12-04"}, {"category": "game", "period": "month", "rank": 27, "date": "2024-12-15"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01278000/RJ01277260_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01278000/RJ01277260_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01278000/RJ01277260_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01278000/RJ01277260_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01278000/RJ01277260_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01278000/RJ01277260_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01278000/RJ01277260_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01278000/RJ01277260_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01278000/RJ01277260_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01278000/RJ01277260_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01278000/RJ01277260_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01278000/RJ01277260_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01278000/RJ01277260_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01278000/RJ01277260_img_smp6_100x100.jpg"], "alt": "おさわりファンタジー 本好きエルフの知らない夜 [ぷろおな]"}, "introductions": [{"type": "text", "title": "作品内容", "body": [{"intro": "おさわりファンタジー第1弾!<br />\n<br />\n本を読み疲れて寝落ちしてしまったエルフさんに悪戯をしよう。<br />\nLive2Dで作ったモデルだからヌルヌルと服を脱がせます。<br />\n<br />\nキスをしたり、おっぱいを揉んだり、もちろん挿入だってOK!<br />\n<br />\n【注意事項】<br />\nLive2Dアニメーションを使っているため、ある程度のPCスペックが必要です。<br />\n<br />\nVer 1.01  2024/12/15<br />\n<br />\nフルスクリーンモード・Windowモード切替ボタンの実装"}]}, {"type": "image", "title": "", "body": [{"intro": "起こさないようにそ～～っと服を脱がそう。<br />\nいっぱい服を着ているから、脱がしがいがあるぞ。<br />\n<br />\nLive2Dモデルだから自由に服を脱がせられる。<br />\n好きな場所で止めたり戻したりできるから、<br />\n乱れた姿を堪能してほしい。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01278000/RJ01277260/b7ede037021d0f252858ce63adae737b.jpg", "alt": "おさわりファンタジー 本好きエルフの知らない夜 [ぷろおな]", "title": "おさわりファンタジー 本好きエルフの知らない夜 [ぷろおな]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "服を脱がした後は、好きなように悪戯しよう。<br />\n<br />\n顔にキスをしたり、ペロペロしたり、<br />\n胸を揉んだり、乳首をクリクリしたり、<br />\nもちろん挿入もできます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01278000/RJ01277260/82aefd7c58fe58503f9128e32aba66b7.jpg", "alt": "おさわりファンタジー 本好きエルフの知らない夜 [ぷろおな]", "title": "おさわりファンタジー 本好きエルフの知らない夜 [ぷろおな]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "ファンタジー世界の定番のやつ…<br />\nおっぱいを大きくするポーションとおねんねポーションがあるぞ。<br />\n<br />\nなんと服を着た状態でも脱いだ状態でも、おっぱいが大きくなる…<br />\nぺたんこおっぱいもいいが、巨乳も捨てがたいというプレイヤーには<br />\n嬉しい機能だ!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01278000/RJ01277260/7d57b906497aeea0b9376a4c3d220799.jpg", "alt": "おさわりファンタジー 本好きエルフの知らない夜 [ぷろおな]", "title": "おさわりファンタジー 本好きエルフの知らない夜 [ぷろおな]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "Live2Dで作っているのでリアルに動くよ!<br />\nドラッグ操作でピストンをコントロールすることも可能だ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01278000/RJ01277260/031bcb1735de37206cd5aec6dab3d52a.jpg", "alt": "おさわりファンタジー 本好きエルフの知らない夜 [ぷろおな]", "title": "おさわりファンタジー 本好きエルフの知らない夜 [ぷろおな]"}, "position": "over"}]}, {"type": "image_list", "title": "", "body": [{"intro": "「睡眠○でしょ?　起きたら終わりですか??」<br />\n<br />\nいいえ、もう少し続きます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01278000/RJ01277260/aa41b1d5c0af44cf9d00d60eb3e50436.jpg", "alt": "おさわりファンタジー 本好きエルフの知らない夜 [ぷろおな]", "title": "おさわりファンタジー 本好きエルフの知らない夜 [ぷろおな]"}}, {"intro": "下着は3種類用意しました。<br />\n好きな下着で犯してください。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01278000/RJ01277260/5dbfaef758e71a26dcb48d281709f4f1.jpg", "alt": "おさわりファンタジー 本好きエルフの知らない夜 [ぷろおな]", "title": "おさわりファンタジー 本好きエルフの知らない夜 [ぷろおな]"}}]}], "description": "寝ているエルフさんを起こさないように悪戯するゲームです。慎重に服を脱がしてHな悪戯をしよう!", "short_introduction": "寝ているエルフさんを起こさないように悪戯するゲームです。慎重に服を脱がしてHな悪戯をしよう!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01277260.html", "site_id": "maniax", "fetched_at": 1794949827}