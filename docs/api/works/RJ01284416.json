}, {"category": "game", "period": "day", "rank": 1, "date": "2024-12-22"}, {"category": "game", "period": "week", "rank": 4, "date": "2024-12-28"}, {"category": "game", "period": "month", "rank": 14, "date": "2024-12-30"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01285000/RJ01284416_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01285000/RJ01284416_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01285000/RJ01284416_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01285000/RJ01284416_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01285000/RJ01284416_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01285000/RJ01284416_img_smp4.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01285000/RJ01284416_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01285000/RJ01284416_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01285000/RJ01284416_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01285000/RJ01284416_img_smp4_100x100.jpg"], "alt": "エリーゼと恍惚のマリオネット [和菓子日和]"}, "introductions": [{"type": "image", "title": "◆プロローグ", "body": [{"intro": "メルクマールで冒険者として生計を立てているエリーゼ。<br />\r\n<br />\r\nいつものように依頼を終え、報告のために町へ戻る帰り道<br />\r\n道外れの草むらで倒れている少女を見つける。<br />\r\n<br />\r\n少女は意識がなく、体も衰弱して危険な状態だったため<br />\r\nエリーゼは少女を町へ運ぶことにするが……", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01285000/RJ01284416/7abc4ac1943404bfdaa8664f1d2109b8.jpg", "alt": "エリーゼと恍惚のマリオネット [和菓子日和]", "title": "エリーゼと恍惚のマリオネット [和菓子日和]"}, "position": "over"}]}, {"type": "image", "title": "◆戦闘仕様", "body": [{"intro": "戦闘は基本的な従来のRPG同様にターン式で行われ<br />\r\nこの作品のHシーンは戦闘中に特定の条件下で発生する<br />\r\n敵からの凌○イベント(戦闘H)が中心となっております。<br />\r\n<br />\r\n※もちろん戦闘H以外にも条件を満たすと発生する<br />\r\n　フィールドMAPでのHシーンも存在します。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01285000/RJ01284416/6df969c5e07764a371ff7b20854643ab.jpg", "alt": "エリーゼと恍惚のマリオネット [和菓子日和]", "title": "エリーゼと恍惚のマリオネット [和菓子日和]"}, "position": "over"}]}, {"type": "image", "title": "◆主なシチュエーションor内容", "body": [{"intro": "基本CG枚数41(立ち絵を含めると43枚)<br />\r\n総CG枚数519枚以上<br />\r\n<br />\r\n・対人凌○<br />\r\n・セクハラ<br />\r\n・催○<br />\r\n・異種〇(触手・スライムなど)<br />\r\n・ボ〇腹などなど……。<br />\r\n<br />\r\n　淫乱値あり。<br />\r\n　Hステータスあり。<br />\r\n　メッセージスキップあり<br />\r\n　回想部屋あり。<br />\r\n　クリア後全開放あり。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01285000/RJ01284416/f1742f74930b1335a6e4ca8988443c3e.jpg", "alt": "エリーゼと恍惚のマリオネット [和菓子日和]", "title": "エリーゼと恍惚のマリオネット [和菓子日和]"}, "position": "over"}]}, {"type": "image_list", "title": "◆主な登場人物", "body": [{"intro": "【 エリーゼ 】<br />\r\n<br />\r\n物語の主人公、メルクマールで冒険者として<br />\r\n依頼を受けながら生活している。<br />\r\nいつもの様に依頼を受け町外れの街道へ向かうが‥‥?。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01285000/RJ01284416/6d1bd09f5317b370cd26e3e381719010.jpg", "alt": "エリーゼと恍惚のマリオネット [和菓子日和]", "title": "エリーゼと恍惚のマリオネット [和菓子日和]"}}, {"intro": "【 ローズ 】<br />\r\n<br />\r\n町外れの街道で倒れていた少女<br />\r\nなにやら深い事情がありそうだが…。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01285000/RJ01284416/5e8e353d13d3b8d678b9afb75321a754.jpg", "alt": "エリーゼと恍惚のマリオネット [和菓子日和]", "title": "エリーゼと恍惚のマリオネット [和菓子日和]"}}, {"intro": "【 キリエ 】<br />\r\n<br />\r\nメルクマールに住む<br />\r\n呪いの解除や治療が得意な魔術士<br />\r\n古い遺物など採取することが趣味。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01285000/RJ01284416/e6c8a92c6ebf3107e882246ff72c0a3f.jpg", "alt": "エリーゼと恍惚のマリオネット [和菓子日和]", "title": "エリーゼと恍惚のマリオネット [和菓子日和]"}}]}, {"type": "image", "title": "◆注意事項", "body": [{"intro": "このゲームは RPGツクールMV で制作しています。<br />\r\n製品版をご購入前に、体験版で動作のご確認をお願いします。<br />\r\n<br />\r\n※バグ修正などのため、ゲームの内容を<br />\r\n差し替える場合がありますのでDLsite様の会員登録をしてから<br />\r\nご購入することをオススメします。<br />\r\n　　<br />\r\n体験版セーブデータを製品版で使用する事は、<br />\r\nバグの原因になりますのでおやめください", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01285000/RJ01284416/c7d0cbf1f84939