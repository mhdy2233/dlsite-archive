https://img.dlsite.jp/modpub/images2/work/doujin/RJ01289000/RJ01288083_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01289000/RJ01288083_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01289000/RJ01288083_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01289000/RJ01288083_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01289000/RJ01288083_img_smp9.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01289000/RJ01288083_img_smp10.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01289000/RJ01288083_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01289000/RJ01288083_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01289000/RJ01288083_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01289000/RJ01288083_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01289000/RJ01288083_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01289000/RJ01288083_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01289000/RJ01288083_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01289000/RJ01288083_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01289000/RJ01288083_img_smp9_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01289000/RJ01288083_img_smp10_100x100.jpg"], "alt": "しーく淫! [OKKSG]"}, "introductions": [{"type": "image", "title": "地球から女の子をさらって好みに飼育!種付けエイリアンを投入して孕ませ!それが『しーく淫!』", "body": [{"intro": "本作は超高度文明を持つ宇宙人が主人公。<br />\r\n少子化に悩む宇宙人一族は地球人をさらって飼育&amp;改造、そして身代わりに子を孕ませる究極のテクノロジーを駆使して少子化に策を打った!<br />\r\n女の子を魅力的な母体へと育て上げ、たくさん赤ちゃん作りに励ませよう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01289000/RJ01288083/a182983cf48b4fc1d6fda68ddf224fd1.jpg", "alt": "しーく淫! [OKKSG]", "title": "しーく淫! [OKKSG]"}, "position": "over"}]}, {"type": "image", "title": "住居となる飼育箱をカスタマイズして快適な環境を作り上げる女の子飼育ゲーム!", "body": [{"intro": "飼育箱をカスタマイズして快適な住居を作ってあげよう!<br />\r\n女の子がストレスなく育つと性欲も魅力もどんどんアップ!<br />\r\n赤ちゃんを作りまくって惑星からの助成金で稼げばさらに飼育箱をアップグレードだ!<br />\r\n女の子を飼いすぎてもう飼育できない?ストレスが溜まってしまうと地球に強○送還されるから気を付けよう!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01289000/RJ01288083/16648e02829243abaf12fdad4c35feee.jpg", "alt": "しーく淫! [OKKSG]", "title": "しーく淫! [OKKSG]"}, "position": "over"}]}, {"type": "image", "title": "育て方で変わるえっちな身体付き!ぽっちゃりもムチムチもスレンダーも!", "body": [{"intro": "食事やマッサージでステータスも見た目も変化!<br />\r\n女の子は性格も色々!お気に入りの女の子を好きな体型で育て上げて孕ませ孕ませ!<br />\r\nトイレに睡眠に性欲処理もお世話してあげよう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01289000/RJ01288083/23ca522fb2cd2ed0e8b79ce7fd89e04f.jpg", "alt": "しーく淫! [OKKSG]", "title": "しーく淫! [OKKSG]"}, "position": "over"}]}, {"type": "image", "title": "進化したおさわりモード!", "body": [{"intro": "こだわりのおさわり表現にリアルで滑らかなカメラ操作がストレスフリー!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01289000/RJ01288083/b78cfbc3e92bbb226d3f5ca248b93920.jpg", "alt": "しーく淫! [OKKSG]", "title": "しーく淫! [OKKSG]"}, "position": "over"}]}, {"type": "image_list", "title": "様々な機能で充実の孕ませしーく淫ライフを!", "body": [{"intro": "地球から精力の強そうなおじさんをさらって種付けエイリアンに改造!<br />\r\n観察するだけじゃなく操作してお気に入りの女の子を孕ませられる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01289000/RJ01288083/f4202b3103ca99f22729d4d3622737d9.jpg", "alt": "しーく淫! [OKKSG]", "title": "しーく淫! [OKKSG]"}}, {"intro": "女の子は宇宙子供手当で稼いだお金で地球から仕入れよう!<br />\r\nたくさん飼いすぎると飼育しきれなくなって女の子がストレスマックスに。<br />\r\n計画的な飼育が大切だ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01289000/RJ01288083/1863e86cd00bd9bbe783ab80a48bddb4.jpg", "alt": "しーく淫! [OKKSG]", "title": "しーく淫! [OKKSG]"}}, {"intro": "女の子は自由にカラーリング可能!<br />\r\n褐色ギャルに変身しちゃおう!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01289000/RJ01288083/26e009320c0ba965e7934375526e1e56.jpg", "alt": "しーく淫! [OKKSG]", "title": "しーく淫! [OKKSG]"}}, {"intro": "おじさんはまさかのガチャ!<br />\r\n最強の種付けパワーのあるおじさんを探しに地球へアブダクション!<br />\r\n強いおじさんはなかなか捕まらないぞ!<br />\r\n迫力の演出を見逃すな!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01289000/RJ01288083/ddc75e1df7b215c2ca7227648601a860.jpg", "alt": "しーく淫! [OKKSG]", "title": "しーく淫! [OKKSG]"}}]}], "description": "女の子をさらって好みに飼育!カスタマイズして作った住居に種付けエイリアンを投入して…孕ませまくり!! そんな育成ゲーム、それが『しーく淫!』", "short_introduction": "女の子をさらって好みに飼育!カスタマイズして作った住居に種付けエイリアンを投入して…孕ませまくり!! そんな育成ゲーム、それが『しーく淫!』", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01288083.html", "site_id": "maniax", "fetched_at": 1794949619}