tegory": "all", "period": "month", "rank": 90, "date": "2025-05-24"}, {"category": "game", "period": "day", "rank": 9, "date": "2025-04-25"}, {"category": "game", "period": "week", "rank": 21, "date": "2025-05-01"}, {"category": "game", "period": "month", "rank": 37, "date": "2025-05-24"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01296000/RJ01295905_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01296000/RJ01295905_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01296000/RJ01295905_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01296000/RJ01295905_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01296000/RJ01295905_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01296000/RJ01295905_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01296000/RJ01295905_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01296000/RJ01295905_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01296000/RJ01295905_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01296000/RJ01295905_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01296000/RJ01295905_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01296000/RJ01295905_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01296000/RJ01295905_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01296000/RJ01295905_img_smp6_100x100.jpg"], "alt": "苗床ぐらし～イケニエ少女のドキドキ子作り性活～ [そんだけ。]"}, "introductions": [{"type": "image", "title": "3食おやつ付きの苗床性活、はじめませんか?", "body": [{"intro": "魔物のイケニエとして捧げられた少女、ヨミ(処女)。<br />\n<br />\n彼女に待ち受けるのは<br />\n魔物の苗床としての過酷な運命―<br />\n<br />\n…のはずなのだが、<br />\nこの少女、魔物とのえっちに興味津々であった…!<br />\n<br />\n魔物たちとまぐわい、<br />\n孕み、<br />\n産み、<br />\n育てよう!<br />\n<br />\nそして育てた子たちとまた…", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01296000/RJ01295905/65e973d9ce1b5e875b2dd0278fb3d953.jpg", "alt": "苗床ぐらし～イケニエ少女のドキドキ子作り性活～ [そんだけ。]", "title": "苗床ぐらし～イケニエ少女のドキドキ子作り性活～ [そんだけ。]"}, "position": "left"}]}, {"type": "image", "title": "日々の性活", "body": [{"intro": "主人公であるヨミは拠点となる「贄の棲家」、<br />\nそして魔物たちの棲まう「贄の洞窟」を行き来して日々を過ごします。<br />\n<br />\n●贄の住処<br />\nヨミの生活の場です。<br />\n食事に睡眠、お風呂…おやつも忘れずに。<br />\n採集した食材で料理を作ってもらうこともできます。<br />\n<br />\n●贄の洞窟<br />\n魔物たちの棲家です。<br />\nイケニエであるヨミがここですることは、<br />\nただひたすらに魔物たちとエッチすることのみです。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01296000/RJ01295905/e10ee77422ba5772d409c5f566d2f660.jpg", "alt": "苗床ぐらし～イケニエ少女のドキドキ子作り性活～ [そんだけ。]", "title": "苗床ぐらし～イケニエ少女のドキドキ子作り性活～ [そんだけ。]"}, "position": "left"}]}, {"type": "image", "title": "魔物とのえっち、そして…", "body": [{"intro": "魔物たちとえっちをすることでヨミは妊娠し、<br />\nやがて魔物の子を出産します。<br />\n<br />\n産んだ子供は授乳室で育てることとなります。<br />\n<br />\n時が経つと子供たちは成長し、贄の洞窟へと向かいます。<br />\nそしてヨミはその子達とも…", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01296000/RJ01295905/450d2514d4ef34c98890283365aa37cc.jpg", "alt": "苗床ぐらし～イケニエ少女のドキドキ子作り性活～ [そんだけ。]", "title": "苗床ぐらし～イケニエ少女のドキドキ子作り性活～ [そんだけ。]"}, "position": "left"}]}, {"type": "image", "title": "Hシーン", "body": [{"intro": "ヨミのエッチ相手は全て魔物となります。<br />\n人間♂は登場しません。<br />\n<br />\n●登場する魔物<br />\n8種類+αが登場します。<br />\n下記8種にはそれぞれセックス及び出産シーンがあります。<br />\n・亜人系:2種<br />\n・蟲系:2種<br />\n・触手系:2種<br />\n・動物系:2種", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01296000/RJ01295905/d1ea72584c546b524ba1e8d1ced073f5.jpg", "alt": "苗床ぐらし～イケニエ少女のドキドキ子作り性活～ [そんだけ。]", "title": "苗床ぐらし～イケニエ少女のドキドキ子作り性活～ [そんだけ。]"}, "position": "left"}]}, {"type": "image", "title": "新コンテンツの追加(version1.50)", "body": [{"intro": "version1.50にて新たなコンテンツが追加されました！<br />\n●マップの追加<br />\n新たなマップ「魔王の祭壇」が追加されました。<br />\nこのマップではヨミは新たな衣装を纏います！<br />\n<br />\n●魔物の追加<br />\n新たな魔物が6種追加されます。<br />\nもちろん全ての魔物とエッチができ、子を孕むことができます！<br />\n<br />\n●システム面の改良<br />\n投げキッスで魔物を誘惑したり、どこでも搾乳ができるようになったりとより遊びやすくなりました！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01296000/RJ01295905/98cf89f123eae309a1eaa3c35bca061e.jpg", "alt": "苗床ぐらし～イケニエ少女のドキドキ子作り性活～ [そんだけ。]", "title": "苗床ぐらし～イケニエ少女のドキドキ子作り性活～ [そんだけ。]"}, "position": "left"}]}, {"type": "image_list", "title": "登場人物", "body": [{"intro": "●ヨミ<br />\nイケニエとして捧げられた少女。<br />\n本作の主人公。<br />\n<br />\n魔物とのえっちに興味津々。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01296000/RJ01295905/b001c2c7769ed10a7589e2bee68bc23c.jpg", "alt": "苗床ぐらし～イケニエ少女のドキドキ子作り性活～ [そんだけ。]", "title": "苗床ぐらし～イケニエ少女のドキドキ子作り性活～ [そんだけ。]"}}, {"intro": "●アビー<br />\nヨミのお世話係。<br />\nクール(?)なメイドさん。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01296000/RJ01295905/35458cb2095d237febbff3b501d3406d.jpg", "alt": "苗床ぐらし～イケニエ少女のドキドキ子作り性活～ [そんだけ。]", "title": "苗床ぐらし～イケニエ少女のドキドキ子作り性活～ [そんだけ。]"}}, {"intro": "⚫︎エリ<br />\nとある方に仕えるハーフエルフのメイド。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01296000/RJ01295905/ac85b2e9f8889a660b311eb6961d049c.jpg", "alt": "苗床ぐらし～イケニエ少女のドキドキ子作り性活～ [そんだけ。]", "title": "苗床ぐらし～イケニエ少女のドキドキ子作り性活～ [そんだけ。]"}}]}], "description": "3食おやつ付きの苗床性活、はじめませんか?", "short_introduction": "3食おやつ付きの苗床性活、はじめませんか?", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01295905.html", "site_id": "maniax", "fetched_at": 1794948767}