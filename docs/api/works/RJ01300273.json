1"}, {"category": "all", "period": "month", "rank": 50, "date": "2026-01-12"}, {"category": "game", "period": "day", "rank": 1, "date": "2025-12-17"}, {"category": "game", "period": "week", "rank": 6, "date": "2025-12-21"}, {"category": "game", "period": "month", "rank": 22, "date": "2026-01-02"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01301000/RJ01300273_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01301000/RJ01300273_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01301000/RJ01300273_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01301000/RJ01300273_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01301000/RJ01300273_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01301000/RJ01300273_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01301000/RJ01300273_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01301000/RJ01300273_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01301000/RJ01300273_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01301000/RJ01300273_img_smp8.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01301000/RJ01300273_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01301000/RJ01300273_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01301000/RJ01300273_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01301000/RJ01300273_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01301000/RJ01300273_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01301000/RJ01300273_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01301000/RJ01300273_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01301000/RJ01300273_img_smp8_100x100.jpg"], "alt": "シスタはみんなのオナホです!!~7日間の〇隷性活~ [虫の知らせ]"}, "introductions": [{"type": "text", "title": "シスター・調教・段階エロな非戦闘RPGです。", "body": [{"intro": "◆ゲーム内容<br />\n・戦闘無しの探索型RPGで手軽に遊べる内容となっています。<br />\n・ゲーム内日数で物語が進行していき、服装やHイベントが過激なものになっていきます。<br />\n・1人のヒロインを徹底的に墜としたい人におススメです!<br />\n・プレイはアナル多めボテ腹、拘束、触手など凌○、マニアックなプレイが主になっています!<br />\n<br />\n◆あらすじ<br />\n略奪者に村を追われ1人で途方に暮れていたシスタは教会に保護された。<br />\n教会で保護され1ヶ月ほど経つと神父からある提案をされてしまう、<br />\n資金不足のため、教会の娘を1人性〇隷として7日間、男たちに奉仕しなければならない……と<br />\n「自分以外の誰かが犠牲になるくらいなら」と、シスタはその提案を受けいれてしまい…………<br />\n<br />\n日々苛烈さを増していく男たちの調教………<br />\nシスタの意思に反して開発されていく躰。<br />\n果たしてシスタは7日間の調教に耐えることができるのか………<br />\n<br />\n◆想定クリア時間<br />\n　2～3時間<br />\n<br />\n◆CG枚数<br />\n　基本HCG8枚<br />\n　差分数700以上<br />\n　Hシーン数27+クリア後追加シーン"}]}, {"type": "image", "title": "主人公", "body": [{"intro": "◆シスタ<br />\n<br />\n略奪者によって住んでいた村をを追われてしまい、1人でいたところを、<br />\n神父に拾われシスターとなった。<br />\n性格は優しく、献身的。<br />\n人からものを頼まれたら断れない節がある。<br />\n<br />\n性の知識は興味はあるが、ほとんど知らない。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01301000/RJ01300273/892ed2dce6c221bddad24a8209d75940.jpg", "alt": "シスタはみんなのオナホです!!~7日間の〇隷性活~ [虫の知らせ]", "title": "シスタはみんなのオナホです!!~7日間の〇隷性活~ [虫の知らせ]"}, "position": "left"}]}, {"type": "image", "title": "ストーリー進行で変化する立ち絵", "body": [{"intro": "◆魔法で関係者以外は普通の服に見える特別な衣装。<br />\n　物語の中盤にはさらに淫紋も刻まれて…………<br />\n<br />\n　目隠しの他にも、<br />\n　鼻フックや口枷などのアクセサリーも豊富です！<br />\n<br />\n　ボテ腹状態でイベントシーンに入ると<br />\n　HCGにも反映されます!※<br />\n　シスタをHな衣装でマップを歩かせて辱めよう!<br />\n<br />\n　※構図で見えないものを除く", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01301000/RJ01300273/4e7392cd24987090dc3e03e01f08f30f.jpg", "alt": "シスタはみんなのオナホです!!~7日間の〇隷性活~ [虫の知らせ]", "title": "シスタはみんなのオナホです!!~7日間の〇隷性活~ [虫の知らせ]"}, "position": "right"}]}, {"type": "image_list", "title": "システム", "body": [{"intro": "メニュー画面ではシスタが今の心情だったりゲーム進行のヒントをくれたりします!<br />\nもちろんこちらの画面にも服装の<br />\n変化は反映されます!<br />\nhシーンの後に覗くと………?", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01301000/RJ01300273/5969c09d42268cf58d710fac0d6c40b2.jpg", "alt": "シスタはみんなのオナホです!!~7日間の〇隷性活~ [虫の知らせ]", "title": "シスタはみんなのオナホです!!~7日間の〇隷性活~ [虫の知らせ]"}}, {"intro": "シーンごとに更新されていく<br />\nシスタのひみつ<br />\n<br />\n物語の進行で次々と<br />\n刻まれてく、<br />\nエロステータスは着実に<br />\nシスタの身体を蝕んでいきます！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01301000/RJ01300273/713e9f84c11b3d99ab75571d4a992885.jpg", "alt": "シスタはみんなのオナホです!!~7日間の〇隷性活~ [虫の知らせ]", "title": "シスタはみんなのオナホです!!~7日間の〇隷性活~ [虫の知らせ]"}}, {"intro": "シスタの部屋の鏡では……♡<br />\n<br />\n物語の序盤で設置される鏡<br />\nシスタの大事な場所を<br />\n見ることができます！<br />\n立ち絵の状態、<br />\nシーンの後で変化が……", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01301000/RJ01300273/3e9826e77ebfdba37240989ccb3a1621.jpg", "alt": "シスタはみんなのオナホです!!~7日間の〇隷性活~ [虫の知らせ]", "title": "シスタはみんなのオナホです!!~7日間の〇隷性活~ [虫の知らせ]"}}]}, {"type": "image", "title": "Hイベント", "body": [{"intro": "◆一部Hシーンは日数が経過するにつれ、段階的に服装、体の状態が反映されます。<br />\n　過激になっていく調教がシスタの体と心を追い詰めていきます………。<br />\n<br />\n◆Hシチュエーション<br />\n<br />\n　寝ている間に代わる代わる犯され………<br />\n　色々な形のおもちゃでアナルを調教される。<br />\n　ボテ腹になるまでゼリー浣腸……<br />\n　上記の状態で、疑似妊婦として1日を過ごす。<br />\n　機械を使った強○搾乳。<br />\n　触手責め、などなど………", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01301000/RJ01300273/b57f2dc67ddf25be53beada1218ea598.jpg", "alt": "シスタはみんなのオナホです!!~7日間の〇隷性活~ [虫の知らせ]", "title": "シスタはみんなのオナホです!!~7日間の〇隷性活~ [虫の知らせ]"}, "position": "over"}]}, {"type": "text", "title": "その他 不具合、サポートなど", "body": [{"intro": "本作品はRPGツクールMVで制作されており、<br />\n動作の方はRPGツクールMVの推奨環境に準拠しています。<br />\n<br />\n不具合などありましたら、<br />\n作者cienの方で受け付けております。<br />\n下記urlにお願いします。<br />\n<br />\n<a href=\"https://ci-en.dlsite.com/creator/23954/article/1667140\" target=\"_blank\">https://ci-en.dlsite.com/creator/23954/article/1667140</a><br />\n<br />\n作者x<br />\n<a href=\"https://x.com/yukao_100\" target=\"_blank\">https://x.com/yukao_100</a>"}]}], "description": "見習いシスターが7日間色々な調教されちゃう非戦闘RPGです!", "short_introduction": "見習いシスターが7日間色々な調教されちゃう非戦闘RPGです!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01300273.html", "site_id": "mani