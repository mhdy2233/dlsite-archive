ro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01304000/RJ01303350/bd761d233d5262dfd1a339e3b398e228.jpg", "alt": "一緒に仲良くHしようよ!! [トラバサミ]", "title": "一緒に仲良くHしようよ!! [トラバサミ]"}, "position": "over"}]}, {"type": "image", "title": "■キャラ紹介(1)", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01304000/RJ01303350/679a32f4d266fb9cd7cb47cc1f98c5a1.jpg", "alt": "一緒に仲良くHしようよ!! [トラバサミ]", "title": "一緒に仲良くHしようよ!! [トラバサミ]"}, "position": "over"}]}, {"type": "image", "title": "■一部シーン紹介(1)", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01304000/RJ01303350/4415efab1c4ab3269d60ce7c5c1d4f87.jpg", "alt": "一緒に仲良くHしようよ!! [トラバサミ]", "title": "一緒に仲良くHしようよ!! [トラバサミ]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "今作は本番エッチとパイズリが多めの作品です!<br />\n配信したり外出先でエッチしたり、もちろん家の中でもエッチだ～～～!<br />\n(配信リスナー達はおっぱいを性的に見つつ、ヒロインと主人公がくっつくのを望んでいるので純愛です)", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01304000/RJ01303350/400b10dab65514ec40c9d28b5cbb552b.jpg", "alt": "一緒に仲良くHしようよ!! [トラバサミ]", "title": "一緒に仲良くHしようよ!! [トラバサミ]"}, "position": "over"}]}, {"type": "image", "title": "■戦闘について", "body": [{"intro": "戦闘中は純愛圏のモンスター達によるエロ催○攻撃が行われ。<br />\n主人公は強○的に勃起してしまうため。戦いを観戦しにきていたヒロインは仕方なく性処理をしてくれます。<br />\nおちんちん大きくなるからね仕方ないね……<br />\n<br />\nだったらこっちもエロスキルで対抗だ!<br />\n女の子にちんちんしごいてもらうことで攻撃力を上げて殴れ～～～!<br />\n(モンスターは主人公を勃起させた後見ているだけです。<br />\n勃起が治まったらまた勃起させてきます。)<br />\n----------------------------------------------------------------------------<br />\n※必ず体験版にて動作の確認をお願いいたします。<br />\n<br />\n制作者のX:@mimiga410<br />\nci-en:<a href=\"https://ci-en.dlsite.com/creator/8643\" target=\"_blank\">https://ci-en.dlsite.com/creator/8643</a>", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01304000/RJ01303350/f5a1ddb8eaefed642523f8f1839f001d.jpg", "alt": "一緒に仲良くHしようよ!! [トラバサミ]", "title": "一緒に仲良くHしようよ!! [トラバサミ]"}, "position": "over"}]}], "description": "おっぱいでかでか女友達二人といちゃいちゃラブラブHしよう!!", "short_introduction": "おっぱいでかでか女友達二人といちゃいちゃラブラブHしよう!!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01303350.html", "site_id": "maniax", "fetched_at": 1794949577}