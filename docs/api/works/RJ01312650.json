mages": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01313000/RJ01312650_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01313000/RJ01312650_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01313000/RJ01312650_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01313000/RJ01312650_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01313000/RJ01312650_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01313000/RJ01312650_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01313000/RJ01312650_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01313000/RJ01312650_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01313000/RJ01312650_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01313000/RJ01312650_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01313000/RJ01312650_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01313000/RJ01312650_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01313000/RJ01312650_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01313000/RJ01312650_img_smp6_100x100.jpg"], "alt": "MesmaraizeFlow [えちえちさん]"}, "introductions": [{"type": "text", "title": "概要", "body": [{"intro": "推定プレイ時間は10分程です。<br />\n抜きゲー特化、時間がない人でもサクッとできます!<br />\n差分、おかず写真多数!<br />\n<br />\n～あらすじ～<br />\nある日、男のスマートフォンに謎のアプリが勝手にインストールされた。どうやらそれは〇眠アプリだとわかった。数日後、そこにはすっかり〇眠アプリを使い慣れた男がいた。次のターゲットは近所に住む〇学生だった。"}]}, {"type": "image_list", "title": "サンプル", "body": [{"intro": "近所に住む〇学生がターゲット。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01313000/RJ01312650/5b6303a7c0f40b45266c55f243513c6f.jpg", "alt": "MesmaraizeFlow [えちえちさん]", "title": "MesmaraizeFlow [えちえちさん]"}}, {"intro": "脱がしておさわりできます。撮影された写真はいつでもスマホから観覧できます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01313000/RJ01312650/b215d1aa6402dda3feec871152fbb279.jpg", "alt": "MesmaraizeFlow [えちえちさん]", "title": "MesmaraizeFlow [えちえちさん]"}}, {"intro": "すやすやえっち。くまみみカチューシャなど差分が5つあります。ピストン速度により、寝息も変化します。中出し差分1枚、外出し差分3枚です。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01313000/RJ01312650/7ef1270f587d88d0d8026f9528ac3e24.jpg", "alt": "MesmaraizeFlow [えちえちさん]", "title": "MesmaraizeFlow [えちえちさん]"}}, {"intro": "追加された写真をいつでも表示出来ます。写真は計18枚。クリア後も複数追加されます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01313000/RJ01312650/8c531554149fe0e0f6b819473bc0658f.jpg", "alt": "MesmaraizeFlow [えちえちさん]", "title": "MesmaraizeFlow [えちえちさん]"}}]}, {"type": "text", "title": "ーその他ー", "body": [{"intro": "・導入→脱がしシーン→本番シーンで構成されています。<br />\n・中だし差分1、外出し差分3<br />\n・断面図ON/OFFあり<br />\n・照明ON/OFFあり<br />\n・写真フェルダ計18枚(クリア後追加あり)<br />\n・本番シーンにくまみみカチューシャなどの差分5つあります。<br />\n・クリア後ギャラリーシーン(写真フォルダ)が追加されます。<br />\n・説明を読んだ方はオプションからチュートリアルをOFFに出来ます。<br />\n・ゲーム内からいつでも説明書を開けます。<br />\n<br />\n●体験版について<br />\n脱がしシーンまで行えます。<br />\n<br />\n●必要スペック<br />\n体験版でご確認ください。"}]}], "description": "無垢な少女に背徳えっち /差分5つおかず18枚/ サクッとヌける", "short_introduction": "無垢な少女に背徳えっち /差分5つおかず18枚/ サクッとヌける", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01312650.html", "site_id": "maniax", "fetched_at": 1794949588}