ng": ["KO_KR"]}], "rating": {"average": 4.35, "count": 1542}, "review_count": 24, "dl_count": 8362, "wishlist_count": 5824, "ranking": [{"category": "all", "period": "month", "rank": 97, "date": "2025-02-02"}, {"category": "game", "period": "day", "rank": 11, "date": "2025-01-08"}, {"category": "game", "period": "week", "rank": 20, "date": "2025-01-12"}, {"category": "game", "period": "month", "rank": 29, "date": "2025-01-31"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01320000/RJ01319311_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01320000/RJ01319311_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01320000/RJ01319311_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01320000/RJ01319311_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01320000/RJ01319311_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01320000/RJ01319311_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01320000/RJ01319311_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01320000/RJ01319311_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01320000/RJ01319311_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01320000/RJ01319311_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01320000/RJ01319311_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01320000/RJ01319311_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01320000/RJ01319311_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01320000/RJ01319311_img_smp6_100x100.jpg"], "alt": "俺は義妹の部屋に忍び込む [silent hentai]"}, "introductions": [{"type": "image", "title": "作品紹介", "body": [{"intro": "父が再婚した。<br />\nそうして俺には義妹ができた。<br />\n俺のことを嫌いであまり会話もしない妹だが…。<br />\n女とは縁のなかった俺にとって、女と一つ屋根の下で暮らすというのはとても興奮する事だった。<br />\nそんなある夜、性的な衝動を抑えられなかった俺は義妹の部屋に忍び込んだ。<br />\n<br />\n<br />\n………<br />\n……<br />\n…<br />\n<br />\n<br />\n眠っている妹の部屋に忍び込んでエッチなことをするlive2d適用されたおさわりゲームです。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01320000/RJ01319311/6d0f809ac908d23a528c1379e9c534fc.jpg", "alt": "俺は義妹の部屋に忍び込む [silent hentai]", "title": "俺は義妹の部屋に忍び込む [silent hentai]"}, "position": "over"}]}, {"type": "image_list", "title": "操作方法", "body": [{"intro": "基本的にクリック&amp;ドラッグで操作します。 インタラクションが可能な部分に触れると、マウス カーソルが変わります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01320000/RJ01319311/22e1a5092073b86237341c657f0f22a9.jpg", "alt": "俺は義妹の部屋に忍び込む [silent hentai]", "title": "俺は義妹の部屋に忍び込む [silent hentai]"}}, {"intro": "胸とちくびは右クリックすると両手で触ることが可能になります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01320000/RJ01319311/c5d40beb30c0cf9ea149b8ff6f23081a.jpg", "alt": "俺は義妹の部屋に忍び込む [silent hentai]", "title": "俺は義妹の部屋に忍び込む [silent hentai]"}}, {"intro": "その他の部分は右クリックするとオートモードが始まります。 <br />\n<br />\nマウスホイールでオートスピードを調節できます。 <br />\n<br />\nもう一度右クリックするとオートモードが終了します。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01320000/RJ01319311/a372d0544310821870d1cba9b19c8aa4.jpg", "alt": "俺は義妹の部屋に忍び込む [silent hentai]", "title": "俺は義妹の部屋に忍び込む [silent hentai]"}}]}, {"type": "image", "title": "ゲームをクリアするためには", "body": [{"intro": "妹を起こさないようにするには、ゆっくりとドラッグする必要があります。<br />\n挿入を目指して気をつけてドラッグしましょう。<br />\n<br />\nその後、後片付けまで済ませてから、部屋を出るならゲームクリアです!<br />\n<br />\nもしあまりにも強くドラッグしたり後片付けをきちんと終わらせないとゲームオーバーです···。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01320000/RJ01319311/be2a737e913db6ab9934d9682e72acad.jpg", "alt": "俺は義妹の部屋に忍び込む [silent hentai]", "title": "俺は義妹の部屋に忍び込む [silent hentai]"}, "position": "left"}]}, {"type": "image_list", "title": "クリアした後は", "body": [{"intro": "ゲームをクリアすると、コスチューム、断面図、フリーモードが解禁されます。<br />\n<br />\n別のコスチュームを着た妹を相手にゲームを楽しむことができます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01320000/RJ01319311/3890e9e848fac430ee4997489a723334.jpg", "alt": "俺は義妹の部屋に忍び込む [silent hentai]", "title": "俺は義妹の部屋に忍び込む [silent hentai]"}}, {"intro": "そして、2つの部分の断面図を見ることが可能になります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01320000/RJ01319311/62b4c1f91833b6bfc3ee70785ae74e5e.jpg", "alt": "俺は義妹の部屋に忍び込む [silent hentai]", "title": "俺は義妹の部屋に忍び込む [silent hentai]"}}, {"intro": "解禁されたフリーモードはタイトルを通じて入ることができます。 妹が起きる心配なく思いっきりエッチを楽しめます!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01320000/RJ01319311/44bf38dca1bb4bd009d571d029f3784e.jpg", "alt": "俺は義妹の部屋に忍び込む [silent hentai]", "title": "俺は義妹の部屋に忍び込む [silent hentai]"}}]}, {"type": "text", "title": "不具合報告", "body": [{"intro": "不具合報告はこちらにお願いいたします。<br />\n<br />\n<a href=\"https://ci-en.dlsite.com/creator/26710/article/1329558\" target=\"_blank\">https://ci-en.dlsite.com/creator/26710/article/1329558</a><br />\n<br />\n大変ご迷惑をおかけ致しますが、よろしくお願いいたします。"}]}, {"type": "text", "title": "使用素材", "body": [{"intro": "本作品は、下記の素材を使用させていただいております。<br />\nこの場を借りて製作者様に深く御礼申し上げます。<br />\n<br />\n・魔王魂<br />\n・タイガーリリー<br />\n・月に憑かれたピエロ<br />\n・オコジョ彗星<br />\n・しんさんわーくす<br />\n・Junky-Soft<br />\n・itch.ioのSpiral Atlas<br />\n・DOVA-SYNDROMEのNaruIDEA <br />\n・魔王魂<br />\n・みんちりえ<br />\n・On-Jin ～音人～<br />\n・効果音ラボ<br />\n・MODI工場(モーディーコウジョウ)"}]}], "description": "眠っている妹の部屋に忍び込んでエッチするLIVE2D&おさわりゲーム", "short_introduction": "眠っている妹の部屋に忍び込んでエッチするLIVE2D&おさわりゲーム", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01319311.html", "site_id": "maniax", "fetched_at": 1794949509}