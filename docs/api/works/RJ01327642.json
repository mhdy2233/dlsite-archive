ank": 64, "date": "2025-02-12"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01328000/RJ01327642_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01328000/RJ01327642_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01328000/RJ01327642_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01328000/RJ01327642_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01328000/RJ01327642_img_smp3.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01328000/RJ01327642_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01328000/RJ01327642_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01328000/RJ01327642_img_smp3_100x100.jpg"], "alt": "蟲使いアラニア [Phantom Fox]"}, "introductions": [{"type": "text", "title": "村の仇!　打倒王国を目指して進軍しよう!", "body": [{"intro": "・あらすじ<br />\r\n<br />\r\n故郷の村を焼かれ、一人生き残ったアラニア。<br />\r\n<br />\r\n蟲使いの一族最後の生き残りとして、打倒王国に燃える。<br />\r\n<br />\r\n僻地に身を潜めながら蟲を産み育て、反撃の牙を研ぐのだった・・・"}]}, {"type": "image", "title": "苗床を世話して蟲を生産しよう!", "body": [{"intro": "アラニアは非力で全く戦えない!<br />\r\n<br />\r\n戦力となる蟲を生産し、代わりに戦ってもらおう!<br />\r\n<br />\r\n苗床のレベルに応じて生産される虫も強くなっていく。<br />\r\n<br />\r\n安定して生産できるよう、苗床の世話をして良い状態を維持し続けよう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01328000/RJ01327642/c6fdc1f0c4d8af085d69e5d281794ec7.jpg", "alt": "蟲使いアラニア [Phantom Fox]", "title": "蟲使いアラニア [Phantom Fox]"}, "position": "over"}]}, {"type": "image", "title": "生産した蟲を編成して、いざ戦闘へ!", "body": [{"intro": "盾のワーム、攻撃のインセクト、魔法のローパー。<br />\r\n<br />\r\n特徴ある三種の蟲を自由に編成し、好みの軍団を作り上げよう!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01328000/RJ01327642/4d4f29da5d261898969f1f5c42b77c5c.jpg", "alt": "蟲使いアラニア [Phantom Fox]", "title": "蟲使いアラニア [Phantom Fox]"}, "position": "over"}]}, {"type": "image", "title": "複雑な操作のない自動戦闘!", "body": [{"intro": "蟲は自分で勝手に行動を決めて戦ってくれる。<br />\r\n<br />\r\nアイテムを駆使して虫たちを支援してあげよう!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01328000/RJ01327642/17e4757f1ff11fe1e435fd6b18886aa2.jpg", "alt": "蟲使いアラニア [Phantom Fox]", "title": "蟲使いアラニア [Phantom Fox]"}, "position": "over"}]}, {"type": "image", "title": "一日の制限時間", "body": [{"intro": "アラニアは一日に行動できる時間が決まっている。<br />\n<br />\n期限付きのクエストもあるので計画的に行動しよう。<br />\n一年経つと王国軍の襲撃がやってくる!<br />\n<br />\n※戦闘、Hシーンでは時間が進行しません。ゆっくりお楽しみください。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01328000/RJ01327642/2562497776da20b9d4e8e00488e1cdb0.jpg", "alt": "蟲使いアラニア [Phantom Fox]", "title": "蟲使いアラニア [Phantom Fox]"}, "position": "over"}]}, {"type": "text", "title": "その他", "body": [{"intro": "当サークルはCi-en様にて活動しております。<br />\n不具合報告などはこちらにしていただけますと幸いです。<br />\n<br />\n<a href=\"https://ci-en.dlsite.com/creator/26000\" target=\"_blank\">https://ci-en.dlsite.com/creator/26000</a><br />\n<br />\n<br />\nVer1.2更新内容<br />\n・苗床画面の立ち絵をCGルームでも見られるように変更。<br />\n・採取時エフェクトの時間を調整。<br />\n・エンカウント判定エフェクトの時間を調整。<br />\n・就寝時にBGMを飛ばせるように変更。<br />\nVer1,3更新内容<br />\n・ポーンのグラフィックが間違っていたのを修正。<br />\nVer1,4更新内容<br />\n・出現しないイベントが回想ルームに登録されていたのを修正。"}]}], "description": "苗床を育てて戦力となるモンスターを増やす、飼育系RPG", "short_introduction": "苗床を育てて戦力となるモンスターを増やす、飼育系RPG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01327642.html", "site_id": "maniax", "fetched_at": 1794949413}