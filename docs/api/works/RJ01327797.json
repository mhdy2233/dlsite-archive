/img.dlsite.jp/modpub/images2/parts/RJ01328000/RJ01327797/2156d7d2aca4ad6c64f65ff520b1ad74.jpg", "alt": "ゴブリン・ストラテジー [さみやみソフト]", "title": "ゴブリン・ストラテジー [さみやみソフト]"}}, {"intro": "モブ歩兵娘<br />\n<br />\n王国の歩兵。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01328000/RJ01327797/d709fe1220b672933cd129d77dac5ffa.jpg", "alt": "ゴブリン・ストラテジー [さみやみソフト]", "title": "ゴブリン・ストラテジー [さみやみソフト]"}}, {"intro": "モブ弓兵娘<br />\n<br />\n王国の弓兵。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01328000/RJ01327797/aeb85da89db5db64cb1c63f2fd27708b.jpg", "alt": "ゴブリン・ストラテジー [さみやみソフト]", "title": "ゴブリン・ストラテジー [さみやみソフト]"}}, {"intro": "モブ魔法兵娘<br />\n<br />\n王国の魔法兵。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01328000/RJ01327797/76b21cbb3cc89524226670de18bf1ea0.jpg", "alt": "ゴブリン・ストラテジー [さみやみソフト]", "title": "ゴブリン・ストラテジー [さみやみソフト]"}}]}, {"type": "image_list", "title": "", "body": [{"intro": "モブ重装兵娘<br />\n<br />\n王国の重装兵。その顔は隠されているが……。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01328000/RJ01327797/fcc52c5a8d20a27f7be24af57bf67e2e.jpg", "alt": "ゴブリン・ストラテジー [さみやみソフト]", "title": "ゴブリン・ストラテジー [さみやみソフト]"}}, {"intro": "モブ村娘<br />\n<br />\nその辺に住んでいた哀れな村娘。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01328000/RJ01327797/29746ef3402ddb36cc65fd25210ddbc5.jpg", "alt": "ゴブリン・ストラテジー [さみやみソフト]", "title": "ゴブリン・ストラテジー [さみやみソフト]"}}]}, {"type": "text_list", "title": "その他", "body": [{"intro": "3Dゲームであるため、体験版で動作確認のうえご購入願います。"}, {"intro": "ゴブリンゲーですが孕ませ要素はありません。"}, {"intro": "戦闘エロについては自由視点となりますが、イベントシーンについては固定視点となります。"}]}], "description": "ゴブリンを指揮して女の子をえっちな目に合わせるストラテジー", "short_introduction": "ゴブリンを指揮して女の子をえっちな目に合わせるストラテジー", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01327797.html", "site_id": "maniax", "fetched_at": 1794948850}