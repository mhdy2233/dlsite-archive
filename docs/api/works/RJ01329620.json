es": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01330000/RJ01329620_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01330000/RJ01329620_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01330000/RJ01329620_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01330000/RJ01329620_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01330000/RJ01329620_img_smp5.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01330000/RJ01329620_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01330000/RJ01329620_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01330000/RJ01329620_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01330000/RJ01329620_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01330000/RJ01329620_img_smp5_100x100.jpg"], "alt": "戦斧とメイドさん [ヤモリ木工所]"}, "introductions": [{"type": "text", "title": "どんなゲーム?", "body": [{"intro": "貴方は一冊の本を手に入れる。<br />\nその内容とは古(いにしえ)の時代の冒険記だった…から始まる物語です。<br />\n<br />\n主人公ことショタがダンジョンに潜り、<br />\n帰ってきたらメイドさんにヨシヨシしてもらえるゲームです。<br />\n<br />\nゲームブック風にゲームは進行します。<br />\n戦闘システムもダイスで進行します。<br />\n<br />\n牧歌的蛮勇おねショタRPGです。"}]}, {"type": "image_list", "title": "主な登場人物", "body": [{"intro": "「クート」<br />\nショタのほう。<br />\n<br />\n領主の息子。<br />\n年頃になったので、ダンジョン平定に行かされる。<br />\n童貞。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01330000/RJ01329620/e163342f3e66e98cb808f966d17b6692.jpg", "alt": "戦斧とメイドさん [ヤモリ木工所]", "title": "戦斧とメイドさん [ヤモリ木工所]"}}, {"intro": "「アルヤ」<br />\nメイドのほう。<br />\n<br />\n年上の美人メイドが、従者としてダンジョン攻略についてきてくれます。<br />\n巨乳。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01330000/RJ01329620/1d77e9a6ea69b7c8c4ca0b4e2c8655e2.jpg", "alt": "戦斧とメイドさん [ヤモリ木工所]", "title": "戦斧とメイドさん [ヤモリ木工所]"}}]}, {"type": "image", "title": "こだわりポイント", "body": [{"intro": "ゲームはサイドビュー視点。<br />\n大きな等身のキャラクターが動き回ります。<br />\n<br />\n牧歌的音楽、暖かみのある光の表現。<br />\n拠点でメイドさんとの一時の生活を楽しめます。<br />\n<br />\nゲームが進めば”搾って”もらえることも!?", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01330000/RJ01329620/7dd06e469bea207e4221f6bc6ccb733c.jpg", "alt": "戦斧とメイドさん [ヤモリ木工所]", "title": "戦斧とメイドさん [ヤモリ木工所]"}, "position": "left"}]}, {"type": "image", "title": "ゲームブック風の戦闘", "body": [{"intro": "ダンジョン内ではゲームブック風の戦闘やイベントが発生します。<br />\n戦闘はプレイヤーの選択とダイスの目で勝敗が決まります。<br />\n<br />\n敵キャラはすべて描きおろし。<br />\nサキュバスもいるぞ!しかも二人!!<br />\n(敗北Hはありませんが、倒すとイイことが起こります)", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01330000/RJ01329620/fbf994c26d53ec9b1046968c018527fa.jpg", "alt": "戦斧とメイドさん [ヤモリ木工所]", "title": "戦斧とメイドさん [ヤモリ木工所]"}, "position": "left"}]}, {"type": "image", "title": "簡易アニメーション搭載", "body": [{"intro": "Hシーンはすべて簡易的なアニメーションが搭載されています。<br />\nお好きなタイミングまでループを続ける親切設計。<br />\nHCG 基本12枚/差分込80枚。その他のイベントCG9枚。<br />\n<br />\nHなSEは独立で音量調節が可能です(重要)。<br />\n<br />\nゲーム本編クリア後におまけモードがあり、<br />\n好きなシーンを見返すことができます。<br />\n<br />\n2025/4/16 v1.2アップデート<br />\n速度調整等を備えたループアニメ鑑賞モードが実装されました。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01330000/RJ01329620/d9fd3affd9a95b9d7357c69499af205f.jpg", "alt": "戦斧とメイドさん [ヤモリ木工所]", "title": "戦斧とメイドさん [ヤモリ木工所]"}, "position": "left"}]}, {"type": "text", "title": "その他情報", "body": [{"intro": "このゲームはRPGツクールMZで製作されています。<br />\n動作は体験版でご確認ください。<br />\n<br />\nNTR要素はありません。<br />\n<br />\n感想・バグ報告等はこちらまで。<br />\n<a href=\"https://ci-en.dlsite.com/creator/25905\" target=\"_blank\">https://ci-en.dlsite.com/creator/25905</a>"}]}], "description": "【おねショタRPG】ショタがダンジョンに潜って、帰ってきたらメイドさんにヨシヨシしてもらえるゲームです。ゲームブック風のシナリオとオリジナルのシステムを搭載しています。", "short_introduction": "【おねショタRPG】ショタがダンジョンに潜って、帰ってきたらメイドさんにヨシヨシしてもらえるゲームです。ゲームブック風のシナリオとオリジナルのシステムを搭載しています。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01329620.html", "site_id": "maniax", "fetched_at": 1794949084}