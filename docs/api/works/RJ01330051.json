-03-11"}, {"category": "game", "period": "day", "rank": 3, "date": "2025-02-27"}, {"category": "game", "period": "week", "rank": 6, "date": "2025-03-05"}, {"category": "game", "period": "month", "rank": 15, "date": "2025-03-10"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01331000/RJ01330051_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01331000/RJ01330051_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01331000/RJ01330051_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01331000/RJ01330051_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01331000/RJ01330051_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01331000/RJ01330051_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01331000/RJ01330051_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01331000/RJ01330051_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01331000/RJ01330051_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01331000/RJ01330051_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01331000/RJ01330051_img_smp9.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01331000/RJ01330051_img_smp10.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01331000/RJ01330051_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01331000/RJ01330051_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01331000/RJ01330051_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01331000/RJ01330051_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01331000/RJ01330051_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01331000/RJ01330051_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01331000/RJ01330051_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01331000/RJ01330051_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01331000/RJ01330051_img_smp9_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01331000/RJ01330051_img_smp10_100x100.jpg"], "alt": "僕ノ知ラナイ女師匠ノ情事 [クレイジー二厘]"}, "introductions": [{"type": "text", "title": "憧れていた師匠の雌の顔を知らないふりするRPG", "body": [{"intro": "※RPGツクールMZ製です。体験版などで動作確認を行うことをおすすめします<br />\n※体験版のセーブデータは製品版に引き継ぐことはできません<br />\n<br />\n主人公の少年ユウは、師匠クロエと共に共和国にある村で暮らしていた。<br />\n<br />\n魔装という強力な力を持ちながらも田舎の村で穏やかな生活を送るクロエと、彼女に憧れるユウ…。<br />\n<br />\n平和な日々は、世界征服を目指す帝国の侵略によって崩された。<br />\n<br />\n<br />\n帝国の攻撃から村を守るため戦うクロエ。<br />\n<br />\nしかし、そんな彼女を帝国の士官モルガンが謎の力で無力化する。<br />\n<br />\n<br />\n帝国は村を占拠し、クロエの過去が明かされる…。<br />\n<br />\nクロエはかつて帝国によって淫紋を刻まれ、何度も性行為を許していた。<br />\n<br />\nそして今でも、男の性欲の前では無力になってしまうのだ。<br />\n<br />\n<br />\n村人を懐柔したいモルガンは、クロエに男達への奉仕を命令する。<br />\n<br />\n喜ぶ村人や帝国兵の中、唯一弟子のユウだけは憧れの師匠を性的に見ないことを誓うのだが…。"}]}, {"type": "text", "title": "コンセプト", "body": [{"intro": "憧れの師匠だった女騎士の性行為を見てみぬふりしましょう<br />\n<br />\n不特定多数の男と性行為をするほか、エロガキ、BSS風?、自分より強い騎士など特定の男に寝取られる要素もあります<br />\n<br />\nまた、主人公の少年ユウも敵の女幹部と逆寝取り?されます"}]}, {"type": "text", "title": "ゲーム性について", "body": [{"intro": "外に探索に出て、村に資材を納品<br />\n<br />\n納品した資材で村の施設を開発、そこに行くことでHシーンを見ることが出来ます<br />\n<br />\n施設は<br />\n<br />\n道具屋、酒場、簡易住居、浴場、練兵場、研究所、マッサージ施設、娼館　があります<br />\n<br />\n<br />\nCG40枚超<br />\n<br />\nHシーン60超です"}]}, {"type": "image_list", "title": "登場人物紹介", "body": [{"intro": "クロエ<br />\n<br />\nヒロインです<br />\n<br />\n魔装騎士と呼ばれる強い力を持つ存在ですが、帝国から淫紋を刻まれた上性行為実験を受けてしまいました<br />\n<br />\nそのため、男からの性欲を受けると発情し弱体化するという弱点を持っています", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01331000/RJ01330051/04a6af5e5599973bb128eee3ca82ff48.jpg", "alt": "僕ノ知ラナイ女師匠ノ情事 [クレイジー二厘]", "title": "僕ノ知ラナイ女師匠ノ情事 [クレイジー二厘]"}}, {"intro": "モルガン<br />\n<br />\nサブヒロインです<br />\n<br />\n帝国の士官であり、クロエに淫紋を刻み村を侵略しました<br />\n<br />\nどうやらユウのことが気になっているようです", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01331000/RJ01330051/abf36be2e23e471dfc7124073185a229.jpg", "alt": "僕ノ知ラナイ女師匠ノ情事 [クレイジー二厘]", "title": "僕ノ知ラナイ女師匠ノ情事 [クレイジー二厘]"}}, {"intro": "ユウ<br />\n<br />\n主人公の少年です<br />\n<br />\n師匠は他の男と性行為してるし師匠よりも年増の敵軍女幹部に狙われるしで散々な目に遭います", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01331000/RJ01330051/134114e5f517d71c826b6170a20bc646.jpg", "alt": "僕ノ知ラナイ女師匠ノ情事 [クレイジー二厘]", "title": "僕ノ知ラナイ女師匠ノ情事 [クレイジー二厘]"}}]}, {"type": "image_list", "title": "Hシーン紹介", "body": [{"intro": "皆の前で淫紋を刻まれたことと、過去の性行為を暴露されます", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01331000/RJ01330051/fa4b141bf5788ad46abd88806147f126.jpg", "alt": "僕ノ知ラナイ女師匠ノ情事 [クレイジー二厘]", "title": "僕ノ知ラナイ女師匠ノ情事 [クレイジー二厘]"}}, {"intro": "道具屋で村人へのサービスフェラチオをしています", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01331000/RJ01330051/bff6a0a95e5132e30955b5b73796c8ae.jpg", "alt": "僕ノ知ラナイ女師匠ノ情事 [クレイジー二厘]", "title": "僕ノ知ラナイ女師匠ノ情事 [クレイジー二厘]"}}, {"intro": "やがて逃げていた淫猥な過去から抜け出せなくなり、セックスを受け入れるように…", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01331000/RJ01330051/8bfadb69ef10e2cd7cde093a43c6fd6c.jpg", "alt": "僕ノ知ラナイ女師匠ノ情事 [クレイジー二厘]", "title": "僕ノ知ラナイ女師匠ノ情事 [クレイジー二厘]"}}, {"intro": "一方、弟子のユウもまた敵国の女によって…", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01331000/RJ01330051/1e9cff5fae32c6779db9abe1859cb4b2.jpg", "alt": "僕ノ知ラナイ女師匠ノ情事 [クレイジー二厘]", "title": "僕ノ知ラナイ女師匠ノ情事 [クレイジー二厘]"}}]}], "description": "憧れていた師匠の雌の顔を知らないふりするRPG", "short_introduction": "憧れていた師匠の雌の顔を知らないふりするRPG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01330051.html", "site_id": "maniax", "fetched_at": 1794949131}