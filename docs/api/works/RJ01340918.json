 ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01341000/RJ01340918_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01341000/RJ01340918_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01341000/RJ01340918_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01341000/RJ01340918_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01341000/RJ01340918_img_smp5.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01341000/RJ01340918_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01341000/RJ01340918_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01341000/RJ01340918_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01341000/RJ01340918_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01341000/RJ01340918_img_smp5_100x100.jpg"], "alt": "田中家の浮気事情 [BABYLON]"}, "introductions": [{"type": "image", "title": "", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01341000/RJ01340918/1eb1229c95ab4a92a2298d62ca17d93d.jpg", "alt": "田中家の浮気事情 [BABYLON]", "title": "田中家の浮気事情 [BABYLON]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01341000/RJ01340918/393dbdabf6cdaabcca0d6c70c0c8928a.jpg", "alt": "田中家の浮気事情 [BABYLON]", "title": "田中家の浮気事情 [BABYLON]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01341000/RJ01340918/748bea868ff40003d93753ef5c783383.jpg", "alt": "田中家の浮気事情 [BABYLON]", "title": "田中家の浮気事情 [BABYLON]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01341000/RJ01340918/a4c003649346bc2db2ee99057bc4de19.jpg", "alt": "田中家の浮気事情 [BABYLON]", "title": "田中家の浮気事情 [BABYLON]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01341000/RJ01340918/ff08e12993f3806929c6e3d11551588a.jpg", "alt": "田中家の浮気事情 [BABYLON]", "title": "田中家の浮気事情 [BABYLON]"}, "position": "over"}]}, {"type": "text", "title": "", "body": [{"intro": "【どこにでもいる普通の夫婦】<br />\n夫は在宅ワークをしている会社員。妻は散歩を日課とするジムに通うアクティブな若妻。<br />\n<br />\n■環境の変化■<br />\n最近になっていままでのご近所さんが引っ越してしまい代わりに新しいご近所さん達が引っ越してきた。<br />\nごく普通に見えるご近所さん達。当たり前の日常生活――。<br />\n<br />\n新しく引っ越してきたご近所さんたちは新しい人間関係に興味津々!<br />\n手探りの近所づきあいがやがて浮気に変わりそうな危ない予感。<br />\n妻もなんか最近ソワソワしている…。<br />\n<br />\n■田中家の一日■<br />\nご近所さん達とは仲良く良好なご近所関係を築こう!<br />\n困ったときはお互い様。元気な挨拶と助け合いが近所づきあいの基本です!<br />\n<br />\n&lt;浮気も!妊娠も!親密すぎるご近所生活&gt;<br />\n特定の人物と仲良くなっていくとエッチ可能な関係に発展していきます<br />\nさらに仲良くなると濃密なエッチにエスカレートしていき妊娠させることも可能です<br />\n<br />\n&lt;妻の内緒の行動&gt;<br />\n妻は近所の男達にとても人気がありチヤホヤされているシーンをよく見かけることも…。<br />\nそんな妻が一人で過ごしている時間の秘密は探偵に依頼して調査してもらいましょう!<br />\n(見ない方が良かった…なんてことにもなりがちです)<br />\n<br />\n■妻の浮気事情<br />\n自分が自由行動をしている時にも妻は次々と男達に迫られています<br />\n妻・夏穂の寝取られ状況を覗き見ましょう!<br />\n<br />\n・会話した回数<br />\n・何気なく口説かれた回数<br />\n・キスされた回数<br />\n・乳を揉まれた回数<br />\n・膣に指を入れられた回数<br />\n・フェラチオさせられた回数<br />\n・射精された場所(お腹、口、膣、アナル…)<br />\n<br />\n&lt;妻との夫婦生活&gt;<br />\n妻との幸せな日常生活。<br />\n今日あった事などを報告したりの何気ない楽しい時を過ごす時間です<br />\n妻が寝取られている事実を掴んでいる場合にはあえて問い詰めないで泳がせることも夫婦生活には必要です?!<br />\n<br />\n■ご近所さん達の秘密■<br />\n深入りは厳禁!<br />\n仲良く親密になっていくほどに知りたくなっていくご近所さん達の真実の姿…。<br />\nそんなご近所さんの秘密は知らない方が良いことばかり?!"}]}], "description": "どこにでもいる普通の夫婦。田中雄介と夏穂。 最近引っ越してきた魅力的な奥さん達と妻にちょっかいを出す男達…。 普通じゃ無くなってくるドキドキの日常生活", "short_introduction": "どこにでもいる普通の夫婦。田中雄介と夏穂。 最近引っ越してきた魅力的な奥さん達と妻にちょっかいを出す男達…。 普通じゃ無くなってくるドキドキの日常生活", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01340918.html", "site_id": "maniax", "fetched_at": 1794949246}