doujin/RJ01360000/RJ01359694_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01360000/RJ01359694_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01360000/RJ01359694_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01360000/RJ01359694_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01360000/RJ01359694_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01360000/RJ01359694_img_smp5.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01360000/RJ01359694_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01360000/RJ01359694_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01360000/RJ01359694_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01360000/RJ01359694_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01360000/RJ01359694_img_smp5_100x100.jpg"], "alt": "元親友ちゃんと14日間同棲シミュ [イヌのすみか]"}, "introductions": [{"type": "text", "title": "女の子になった元親友ちゃんと、14日間。ずっと。", "body": [{"intro": "シンプルな同棲シミュレーション。<br />\n<br />\n※作者Ci-enにて簡単な攻略記事を作成しました。エンドリストが埋められない場合は参考にしてください。<br />\n<a href=\"https://ci-en.dlsite.com/creator/16348/article/1471985\" target=\"_blank\">https://ci-en.dlsite.com/creator/16348/article/1471985</a>"}]}, {"type": "image", "title": "", "body": [{"intro": "ある日突然女の子になってしまった「親友ちゃん」。<br />\n<br />\nゆっくりと信頼関係を築き、ちょっとずつ心の距離を縮めていきましょう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01360000/RJ01359694/9fae275a5092af5674328881fc372b67.jpg", "alt": "元親友ちゃんと14日間同棲シミュ [イヌのすみか]", "title": "元親友ちゃんと14日間同棲シミュ [イヌのすみか]"}, "position": "left"}]}, {"type": "image", "title": "", "body": [{"intro": "バカな話をしたり、一緒にゲームをしたり……。<br />\n<br />\nどのように過ごすかは、あなた次第です。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01360000/RJ01359694/9af6979cb3d8a1ef2cfe896929c714f0.jpg", "alt": "元親友ちゃんと14日間同棲シミュ [イヌのすみか]", "title": "元親友ちゃんと14日間同棲シミュ [イヌのすみか]"}, "position": "left"}]}, {"type": "image", "title": "", "body": [{"intro": "同棲期間は14日間。<br />\n<br />\n親友ちゃんとの過ごし方によって、3つのエンディングに分岐します。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01360000/RJ01359694/84cfda2e41488cc012ec2fc10b49f52f.jpg", "alt": "元親友ちゃんと14日間同棲シミュ [イヌのすみか]", "title": "元親友ちゃんと14日間同棲シミュ [イヌのすみか]"}, "position": "left"}]}, {"type": "image", "title": "", "body": [{"intro": "Hパートはコマンド選択方式。<br />\n<br />\n選択したコマンドに応じて、さまざまな反応が見られます。<br />\n<br />\n親友ちゃんも最初は緊張していますが、快感を与えることで、徐々にほぐれていきます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01360000/RJ01359694/dd4c06e7832d8ebf6054f5b4402943b6.jpg", "alt": "元親友ちゃんと14日間同棲シミュ [イヌのすみか]", "title": "元親友ちゃんと14日間同棲シミュ [イヌのすみか]"}, "position": "left"}]}, {"type": "image", "title": "", "body": [{"intro": "何回も身体を重ねることで、少しずつ「女の子度」が上昇。<br />\n<br />\n親友ちゃんの反応も、エロくなっていきます。<br />\n<br />\nそして、最後には……。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01360000/RJ01359694/226da205afb18c8cd33815a91e5c2570.jpg", "alt": "元親友ちゃんと14日間同棲シミュ [イヌのすみか]", "title": "元親友ちゃんと14日間同棲シミュ [イヌのすみか]"}, "position": "left"}]}], "description": "元親友は、Cカップ。", "short_introduction": "元親友は、Cカップ。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01359694.html", "site_id": "maniax", "fetched_at": 1794948405}