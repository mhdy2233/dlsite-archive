"}, {"category": "game", "period": "month", "rank": 32, "date": "2025-04-25"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01365000/RJ01364649_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01365000/RJ01364649_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01365000/RJ01364649_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01365000/RJ01364649_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01365000/RJ01364649_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01365000/RJ01364649_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01365000/RJ01364649_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01365000/RJ01364649_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01365000/RJ01364649_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01365000/RJ01364649_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01365000/RJ01364649_img_smp9.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01365000/RJ01364649_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01365000/RJ01364649_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01365000/RJ01364649_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01365000/RJ01364649_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01365000/RJ01364649_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01365000/RJ01364649_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01365000/RJ01364649_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01365000/RJ01364649_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01365000/RJ01364649_img_smp9_100x100.jpg"], "alt": "エレナの物語 [submissive fate]"}, "introductions": [{"type": "text", "title": "ストーリー", "body": [{"intro": "冒険者だったエレナは、地下に住む赤い肌を持つ種族であるアンインに誘拐され、物語が始まります。<br />\nエレナは地下世界の奴○交易の都市、エゴナルへと連れて行かれ、そこで生活することになります。"}]}, {"type": "image", "title": "◆ 主人公エレナと人間奴○たち", "body": [{"intro": "冒険者だったエレナは、仲間たちと共に洞窟に残された人間狩りの痕跡を追跡し、報告する任務を受けました。<br />\nしかし、エレナ一行は人間狩りの者たちに襲撃され、エレナだけが捕らえられ、奴○となってしまいます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01365000/RJ01364649/38b0f397db37c5053d779be8af1e04af.jpg", "alt": "エレナの物語 [submissive fate]", "title": "エレナの物語 [submissive fate]"}, "position": "over"}]}, {"type": "image", "title": "◆ 人間狩りの者たち(アンイン)", "body": [{"intro": "赤い肌を持つ、屈強な人型の種族です。<br />\n地下世界に住み、地上の人々を誘拐したり略奪したりしています。<br />\n彼らは小さくて弱い地上人を見下しています.", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01365000/RJ01364649/bdd86b07343d63aa052ff5ab19e954c7.jpg", "alt": "エレナの物語 [submissive fate]", "title": "エレナの物語 [submissive fate]"}, "position": "over"}]}, {"type": "image", "title": "作品が扱う物語の題材", "body": [{"intro": "アンインたちは非常に支配的でサディスティックな気質を持っています。<br />\n特にアンインの女性は数が少ないため、平均して社会では高い階級を持ち、より強い支配的傾向を示します。<br />\n物語のテーマは主に「支配と服従」「拘束と処罰」を扱っています。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01365000/RJ01364649/50bf76a202d10fd9839cfffbf8e327c0.jpg", "alt": "エレナの物語 [submissive fate]", "title": "エレナの物語 [submissive fate]"}, "position": "over"}]}, {"type": "image", "title": "ゲームのプレイスタイル", "body": [{"intro": "基本的に、インタラクションのあるビジュアルノベル形式のゲームです。<br />\nHシーンはイラストではなくモデルを使用して制作しており、<br />\n空間表現に優れたアイソメトリックビューを採用することで、より「観察者の視点」で鑑賞できるようにしました。<br />\nすべてのHシーンはアニメーション化されています。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01365000/RJ01364649/393ae47a1c26328d69e76d58fdd03622.jpg", "alt": "エレナの物語 [submissive fate]", "title": "エレナの物語 [submissive fate]"}, "position": "over"}]}, {"type": "text", "title": "お知らせ", "body": [{"intro": "本ゲームは開発中の作品です。<br />\n最初のチャプター1のリリース以降、継続的にアップデートを行っており、今後もアップデートを続けていく予定です。<br />\n詳しいアップデート情報はCi-enをご確認ください。<br />\n<br />\n<a href=\"https://ci-en.dlsite.com/creator/27502\" target=\"_blank\">https://ci-en.dlsite.com/creator/27502</a>"}]}], "description": "地下種族のハンターに捕まり、奴○となる一人の冒険少女の物語。", "short_introduction": "地下種族のハンターに捕まり、奴○となる一人の冒険少女の物語。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01364649.html", "site_id": "maniax", "fetched_at": 1794948956}