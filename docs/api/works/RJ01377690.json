image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01378000/RJ01377690/34f899b475854ef19b3259376c5da243.jpg", "alt": "幼蟲排泄 [pon]", "title": "幼蟲排泄 [pon]"}, "position": "left"}]}, {"type": "image", "title": "ぬるぬる動くアニメーション", "body": [{"intro": "エロシーンはLive2Dによるアニメーションで構成されています。<br />\n<br />\n・蟲の肛門出産<br />\n・臭い責め<br />\n・鼻姦<br />\n・食料加工による状態変化<br />\n・蟲とのアナルセックス<br />\n・脱糞<br />\n<br />\nこれらをアニメーションで楽しめます。<br />\n<br />\n音声に関しては<br />\n<br />\n・喘ぎ声(オホ声・鼻豚音　など有)<br />\n・効果音(排泄音・おなら音・脱糞音・アナルピストン音　など)<br />\n<br />\nが実装されています。<br />\nとても下品に仕上げています。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01378000/RJ01377690/c6d22aa88f5d2eafce740d8fc5f3b208.jpg", "alt": "幼蟲排泄 [pon]", "title": "幼蟲排泄 [pon]"}, "position": "over"}]}, {"type": "image", "title": "チャプターセレクト", "body": [{"intro": "チャプターセレクト画面で<br />\nゲーム本編の好きなエッチシーンに<br />\nジャンプできます。<br />\n途中から始めたい方など<br />\nご活用ください。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01378000/RJ01377690/27df7f13e45741921d66d05afdb8f744.jpg", "alt": "幼蟲排泄 [pon]", "title": "幼蟲排泄 [pon]"}, "position": "left"}]}, {"type": "image", "title": "アニメーションギャラリー", "body": [{"intro": "アニメーションギャラリーで<br />\nゲーム本編に使用されているアニメーションを<br />\nじっくり鑑賞できます。<br />\nストーリーには興味ない方、<br />\nじっくりアニメーションを見たい方などが楽しめます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01378000/RJ01377690/51dfb3f2c49a5df54615b46886f1a541.jpg", "alt": "幼蟲排泄 [pon]", "title": "幼蟲排泄 [pon]"}, "position": "left"}]}], "description": "蟲に支配され社会。彼女は幼虫を肛門出産する労働に従事することになる。", "short_introduction": "蟲に支配され社会。彼女は幼虫を肛門出産する労働に従事することになる。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01377690.html", "site_id": "maniax", "fetched_at": 1794948164}