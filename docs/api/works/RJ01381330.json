body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01382000/RJ01381330/305c7ff68bd090eb11bf0759e4950704.jpg", "alt": "青春ストリップバトラー [のらくにん]", "title": "青春ストリップバトラー [のらくにん]"}, "position": "over"}]}, {"type": "image", "title": "バトルシステム", "body": [{"intro": "着せ替えした衣装でストリップバトルを楽しむことができます！<br />\r\n<br />\r\n<br />\r\nバトルは独自のシステムを採用。ターン制でお互いに一枚ずつ衣装を脱ぎ合います。<br />\r\n衣装ごとに設定されている「脱ぎ効果」によって【キュート度】【クール度】【セクシー度】のスコアを上げていきます。<br />\r\n<br />\r\nお互い全て脱ぎ合ったら試合終了！<br />\r\n最終的に合計スコアが高い方が勝利となります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01382000/RJ01381330/27ea712200200169650ef59d049b542f.jpg", "alt": "青春ストリップバトラー [のらくにん]", "title": "青春ストリップバトラー [のらくにん]"}, "position": "under"}]}, {"type": "image", "title": "Hシーン", "body": [{"intro": "主にサブクエストを進めていくとでHシーンを見ることができます。<br />\r\nニッチなシーンもたくさんあります！<br />\r\n※CGシーンでは着せ替えは反映されません<br />\r\n<br />\r\nHな経験を積んでいくと魅力が上がり主人公のステータスも上昇していきます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01382000/RJ01381330/9b423b8eda363d2c1a8c4cd09ae1591f.jpg", "alt": "青春ストリップバトラー [のらくにん]", "title": "青春ストリップバトラー [のらくにん]"}, "position": "over"}]}, {"type": "image", "title": "ストーリー", "body": [{"intro": "春風学園に入学した主人公「サクラ」。<br />\r\nひょんなことから「ストリップ部」に入部したサクラが仲間たちと一緒にストリップバトルで大会を目指したり、学園生活を送る青春物語！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01382000/RJ01381330/7d75ece2518f0e8d19936d49ca0c3d4c.jpg", "alt": "青春ストリップバトラー [のらくにん]", "title": "青春ストリップバトラー [のらくにん]"}, "position": "over"}]}, {"type": "text", "title": "その他情報", "body": [{"intro": "・本ゲームはRPGツクールMVにて制作しています。<br />\r\n<br />\r\n・体験版公開しています。購入前に体験版での動作確認を推奨します。<br />\r\n<br />\r\n・クリア時間までは2~3時間ほどを想定しています。<br />\r\n<br />\r\n・Ci-enにて進捗情報を更新しています！興味のある人は是非フォローしていただけると励みになります。また、バグ報告などもこちらにお願いいたします。<br />\r\n<a href=\"https://ci-en.dlsite.com/creator/14149\" target=\"_blank\">https://ci-en.dlsite.com/creator/14149</a>"}]}], "description": "着せ替えパーツ450種類以上！！新感覚ストリップバトルRPG！！", "short_introduction": "着せ替えパーツ450種類以上！！新感覚ストリップバトルRPG！！",