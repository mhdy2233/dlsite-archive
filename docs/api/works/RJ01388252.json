00/RJ01388252_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01389000/RJ01388252_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01389000/RJ01388252_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01389000/RJ01388252_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01389000/RJ01388252_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01389000/RJ01388252_img_smp5.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01389000/RJ01388252_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01389000/RJ01388252_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01389000/RJ01388252_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01389000/RJ01388252_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01389000/RJ01388252_img_smp5_100x100.jpg"], "alt": "魔女の家 林中の物語 [NEKOPUNCH]"}, "introductions": [{"type": "text", "title": "ストーリー", "body": [{"intro": "漆黒の森の奥深く——<br />\n主人公は、古びた小屋の中で意識を取り戻す。<br />\n目の前にいたのは、美しくもどこか妖しげな雰囲気を纏った魔女。<br />\n彼女はかつて、教会さえも恐れた存在だった。<br />\nしかし、ある戦いをきっかけに、その力のほとんどを失ってしまっていた——。"}]}, {"type": "image", "title": "ヴィヴィアン", "body": [{"intro": "魔女狩り戦争を生き延びた数少ない高位魔女のひとり。<br />\n己の身を守り、気配を断つために魔力を封じ、大森林の奥でひっそりと隠遁生活を送っている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01389000/RJ01388252/acc524cc4f3a947ad957ab6b1b5c3ebb.jpg", "alt": "魔女の家 林中の物語 [NEKOPUNCH]", "title": "魔女の家 林中の物語 [NEKOPUNCH]"}, "position": "over"}]}, {"type": "image", "title": "リネット", "body": [{"intro": "エルフ族の見習い商人。<br />\n少しドジで、引っ込み思案な性格。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01389000/RJ01388252/ba71d938a0de026214bf9b21391aa111.jpg", "alt": "魔女の家 林中の物語 [NEKOPUNCH]", "title": "魔女の家 林中の物語 [NEKOPUNCH]"}, "position": "over"}]}, {"type": "image", "title": "画面・操作について", "body": [{"intro": "本作は、クォータービュー(斜め見下ろし視点)のピクセルアートスタイルで制作されたRPGです。<br />\nRPGmaker MZを使用して開発しています。<br />\n画面内のボタンをクリックすることで操作が行えます。<br />\nキャラクターと会話したい時は、画面上の対象キャラを直接クリックしてください。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01389000/RJ01388252/a858b938493241fa65a5970c5893fe95.jpg", "alt": "魔女の家 林中の物語 [NEKOPUNCH]", "title": "魔女の家 林中の物語 [NEKOPUNCH]"}, "position": "over"}]}, {"type": "image", "title": "手描きアニメ&amp;CG", "body": [{"intro": "ヒロインはゲームの進行にあわせて段階的に成長し、<br />\n各成長段階で専用のアニメーションが新たに解放されます。<br />\nすべてのアニメ・CGは手描きで制作されています。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01389000/RJ01388252/c2000ff8545ff57c63c4a2babba09c5e.jpg", "alt": "魔女の家 林中の物語 [NEKOPUNCH]", "title": "魔女の家 林中の物語 [NEKOPUNCH]"}, "position": "over"}]}, {"type": "text", "title": "体験版について", "body": [{"intro": "ご購入の前に、まずは体験版をお試しいただけます。<br />\n体験版では、ゲームシステム全体をしっかり体験していただけますが、<br />\nストーリーや一部の内容には制限がありますので、ご了承ください。"}]}], "description": "森で作物を育て、魔女の力を取り戻そう。", "short_introduction": "森で作物を育て、魔女の力を取り戻そう。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01388252.html", "site_id": "maniax", "fetched_at": 1794948613}