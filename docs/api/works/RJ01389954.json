{"id": "RJ01389954", "title": "調査員奇譚", "title_romaji": "chousainkitan", "circle": {"id": "RG26796", "name": "あほうとり酸素", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG26796.html"}, "type": {"code": "ADV", "name": "アドベンチャー", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 990, "official_jpy": 990, "currencies": {"USD": 6.204060965239085, "EUR": 5.637890267292947, "GBP": 4.703986224447614, "TWD": 204.53277689399417, "CNY": 41.428661100998056, "KRW": 8284.518828451883, "IDR": 113402.06185567011, "VND": 159677.41935483873, "THB": 210.24018348234196, "SEK": 62.62691439090581, "HKD": 48.68405523427357, "SGD": 7.995709776733938, "CAD": 8.869815301775306, "MYR": 25.404222233056792, "BRL": 35.30116529503216, "AUD": 9.198247315784192, "PHP": 396.53929343907714, "MXN": 115.0908520210651, "NZD": 11.26879840461133, "INR": 582.8329212292476}}, "point": {"point_amount": 54, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1747407600, "file": {"type": "EXE", "size": 327671736}, "tags": [{"key": "432", "name": "女主人公"}, {"key": "298", "name": "ミステリー"}, {"key": "324", "name": "異種えっち"}, {"key": "182", "name": "巨乳/爆乳"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 4.5, "count": 22}, "review_count": 1, "dl_count": 104, "wishlist_count": 314, "ranking": [], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01390000/RJ01389954_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01390000/RJ01389954_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01390000/RJ01389954_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01390000/RJ01389954_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01390000/RJ01389954_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01390000/RJ01389954_img_smp4.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01390000/RJ01389954_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01390000/RJ01389954_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01390000/RJ01389954_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01390000/RJ01389954_img_smp4_100x100.jpg"], "alt": "調査員奇譚 [あほうとり酸素]"}, "introductions": [{"type": "text", "title": "概要", "body": [{"intro": "シンプルな探索・選択肢型短編アドベンチャーゲームです。<br />\n<br />\n■ゲームの進め方■<br />\n<br />\n　マップを移動し、探索や人に話を聞きながら情報を集め<br />\n　まとめパートに進む流れです。<br />\n　まとめパートにおいては選択肢を選ぶだけで話が進んでゆきます。<br />\n　<br />\n　選択ミスによるゲームオーバーはありません。<br />\n　1本道シナリオです。<br />\n<br />\n■ストーリー■<br />\n<br />\n　VRトークゲームに興じるサオリとサオリの友人。<br />\n　刺激のある展開を欲した語り手サオリは、かねてより考えていたストーリーを提示する。<br />\n　<br />\n　ゲームは題して『調査員奇譚　ある行方不明の話』<br />\n<br />\n　とある調査事務所に、人探し依頼が舞い込むところから物語は始まる。<br />\n　プレイヤーであるサオリの友人が演じる役柄は、その事務所の調査員\"キャロル\"。<br />\n　彼女は「場の過去」を見ることが出来る特殊能力者。<br />\n　キャロルは、所長である\"タナカ\"と共に行方不明者\"ウロザキ\"探しへのぞんでゆく。"}]}, {"type": "image_list", "title": "人物紹介", "body": [{"intro": "■サオリ<br />\r\n<br />\r\nトークゲームが好きな女性。<br />\r\n刺激が欲しいと<br />\r\nかねてより考えていた<br />\r\nストーリーを友人に提示する。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01390000/RJ01389954/b90cecfa76ca233a8d394d4ed4fb4ce1.jpg", "alt": "調査員奇譚 [あほうとり酸素]", "title": "調査員奇譚 [あほうとり酸素]"}}, {"intro": "■サオリの友人<br />\r\n<br />\r\nよくサオリのトークゲームに<br />\r\n付き合っている友人。<br />\r\nサオリの提示したストーリーに<br />\r\n乗り気。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01390000/RJ01389954/ff0b555b69caf557aa12b31403e85bf9.jpg", "alt": "調査員奇譚 [あほうとり酸素]", "title": "調査員奇譚 [あほうとり酸素]"}}, {"intro": "■キャロル<br />\r\n<br />\r\nサオリが提示したストーリー<br />\r\n『調査員奇譚』の登場人物。<br />\r\n調査事務所職員。<br />\r\n場の\"過去\"を見ることが出来る<br />\r\n特殊能力がある。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01390000/RJ01389954/8393e144758a18347990251616b3c4d4.jpg", "alt": "調査員奇譚 [あほうとり酸素]", "title": "調査員奇譚 [あほうとり酸素]"}}, {"intro": "■タナカ<br />\r\n<br />\r\nサオリが提示したストーリー<br />\r\n『調査員奇譚』の登場人物。<br />\r\n調査事務所所長。<br />\r\nキャロルと共に<br />\r\n人探し調査にあたる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01390000/RJ01389954/fccd9cd7bbc3f2a4162a32fd93c3cf0f.jpg", "alt": "調査員奇譚 [あほうとり酸素]", "title": "調査員奇譚 [あほうとり酸素]"}}]}, {"type": "image", "title": "", "body": [{"intro": "■ウロザキ<br />\r\n<br />\r\nキャロルたちが探すことになる女性。<br />\r\n少々変わった人物らしい。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01390000/RJ01389954/ae14718c20bc3d433f8e78ad2f7addb2.jpg", "alt": "調査員奇譚 [あほうとり酸素]", "title": "調査員奇譚 [あほうとり酸素]"}, "position": "left"}]}, {"type": "text", "title": "仕様・その他", "body": [{"intro": "■仕様■<br />\n　<br />\n　・18禁シーンは1つを除き、すべてモンスター相手となります(流血。グロ描写等はありません)。<br />\n　・ストーリーの進行上、18禁シーンの9割以上は前半の探索パートにて発生します。ご容赦ください。<br />\n　・基本CG14枚　差分200枚程度の13+1シーンとなります。<br />\n<br />\n■その他■<br />\n　<br />\n　・トークゲームを題材にしたアドベンチャーゲームですが、行動判定等の要素はありません。<br />\n　・必ず体験版にて動作確認をお願いします。<br />\n　・本ゲームはRPGツクールVX Aceにて制作されています。ランタイムパッケージは必要ありません。"}]}], "description": "ある調査員の立場となり、行方不明になった人を探すシンプルなアドベンチャーゲーム。", "short_introduction": "ある調査員の立場となり、行方不明になった人を探すシンプルなアドベンチャーゲーム。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01389954.html", "site_id": "maniax", "fetched_at": 1794948598}