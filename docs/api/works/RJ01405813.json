25-08-15"}, {"category": "all", "period": "month", "rank": 1, "date": "2025-08-31"}, {"category": "all", "period": "year", "rank": 20, "date": "2025"}, {"category": "all", "period": "total", "rank": 99, "date": "2026-10-02"}, {"category": "game", "period": "day", "rank": 1, "date": "2025-08-12"}, {"category": "game", "period": "week", "rank": 1, "date": "2025-08-13"}, {"category": "game", "period": "month", "rank": 1, "date": "2025-08-31"}, {"category": "game", "period": "year", "rank": 20, "date": "2025"}, {"category": "game", "period": "total", "rank": 91, "date": "2026-10-02"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01406000/RJ01405813_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01406000/RJ01405813_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01406000/RJ01405813_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01406000/RJ01405813_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01406000/RJ01405813_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01406000/RJ01405813_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01406000/RJ01405813_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01406000/RJ01405813_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01406000/RJ01405813_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01406000/RJ01405813_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01406000/RJ01405813_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01406000/RJ01405813_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01406000/RJ01405813_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01406000/RJ01405813_img_smp6_100x100.jpg"], "alt": "CYANBRAIN/シアンブレイン [NEKOUJI]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "未知の時間、未知の空間——<br />\r\n名もなき少女が目覚めたその瞬間、宿命はすでに骨の髄に刻み込まれていた。祈りを知らぬまま、ただ壊れ果てた機械の世界に立ち向かう。<br />\r\n終わることなき殺戮と、絶望の邂逅の果てに——<br />\r\n青く揺らめく光は、幾度となく砕かれ、奪われ、それでも少女は歩みを止めなかった。<br />\r\n教会の鐘の音が、暴力と救済の狭間に響き渡り、血肉と精神の限界が崩れ落ちるとき、世界は静かにその姿を変え始める。悪夢の最深部——<br />\r\n互いの影を映し合う双つの魂が、ついに現れる。「……あなたは、自らのすべてを捧げる覚悟があるのか?」<br />\r\n存在と湮滅、恐怖と快楽を巡る、ひとつの暗黒寓話。<br />\r\n退廃系SF横スクロールアクションシューティングゲーム<br />\r\n『CYAN BRAIN』<br />\r\n※本作には暴力的・グロテスクな描写や、過激な演出が含まれます。　一部に身体的損壊・精神的凌○・性的支配を想起させる表現がございます。　<br />\r\n閲覧・プレイにはご注意ください。"}]}, {"type": "image_list", "title": "Hシステム紹介", "body": [{"intro": "♠モンスターに倒されると、対応の処刑アニメが流れます。<br />\r\n※アニメーション演出の合計時間はおよそ25分", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01406000/RJ01405813/3526d0135e355d522f14d0a47ddc1a37.jpg", "alt": "CYANBRAIN/シアンブレイン [NEKOUJI]", "title": "CYANBRAIN/シアンブレイン [NEKOUJI]"}}, {"intro": "♦全画面表示のHアニメーションを解放できます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01406000/RJ01405813/500ddc83d3ca5ca68da30b296974cb68.jpg", "alt": "CYANBRAIN/シアンブレイン [NEKOUJI]", "title": "CYANBRAIN/シアンブレイン [NEKOUJI]"}}, {"intro": "■処刑アニメーションの再生後に、死亡カードを入手できます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01406000/RJ01405813/4e9ffe370db704cb232fccaf2dabbd78.jpg", "alt": "CYANBRAIN/シアンブレイン [NEKOUJI]", "title": "CYANBRAIN/シアンブレイン [NEKOUJI]"}}, {"intro": "♣戦闘中、ダメージを受けることで衣装が段階的に破損！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01406000/RJ01405813/f801c3ffef317a065405f9947fcf0e91.jpg", "alt": "CYANBRAIN/シアンブレイン [NEKOUJI]", "title": "CYANBRAIN/シアンブレイン [NEKOUJI]"}}]}, {"type": "image_list", "title": "登場人物[ゲーム内全台詞フルボイス対応]", "body": [{"intro": "主人公<br />\r\nCV.恋鈴桃歌<br />\r\n記憶を失った主人公は、<br />\r\n巨大な廃墟都市を舞台に、さまざまな敵性体や怪物との戦闘を繰り広げていく。<br />\r\n敵との過酷な戦いを重ねる中で、少女は自身の能力を高め、<br />\r\n新たな強力武器を見つけ出し、解放していく。<br />\r\n世界各地に散らばる「記憶の断片」を手がかりに、<br />\r\nこの荒廃した世界の真実へと近づいていく。<br />\r\n旅の途中で出会う仲間たちとの絆は、少女の歩みに確かな意味を与え、<br />\r\nやがて訪れる「運命の終焉」へと、共に進んでいくこととなる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01406000/RJ01405813/929b53de198698e547f9b67a4b9054a5.jpg", "alt": "CYANBRAIN/シアンブレイン [NEKOUJI]", "title": "CYANBRAIN/シアンブレイン [NEKOUJI]"}}, {"intro": "HS202<br />\r\nCV.涼貴涼<br />\r\n教会の狩猟部隊のメンバーだけど……どうやら迷子になっちゃったみたい。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01406000/RJ01405813/9624e24932dec7acca6ac91be6d2a4a8.jpg", "alt": "CYANBRAIN/シアンブレイン [NEKOUJI]", "title": "CYANBRAIN/シアンブレイン [NEKOUJI]"}}, {"intro": "L<br />\r\nCV.御子柴泉<br />\r\nかつての修女会だった彼女は、遺された計画を主人公に託した。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01406000/RJ01405813/631ca928a470bf7ebccfe3a8cc5c43af.jpg", "alt": "CYANBRAIN/シアンブレイン [NEKOUJI]", "title": "CYANBRAIN/シアンブレイン [NEKOUJI]"}}, {"intro": "M<br />\r\nCV.乙倉由依<br />\r\n奇妙な領域に現れた謎の少女", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01406000/RJ01405813/51e317c448b2b8d2ddfcdfd960a06ce0.jpg", "alt": "CYANBRAIN/シアンブレイン [NEKOUJI]", "title": "CYANBRAIN/シアンブレイン [NEKOUJI]"}}]}, {"type": "image", "title": "殺人機械、改造人間、変異動物との死闘", "body": [{"intro": "全29種類の敵や罠が登場！<br />\r\n敗北時には敵ごとに異なる2Dアニメーションが再生され、それぞれ個性的な演出を楽しめます。<br />\r\nさらに、ゲーム全編にわたって高品質かつリアルなサウンドエフェクトを実装。没入感を一層高めます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01406000/RJ01405813/7a1af1ba8085e9fa46555a66706300af.jpg", "alt": "CYANBRAIN/シアンブレイン [NEKOUJI]", "title": "CYANBRAIN/シアンブレイン [NEKOUJI]"}, "position": "over"}]}, {"type": "image_list", "title": "重みと破壊力を備えた多種のガチ武器", "body": [{"intro": "銃器ごとの性能に応じて、敵に与える破壊表現も変化します。<br />\r\nゲーム内には反動システムがあり、武器ごとに威力や敵を吹き飛ばす効果が異なります。<br />\r\nさらに、敵の種類に応じて異なる撃破アニメーションも用意されています。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01406000/RJ01405813/4278ede61724c31bce63a50578bea625.jpg", "alt": "CYANBRAIN/シアンブレイン [NEKOUJI]", "title": "CYANBRAIN/シアンブレイン [NEKOUJI]"}}, {"intro": "攻撃が命中すると、ランダムかつリアルな血飛沫が飛び散ります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01406000/RJ01405813/b2e9ec24e95b9c81f2ebb99d7f7c670d.jpg", "alt": "CYANBRAIN/シアンブレイン [NEKOUJI]", "title": "CYANBRAIN/シアンブレイン [NEKOUJI]"}}, {"intro": "搭乗可能な強力兵器が戦場に投入される！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01406000/RJ01405813/0294fd7cbbdb8b8c1f347f6912c331cf.jpg", "alt": "CYANBRAIN/シアンブレイン [NEKOUJI]", "title": "CYANBRAIN/シアンブレイン [NEKOUJI]"}}]}, {"type": "image", "title": "高品質な3Dステージ", "body": [{"intro": "2Dと3Dを組み合わせた背景が、美しい光や反射をリアルに描き出します。シーンの移り変わりや動きも臨場感たっぷりに表現されています。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01406000/RJ01405813/7d2a74f5c698040254ccfcb6e95185f6.jpg", "alt": "CYANBRAIN/シアンブレイン [NEKOUJI]", "title": "CYANBRAIN/シアンブレイン [NEKOUJI]"}, "position": "over"}]}], "description": "記憶を失った主人公は、 巨大な廃墟都市を舞台に、さまざまな敵性体や怪物との戦闘を繰り広げていく。  敵との過酷な戦いを重ねる中で、少女は自身の能力を高め、 新たな強力武器を見つけ出し、解放していく。  世界各地に散らばる「記憶の断片」を手がかりに、 この荒廃した世界の真実へと近づいていく。  旅の途中で出会う仲間たちとの絆は、少女の歩みに確かな意味を与え、 やがて訪れる「運命の終焉」へと、共に進んでいくこととなる。", "short_introduction": "記憶を失った主人公は、 巨大な廃墟都市を舞台に、さまざまな敵性体や怪物との戦闘を繰り広げていく。  敵との過酷な戦いを重ねる中で、少女は自身の能力を高め、 新たな強力武器を見つけ出し、解放していく。  世界各地に散らばる「記憶の断片」を手がかりに、 この荒廃した世界の真実へと近づいていく。  旅の途中で出会う仲間たちとの絆は、少女の歩みに確かな意味を与え、 やがて訪れる「運命の終焉」へと、共に進んでいくこととなる。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01405813.html", "site_id": "maniax", "fetched_at": 1794947981}