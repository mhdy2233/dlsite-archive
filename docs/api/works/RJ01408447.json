es": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01409000/RJ01408447_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01409000/RJ01408447_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01409000/RJ01408447_img_smp3.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01409000/RJ01408447_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01409000/RJ01408447_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01409000/RJ01408447_img_smp3_100x100.jpg"], "alt": "ゲーム制作と青い春 [えるりんご]"}, "introductions": [{"type": "text", "title": "あらすじ", "body": [{"intro": "主人公の夏都は、同人誌即売会でノベルゲームを頒布したことをきっかけにゲーム会社に就職した。<br />\nゲーム会社でさまざまなことを経験しつつ、同人ノベルゲームも制作しつつ充実した日々を送っていた。<br />\nしかしある日、彼に人生の選択が訪れる。"}]}, {"type": "image_list", "title": "登場人物", "body": [{"intro": "【夏都(なつと)】<br />\n主人公。エンジニア。<br />\n素直で前向きな性格だが、ときどき無鉄砲。<br />\n趣味は同人ノベルゲームを作ること。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01409000/RJ01408447/5e6da03c92496eb5b8bfb68a334d209e.jpg", "alt": "ゲーム制作と青い春 [えるりんご]", "title": "ゲーム制作と青い春 [えるりんご]"}}, {"intro": "【葉月(はづき)】<br />\n夏都が作る同人ゲームのファン。<br />\n夏都よりも年上。<br />\n熟練のノベルゲームプレイヤー。<br />\n同人誌即売会で、新作のノベルゲームを片っ端から買い集めてレビューを書いている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01409000/RJ01408447/8c2312646be26e6ca8d9ea1e5f86e1cb.jpg", "alt": "ゲーム制作と青い春 [えるりんご]", "title": "ゲーム制作と青い春 [えるりんご]"}}, {"intro": "【洋子(ようこ)】<br />\n夏都の会社の同期で、仕事の相棒。エンジニア。<br />\nお金と食べることが大好き。<br />\n口が悪く、職業柄正論を言うことが多い。<br />\n夏都が困っているときは助けてくれる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01409000/RJ01408447/38973b8734a0af9b43e0bf70d7cfbde6.jpg", "alt": "ゲーム制作と青い春 [えるりんご]", "title": "ゲーム制作と青い春 [えるりんご]"}}, {"intro": "【冬夜(とうや)】<br />\n夏都の大学時代からの友人で、会社の同期。プランナー。<br />\n甘いものが好き。口が悪いのは相変わらず。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01409000/RJ01408447/b8c44e6c78523b68b0bb686e8d95596d.jpg", "alt": "ゲーム制作と青い春 [えるりんご]", "title": "ゲーム制作と青い春 [えるりんご]"}}]}, {"type": "image_list", "title": "登場人物", "body": [{"intro": "【めめ】<br />\n夏都の会社の同期。エンジニア。<br />\n美少女とエロゲーが大好きな女の子。同性愛者。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01409000/RJ01408447/f1a8f342e57983236523e1c01886197e.jpg", "alt": "ゲーム制作と青い春 [えるりんご]", "title": "ゲーム制作と青い春 [えるりんご]"}}, {"intro": "【リリー】<br />\n夏都の会社の先輩。デザイナー。<br />\nBLとうさぎが大好き。冬夜×夏都で妄想中。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01409000/RJ01408447/a34d4a7893e13069d0d99c9862b23042.jpg", "alt": "ゲーム制作と青い春 [えるりんご]", "title": "ゲーム制作と青い春 [えるりんご]"}}, {"intro": "【梶谷(かじたに)】<br />\n夏都の会社の先輩。プロデューサー。<br />\nBLが大好きな男性。夏都×冬夜で妄想中。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01409000/RJ01408447/f593a4e49a4e9d1cfc186d66e165f751.jpg", "alt": "ゲーム制作と青い春 [えるりんご]", "title": "ゲーム制作と青い春 [えるりんご]"}}, {"intro": "【茂松(しげまつ)】<br />\n夏都の会社の先輩。エンジニア。<br />\nどこか抜けている残念なイケメン男性。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01409000/RJ01408447/4d6918a1e3e45214a878ec8a5ace89b4.jpg", "alt": "ゲーム制作と青い春 [えるりんご]", "title": "ゲーム制作と青い春 [えるりんご]"}}]}, {"type": "text_list", "title": "ゲーム概要", "body": [{"intro": "総プレイ時間(オートモード選択時):23時間程度"}, {"intro": "ED数:6"}, {"intro": "選択肢:あり"}, {"intro": "イベントスチル枚数:53枚(+差分)"}, {"intro": "キャラクターボイス:なし"}, {"intro": "リリース日:2025/08/17"}]}], "description": "ゲーム会社の仕事と同人ゲーム制作に日々を費やした大人の青春ドラマノベルゲーム", "short_introduction": "ゲーム会社の仕事と同人ゲーム制作に日々を費やした大人の青春ドラマノベルゲーム", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01408447.html", "site_id": "home", "fetched_at": 1794947899}