te": "2025-08-06"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01427000/RJ01426997_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01427000/RJ01426997_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01427000/RJ01426997_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01427000/RJ01426997_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01427000/RJ01426997_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01427000/RJ01426997_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01427000/RJ01426997_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01427000/RJ01426997_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01427000/RJ01426997_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01427000/RJ01426997_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01427000/RJ01426997_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01427000/RJ01426997_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01427000/RJ01426997_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01427000/RJ01426997_img_smp6_100x100.jpg"], "alt": "お姫様救出クエスト ローズ編 [青りんご]"}, "introductions": [{"type": "text", "title": "前作の登場人物「ローズ」視点での救出劇。", "body": [{"intro": "お姫様がさらわれた…いざ救出へ…！<br />\nクリスタルにより巨大な魔力を手にし、盗賊達と手を組んで姫を誘拐した魔法使い「シャドウ」<br />\n彼らのアジトとする洞窟へ向かうとそこには多くの人々が住む一つの街があった…<br />\n<br />\n前作「お姫様救出クエスト」に登場した、カイルの姉であるローズ。今回はローズ視点で描くお姫様救出劇。<br />\n<br />\n明るく楽観的で親しみやすい性格と、36歳の人妻の色気が男たちを魅了する。<br />\n街に潜む好色な男たちの情欲から逃れ、無事お姫様を救出し洞窟から脱出できるのか…?<br />\n<br />\n前回のローズのシーンの詳細をボリュームアップし、さらに新イベントも複数追加。<br />\n<br />\n基本CG45枚<br />\n(描き下ろし42枚+前作の加筆修正3枚)"}]}, {"type": "image_list", "title": "セクハラシーン", "body": [{"intro": "洞窟内を進んでいくと街が現れ、戸惑うローズ。住人たちに話を聞くも…", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01427000/RJ01426997/d8e81dc25c50725a91cf280f52462da6.jpg", "alt": "お姫様救出クエスト ローズ編 [青りんご]", "title": "お姫様救出クエスト ローズ編 [青りんご]"}}, {"intro": "セクハラに慣れっこなローズは男たちを軽くあしらう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01427000/RJ01426997/ef618edde27ac6fcccd388beb4466cb9.jpg", "alt": "お姫様救出クエスト ローズ編 [青りんご]", "title": "お姫様救出クエスト ローズ編 [青りんご]"}}]}, {"type": "image_list", "title": "ローズを狙う男たち、その他イベントも追加。", "body": [{"intro": "情報収集のつもりが女好きの若い男に…", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01427000/RJ01426997/501becc0efa48287703f5f34a929e684.jpg", "alt": "お姫様救出クエスト ローズ編 [青りんご]", "title": "お姫様救出クエスト ローズ編 [青りんご]"}}, {"intro": "因縁の男と再会。シャドウのことを何か知っているようだ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01427000/RJ01426997/43177e31a0ad4b12288090aff6214b61.jpg", "alt": "お姫様救出クエスト ローズ編 [青りんご]", "title": "お姫様救出クエスト ローズ編 [青りんご]"}}, {"intro": "温泉シーンもあり。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01427000/RJ01426997/498c3ca20447ca8527b55e08fc49aef8.jpg", "alt": "お姫様救出クエスト ローズ編 [青りんご]", "title": "お姫様救出クエスト ローズ編 [青りんご]"}}, {"intro": "失敗すればシャドウに…", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01427000/RJ01426997/8763849dc18b8e99ad637bf92efcde9c.jpg", "alt": "お姫様救出クエスト ローズ編 [青りんご]", "title": "お姫様救出クエスト ローズ編 [青りんご]"}}]}, {"type": "text", "title": "", "body": [{"intro": "RPGツクールMZで制作しています。<br />\n<br />\n体験版にて動作確認お願いします。"}]}], "description": "お姫様が盗賊達にさらわれた…いざ救出へ…！前作「お姫様救出クエスト」の登場人物「ローズ」視点での物語。", "short_introduction": "お姫様が盗賊達にさらわれた…いざ救出へ…！前作「お姫様救出クエスト」の登場人物「ローズ」視点での物語。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01426997.html", "site_id": "maniax", "fetched_at": 1794948179}