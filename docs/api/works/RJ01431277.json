iod": "month", "rank": 1, "date": "2025-08-19"}, {"category": "all", "period": "year", "rank": 41, "date": "2025"}, {"category": "all", "period": "total", "rank": 294, "date": "2026-06-12"}, {"category": "game", "period": "day", "rank": 1, "date": "2025-08-01"}, {"category": "game", "period": "week", "rank": 1, "date": "2025-08-02"}, {"category": "game", "period": "month", "rank": 1, "date": "2025-08-17"}, {"category": "game", "period": "year", "rank": 36, "date": "2025"}, {"category": "game", "period": "total", "rank": 251, "date": "2026-06-12"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01432000/RJ01431277_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01432000/RJ01431277_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01432000/RJ01431277_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01432000/RJ01431277_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01432000/RJ01431277_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01432000/RJ01431277_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01432000/RJ01431277_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01432000/RJ01431277_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01432000/RJ01431277_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01432000/RJ01431277_img_smp8.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01432000/RJ01431277_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01432000/RJ01431277_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01432000/RJ01431277_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01432000/RJ01431277_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01432000/RJ01431277_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01432000/RJ01431277_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01432000/RJ01431277_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01432000/RJ01431277_img_smp8_100x100.jpg"], "alt": "ダンジョンアンドブライド [まくらカバーソフト]"}, "introductions": [{"type": "image", "title": "多彩なHシステムと本格的なゲーム内容の豪華ダンジョンRPG", "body": [{"intro": "※こちらでゲームをさらに詳しく紹介しております。ぜひご覧ください!<br />\n<a href=\"http://www.makuracover.com/dungeon/top.htm\" target=\"_blank\">http://www.makuracover.com/dungeon/top.htm</a><br />\n<br />\n■超本格派のダンジョンRPG<br />\n■自由なパーティー編成、キャラクターメイキング<br />\n■充実の装備着せ替えシステム<br />\n■RPGの夜のお楽しみを再現した「ホテル予約システム」<br />\n■敵パーティーと女の子を奪い合う「決闘システム」<br />\n■モンスターによる捕縛陵○<br />\n■CG差分抜きで80枚超、Hイベントは派生抜きで70を超えます<br />\n■ヒロインキャラ全部で10人、フルボイスです", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01432000/RJ01431277/af77843ccf3ce69c7bf6ae5016c7a177.jpg", "alt": "ダンジョンアンドブライド [まくらカバーソフト]", "title": "ダンジョンアンドブライド [まくらカバーソフト]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "■自由度の高い本格派のダンジョンRPG<br />\n本格的なシステムを導入した、大ボリュームの寝取られダンジョンRPGです。<br />\nダンジョン、クエスト、魔法、アイテム、モンスター等々すべてが作り込まれており、一般向けゲーム並の本格的なRPGを楽しむことができます。<br />\n非常に自由度が高く、キャラクターを自分で作ったり、攻略するダンジョンや受けるクエストを自由に選べます。<br />\n<br />\n■キャラクターメイキング<br />\nなんとヒロインを自分で作ることができます。<br />\nヒューマンやエルフなど5つの種族の中から種族を選び、自分で名前・髪色・職業などを決定し、好きなだけギルドに登録できます。<br />\n自分だけのキャラクターでパーティーを編成できます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01432000/RJ01431277/60c66af25ad1df07b90ee6f32e99245f.jpg", "alt": "ダンジョンアンドブライド [まくらカバーソフト]", "title": "ダンジョンアンドブライド [まくらカバーソフト]"}, "position": "left"}]}, {"type": "image", "title": "", "body": [{"intro": "■装備着せ替えシステム<br />\n装備アイテムは手・足・胸・腰・下着・アクセサリなど身体の各部位ごとに装備できます。<br />\n装備するとキャラクターの画像が変化し、着せ替え感覚で楽しむことができます。<br />\n装備アイテムは200種以上です。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01432000/RJ01431277/09effef23f5e93f43094c756705e3bb7.jpg", "alt": "ダンジョンアンドブライド [まくらカバーソフト]", "title": "ダンジョンアンドブライド [まくらカバーソフト]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "■RPGの夜のお楽しみを再現した「ホテル予約システム」<br />\n宿屋の部屋割りをプレイヤーが決めることができます。<br />\nヒロインと男キャラを同室にすると、様々なHイベントが発生します。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01432000/RJ01431277/ecd6713f2354d860657b060106862c7a.jpg", "alt": "ダンジョンアンドブライド [まくらカバーソフト]", "title": "ダンジョンアンドブライド [まくらカバーソフト]"}, "position": "left"}]}, {"type": "image", "title": "", "body": [{"intro": "■敵パーティーと女の子を奪い合う「決闘システム」<br />\n探索中にライバルパーティーから決闘を挑まれることがあります。<br />\n決闘に負けるとヒロインを奪われ、色々Hなことをされてしまいます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01432000/RJ01431277/dbfd55a7bb47dbdddc7e0a726ba7c716.jpg", "alt": "ダンジョンアンドブライド [まくらカバーソフト]", "title": "ダンジョンアンドブライド [まくらカバーソフト]"}, "position": "left"}]}, {"type": "image", "title": "", "body": [{"intro": "■モンスターによる捕縛システム<br />\n戦闘中、一部のモンスターはヒロインを捕らえて陵○しようとします。<br />\n捕らえられたヒロインを救出できないとHに持ち込まれてしまいます。<br />\n男性キャラがサキュバスに陵○されることもあります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01432000/RJ01431277/1ab2e20b89edece61166fe07628fecb0.jpg", "alt": "ダンジョンアンドブライド [まくらカバーソフト]", "title": "ダンジョンアンドブライド [まくらカバーソフト]"}, "position": "left"}]}], "description": "自由なパーティー編成と豪華システムの本格派寝取られダンジョンRPG", "short_introduction": "自由なパーティー編成と豪華システムの本格派寝取られダンジョンRPG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01431277.html", "site_id": "maniax", "fetched_at": 1794948073}