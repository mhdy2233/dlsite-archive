26-01-09"}, {"category": "game", "period": "day", "rank": 2, "date": "2025-12-12"}, {"category": "game", "period": "week", "rank": 2, "date": "2025-12-15"}, {"category": "game", "period": "month", "rank": 7, "date": "2025-12-21"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01433000/RJ01432892_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01433000/RJ01432892_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01433000/RJ01432892_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01433000/RJ01432892_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01433000/RJ01432892_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01433000/RJ01432892_img_smp4.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01433000/RJ01432892_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01433000/RJ01432892_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01433000/RJ01432892_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01433000/RJ01432892_img_smp4_100x100.jpg"], "alt": "MazeCave II~肛門の逆襲~ [東京乳業]"}, "introductions": [{"type": "text", "title": "Story", "body": [{"intro": "それは誰にも知られざる地下。<br />\r\n悪意と欲望が血肉となり、呪われた――MazeCaveを形づくった.......<br />\r\n<br />\r\nそれは偉大なる戦争の終焉であり、同時に新たなる時代の幕開けでもあった。<br />\r\n<br />\r\nああ……帰魂者よ――<br />\r\n我らを導け、この終わりなき暗黒の地下より……！"}]}, {"type": "image", "title": "戦敗すれば――人格は排泄される", "body": [{"intro": "どんな敵に屈しても、戦闘敗北時には淫靡な敗北イベントが発生。<br />\r\nボスに、そして迷宮の魔物たちに、魂ごと嬲られる快楽を味わえ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01433000/RJ01432892/f1d0d76d7b8bf22ab4c9ea64720605f8.jpg", "alt": "MazeCave II~肛門の逆襲~ [東京乳業]", "title": "MazeCave II~肛門の逆襲~ [東京乳業]"}, "position": "over"}]}, {"type": "image_list", "title": "キャラクター", "body": [{"intro": "■喚霊女:<br />\r\n<br />\r\n主人公を目覚めさせる神秘的な女性。<br />\r\n祭祀場を守護し、主人公の能力を高める。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01433000/RJ01432892/a524e4591d69df1834fc57882e1a5eda.jpg", "alt": "MazeCave II~肛門の逆襲~ [東京乳業]", "title": "MazeCave II~肛門の逆襲~ [東京乳業]"}}, {"intro": "■人格熔炉:<br />\r\n<br />\r\n調教と改造を経て救い出された女性。<br />\r\n体内に挿入された“大人格”を本源の力として育むことができる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01433000/RJ01432892/6d09ac2d980e6cbea3eb2f1554e6ac64.jpg", "alt": "MazeCave II~肛門の逆襲~ [東京乳業]", "title": "MazeCave II~肛門の逆襲~ [東京乳業]"}}, {"intro": "■触手の母:<br />\r\n<br />\r\n快楽に溺れた女性は、無数の触手を孕んでいる。<br />\r\n帰魂者が意識を失った際、彼女はその身を祭祀場へと運び戻す。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01433000/RJ01432892/9982c608f866f70d39a5eacd8106a1c5.jpg", "alt": "MazeCave II~肛門の逆襲~ [東京乳業]", "title": "MazeCave II~肛門の逆襲~ [東京乳業]"}}, {"intro": "■迷宮の宝庫:<br />\r\n<br />\r\n身体が異次元と接続された女性。<br />\r\n主人公のためにさまざまなアイテムを保管している。<br />\r\n異次元の影響により、時折意味不明な言葉を口にすることがある。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01433000/RJ01432892/3f5e941134bc0cbf51f661461d3091f3.jpg", "alt": "MazeCave II~肛門の逆襲~ [東京乳業]", "title": "MazeCave II~肛門の逆襲~ [東京乳業]"}}]}, {"type": "image", "title": "遊び方", "body": [{"intro": "A/W/S/Dキーで移動、Shiftキーで回避。<br />\r\nマウス左クリックで軽攻撃、右クリックで強攻撃、ホイールクリックでガード・パリィ。<br />\r\nFキーでスキル発動、Rキーでスキルをキャンセル(進行度をリセット)。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01433000/RJ01432892/c87739079756a8ea448ea17e9056972f.jpg", "alt": "MazeCave II~肛門の逆襲~ [東京乳業]", "title": "MazeCave II~肛門の逆襲~ [東京乳業]"}, "position": "over"}]}, {"type": "image", "title": "モンスター", "body": [{"intro": "25種類のエロモンスターが登場！<br />\r\n4人の「迷宮の主」ボスが、あなたの挑戦を待ち受ける！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01433000/RJ01432892/f54d4fabe99d52e2ae420e190a521026.jpg", "alt": "MazeCave II~肛門の逆襲~ [東京乳業]", "title": "MazeCave II~肛門の逆襲~ [東京乳業]"}, "position": "over"}]}, {"type": "image", "title": "戦闘ステージ", "body": [{"intro": "多彩なスタイルの地下迷宮に、様々な戦闘ルームが存在する。<br />\r\n<br />\r\n■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■<br />\r\n<br />\r\nその他<br />\r\n<br />\r\n対応言語<br />\r\n・日本語<br />\r\n・English<br />\r\n・簡体中文<br />\r\n・繁体中文<br />\r\n<br />\r\n回想シーン機能あり<br />\r\n<br />\r\n■企画・シナリオ<br />\r\n東京乳業Tokyo Dairy<br />\r\nX (@Tokyo_Dairy)<br />\r\n<br />\r\n※バグ報告・アップデート情報:<br />\r\n<a href=\"https://ci-en.dlsite.com/creator/26136\" target=\"_blank\">https://ci-en.dlsite.com/creator/26136</a>", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01433000/RJ01432892/3233567c7f5fa280169035d1aae9cee8.jpg", "alt": "MazeCave II~肛門の逆襲~ [東京乳業]", "title": "MazeCave II~肛門の逆襲~ [東京乳業]"}, "position": "over"}]}], "description": "錯綜とした迷宮の中でモンスターを斬り倒し、大人格を奪おう！", "short_introduction": "錯綜とした迷宮の中でモンスターを斬り倒し、大人格を奪おう！", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01432892.html", "site_id": "maniax", "fetched_at": 1794947076}