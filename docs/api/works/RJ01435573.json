": "all", "period": "month", "rank": 79, "date": "2025-09-21"}, {"category": "game", "period": "day", "rank": 6, "date": "2025-08-23"}, {"category": "game", "period": "week", "rank": 13, "date": "2025-08-27"}, {"category": "game", "period": "month", "rank": 30, "date": "2025-09-02"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01436000/RJ01435573_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01436000/RJ01435573_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01436000/RJ01435573_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01436000/RJ01435573_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01436000/RJ01435573_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01436000/RJ01435573_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01436000/RJ01435573_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01436000/RJ01435573_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01436000/RJ01435573_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01436000/RJ01435573_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01436000/RJ01435573_img_smp9.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01436000/RJ01435573_img_smp10.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01436000/RJ01435573_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01436000/RJ01435573_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01436000/RJ01435573_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01436000/RJ01435573_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01436000/RJ01435573_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01436000/RJ01435573_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01436000/RJ01435573_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01436000/RJ01435573_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01436000/RJ01435573_img_smp9_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01436000/RJ01435573_img_smp10_100x100.jpg"], "alt": "エーテルナイツ～セーラーヒロイン凄絶○問～ [いぼつきぐんて]"}, "introductions": [{"type": "image", "title": "ストーリー", "body": [{"intro": "ブレイズ・アクアのコンビを中心に活躍する、正義のセーラーヒロインチーム「エーテルナイツ」。<br />\r\n悪の秘密結社を討伐すべくアジトへ乗り込んだ彼女たちは、卑劣な罠に嵌まり結社に囚われてしまう。<br />\r\n<br />\r\nただ一人、罠を逃れたアクアはプライベートに身を隠し、仲間たちを救出する作戦の準備を進める。<br />\r\n一方その頃、結社のアジトではアクアの居場所を白状させるべく、ブレイズへの○問が始まった。<br />\r\n<br />\r\n痛みによる○問、快楽による○問、SM調教による○問……。<br />\r\n<br />\r\n果たしてブレイズは、救出作戦の準備が整うまでアクアの居場所を守り通すことができるのか。<br />\r\nそして、物語の結末は……?", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01436000/RJ01435573/593bdea5aab955cfb9a89694fac2baef.jpg", "alt": "エーテルナイツ～セーラーヒロイン凄絶○問～ [いぼつきぐんて]", "title": "エーテルナイツ～セーラーヒロイン凄絶○問～ [いぼつきぐんて]"}, "position": "over"}]}, {"type": "image", "title": "どんなゲーム?", "body": [{"intro": "悪の秘密結社に捕らわれたセーラーヒロイン、ブレイズとなり、<br />\r\n結社のアジト内を探索するアクションRPGです。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01436000/RJ01435573/43bf2b6b4c26ce2a1f708e4b01f635c5.jpg", "alt": "エーテルナイツ～セーラーヒロイン凄絶○問～ [いぼつきぐんて]", "title": "エーテルナイツ～セーラーヒロイン凄絶○問～ [いぼつきぐんて]"}, "position": "over"}]}, {"type": "image", "title": "結社による○問を耐え抜こう", "body": [{"intro": "結社のアジトには○問室が点在し、<br />\r\n中に入るとブレイズへの○問が始まります。<br />\r\n<br />\r\n探索を怠って○問に臨むとブレイズはアクアの居場所を白状してしまいます。<br />\r\nその結果、アクアまでもが結社に囚われてしまい、二人揃って悲惨な末路を迎えることに。<br />\r\nあらかじめ精力剤を取得し、○問耐久力を上げておきましょう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01436000/RJ01435573/b912342bb8da7b6591feee638a606946.jpg", "alt": "エーテルナイツ～セーラーヒロイン凄絶○問～ [いぼつきぐんて]", "title": "エーテルナイツ～セーラーヒロイン凄絶○問～ [いぼつきぐんて]"}, "position": "over"}]}, {"type": "image", "title": "アジトには奴○娼館や○問場、研究施設まで", "body": [{"intro": "アジト内には多種多様なエリアが存在し、その特色に応じたエッチシーンが発生します。<br />\r\nまた、各エリアでは捕まった仲間たちが酷い目に遭わされており、<br />\r\nその様子をボイス付きのドットアニメで鑑賞することができます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01436000/RJ01435573/fdb35fb1188f03b5697368dc904030de.jpg", "alt": "エーテルナイツ～セーラーヒロイン凄絶○問～ [いぼつきぐんて]", "title": "エーテルナイツ～セーラーヒロイン凄絶○問～ [いぼつきぐんて]"}, "position": "over"}]}, {"type": "image", "title": "ブレイズとアクアを襲う幾多のピンチ", "body": [{"intro": "反省房に入れられ、スパンキング&amp;ロウソク責め。<br />\r\n研究所エリアにて、機械○によるアナル開発。<br />\r\n結社のペットに成り果てた姿を街の住民たちに晒される。等々。<br />\r\n<br />\r\nループアニメや各種エフェクトを多用したエッチシーンをお楽しみください。<br />\r\nブレイズたちが捕縛されるオープニングも含めて、エッチシーン中はヒロインフルボイスです。<br />\r\n<br />\r\n<br />\r\nヒロインピンチ、DIDがお好きな方は是非どうぞ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01436000/RJ01435573/b541d65a702c7d27932ceee0539de80d.jpg", "alt": "エーテルナイツ～セーラーヒロイン凄絶○問～ [いぼつきぐんて]", "title": "エーテルナイツ～セーラーヒロイン凄絶○問～ [いぼつきぐんて]"}, "position": "over"}]}, {"type": "text", "title": "基本情報", "body": [{"intro": "◯エッチシーンはヒロインフルボイス<br />\r\n◯収録エッチシーン数20<br />\r\n○エッチシーン中のループアニメ多数。<br />\r\n◯シーン回想モード、ドットアニメ回想モードあり。<br />\r\n○アクションが苦手な方向けに、イージーモードあり。<br />\r\n◯プレイ時間およそ4時間程度。<br />\r\n<br />\r\nキャラクターボイス<br />\r\nブレイズ……あいりん<br />\r\nアクア……kokko<br />\r\n女帝メリーサ……このえゆずこ<br />\r\n<br />\r\n<br />\r\n※本作品は「RPGツクールMZ」で制作されています。<br />\r\n※ご購入の前に体験版で動作をご確認ください。<br />\r\n<br />\r\n<br />\r\n■■■■■■■■■■■■■■■■■■■■■■■■■■■■<br />\r\n<br />\r\nより詳しくは、Cienを御覧ください。<br />\r\n<br />\r\n<a href=\"https://ci-en.dlsite.com/creator/4852\" target=\"_blank\">https://ci-en.dlsite.com/creator/4852</a><br />\r\n<br />\r\n■■■■■■■■■■■■■■■■■■■■■■■■■■■■"}]}], "description": "悪の秘密結社に捕らわれたセーラーヒロインとなり、結社のアジト内を探索するアクションRPGです。○問、SM調教、快楽責め等のヒロインピンチが多数。ループアニメを多用したエッチシーンはヒロインフルボイス。", "short_introduction": "悪の秘密結社に捕らわれたセーラーヒロインとなり、結社のアジト内を探索するアクションRPGです。○問、SM調教、快楽責め等のヒロインピンチが多数。ループアニメを多用したエッチシーンはヒロインフルボイス。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01435573.html", "site_id": "maniax", "fetched_at": 1794947924}