{"id": "RJ01438988", "title": "フィーネと封じられた書庫", "title_romaji": "fwiinetofuujiraretashoko", "circle": {"id": "RG45316", "name": "らて茶場", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG45316.html"}, "type": {"code": "RPG", "name": "ロールプレイング", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 440, "official_jpy": 440, "currencies": {"USD": 2.757360428995149, "EUR": 2.5057290076857544, "GBP": 2.0906605441989394, "TWD": 90.90345639733074, "CNY": 18.412738267110246, "KRW": 3682.008368200837, "IDR": 50400.91638029782, "VND": 70967.74193548388, "THB": 93.44008154770754, "SEK": 27.834184173735917, "HKD": 21.637357881899366, "SGD": 3.553648789659528, "CAD": 3.9421401341223583, "MYR": 11.29076543691413, "BRL": 15.689406797792072, "AUD": 4.088109918126308, "PHP": 176.23968597292318, "MXN": 51.15148978714005, "NZD": 5.008354846493924, "INR": 259.0368538796656}}, "point": {"point_amount": 24, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1753858800, "file": {"type": "EXE", "size": 242381549}, "tags": [{"key": "502", "name": "男主人公"}, {"key": "096", "name": "シスター"}, {"key": "016", "name": "ファンタジー"}, {"key": "128", "name": "中出し"}, {"key": "138", "name": "フェラチオ"}, {"key": "130", "name": "母乳"}, {"key": "182", "name": "巨乳/爆乳"}, {"key": "179", "name": "ムチムチ"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 4.61, "count": 945}, "review_count": 9, "dl_count": 4738, "wishlist_count": 6024, "ranking": [{"category": "all", "period": "day", "rank": 11, "date": "2025-07-31"}, {"category": "all", "period": "week", "rank": 38, "date": "2025-08-06"}, {"category": "all", "period": "month", "rank": 80, "date": "2025-08-27"}, {"category": "game", "period": "day", "rank": 7, "date": "2025-07-31"}, {"category": "game", "period": "week", "rank": 19, "date": "2025-08-06"}, {"category": "game", "period": "month", "rank": 31, "date": "2025-08-28"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01439000/RJ01438988_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01439000/RJ01438988_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01439000/RJ01438988_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01439000/RJ01438988_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01439000/RJ01438988_img_smp3.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01439000/RJ01438988_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01439000/RJ01438988_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01439000/RJ01438988_img_smp3_100x100.jpg"], "alt": "フィーネと封じられた書庫 [らて茶場]"}, "introductions": [{"type": "text", "title": "■あらすじ", "body": [{"intro": "危険だと噂され、封印された古い書庫。<br />\nその定期点検に訪れたシスターの護衛として、<br />\n傭兵のあなたは教会を訪れる。<br />\n<br />\nそこで出会ったのは、シスター・フィーネ。<br />\n桃色の髪に、張りのある白い肌。<br />\n服から零れ落ちるほどの爆乳、<br />\nオレンジ色の瞳が輝く少女だった。<br />\n<br />\n簡単に終わるはずだった点検は、<br />\n思わぬはずみで、書庫の中に閉じ込められるという事態に――<br />\n<br />\n書庫に残された道具や本、日記に手がかりを求め、<br />\nふたりは静かな謎解きの時間をともに過ごしていく。"}]}, {"type": "text", "title": "■ゲーム概要", "body": [{"intro": "このゲームに戦闘やホラー要素はありません。<br />\n封印された静かな書庫の中を、<br />\nふたりでゆっくりと探索していく――。<br />\n<br />\n部屋に残された本や日記を読みながら、<br />\nときには会話を交わし、謎を解いていく。<br />\n少しずつ進む時間の中で、<br />\nふたりの距離も、近づいていきます。<br />\n<br />\nゲームオーバーも、時間制限もありません。<br />\n難易度はやさしめです。<br />\n<br />\nなぜ書庫は封印されてしまったのか、<br />\nその答えを見つけるのは、あなたとフィーネの物語です。<br />\n<br />\n<br />\n―Hシーン―<br />\n<br />\n全部で4シーン<br />\n動くエロシーン(全てのHCGにアニメーション有り)<br />\n<br />\n―基本CG数―<br />\n<br />\n・基本CG　5枚<br />\n・HCG数　4枚(立ち絵、差分含まない)<br />\n・総数　89枚"}]}, {"type": "image", "title": "■キャラクター紹介", "body": [{"intro": "・フィーネ<br />\n教会に住んでいる、心優しいシスター。<br />\nむっちり巨乳で、やわらかな雰囲気をまとう少女。<br />\n<br />\n明るく素直な一面もあるが、だいたいいつも困り眉。<br />\n教会に遊びに来る子どもたちからも慕われている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01439000/RJ01438988/23689641fa9692e9731d1225ebac19f3.jpg", "alt": "フィーネと封じられた書庫 [らて茶場]", "title": "フィーネと封じられた書庫 [らて茶場]"}, "position": "left"}]}, {"type": "text", "title": "", "body": [{"intro": "・主人公<br />\n街の傭兵。<br />\n傭兵としては駆け出しなので、<br />\n護衛任務を押し付けられた。<br />\n<br />\n―その他要素―<br />\n<br />\n・回想部屋<br />\n・オート/スキップ/メッセージウィンドウ消去/バックログ<br />\n・エロシーン中のBGV有<br />\n<br />\n―――注意事項―――<br />\n◇　お使いのPCの使用環境によっては正常に動作しない場合がございます。<br />\nまずは体験版での動作確認をお願いします。<br />\n◇　不具合報告や修正などの最新情報は、Ci-enからご確認ください。"}]}], "description": "巨乳シスターと密室からの脱出", "short_introduction": "巨乳シスターと密室からの脱出", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01438988.html", "site_id": "maniax", "fetched_at": 1794948088}