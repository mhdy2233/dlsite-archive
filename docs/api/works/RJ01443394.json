00/RJ01443394_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01444000/RJ01443394_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01444000/RJ01443394_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01444000/RJ01443394_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01444000/RJ01443394_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01444000/RJ01443394_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01444000/RJ01443394_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01444000/RJ01443394_img_smp9.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01444000/RJ01443394_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01444000/RJ01443394_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01444000/RJ01443394_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01444000/RJ01443394_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01444000/RJ01443394_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01444000/RJ01443394_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01444000/RJ01443394_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01444000/RJ01443394_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01444000/RJ01443394_img_smp9_100x100.jpg"], "alt": "CODE:OOC [文芸部]"}, "introductions": [{"type": "image", "title": "「お前を親友だと思ったことはない」", "body": [{"intro": "■ ストーリー<br />\r\n　2384年。<br />\r\n<br />\r\n　遺伝変異しながら増殖するOOCウイルスは、地球を飲み込み<br />\r\n　宇宙に移住した人類をも飲み込もうとしていた。<br />\r\n<br />\r\n　星連より特命を受けた月の住人『白金あんこ』と『ヨハンセ』は、<br />\r\n　地球へ降り立ち、ウイルスへの対抗手段である古のアイドルを蘇らせる。<br />\r\n<br />\r\n　普通になりたいあんこと、普通を装うヨハンセ。<br />\r\n　彼女たちの物語が始まる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01444000/RJ01443394/c996c186e55aad6898cf6181c7c15ca6.jpg", "alt": "CODE:OOC [文芸部]", "title": "CODE:OOC [文芸部]"}, "position": "over"}]}, {"type": "image", "title": "──「アイドル」と「SF」の要素が絡み合う中、描かれる人間模様とは?", "body": [{"intro": "■ 作品概要<br />\r\n<br />\r\n本作の内容は以下の四部構成となっております。<br />\r\n　「マスクアイドル・アイデンティティ」<br />\r\n　「コンプレックス・アイドル」<br />\r\n　「CODE:OOC」(QUESTION、ANSWERの2シナリオ)<br />\r\n　「特定秘密情報」<br />\r\n<br />\r\nまた本作は、前作「そらのひらけたばしょ」との繋がりが一部ございます。<br />\r\n本作単体でも楽しめますが、前作をプレイしていると<br />\r\nより深い部分までお楽しみいただけます。<br />\r\n<br />\r\n使用ツール: ティラノスクリプト<br />\r\nプレイ時間: 約4時間<br />\r\n<br />\r\n■ AI利用箇所について<br />\r\nイラスト素材について、一部の背景美術および限定的なシーンのモブキャラにのみAI技術を使用しています。<br />\r\nメインキャラクターや作品の主要ビジュアルには一切使用しておりません。<br />\r\n<br />\r\n明里灯の楽曲はメロディ、コード、ベースは制作しておりますが、<br />\r\n一部の編曲および歌唱にAI技術を使用しております。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01444000/RJ01443394/807e6980d20753aaa17dd7fbfebb861f.jpg", "alt": "CODE:OOC [文芸部]", "title": "CODE:OOC [文芸部]"}, "position": "over"}]}, {"type": "image", "title": "プレイ画面", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01444000/RJ01443394/18f7578eb264b5a179cf9c42ff7ff8a5.jpg", "alt": "CODE:OOC [文芸部]", "title": "CODE:OOC [文芸部]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01444000/RJ01443394/a968f3f22049f397352ce4d6118a2ec9.jpg", "alt": "CODE:OOC [文芸部]", "title": "CODE:OOC [文芸部]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01444000/RJ01443394/5b677071c2931e5fe9f55852f858bd53.jpg", "alt": "CODE:OOC [文芸部]", "title": "CODE:OOC [文芸部]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01444000/RJ01443394/4b4097c62bfc0478a9acbb5b7a9f6b40.jpg", "alt": "CODE:OOC [文芸部]", "title": "CODE:OOC [文芸部]"}, "position": "over"}]}], "description": "普通になりたいあなたへ。「SF」×「アイドル」ADV。", "short_