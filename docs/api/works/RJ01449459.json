": "month", "rank": 86, "date": "2026-03-24"}, {"category": "game", "period": "day", "rank": 10, "date": "2026-02-28"}, {"category": "game", "period": "week", "rank": 20, "date": "2026-03-06"}, {"category": "game", "period": "month", "rank": 44, "date": "2026-03-28"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01450000/RJ01449459_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01450000/RJ01449459_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01450000/RJ01449459_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01450000/RJ01449459_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01450000/RJ01449459_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01450000/RJ01449459_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01450000/RJ01449459_img_smp5.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01450000/RJ01449459_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01450000/RJ01449459_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01450000/RJ01449459_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01450000/RJ01449459_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01450000/RJ01449459_img_smp5_100x100.jpg"], "alt": "Succubus Siege ～サキュバスシージ～ [ごゆるりと]"}, "introductions": [{"type": "text", "title": "物語", "body": [{"intro": "はるか昔……<br />\nレドリンの地に栄えたステラ帝国はもはや完全に滅び去り、人々の記憶からも姿を消した。<br />\n帝国を滅亡させたのは、人々をたぶらかし、弄んだ淫虐暴戻な古代の淫魔であった。<br />\n<br />\nしかし、帝国の精鋭からなる信頼厚き第10部隊は、滅びゆく帝国と運命を共にする事と引き換えに、<br />\n淫魔を地の奥深くへと封印することに成功した。<br />\n<br />\n生き延びた者たちは、滅びゆく帝国を逃れて西へ向かい、遥かなエルブの地へとたどり着いた。<br />\n険しい山々と豊かな渓谷に囲まれたこの地を新たな故郷として、彼らはエルブ王国を築いたのだった。<br />\n<br />\n300年もの間、エルブ王国は自由と平和を謳歌してきた。<br />\nしかし、それには代償が支払われていたのだ。<br />\n彼らが立ち向かった淫魔の事も、皆の記憶から消えようとしていた今、王国を再び闇が包もうとしていた…。<br />\n<br />\nそして、誰が想像したであろう、<br />\n一介の農村の若者が王国の存亡をかけ、立ち上がる事になろうとは…。"}]}, {"type": "image", "title": "戦闘", "body": [{"intro": "戦闘はシンプルなターン制です。<br />\nしかし、敵は戦闘中もエッチな誘惑攻撃を仕掛けてきます。<br />\nEPに注意しつつ、QTEを成功させて誘惑を跳ね除けましょう。<br />\n<br />\n・誘惑攻撃<br />\n　敵が使ってくる強力な攻撃です。<br />\n　表示されたコマンドを制限時間内に左から全て入力する事で、誘惑を跳ね除ける事が出来ます。<br />\n　違うコマンドを入力する、もしくは時間切れになると敵に拘束されてしまします。<br />\n　また、誘惑攻撃は跳ね除けない限り永遠に攻撃され続けるので、早く振り払いましょう。<br />\n<br />\n・EP(興奮度)<br />\n　敵の攻撃を受けると上昇し、50以上になると誘惑攻撃の難易度が上がってしまいます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01450000/RJ01449459/4f7735429fb87140ee1064eca6ebeafe.jpg", "alt": "Succubus Siege ～サキュバスシージ～ [ごゆるりと]", "title": "Succubus Siege ～サキュバスシージ～ [ごゆるりと]"}, "position": "left"}]}, {"type": "text", "title": "忙しい方も安心", "body": [{"intro": "戦闘を楽にする装備も完備。<br />\nまた、回想部屋も最初から全開放済みです。<br />\nゲーム開始直後から全てのHシーンをご覧になれます。"}]}], "description": "蘇りし古代の淫魔の陰謀を打ち砕け！逆レ○プ&色仕掛けRPG！", "short_introduction": "蘇りし古代の淫魔の陰謀を打ち砕け！逆レ○プ&色仕掛けRPG！", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01449459.html", "site_id": "maniax", "fetched_at": 1794945018}