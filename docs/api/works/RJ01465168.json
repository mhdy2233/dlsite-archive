8/f680075f95b850f993e27718e0b92bbf.jpg", "alt": "おさわり路線バス [にちゃにちゃソフト]", "title": "おさわり路線バス [にちゃにちゃソフト]"}, "position": "under"}]}, {"type": "image", "title": "ストーリーモード", "body": [{"intro": "状況に合った話題を選択していくとストーリーが進展し、おさわりすることができます。<br />\n会話とシチュエーションを楽しむことができます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01466000/RJ01465168/ae7d3ec3502867581c0e7349a2cf53c3.jpg", "alt": "おさわり路線バス [にちゃにちゃソフト]", "title": "おさわり路線バス [にちゃにちゃソフト]"}, "position": "under"}]}, {"type": "image", "title": "フリーモード", "body": [{"intro": "会話が無くおさわりだけを自由に遊ぶことができます。<br />\nまたストーリーモードではシチュエーション的に無理な全裸も可能。<br />\n最初から即遊ぶことができます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01466000/RJ01465168/b140a4cb783e9cfad7b796d4af1d1d8a.jpg", "alt": "おさわり路線バス [にちゃにちゃソフト]", "title": "おさわり路線バス [にちゃにちゃソフト]"}, "position": "under"}]}], "description": "バスで〇リっ子におさわりするSLGです。", "short_introduction": "バスで〇リっ子におさわりするSLGです。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01465168.html", "site_id": "maniax", "fetched_at": 1794947791}