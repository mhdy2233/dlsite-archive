{"id": "RJ01468382", "title": "ゼロ・ルート ～童貞の道程RPG～", "title_romaji": "zeroruutodouteinomichinoriaarupiijii", "circle": {"id": "RG01055191", "name": "お魚市場", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG01055191.html"}, "type": {"code": "RPG", "name": "ロールプレイング", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 1100, "official_jpy": 1100, "currencies": {"USD": 6.8934010724878725, "EUR": 6.264322519214385, "GBP": 5.226651360497349, "TWD": 227.25864099332685, "CNY": 46.03184566777561, "KRW": 9205.020920502093, "IDR": 126002.29095074456, "VND": 177419.3548387097, "THB": 233.60020386926882, "SEK": 69.5854604343398, "HKD": 54.09339470474841, "SGD": 8.88412197414882, "CAD": 9.855350335305896, "MYR": 28.226913592285324, "BRL": 39.223516994480185, "AUD": 10.22027479531577, "PHP": 440.599214932308, "MXN": 127.87872446785012, "NZD": 12.52088711623481, "INR": 647.5921346991639}}, "point": {"point_amount": 60, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1764255600, "file": {"type": "EXE", "size": 186465855}, "tags": [{"key": "502", "name": "男主人公"}, {"key": "506", "name": "サキュバス/淫魔"}, {"key": "317", "name": "人外娘/モンスター娘"}, {"key": "046", "name": "ハーレム"}, {"key": "016", "name": "ファンタジー"}, {"key": "128", "name": "中出し"}, {"key": "182", "name": "巨乳/爆乳"}, {"key": "192", "name": "童貞"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 3.92, "count": 12}, "review_count": 1, "dl_count": 62, "wishlist_count": 388, "ranking": [], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01469000/RJ01468382_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01469000/RJ01468382_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01469000/RJ01468382_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01469000/RJ01468382_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01469000/RJ01468382_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01469000/RJ01468382_img_smp4.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01469000/RJ01468382_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01469000/RJ01468382_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01469000/RJ01468382_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01469000/RJ01468382_img_smp4_100x100.jpg"], "alt": "ゼロ・ルート ～童貞の道程RPG～ [お魚市場]"}, "introductions": [{"type": "text", "title": "どんなゲーム?　王道RPGだよ。", "body": [{"intro": "人類は千年以上昔から、魔物との抗争を続けてきた。<br />\n魔物は危険だ。やつらがいる限り、人類に安寧は訪れないだろう。<br />\nそこで！　世界中の人々を救うため、勇者が立ち上がった！<br />\nさあ！　諸悪の根源である魔王をぶちのめそう！　<br />\n<br />\n◆◇◆――――――――――――――――――――――◆◇◆<br />\n各種詳細、攻略情報、アプデ情報などはCi-enにて公開予定です。<br />\n　→<a href=\"https://ci-en.dlsite.com/creator/32552\" target=\"_blank\">https://ci-en.dlsite.com/creator/32552</a><br />\n◆◇◆――――――――――――――――――――――◆◇◆"}]}, {"type": "image", "title": "", "body": [{"intro": "特技なし。魔力ゴミカス。そんな童貞(経験人数ゼロ)の旅路(ルート)。<br />\n<br />\n<br />\n【ゲーム仕様】<br />\n・想定クリア時間6～8時間<br />\n・エロCG枚数:11枚(差分抜き)　※差分込み29枚<br />\n・シーン回想機能&amp;全開放機能:あり<br />\n・制作ツール:WOLF RPGエディター", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01469000/RJ01468382/7afa5bb390587f4e8869d2b914e6dd2b.jpg", "alt": "ゼロ・ルート ～童貞の道程RPG～ [お魚市場]", "title": "ゼロ・ルート ～童貞の道程RPG～ [お魚市場]"}, "position": "over"}]}, {"type": "image_list", "title": "キャラクター", "body": [{"intro": "◆ウェズン<br />\n<br />\n勇者。<br />\n天才的な魔術師で、主人公の幼馴染でもある。<br />\n得意な魔術属性は炎。<br />\n本人の属性はツンデレ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01469000/RJ01468382/1fe7cd5271d256f8ef7a8e00156db95c.jpg", "alt": "ゼロ・ルート ～童貞の道程RPG～ [お魚市場]", "title": "ゼロ・ルート ～童貞の道程RPG～ [お魚市場]"}}, {"intro": "◆メイサ<br />\n<br />\n魔術も剣術も使いこなす万能タイプの年上女性。<br />\n彼女には、人の生命に関するとある噂がある。その胸に挟まれた者は昇天するという噂だ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01469000/RJ01468382/68a6c8d5dedccf013898d3629c52d81f.jpg", "alt": "ゼロ・ルート ～童貞の道程RPG～ [お魚市場]", "title": "ゼロ・ルート ～童貞の道程RPG～ [お魚市場]"}}, {"intro": "◆ラナ<br />\n<br />\nクール系。<br />\n素早さを活かし、敵に接近して戦う。<br />\n貧困環境で育ったことと彼女の発育は、無関係ではないのだろう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01469000/RJ01468382/22b0916f2e9b5afd86e64dc7e392a7d1.jpg", "alt": "ゼロ・ルート ～童貞の道程RPG～ [お魚市場]", "title": "ゼロ・ルート ～童貞の道程RPG～ [お魚市場]"}}]}, {"type": "image", "title": "意外とRPGっぽい", "body": [{"intro": "「俺はポテチを食べ終わったあと、指についてる粉をベロベロするんだ！」<br />\n「味噌汁の器にへばりついてるワカメって美味しいよね」<br />\n「ラーメンは汁まで飲まないと」<br />\n<br />\nそんな方々のために、やりこみ要素もあります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01469000/RJ01468382/e67098db97b1aebd65cdb917474426de.jpg", "alt": "ゼロ・ルート ～童貞の道程RPG～ [お魚市場]", "title": "ゼロ・ルート ～童貞の道程RPG～ [お魚市場]"}, "position": "over"}]}, {"type": "image", "title": "目指せ！！　非童貞！！！！！！！", "body": [{"intro": "「魔物は憎き敵である！　どエロいサキュバスの誘惑など跳ね除けるんだ！」<br />\n<br />\n「仲間とは、命を預けあう相棒である！　異性であろうと情欲を向けてはならない！」<br />\n<br />\nそんなの無視でいいっす。性欲に従おうよ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01469000/RJ01468382/2a328895351a79d42e30e77f56aa5e81.jpg", "alt": "ゼロ・ルート ～童貞の道程RPG～ [お魚市場]", "title": "ゼロ・ルート ～童貞の道程RPG～ [お魚市場]"}, "position": "over"}]}, {"type": "image", "title": "勇者の仲間ってだけでモテるらしいぜ", "body": [{"intro": "来世は勇者か、その仲間になりたいね。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01469000/RJ01468382/4862f43dff4af5d8e0761f96067e82a2.jpg", "alt": "ゼロ・ルート ～童貞の道程RPG～ [お魚市場]", "title": "ゼロ・ルート ～童貞の道程RPG～ [お魚市場]"}, "position": "over"}]}], "description": "人類を救うため、(田舎の童貞が)魔王討伐の旅に出る王道RPG！", "short_introduction": "人類を救うため、(田舎の童貞が)魔王討伐の旅に出る王道RPG！", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01468382.html", "site_id": "maniax", "fetched_at": 1794947181}