{"id": "RJ01479399", "title": "NTR・Strategy", "title_romaji": "netoraresutoratejii", "circle": {"id": "RG72604", "name": "三日月鳥", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG72604.html"}, "type": {"code": "SLN", "name": "シミュレーション", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 1980, "official_jpy": 1980, "currencies": {"USD": 12.40812193047817, "EUR": 11.275780534585895, "GBP": 9.407972448895228, "TWD": 409.06555378798834, "CNY": 82.85732220199611, "KRW": 16569.037656903765, "IDR": 226804.12371134022, "VND": 319354.83870967745, "THB": 420.4803669646839, "SEK": 125.25382878181162, "HKD": 97.36811046854714, "SGD": 15.991419553467876, "CAD": 17.739630603550612, "MYR": 50.808444466113585, "BRL": 70.60233059006433, "AUD": 18.396494631568384, "PHP": 793.0785868781543, "MXN": 230.1817040421302, "NZD": 22.53759680922266, "INR": 1165.6658424584953}}, "point": {"point_amount": 108, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1764946800, "file": {"type": "EXE", "size": 468658319}, "tags": [{"key": "502", "name": "男主人公"}, {"key": "506", "name": "サキュバス/淫魔"}, {"key": "448", "name": "色仕掛け"}, {"key": "526", "name": "快楽堕ち"}, {"key": "006", "name": "退廃/背徳/インモラル"}, {"key": "048", "name": "寝取られ"}, {"key": "325", "name": "悪堕ち"}, {"key": "186", "name": "ぼて腹/妊婦"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 4.12, "count": 181}, "review_count": 7, "dl_count": 952, "wishlist_count": 1646, "ranking": [{"category": "all", "period": "day", "rank": 30, "date": "2025-12-07"}, {"category": "game", "period": "day", "rank": 16, "date": "2025-12-07"}, {"category": "game", "period": "week", "rank": 35, "date": "2025-12-13"}, {"category": "game", "period": "month", "rank": 64, "date": "2025-12-22"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01480000/RJ01479399_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01480000/RJ01479399_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01480000/RJ01479399_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01480000/RJ01479399_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01480000/RJ01479399_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01480000/RJ01479399_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01480000/RJ01479399_img_smp5.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01480000/RJ01479399_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01480000/RJ01479399_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01480000/RJ01479399_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01480000/RJ01479399_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01480000/RJ01479399_img_smp5_100x100.jpg"], "alt": "NTR・Strategy [三日月鳥]"}, "introductions": [{"type": "text", "title": "戦略的NTR系SRPG", "body": [{"intro": "とあるボードゲームを基本としたオリジナルの戦闘システムにより、相手を説得したり味方が裏切ったりするゲームです。<br />\n<br />\nストーリーモードでは戦闘中に味方が寝取られた回数や魅了された回数によってイベントが発生します。さらにイベントによっては別のキャラのNTR回数が増加することもあり、戦闘では寝取られていないキャラでも連鎖NTRイベントが発生することがあります。<br />\n<br />\nフリーゲームとして戦闘のみのモードもあります。練習用にも使えます。"}]}, {"type": "image_list", "title": "オリジナル戦闘システム", "body": [{"intro": "9×9マスの戦場の中で敵のリーダーを撃破せよ。(説得でも可)<br />\n<br />\nこちらのリーダーがやられると敗北になる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/0b53cb1e6759bd19e87a944a56edac14.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}, {"intro": "敵を説得することで味方にすることができる。<br />\n説得率はカーソルを合わせると表示される。<br />\n失敗しても何度も説得することで説得率は上昇するぞ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/ff825ddd83fa9f392a5c5292b63fd8cf.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}, {"intro": "裏切るのは敵だけはない。<br />\n味方も魅了されたり寝取られたりして裏切る可能性がある。<br />\n<br />\n何度も味方が裏切るとステージ終了後にHイベントが発生する。<br />\n寝取られたくないキャラがいる場合はそのキャラを守りながら戦おう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/bf8aef4858f10c0b9de611284e8bf08b.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}, {"intro": "説得するだけでなく普通に倒すこともできる。<br />\n<br />\n行動範囲内にいる敵を左クリックで撃破、右クリックで説得だ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/487fba780a79b8c46bc8dbe8a4f2087d.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}]}, {"type": "image_list", "title": "ゲームの流れ", "body": [{"intro": "ステージセレクト画面でプレイしたいステージを選択してください。<br />\nクリアしても何度も同じステージをプレイすることは可能です。<br />\n<br />\nただし、キャラクターのNTR回数は加算されていきますので注意してください。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/5ccaa8057fd7b18d16d7a2fbcfc6e62e.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}, {"intro": "ステージを選択するとストーリーが始まります。味方になるキャラが出てきたり、敵となるキャラクターも出現したりします。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/cec8fd5d782decb96b365e31ce92994e.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}, {"intro": "ストーリーがある程度進むと戦闘が始まります。<br />\n<br />\n難易度が選択できますので、自分のプレイスタイルに合った難易度を選択してください。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/a69450ab61fca303a3db0a0933401a56.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}, {"intro": "戦闘に勝利するとストーリーが進みます。新たな敵が現れたり、意外な事実が判明したりします。<br />\n<br />\nステージをクリアすると、次のステージボタンが出現します。もう一度同じステージをプレイしてもいいですし、次のステージに進むこともできます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/7922b846e9f52666fddb230af28ca2f8.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}]}, {"type": "image_list", "title": "連鎖するHイベント", "body": [{"intro": "戦闘で何度も魅了されたり寝取られたキャラクターはステージ終了後(戦闘の勝利・敗北問わず)にHイベントが発生します。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/73b0c64930218a9d4a0d0b5f91fb19b8.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}, {"intro": "特定のキャラクターのHイベントでは別のキャラクターに影響を及ぼすものもあります。<br />\n<br />\n大事なキャラクターだから戦闘では守っていたはずなのに、蔑ろにしたキャラクターのせいで寝取られることになるかも……！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/6a1f0c583692a21a21f9b4175e48d531.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}, {"intro": "連鎖堕ちによって連続でHイベントが発生することもあります。<br />\n大事なキャラクターを守りたい場合はそのキャラクターだけでなく、他のキャラクターを守ることも重要になってきます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/f3f26e902f4147edf618684f23581fad.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}, {"intro": "一度見たHイベントはRemainisenece(回想モード)で見ることができます。<br />\n<br />\nボタンにカーソルを合わせるとイベントイラストが表示されるので間違える心配はありません。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/bea52ffcc8292b37334f4beb58111090.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}]}, {"type": "image_list", "title": "味方キャラクター紹介(一部)", "body": [{"intro": "イリオス・ソルディアン<br />\n<br />\n主人公。ソルディアナ王国の第一王子。<br />\n『信頼の加護』を持っており、みんなに信頼されやすい。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/a95b535788547156417f23673288998b.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}, {"intro": "イレーネ・フェルセリス<br />\n<br />\nイリオスの近衛兵。頭脳明晰、冷静沈着。イリオスのことを慕っており、尊敬以上の感情を持っている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/70ea9f0d52ed09e91238b776aeb294ba.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}, {"intro": "リーナ<br />\n<br />\n新人一般兵。戦闘能力は低いが、マジメな女の子。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/07e9eed4a9bccc4f9888a165b43434a1.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}, {"intro": "ノア・スピアリス<br />\n<br />\n槍使いの女戦士。大雑把な性格だが正義感は強い。ガルドという同じ槍使いの戦士を親に持つ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/db7989d2a1a947807fe28e4c192e35b8.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}]}, {"type": "image_list", "title": "敵キャラクター紹介(一部)", "body": [{"intro": "ゼイク<br />\n<br />\n盗賊団を率いる頭領。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/e0d909b7cf169a6f68d0f4375950b170.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}, {"intro": "リッチ<br />\n<br />\n不死者の王と呼ばれる高位の魔物。ゼイクに『魅了の呪い』を与えた。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/8b079ac76bb795a0f6310646aafbcbef.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}, {"intro": "悪い魔法使い<br />\n<br />\n普通の女の子だったが、ダークエルフによって力を与えられて魔法使いとなった。男を堕落させる才能は元からのもの。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/ae0609bfe3fb5b0b937b3ce1be34c7d5.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}, {"intro": "ダークエルフ<br />\n<br />\n魔王の側近の一人。魔法を使った高い戦闘能力を持つが、魔王が見ていないところでは手を抜きがち。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01480000/RJ01479399/778c76a3a70363e3b836c33cf1f1ee5b.jpg", "alt": "NTR・Strategy [三日月鳥]", "title": "NTR・Strategy [三日月鳥]"}}]}], "description": "寝取られ！色仕掛け！連鎖堕ち！裏切りが連続する戦略的NTR系SRPG！！", "short_introduction": "寝取られ！色仕掛け！連鎖堕ち！裏切りが連続する戦略的NTR系SRPG！！", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01479399.html", "site_id": "maniax", "fetched_at": 1794947106}