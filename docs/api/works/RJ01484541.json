gory": "all", "period": "month", "rank": 45, "date": "2025-12-26"}, {"category": "game", "period": "day", "rank": 2, "date": "2025-12-02"}, {"category": "game", "period": "week", "rank": 7, "date": "2025-12-05"}, {"category": "game", "period": "month", "rank": 21, "date": "2025-12-23"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01485000/RJ01484541_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01485000/RJ01484541_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01485000/RJ01484541_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01485000/RJ01484541_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01485000/RJ01484541_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01485000/RJ01484541_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01485000/RJ01484541_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01485000/RJ01484541_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01485000/RJ01484541_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01485000/RJ01484541_img_smp8.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01485000/RJ01484541_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01485000/RJ01484541_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01485000/RJ01484541_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01485000/RJ01484541_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01485000/RJ01484541_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01485000/RJ01484541_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01485000/RJ01484541_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01485000/RJ01484541_img_smp8_100x100.jpg"], "alt": "Crossdresser Killer [FT少女]"}, "introductions": [{"type": "image", "title": "『CrossdresserKiller -クロスドレッサーキラー』", "body": [{"intro": "――滅びた一族の仇を討つため、彼は女装した。<br />\n<br />\n暗殺者ルナ。<br />\n彼はハイエルフ族最後の生き残りにして、美貌の“男”。<br />\n燃え尽きた森、奪われた故郷、蹂躙された仲間。<br />\n全てを奪ったヴァルドリア帝国に、今、復讐の刃が突き立つ――。<br />\n<br />\n本作は、ダンジョン探索×Roguelike育成RPG。<br />\nプレイヤーはキャラクターを自由にカスタマイズし、仲間と共に地獄の迷宮を攻略していく。<br />\n戦闘、探索、調教、解放、あらゆる選択が新たな物語を生み出す。<br />\n<br />\n※ サポート言語:日本語、英語、簡体中国語、繫体中国語、韓国語<br />\n<br />\nCIENで進捗記事を書いています!ご意見や要望がありましたら、お聞かせください。継続的なアップデートをお楽しみに!<br />\n<a href=\"https://ci-en.dlsite.com/creator/16247\" target=\"_blank\">https://ci-en.dlsite.com/creator/16247</a>", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01485000/RJ01484541/e92904274d3c98f67fe5a260faa0ac73.jpg", "alt": "Crossdresser Killer [FT少女]", "title": "Crossdresser Killer [FT少女]"}, "position": "over"}]}, {"type": "image", "title": "キャラカスタマイズ", "body": [{"intro": "プレイヤーが操作するキャラクターは、外見から能力まで完全にカスタマイズ可能。<br />\n髪型、瞳の色、種族、職業、装備、名前――すべてを自由に組み合わせることで、自分だけの戦士・魔導士・射手を作り上げることができる。<br />\n種族にはそれぞれ特性があり、エルフやハイエルフは魔法適性が高く、ウサギ族は素早さと回避に優れる。<br />\n職業ごとにステータス成長やスキル傾向も異なり、ビルド次第でプレイスタイルが劇的に変化する。<br />\n育成したキャラはそのまま保存され、地牢探索・戦闘・堕落イベントなど全てに反映される。<br />\n<br />\n?カスタマイズ要素<br />\n<br />\n髪型・瞳・服装・職業・名前を自由変更<br />\n<br />\n種族ごとの固有ボーナス:攻撃力・魔法威力・回避率など<br />\n<br />\n外見と性能の両立が可能な高自由度システム", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01485000/RJ01484541/dd00d01c4a2b5aa9ea908efef44f86b5.jpg", "alt": "Crossdresser Killer [FT少女]", "title": "Crossdresser Killer [FT少女]"}, "position": "over"}]}, {"type": "image", "title": "仲間システム", "body": [{"intro": "戦場で出会ったキャラクターは仲間として編成できる。<br />\n仲間たちは単なるNPCではなく、プレイヤーと同じくレベル・武器・衣装・ステータスを持つ実在ユニット。<br />\n各仲間の成長状態や装備はセーブデータに記録され、次回以降の戦闘にも引き継がれる。<br />\n敗北した仲間は捕らわれ、地牢や奴○市場で堕落イベントが発生――救出するか見捨てるかはプレイヤー次第。<br />\nチーム編成や戦術の選択によって、戦場の展開やイベント内容が大きく変化する。<br />\n<br />\n? 特徴<br />\n<br />\n仲間の装備・衣装・ステータスが完全保存される<br />\n<br />\n同行キャラは戦闘・探索で個別反応<br />\n<br />\n仲間が敗北・捕縛された際は専用イベントに分岐", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01485000/RJ01484541/eeb5b5f45b3136a05ce282583b4d65f9.jpg", "alt": "Crossdresser Killer [FT少女]", "title": "Crossdresser Killer [FT少女]"}, "position": "over"}]}, {"type": "image", "title": "団体戦システム", "body": [{"intro": "戦闘は単なる1対1ではなく、数十人が入り乱れるリアルタイム混戦バトル。<br />\n仲間を前衛に突撃させ、自らは後方で魔法を詠唱するか?<br />\nそれとも敵の包囲を突破して捕らわれた奴○を救出するか?<br />\n戦略と判断によって、戦場の展開は大きく変化する！<br />\n<br />\n廃墟と化した帝国の地下で、反逆者たちは命を賭けて戦う。<br />\n仲間を率い、剣と魔法を駆使し、数十人が入り乱れる混戦の中で生き延びろ。<br />\n戦略と判断が、仲間の生死を分ける。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01485000/RJ01484541/ccbf1c81140c55f4c89a15a93ce4b24f.jpg", "alt": "Crossdresser Killer [FT少女]", "title": "Crossdresser Killer [FT少女]"}, "position": "over"}]}, {"type": "image", "title": "公開処刑/奴○遊街", "body": [{"intro": "捕らえられた反逆者たちは、民衆の歓声と共に晒される。<br />\n奴○遊街、公開○問、そして処刑――全ては帝国の支配を誇示するための儀式。<br />\nプレイヤーが育てたキャラクターが、リアルタイムで辱められていく。<br />\nそれは敗北ではなく、永遠の“証明”だ。<br />\n<br />\n鉄檻と鎖、○問具と観衆。<br />\n人としての尊厳を奪われ、心が壊れるまで繰り返される屈辱の訓練。<br />\n永久に続く奴○の輪廻――抵抗の叫びはやがて快楽へと変わり、<br />\n彼女たちは、群衆の前で笑う“人形”となる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01485000/RJ01484541/119e97614e7f43f4efddc18b398a4200.jpg", "alt": "Crossdresser Killer [FT少女]", "title": "Crossdresser Killer [FT少女]"}, "position": "over"}]}, {"type": "image", "title": "敗北イベント/調教所", "body": [{"intro": "敗北したキャラクターたちは「調教所」に送られ、<br />\n鞭打ち、拘束、○問、強○交合など、屈辱的な訓練を受ける。<br />\n観衆の前で人権を奪われ、日常的に陵○されることで、<br />\nやがて徹底した肉畜へと堕とされる。<br />\n<br />\n鎖に繋がれ、辱めの儀式に堕とされ、肉体と精神の限界を試される。<br />\nそれでも彼女たちは、まだ“希望”を信じようとする――その姿は美しく、そして痛ましい。<br />\n永久に続く性奴○の生涯を強○され、抵抗の余地なく群衆の慰み物となる――。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01485000/RJ01484541/175524ee4442d0d046eb139f1cf035fc.jpg", "alt": "Crossdresser Killer [FT少女]", "title": "Crossdresser Killer [FT少女]"}, "position": "over"}]}], "description": "仲間を失い、堕落した帝国の○問牢に挑むルナ。運命を切り拓くのはあなたの選択――Roguelike、ダンジョン探索、キャラカスタマイズと育成、仲間との連携、そして敗北すれば屈辱の調教が待つ――堕落と支配の輪廻を体感せよ。 闇と快楽が支配する帝都で、生き残るのは理性か、それとも欲望か。全ての選択が新たな快楽と悲劇を紡ぎ出す。", "short_introduction": "仲間を失い、堕落した帝国の○問牢に挑むルナ。運命を切り拓くのはあなたの選択――Roguelike、ダンジョン探索、キャラカスタマイズと育成、仲間との連携、そして敗北すれば屈辱の調教が待つ――堕落と支配の輪廻を体感せよ。 闇と快楽が支配する帝都で、生き残るのは理性か、それとも欲望か。全ての選択が新たな快楽と悲劇を紡ぎ出す。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01484541.html", "site_id": "maniax", "fetched_at": 1794947150}