nk": 17, "date": "2025-11-16"}, {"category": "game", "period": "day", "rank": 3, "date": "2025-11-05"}, {"category": "game", "period": "week", "rank": 3, "date": "2025-11-07"}, {"category": "game", "period": "month", "rank": 11, "date": "2025-11-30"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01497000/RJ01496317_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01497000/RJ01496317_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01497000/RJ01496317_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01497000/RJ01496317_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01497000/RJ01496317_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01497000/RJ01496317_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01497000/RJ01496317_img_smp5.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01497000/RJ01496317_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01497000/RJ01496317_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01497000/RJ01496317_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01497000/RJ01496317_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01497000/RJ01496317_img_smp5_100x100.jpg"], "alt": "ぼくと夏のおねえちゃん達 [おけゆ亭]"}, "introductions": [{"type": "text", "title": "◆ゲームシステム◆", "body": [{"intro": "おねえちゃんや町の人達にエッチな事を教えてもらう、ドットHシミュレーションゲームです。<br />\n<br />\nいたるところにいる人達と交流を重ねる事でエッチな事を教えてもらえます。<br />\nまた、エッチな本を見つけることで新しいエッチ方法を試すことが出来ます。"}]}, {"type": "text", "title": "◆ストーリー◆", "body": [{"intro": "夏休みの間、田舎町の親戚の家で過ごすことになった主人公ユウ。<br />\n<br />\n温かく出迎えてくれたのは、そこに住む三姉妹だった。<br />\n<br />\n久しぶりに会った三姉妹はとってもエッチに興味津々になっており、それは主人公ユウも同じであった。"}]}, {"type": "text", "title": "◆エッチのシチュエーション◆", "body": [{"intro": "登場人物全員と色んな場所でエッチが可能です。<br />\n<br />\n登場人物は全部で14人です。<br />\n<br />\n玄関、台所、居間、縁側、トイレ、風呂や、<br />\n川、土手、神社、交番、バス停、温泉、海、等々、多数の場所でエッチ可能です。<br />\n<br />\nまた、昼、夕方、夜の時間により違った雰囲気を味わう事が出来ます。"}]}, {"type": "text", "title": "◆その他◆", "body": [{"intro": "回想モードも実装しております。<br />\n全開放も可能なので、ゲームの時間がとれない人も安心です。<br />\n<br />\n-----------------<br />\n本作はRPGツクールMZで制作しております。<br />\n製品版をご購入される前に、体験版での動作確認をお願いいたします。<br />\n解像度:1280x720"}]}, {"type": "image_list", "title": "ぼくと三姉妹", "body": [{"intro": "●ユウ(ぼく)<br />\n田舎のおねえちゃん家に<br />\nしばらく泊まることになるよ！<br />\nいっぱい遊んでくれると<br />\n嬉しいな！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01497000/RJ01496317/d191079b90fe55c936a061981d29c688.jpg", "alt": "ぼくと夏のおねえちゃん達 [おけゆ亭]", "title": "ぼくと夏のおねえちゃん達 [おけゆ亭]"}}, {"intro": "●ハナおねえちゃん(長女)<br />\nとってもやさしくって、<br />\nあったかくて、<br />\nとっても料理上手なんだよっ！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01497000/RJ01496317/1dd247524f91a2ca1944a2ad581c50e0.jpg", "alt": "ぼくと夏のおねえちゃん達 [おけゆ亭]", "title": "ぼくと夏のおねえちゃん達 [おけゆ亭]"}}, {"intro": "●リナおねえちゃん(次女)<br />\n誰よりも強くて、<br />\nとってもかっこいいんだ！<br />\nバレー部のエースなんだって！　すごいよね！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01497000/RJ01496317/2afc6a22035aecefd6729149aab363bb.jpg", "alt": "ぼくと夏のおねえちゃん達 [おけゆ亭]", "title": "ぼくと夏のおねえちゃん達 [おけゆ亭]"}}, {"intro": "●ヒナおねえちゃん(三女)<br />\nいつも元気で明るくって、<br />\nなんでもやってみようよって<br />\n言ってくれるんだ！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01497000/RJ01496317/9d4142c68f0558f4e6b14f01c4bf9a96.jpg", "alt": "ぼくと夏のおねえちゃん達 [おけゆ亭]", "title": "ぼくと夏のおねえちゃん達 [おけゆ亭]"}}]}, {"type": "image_list", "title": "町の人々(一部紹介)※全部で11人登場します", "body": [{"intro": "●リンコさん(お隣さん)<br />\n畑とかのお仕事を<br />\nしてるんだって！<br />\nぼくもよくお手伝いさせて<br />\nもらったんだよっ！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01497000/RJ01496317/2f9d1b360e4f11532cb51d462ed00d9b.jpg", "alt": "ぼくと夏のおねえちゃん達 [おけゆ亭]", "title": "ぼくと夏のおねえちゃん達 [おけゆ亭]"}}, {"intro": "●サヤカさん(駄菓子屋さん)<br />\n口数は少ないけど、<br />\nとってもやさしくて<br />\n駄菓子とかいっぱい<br />\nおまけしてくれるんだっ！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01497000/RJ01496317/12528e07dee50e59a237aad1ee944c21.jpg", "alt": "ぼくと夏のおねえちゃん達 [おけゆ亭]", "title": "ぼくと夏のおねえちゃん達 [おけゆ亭]"}}, {"intro": "●アユさん(ヤンキー?)<br />\nすごいバイクに乗ってて<br />\n速くてかっこいいんだよ！<br />\nかわいいキャラグッズが<br />\nマイブームなんだって！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01497000/RJ01496317/353def15a48a42383f8751981411fa7b.jpg", "alt": "ぼくと夏のおねえちゃん達 [おけゆ亭]", "title": "ぼくと夏のおねえちゃん達 [おけゆ亭]"}}, {"intro": "●ジュリさん(ギャル)<br />\n毎日遠出するくらい<br />\nお買い物が好きなんだって<br />\nすっごく元気で<br />\nぼくもつられて<br />\n元気になっちゃうんだっ！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01497000/RJ01496317/8ae94a537d813581bd32a810b707e74a.jpg", "alt": "ぼくと夏のおねえちゃん達 [おけゆ亭]", "title": "ぼくと夏のおねえちゃん達 [おけゆ亭]"}}]}], "description": "おねえちゃんや町の人達にエッチな事を教えてもらう、ドットHシミュレーションゲームです。", "short_introduction": "おねえちゃんや町の人達にエッチな事を教えてもらう、ドットHシミュレーションゲームです。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01496317.html", "site_id": "maniax", "fetched_at": 1794947367}