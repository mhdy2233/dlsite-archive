count": 1415, "wishlist_count": 1092, "ranking": [{"category": "game", "period": "day", "rank": 26, "date": "2025-11-22"}, {"category": "game", "period": "week", "rank": 40, "date": "2025-11-27"}, {"category": "game", "period": "month", "rank": 76, "date": "2025-12-10"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512097_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512097_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512097_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512097_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512097_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512097_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512097_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512097_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512097_img_smp7.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512097_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512097_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512097_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512097_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512097_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512097_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512097_img_smp7_100x100.jpg"], "alt": "穢れたエルフと不浄の迷宮 [大自然重工]"}, "introductions": [{"type": "text", "title": "大量脱糞！大量食糞！どこもかしこも大量の糞まみれスカトロオンリーRPG！", "body": [{"intro": "このゲームはいわゆるhyperscat(大量脱糞)がメインとなっており、<br />\r\n【普通サイズ】の糞が出てきません！すべて極太大量です！<br />\r\n<br />\r\n～あらすじ～<br />\r\nとあるエルフが森で倒れていました。<br />\r\n或る迷宮から逃げ出してきた彼女、<br />\r\nその身には呪いが掛けられており周囲の人々からの認識が阻害されていた。<br />\r\n無一文の彼女は、人気の無いダンジョン【不浄の迷宮】へ冒険へ出発した。<br />\r\n<br />\r\n…と、ストーリーはあって無いようなものなので！！！<br />\r\nとにかくダンジョンで負けまくって脱糞食糞しまくって下さい！！！<br />\r\n(ストレス無く進められるよう、敵が弱めなので【降参】コマンドをご活用下さい)<br />\r\n<br />\r\n<br />\r\n■シチュエーション<br />\r\n・謎の像に触れたら突然催し脱糞<br />\r\n・ゴブリン娘から強○食糞、集団の時もあり<br />\r\n・スライム娘のスカルファック<br />\r\n・馬小屋で馬尻顔面押し付け脱糞<br />\r\n・サキュバスの搾糞、食糞<br />\r\n・ミミックに捕まり触手貫通脱糞<br />\r\n・巨大な女神やドラゴンによるアナルボア<br />\r\n・ケツ掘りサキュバスのケツ穴種付プレス<br />\r\n・肛門to肛門脱糞<br />\r\n<br />\r\n他、閲覧注意な汚っさんエリアは隔離されており<br />\r\n苦手な人は回避できるようになっています"}]}], "description": "大量脱糞！大量食糞！どこもかしこも大量の糞まみれのスカトロオンリーRPG！", "short_introduction": "大量脱糞！大量食糞！どこもかしこも大量の糞まみれのスカトロオンリーRPG！", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01512097.html", "site_id": "maniax", "fetched_at": 1794947228}