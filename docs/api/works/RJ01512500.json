 44, "date": "2026-09-17"}, {"category": "game", "period": "day", "rank": 3, "date": "2026-08-20"}, {"category": "game", "period": "week", "rank": 11, "date": "2026-08-26"}, {"category": "game", "period": "month", "rank": 25, "date": "2026-09-16"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512500_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512500_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512500_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512500_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512500_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512500_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512500_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512500_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512500_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512500_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512500_img_smp9.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01513000/RJ01512500_img_smp10.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512500_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512500_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512500_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512500_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512500_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512500_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512500_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512500_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512500_img_smp9_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01513000/RJ01512500_img_smp10_100x100.jpg"], "alt": "曲芸の天使エステル [サークルRVA]"}, "introductions": [{"type": "text", "title": "笑顔を届ける旅の裏で、少女は妹を探し続ける。", "body": [{"intro": "あらすじ<br />\r\n<br />\r\n巷では誘拐、失踪事件が相次いでいるらしい。<br />\r\nそんな人々の為に、各地を巡り笑顔を届けるさすらいの一座「天使の曲芸団」<br />\r\n何者かに攫われた妹を探すため入団した主人公エステル。<br />\r\nしかし団の運営にはお金が必要！<br />\r\n新人のエステルは各地でお金を稼ぐために奮闘する。すべては妹を見つけるために……。<br />\r\nエステルを支える他の団員も何やら秘密を抱えているようだが……。"}]}, {"type": "image_list", "title": "登場人物", "body": [{"intro": "曲芸師エステル　　　　<br />\r\n　<br />\r\n今作の主人公。<br />\r\nさらわれた妹を探すため、<br />\r\n「天使の曲芸団」に入団。<br />\r\n元気一杯で食べる事が大好き。<br />\r\n容量はあまりよくなく、<br />\r\n性に関しては疎い。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01513000/RJ01512500/8000ca524ebef91fa1401d8f3c0dc306.jpg", "alt": "曲芸の天使エステル [サークルRVA]", "title": "曲芸の天使エステル [サークルRVA]"}}, {"intro": "", "image_info": null}, {"intro": "人形遣いルミラ<br />\r\n<br />\r\n「天使の曲芸団」古参の団員。<br />\r\nツンツンした性格で○ども扱いされることを極端に嫌う。<br />\r\n手先が器用で団の小道具担当。<br />\r\n引きこもり気味で自作の人形と共に過ごす事が多い。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01513000/RJ01512500/d4c4f9dd81e891c988a3ee6d7c7f13b9.jpg", "alt": "曲芸の天使エステル [サークルRVA]", "title": "曲芸の天使エステル [サークルRVA]"}}, {"intro": "ルミラの人形<br />\r\n<br />\r\nルミラが作成した人形。<br />\r\n人に触れられる事を<br />\r\nルミラは快く思っていない。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01513000/RJ01512500/c4b4bfe6a9b80f90d26f2f6a48233602.jpg", "alt": "曲芸の天使エステル [サークルRVA]", "title": "曲芸の天使エステル [サークルRVA]"}}]}, {"type": "image_list", "title": "", "body": [{"intro": "獣遣いセレスティナ<br />\r\n<br />\r\n動植物を愛する心優しい女性。<br />\r\n控えめな性格だが時折感情が<br />\r\n昂ってしまう場面がある。<br />\r\n団内の炊事や家事を担当し、<br />\r\n団内の生活を下支えする。<br />\r\n大きなコンプレックスを<br />\r\n抱えているようだ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01513000/RJ01512500/1b216d176013be1e834c75e3c84ad526.jpg", "alt": "曲芸の天使エステル [サークルRVA]", "title": "曲芸の天使エステル [サークルRVA]"}}, {"intro": "道化師ハイメ<br />\r\n<br />\r\n類稀なる剣の腕を誇る男。<br />\r\nキザな性格だが面倒見はいい。<br />\r\n団の用心棒を担当している。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01513000/RJ01512500/f5cdc958cebd272680585b30d61daf48.jpg", "alt": "曲芸の天使エステル [サークルRVA]", "title": "曲芸の天使エステル [サークルRVA]"}}, {"intro": "団長ルイ<br />\r\n<br />\r\n「天使の曲芸団」の団長。<br />\r\n心優しい性格だが<br />\r\n抜けている場面も多い。<br />\r\n副団長と団を立ち上げた。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01513000/RJ01512500/9eb44a7c6b8746754edaf0efff01b64d.jpg", "alt": "曲芸の天使エステル [サークルRVA]", "title": "曲芸の天使エステル [サークルRVA]"}}, {"intro": "劇作家アウレリオ<br />\r\n<br />\r\n天使の曲芸団副団長。<br />\r\n団の経理や予定管理を担い、<br />\r\n影の団長と称される事も。　<br />\r\n常に笑顔を絶やさないが<br />\r\nそれ以外の表情も見せない。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01513000/RJ01512500/9646c040a543df12e8d521d3d6d525ec.jpg", "alt": "曲芸の天使エステル [サークルRVA]", "title": "曲芸の天使エステル [サークルRVA]"}}]}, {"type": "image_list", "title": "ゲームの概要", "body": [{"intro": "ノンフィールドで町を探索。<br />\r\n限られた期間でお金を稼ごう。<br />\r\n期間を過ぎると別の町へ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01513000/RJ01512500/195f7c10e56216c795d7caf7c14620cf.jpg", "alt": "曲芸の天使エステル [サークルRVA]", "title": "曲芸の天使エステル [サークルRVA]"}}, {"intro": "団員を一人選択し<br />\r\n二人で迷宮内の素材を収集。<br />\r\nたくさん集めて<br />\r\n団の活動費を稼ごう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01513000/RJ01512500/e66ce84bb2c066bc3de2760a96dfdb87.jpg", "alt": "曲芸の天使エステル [サークルRVA]", "title": "曲芸の天使エステル [サークルRVA]"}}, {"intro": "仲間と力を合わせて<br />\r\n魔物に立ち向かおう。<br />\r\n倒した魔物からは<br />\r\n希少な素材が手に入ることも。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01513000/RJ01512500/32352fb26965eaa31fde770652b7e683.jpg", "alt": "曲芸の天使エステル [サークルRVA]", "title": "曲芸の天使エステル [サークルRVA]"}}, {"intro": "魔物に敗北してしまった場合、魔物とのHシーンへ突入。<br />\r\n自爆アイテムや、<br />\r\n対象の迷宮クリア時に<br />\r\n登録も実装。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01513000/RJ01512500/58006129096e54cfb83958fcef84dfca.jpg", "alt": "曲芸の天使エステル [サークルRVA]", "title": "曲芸の天使エステル [サークルRVA]"}}]}, {"type": "image_list", "title": "", "body": [{"intro": "酒場でのアルバイトや<br />\r\n娼館でも金策可能。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01513000/RJ01512500/232738936f4840b88627fb7b92698c28.jpg", "alt": "曲芸の天使エステル [サークルRVA]", "title": "曲芸の天使エステル [サークルRVA]"}}, {"intro": "スキルツリーを駆使し、<br />\r\nエステルを強化。<br />\r\n団員の好感度を上げ団員強化。<br />\r\n同時に団員の回想も閲覧可能。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01513000/RJ01512500/d222e2e7c1ee667dfbae4bec4f770f74.jpg", "alt": "曲芸の天使エステル [サークルRVA]", "title": "曲芸の天使エステル [サークルRVA]"}}, {"intro": "様々なキャラクターが登場！<br />\r\n立ち絵の総数は30以上。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01513000/RJ01512500/d95afa5c75e9eb01f765f10dd8e81e07.jpg", "alt": "曲芸の天使エステル [サークルRVA]", "title": "曲芸の天使エステル [サークルRVA]"}}, {"intro": "町で出会える店主たちには<br />\r\nすべてHシーンあり。<br />\r\n町を散策して見つけてみよう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01513000/RJ01512500/c2d6a474f9111d5261706f7f6a2dffe2.jpg", "alt": "曲芸の天使エステル [サークルRVA]", "title": "曲芸の天使エステル [サークルRVA]"}}]}, {"type": "text", "title": "", "body": [{"intro": "本作はノンフィールドで進行するRPGです。<br />\r\n主なジャンルは敗北Hで魔物との異種姦がメインになります。<br />\r\n<br />\r\nプレイ時間は10～12時間ほどになります。<br />\r\n<br />\r\n迷宮探索、魔物との戦闘を中心に行い、物語を進めていきます。<br />\r\n<br />\r\n本製品はRPGツクールMZで制作されています。<br />\r\n購入の際は体験版で動作確認をお願いいたします。"}]}], "description": "笑顔を届ける旅の裏で、少女は妹を探し続ける。", "short_introduction": "笑顔を届ける旅の裏で、少女は妹を探し続ける。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01512500.html", "site_id": "maniax", "fetched_at": 1794942515}