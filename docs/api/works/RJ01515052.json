rk/doujin/RJ01516000/RJ01515052_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01516000/RJ01515052_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01516000/RJ01515052_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01516000/RJ01515052_img_smp4.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01516000/RJ01515052_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01516000/RJ01515052_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01516000/RJ01515052_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01516000/RJ01515052_img_smp4_100x100.jpg"], "alt": "さよならストーカー [星屑ガレージ]"}, "introductions": [{"type": "text", "title": "「恋か、狂気か　はたまた罪か」追跡型コマンドシミュレーション", "body": [{"intro": "「あらすじ」<br />\r\n<br />\r\n会社を辞め、生きる目的を失った男。<br />\r\n行く当てもなく、ただ\"普通\"のフリをして、街を行き交う日々。<br />\r\n<br />\r\nそんな中、見つけた――ある一人の少女。<br />\r\n恋心とも呼べない歪んだ感情を抱いた男は、次第にその少女の姿を探すようになる……。"}]}, {"type": "image", "title": "【捜索モード】", "body": [{"intro": "街中を自由に歩き回り、少女を探します。<br />\r\n<br />\r\n時間帯によって少女のいる場所が変わるため<br />\r\nプレイヤーはミニマップを確認しながら対象を探し当てなければなりません。<br />\r\n<br />\r\n特定の条件を満たすことで<br />\r\n「朝」だけでなく「夕方」にも行動できるようになります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01516000/RJ01515052/9d20a1659113e56b693ffbda7a5b7844.jpg", "alt": "さよならストーカー [星屑ガレージ]", "title": "さよならストーカー [星屑ガレージ]"}, "position": "left"}]}, {"type": "image", "title": "【追跡モード】", "body": [{"intro": "少女を発見したら、後をつけて追跡します。<br />\r\n<br />\r\n気付かれないように進行と停止を繰り返しながら<br />\r\n少女の行動ルートを把握するだけのシンプルなシステムです。<br />\r\n<br />\r\n追跡時に特定の条件を満たすことで<br />\r\n様々なフラグが解放され、より効率的に日々を過ごすことができるでしょう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01516000/RJ01515052/5e799d51595a95077e9fd8a9f50f7ddf.jpg", "alt": "さよならストーカー [星屑ガレージ]", "title": "さよならストーカー [星屑ガレージ]"}, "position": "left"}]}, {"type": "image", "title": "【会話モード】", "body": [{"intro": "少女に声をかけると、コミュニケーションを取ることが可能です。<br />\r\n<br />\r\n友好的な会話を繰り返すことで<br />\r\n少女との関係性や主人公を見る目も変化していくことでしょう。<br />\r\n<br />\r\nもちろん特に会話などをせずに「連れ込む」こともできます。<br />\r\nこのとき「連れ込む」を選択したときにいる場所や<br />\r\n少女の感情の変化によって、イベントシーンの内容や状態が変わります。<br />\r\n<br />\r\n少女との関係性は、エンディング分岐にも影響する要素です。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01516000/RJ01515052/3cd99721086e34e93a33fbd3d75baf2d.jpg", "alt": "さよならストーカー [星屑ガレージ]", "title": "さよならストーカー [星屑ガレージ]"}, "position": "left"}]}, {"type": "image", "title": "【イベントシーン】", "body": [{"intro": "コマンド選択型の自動アニメーションです。<br />\r\nまた一部シーンでは、タッチによる「お触り」も可能になります。<br />\r\n<br />\r\nパターンアニメは基本的に2パターンから3パターンで<br />\r\n各シーンに射精アニメが用意されています。<br />\r\n<br />\r\nまた少女との関係性によって<br />\r\n台詞や一部シチュエーションが変化します。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01516000/RJ01515052/4e3cd150d3ac29ad2704614fed5d349a.jpg", "alt": "さよならストーカー [星屑ガレージ]", "title": "さよならストーカー [星屑ガレージ]"}, "position": "left"}]}, {"type": "text", "title": "【注意】", "body": [{"intro": "本作品は決して犯罪行為を推奨するものではなく<br />\r\nまたそれを助長するような表現、描写は行っておりません。<br />\r\n現実と妄想の区別が付きづらい方は、本作品のプレイをお控えいただけますと幸いです。"}]}], "description": "「恋か、狂気か はたまた罪か」追跡型コマンドシミュレーション", "short_introduction": "「恋か、狂気か はたまた罪か」追跡型コマンドシミュレーション", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01515052.html", "site_id": "maniax", "fetched_at": 1794947181}