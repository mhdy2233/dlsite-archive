3"}, {"category": "game", "period": "day", "rank": 5, "date": "2025-12-06"}, {"category": "game", "period": "week", "rank": 13, "date": "2025-12-10"}, {"category": "game", "period": "month", "rank": 27, "date": "2025-12-21"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01517000/RJ01516148_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01517000/RJ01516148_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01517000/RJ01516148_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01517000/RJ01516148_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01517000/RJ01516148_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01517000/RJ01516148_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01517000/RJ01516148_img_smp5.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01517000/RJ01516148_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01517000/RJ01516148_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01517000/RJ01516148_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01517000/RJ01516148_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01517000/RJ01516148_img_smp5_100x100.jpg"], "alt": "メカクレちゃん、乗車中……。 [清水庵]"}, "introductions": [{"type": "text", "title": "【ゲーム概要】", "body": [{"intro": "痴○SLG・コマンド選択のお触り形式。警戒値、欲情値、絶頂値を上手く管理しながら引っ込み思案な女の子を\"悪い子\"にしましょう。"}]}, {"type": "image", "title": "【プロローグ】", "body": [{"intro": "両親が別居してしまって、慣れない新生活が始まった女の子、こはる。<br />\nそして以前と違い、約1時間の電車通学を余儀なくされ、満員電車に呑み込まれる事に。<br />\n人ごみの所為でまともな姿勢を取れず、その姿は乗客を煽る形になり……。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01517000/RJ01516148/433eaac91cf7893c0673f7ca32060fb1.jpg", "alt": "メカクレちゃん、乗車中……。 [清水庵]", "title": "メカクレちゃん、乗車中……。 [清水庵]"}, "position": "over"}]}, {"type": "image", "title": "【Hシーンのウリ】", "body": [{"intro": "アクションコマンドは30種類以上、様々な条件で解放されていきます。<br />\nステータス/称号の状況によってリアクションも段階的に変わります。<br />\n擬音による演出(ON/OFF可能)", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01517000/RJ01516148/5e9f35e207990281134dc40626600b83.jpg", "alt": "メカクレちゃん、乗車中……。 [清水庵]", "title": "メカクレちゃん、乗車中……。 [清水庵]"}, "position": "over"}]}, {"type": "image", "title": "【Hのシチュエーション】", "body": [{"intro": "カラダの至る所をおさわり<br />\n耳舐め<br />\n手マン<br />\nキス<br />\nフェラ<br />\n玩具<br />\n素股 etc....", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01517000/RJ01516148/5b066775454d1aa71f4211c7f35ee56e.jpg", "alt": "メカクレちゃん、乗車中……。 [清水庵]", "title": "メカクレちゃん、乗車中……。 [清水庵]"}, "position": "over"}]}, {"type": "image", "title": "【こだわりポイント】", "body": [{"intro": "・ステータス<br />\nその日の終わりに結果を集計し、ステータスに反映します。<br />\nステータスに比例して、アクションやエンディング(三種)が解放されます。<br />\n<br />\n・透視眼鏡<br />\n服を脱がさずとも、布の下を透かし見ることが出来ます。<br />\n実は他にも見る事が出来て……?<br />\n<br />\n・様々な下着<br />\n地味なスポーツブラから下品なランジェリーまで。<br />\n日によって変化するのでチェックしましょう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01517000/RJ01516148/85b0999d6961ef38c584148e41bae02c.jpg", "alt": "メカクレちゃん、乗車中……。 [清水庵]", "title": "メカクレちゃん、乗車中……。 [清水庵]"}, "position": "over"}]}, {"type": "text", "title": "【キャラクター紹介】", "body": [{"intro": "・名前　牛沼こはる(うぬまこはる) CV:夕霧花音<br />\n・身長　158cm<br />\n・バスト　105cm(Kカップ)<br />\n・ウェスト　67cm<br />\n・ヒップ　99cm<br />\n・詳細<br />\n我が弱く、周りに流されやすい性格の女の子。人から何かされても強く言い返せない。<br />\n引っ越し前の場所では苗字からもじって「うしちゃん」と呼ばれていた。<br />\n本人は気に入っていたが、そのスタイル由縁……かもしれない。"}]}], "description": "(痴○SLG)メカクレ地味女の子、こはるちゃん。新生活早々、不慣れな電車通学が始まった。不運にもその時間は通勤ラッシュ、満員電車に揉まれることになり……。", "short_introduction": "(痴○SLG)メカクレ地味女の子、こはるちゃん。新生活早々、不慣れな電車通学が始まった。不運にもその時間は通勤ラッシュ、満員電車に揉まれることになり……。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01516148.html", "site_id": "maniax", "fetched_at": 1794947111}