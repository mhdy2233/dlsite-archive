ples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01524000/RJ01523547_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01524000/RJ01523547_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01524000/RJ01523547_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01524000/RJ01523547_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01524000/RJ01523547_img_smp5.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01524000/RJ01523547_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01524000/RJ01523547_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01524000/RJ01523547_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01524000/RJ01523547_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01524000/RJ01523547_img_smp5_100x100.jpg"], "alt": "お前の妻のマンコ [GURUGURU]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "「お前の妻のマンコ」は、R18 NTR RPGゲームです。ゲームでは、ヒロインの小春を操作し、田舎の6つの大陸に広がる広大な世界で冒険を繰り広げ、さまざまなモンスター、イベント、ボスに挑戦し、多様な稼ぎ方で借金を返済し、複雑な人間関係や複数のエンディングに直面します！<br />\n<br />\nゲームクリアまでに8時間を超え、全要素コンプリートには10時間以上を要します。"}]}, {"type": "image_list", "title": "キャラクター", "body": [{"intro": "ヒロイン - 小春<br />\r\n<br />\r\n優しく貞淑な主婦。夫の和也と共に田舎に戻り、供販社を経営し、借金返済の重い責任を負います。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01524000/RJ01523547/3fbf5fa8760e1370b3c9da6f2a88e480.jpg", "alt": "お前の妻のマンコ [GURUGURU]", "title": "お前の妻のマンコ [GURUGURU]"}}, {"intro": "小春の妹 - 玲奈<br />\r\n<br />\r\n大学を卒業したばかりで、若々しい活力に満ち、田舎に戻って自分の未来を探します。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01524000/RJ01523547/68445e6cd2f731b0af56baee69f87037.jpg", "alt": "お前の妻のマンコ [GURUGURU]", "title": "お前の妻のマンコ [GURUGURU]"}}, {"intro": "主人公 - 和也<br />\r\n<br />\r\n長年都市で重労働に従事し、体が弱く、都会生活に疲れた後、小春と共に田舎に戻り供販社を開業します。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01524000/RJ01523547/1fe871c83e9808fb78524eb6a777c899.jpg", "alt": "お前の妻のマンコ [GURUGURU]", "title": "お前の妻のマンコ [GURUGURU]"}}, {"intro": "田舎の村の覇者 - 大野<br />\r\n<br />\r\nギャンブルエンターテインメントを経営し、和也に供販社の開業資金を貸した人物。表面上は親しげだが、非常に狡猾で、甘い言葉と権力で他人を操るのが得意です。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01524000/RJ01523547/ceee49b70c62b406418037bf9ffdc0f6.jpg", "alt": "お前の妻のマンコ [GURUGURU]", "title": "お前の妻のマンコ [GURUGURU]"}}]}, {"type": "image", "title": "オープンワールド探索", "body": [{"intro": "6つの個性的な大陸で、ランダムなモンスターと遭遇し、ランダムな宝物、装備、さまざまなイベントやCGを獲得します。巣窟を探索し、強力なボスに挑戦し、隠されたストーリーや特別な報酬をアンロックします。敗北すると独特な敗北イベントCGがトリガーされ、刺激的なゲーム体験が追加されます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01524000/RJ01523547/29b2738ac8f508b3c6ed0941fa01f0e3.jpg", "alt": "お前の妻のマンコ [GURUGURU]", "title": "お前の妻のマンコ [GURUGURU]"}, "position": "over"}]}, {"type": "image_list", "title": "多様な稼ぎ方", "body": [{"intro": "農業:作物を植え、農場を経営し、安定した収入を得ます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01524000/RJ01523547/0166d60469a9b3b38cd5a919e1f70e40.jpg", "alt": "お前の妻のマンコ [GURUGURU]", "title": "お前の妻のマンコ [GURUGURU]"}}, {"intro": "商業:供販社を経営し 、商品を売買し、ビジネス帝国を築きます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01524000/RJ01523547/cf6eb8e7553ab96378668c35be4f87c1.jpg", "alt": "お前の妻のマンコ [GURUGURU]", "title": "お前の妻のマンコ [GURUGURU]"}}, {"intro": "狩猟:モンスターを狩り、貴重な素材を売却します。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01524000/RJ01523547/70d360e6fb42ec65423d4ef82df1c42d.jpg", "alt": "お前の妻のマンコ [GURUGURU]", "title": "お前の妻のマンコ [GURUGURU]"}}]}, {"type": "track_list", "title": "スキルと装備システム", "body": [{"duration": "", "name": "さまざまな装備の収集:小春の戦闘と生存能力を強化します。"}, {"duration": "", "name": "多様なスキルの修練:戦闘、売春などを含み、自由に成長ルートを組み合わせます。"}, {"duration": "", "name": "ランダムな宝物のドロップ:プレイヤーが最強のキャラクター構成を作るのを助けます。"}]}, {"type": "image", "title": "CGと成人向けコンテンツ", "body": [{"intro": "超豪華で百枚以上の精美なCGと高品質な動くエロアニメーションを含み、多様な成人向けシーンをカバーしています。 <br />\n敗北イベント、特別な稼ぎ方、サイドクエストには専用の成人向けイベントがあり、内容は豊富で刺激的です。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01524000/RJ01523547/d5d4d76c8719d949928501e2dd366a1a.jpg", "alt": "お前の妻のマンコ [GURUGURU]", "title": "お前の妻のマンコ [GURUGURU]"}, "position": "over"}]}], "description": "「お前の妻のマンコ」は、R18 NTR RPGゲームです。ゲームでは、ヒロインの小春を操作し、田舎の6つの大陸に広がる広大な世界で冒険を繰り広げ、さまざまなモンスター、イベント、ボスに挑戦し、多様な稼ぎ方で借金を返済し、複雑な人間関係や複数のエンディングに直面します！", "short_introduction": "「お前の妻のマンコ」は、R18 NTR RPGゲームです。ゲームでは、ヒロインの小春を操作し、田舎の6つの大陸に広がる広大な世界で冒険を繰り広げ、さまざまなモンスター、イベント、ボスに挑戦し、多様な稼ぎ方で借金を返済し、複雑な人間関係や複数のエンディングに直面します！", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01523547.html", "site_id": "maniax", "fetched_at": 1794947085}