period": "month", "rank": 39, "date": "2026-01-29"}, {"category": "game", "period": "day", "rank": 2, "date": "2025-12-31"}, {"category": "game", "period": "week", "rank": 11, "date": "2026-01-06"}, {"category": "game", "period": "month", "rank": 16, "date": "2026-01-27"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01535000/RJ01534169_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01535000/RJ01534169_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01535000/RJ01534169_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01535000/RJ01534169_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01535000/RJ01534169_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01535000/RJ01534169_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01535000/RJ01534169_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01535000/RJ01534169_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01535000/RJ01534169_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01535000/RJ01534169_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01535000/RJ01534169_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01535000/RJ01534169_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01535000/RJ01534169_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01535000/RJ01534169_img_smp6_100x100.jpg"], "alt": "拘束系リョナRPGの集大成！「深淵の森RPG3」 [SweetSprite]"}, "introductions": [{"type": "text", "title": "制作期間3年半！深淵の森RPGシリーズの集大成！", "body": [{"intro": "今作も大変退屈なRPGに仕上がりました！<br />\r\n<br />\r\n難易度はシリーズ通して高難度で、今作も不慣れな方には厳しい難易度と思われます。<br />\r\n往年のRPGをプレイした事のない方、シリーズを一度もプレイした事のない方、リョナシーンを目的として購入するのはご遠慮ください。<br />\r\nあくまでゲームが本編で、アニメーションは全ておまけです。<br />\r\n<br />\r\n「深淵の森RPG」シリーズは女の子1人だけの無謀な旅をテーマにしています。<br />\r\n主人公が順調に進んでいけば一度も性的な目に遭う事はありませんが、それをさせてくれないのが本シリーズ。<br />\r\n手を止め、ゆっくり考えながら進む事ができるRPGですが、反面、装備やスキルをしっかり整えないと先に進めません。"}]}, {"type": "text", "title": "やり込みたっぷりのアビリティシステム", "body": [{"intro": "往年の名作RPGをリスペクトしたアビリティシステムを採用。<br />\r\n<br />\r\nジョブレベルを上げてアビリティを習得したら、他のジョブにセットしてそのまま使えます。<br />\r\n攻防一体の安定スタイルか、それとも一撃で焼き尽くすアグレッシブなスタイルか…<br />\r\nプレイヤーの個性が出るシステムです。"}]}, {"type": "text", "title": "もちろん拘束シーンは健在", "body": [{"intro": "ボス級のエネミーは当然のように拘束攻撃を仕掛け、こちらの行動を封じてきます。<br />\r\nドキドキする拘束アニメーションを見て興奮…している暇はなく、拘束が進行すると解除不能に！<br />\r\n<br />\r\n最初の街で売られている対策アクセサリは破損こそしますが、敵の拘束攻撃を空振りさせ、大きな隙を発生させます。<br />\r\nアクセサリが破損しないことを祈りつつ、大きな魔法でワンパン‼"}]}, {"type": "text", "title": "ボス敗北はもちろん…", "body": [{"intro": "あまりにも性的嗜好が偏った、ループアニメーションによるバッドエンド。<br />\r\nかわいそうにもほどがあります…<br />\r\n<br />\r\n・ワームに丸呑みされ、口内では粘液まみれで締め付け<br />\r\n・ミミックの中は触手の海！?　ぐるぐる巻きにされ…<br />\r\n・クモに捕まり宙吊りに。大の字に拘束されたり、逆さ吊りにされたり…<br />\r\n・古代遺物のガーディアンはチューブや透明シート、人工粘液で女魔導師を捕えると…?<br />\r\n・図書館の隠し部屋を根城にする盗賊たちは投げ縄で獲物を捕らえ…<br />\r\n・巨大ミミズにぐるぐる巻きにされ、魔力と体液を搾り取られてしまう<br />\r\n・巨大ヒルのような生物は丸呑み後、獲物を強●絶頂させながら魔力を吸い上げる<br />\r\n・臭いのキツい巨大ラフレシアの中心で苗床状態！媚薬粘液を流し込まれ…<br />\r\n・ウツボカズラに上下から丸呑み！全身性感帯状態にされて舐られる<br />\r\n<br />\r\n第一章でバッドエンドは16本！<br />\r\nギャラリーでは本編で再生されない差分アニメも閲覧可能！"}]}, {"type": "image", "title": "おなじみの無料アップデートを実施！", "body": [{"intro": "第二章、第三章と大型アップデートを行い、内容を大量に追加！<br />\r\n将来的にジョブは8種以上、バッドエンドは30種以上になります。<br />\r\n<br />\r\n第二章(2026年夏頃　更新予定)<br />\r\n・プリンセス(お姫様)<br />\r\n・フェンサー(王子様)<br />\r\n・シーカー(体操服)<br />\r\n<br />\r\n第三章(2027年春頃　更新予定)<br />\r\n・サマナー(チアガール)<br />\r\n・アクアノート(スク水)<br />\r\n・クロノダイバー(アリス)<br />\r\n<br />\r\n更に隠しジョブも…?<br />\r\n<br />\r\n本編全収録後は体操服に特化した有料DLCも配信予定！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01535000/RJ01534169/a034b78b43f6c969f352768ad9ad777c.jpg", "alt": "拘束系リョナRPGの集大成！「深淵の森RPG3」 [SweetSprite]", "title": "拘束系リョナRPGの集大成！「深淵の森RPG3」 [SweetSprite]"}, "position": "left"}]}, {"type": "image", "title": "実質イージーモード", "body": [{"intro": "ゲームバランス大崩壊の彼がパーティーに加入⁉<br />\r\nイージーモードの代わりとして使えるのでお気軽に。<br />\r\n<br />\r\n解禁後も任意で加入、脱退させることができます。<br />\r\n<br />\r\n<br />\r\n<br />\r\n※当作品ではAI画像を参考とした背景画像を使用しております。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01535000/RJ01534169/3f168bb282d44e4f1d5a0df87ac82c0f.jpg", "alt": "拘束系リョナRPGの集大成！「深淵の森RPG3」 [SweetSprite]", "title": "拘束系リョナRPGの集大成！「深淵の森RPG3」 [SweetSprite]"}, "position": "left"}]}], "description": "フリーゲームで人気の「深淵の森RPG」シリーズ最新作！", "short_introduction": "フリーゲームで人気の「深淵の森RPG」シリーズ最新作！", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01534169.html", "site_id": "maniax", "fetched_at": 1794945502}