{"id": "RJ01534650", "title": "Plup Hands", "title_romaji": "purappuhanzu", "circle": {"id": "RG01000734", "name": "Conceptual Cage", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG01000734.html"}, "type": {"code": "ACN", "name": "アクション", "category": "game"}, "category": "doujin", "age": "all", "sex": 1, "price": {"jpy": 220, "official_jpy": 220, "currencies": {"USD": 1.3786802144975745, "EUR": 1.2528645038428772, "GBP": 1.0453302720994697, "TWD": 45.45172819866537, "CNY": 9.206369133555123, "KRW": 1841.0041841004186, "IDR": 25200.45819014891, "VND": 35483.87096774194, "THB": 46.72004077385377, "SEK": 13.917092086867958, "HKD": 10.818678940949683, "SGD": 1.776824394829764, "CAD": 1.9710700670611792, "MYR": 5.645382718457065, "BRL": 7.844703398896036, "AUD": 2.044054959063154, "PHP": 88.11984298646159, "MXN": 25.575744893570025, "NZD": 2.504177423246962, "INR": 129.5184269398328}}, "point": {"point_amount": 12, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1766732400, "file": {"type": "EXE", "size": 66951541}, "tags": [{"key": "254", "name": "ロボット/アンドロイド"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": null, "count": null}, "review_count": 0, "dl_count": 0, "wishlist_count": 4, "ranking": [], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01535000/RJ01534650_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01535000/RJ01534650_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01535000/RJ01534650_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01535000/RJ01534650_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01535000/RJ01534650_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01535000/RJ01534650_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01535000/RJ01534650_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01535000/RJ01534650_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01535000/RJ01534650_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01535000/RJ01534650_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01535000/RJ01534650_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01535000/RJ01534650_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01535000/RJ01534650_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01535000/RJ01534650_img_smp6_100x100.jpg"], "alt": "Plup Hands [Conceptual Cage]"}, "introductions": [{"type": "text", "title": "伸びる手、そろう数字", "body": [{"intro": "遊び方:<br />\nビンゴを揃えるゲームです。<br />\n<br />\nゲームが始まるとプレイヤーのボディ選択から始まります。<br />\nプレイヤーのボディは初期状態では何も特徴がありませんが、ロックされている4体のボディはそれぞれ特徴を持っています。<br />\nステージクリアすると入手できるポイントを消費して、ボディのアンロック、ボディのレベルを上げていく事ができます。<br />\nボディを選択している状態で開始ボタンを押すと次に進みます。<br />\n<br />\nプレイヤーは上下左右の4方向に手がある物体です。<br />\nそれぞれコントローラの4つのボタンに対応していてその方向のボタンを押すと、その方向の手が伸びます。<br />\nフィールドには数字の玉、爆弾、敵が存在し、動いています。<br />\n手を伸ばして数字の玉を取ると、ビンゴ盤のその数字が赤くなります。<br />\nそうやって数字の玉を取っていってビンゴを揃えていく事がステージクリアの条件になります。<br />\n最初は2列揃えるとステージクリアから、少しステージが進むと3列揃えなければいけなくなります。<br />\n制限時間が存在し(画面左上の青色のバー)、少しづつ減っていきます。<br />\n制限時間がなくなるとゲームオーバーです。<br />\n数字の玉を取ると時間が少し減ります。<br />\nビンゴを揃えると時間が少し回復します。<br />\nですからやみくもに数字を取っているとどんどん時間が減るので狙って数字を取っていく必要があるという事です。<br />\n爆弾に接触すると制限時間が少し減ります。<br />\n爆弾を手でつかんでしまうと、その手が破壊され、その方向に手が伸ばせなくなってしまいます。<br />\n4つの手が全て破壊されてもゲームオーバーです。<br />\n敵は少しづつプレイヤーに近づいてきます。動き続けていれば逃げる事はできますが、邪魔な時は射撃ボタンを押しながら、その方向の手のボタンを押すと、その方向にミサイルを発射し、敵を破壊する事ができます。<br />\n注意点はミサイルで数字の玉を破壊した場合は、その数字はもう出現しないので、その数字で揃える事ができなくなります。<br />\n<br />\n最初は4x4のマスでビンゴ盤が始まりますが、ステージが進んでいくと5x5のビンゴ盤に変わります。<br />\n<br />\nゲームオーバーになるとどこまでステージを進められたかがランキング表示されます。<br />\nゲームオーバーになるとタイトル画面に戻ります。<br />\nタイトル画面からコンティニューで続きから遊ぶ事ができます。<br />\nボディ選択画面で日本語、英語の切り替えをする事ができます。<br />\n<br />\n※キーボード操作不可能です。<br />\n※XBOX CONTROLLER以外のコントローラーでの動作は試していないため保証できません。<br />\n※体験版は1ステージクリア後にタイトル画面に戻るようになっています。またコンティニューを行う事はできません。<br />\n※このゲームはサークルALL SOURCESの過去作「FREAK BINGO」と内容が重複する部分がありますので、ご注意ください。<br />\n※タイトル画面のタイトルロゴ生成にAIを使用しております。"}]}], "description": "伸びる手、そろう数字", "short_introduction": "伸びる手、そろう数字", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01534650.html", "site_id": "home", "fetched_at": 1794946941}