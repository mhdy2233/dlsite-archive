month", "rank": 30, "date": "2026-04-06"}, {"category": "game", "period": "day", "rank": 1, "date": "2026-03-08"}, {"category": "game", "period": "week", "rank": 4, "date": "2026-03-14"}, {"category": "game", "period": "month", "rank": 19, "date": "2026-03-29"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01553000/RJ01552039_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01553000/RJ01552039_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01553000/RJ01552039_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01553000/RJ01552039_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01553000/RJ01552039_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01553000/RJ01552039_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01553000/RJ01552039_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01553000/RJ01552039_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01553000/RJ01552039_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01553000/RJ01552039_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01553000/RJ01552039_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01553000/RJ01552039_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01553000/RJ01552039_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01553000/RJ01552039_img_smp6_100x100.jpg"], "alt": "レディーナイト-淫魔の迷宮- [アイオライト]"}, "introductions": [{"type": "image", "title": "ゲーム内容", "body": [{"intro": "※ご購入前に体験版での動作確認を必ずお願いいたします<br />\n<br />\nCi-enにて「全開放データ」配布中！<br />\n<a href=\"https://ci-en.dlsite.com/creator/7593/article/1743018\" target=\"_blank\">https://ci-en.dlsite.com/creator/7593/article/1743018</a><br />\n<br />\n・バッドステート<br />\n淫紋、猿轡、ふたなりなどマニアックなバッドステートが襲い来る！<br />\n<br />\n・戦闘中の反応ボイス<br />\n戦闘中のエッチな攻撃に対してイディスはエッチな声を漏らしてしまいます。<br />\n臨場感が際立って実用性アップ！<br />\n<br />\n・シーンボイス<br />\nHシーンはボイスあり!<br />\nキャラのエロさを声が際立てます!<br />\n<br />\n・快楽値<br />\nエロい目にあうごとに「快楽値」が溜まっていきます。<br />\nこの値がマックスになるとイディスは戦闘中に絶頂！<br />\nさらにこの値によってエロイベントの反応も変化……！<br />\n<br />\n・敗北イベント<br />\nダンジョンを闊歩するごろつき冒険者に敗北すると<br />\n女騎士団長は虚しくも犯されてしまう！！<br />\n<br />\n・ゲームオーバーなし<br />\n敗北してもゲームオーバーにならないので、<br />\n安心してゲームを続けられます。<br />\n<br />\n・基本CG<br />\n戦闘立ち絵エロ　12(うち2はふたなり)<br />\n通常シーンエロ　10(うち2はサブキャラ)", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01553000/RJ01552039/d7e542755091f60227cf917ebc8d50d9.jpg", "alt": "レディーナイト-淫魔の迷宮- [アイオライト]", "title": "レディーナイト-淫魔の迷宮- [アイオライト]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "エロシーンは戦闘中の立ち絵によるものが中心です。<br />\r\n立ち絵に変化があるバステは戦闘中の立ち絵にも反映！<br />\r\nさらに一部のバステは一枚絵イベントにも反映されます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01553000/RJ01552039/15679b9fe1f31d5ff0d6336b2e2322e8.jpg", "alt": "レディーナイト-淫魔の迷宮- [アイオライト]", "title": "レディーナイト-淫魔の迷宮- [アイオライト]"}, "position": "over"}]}, {"type": "image", "title": "入るたびに形が変わるダンジョン", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01553000/RJ01552039/4f5719921b04a71249243fef8cd1bf19.jpg", "alt": "レディーナイト-淫魔の迷宮- [アイオライト]", "title": "レディーナイト-淫魔の迷宮- [アイオライト]"}, "position": "over"}]}, {"type": "image", "title": "ストーリー", "body": [{"intro": "とある街の治安を守る女騎士団長イディス。<br />\r\n<br />\r\n普段は街の治安維持の仕事をしているがダンジョンの難易度が急激に上がり<br />\r\n冒険者では手が出せないと報告があり貴族より調査を命じられる。<br />\r\n<br />\r\n調査の結果、ダンジョンは淫魔メルティによって作り変えられていることが発覚する。<br />\r\n淫魔を倒すためにダンジョンを突き進むが、<br />\r\nイディスは弱体化の呪文にかかってしまう……！<br />\r\n魔物たちはイディスの女体を狙っていやらしい攻撃を繰り出してくる。<br />\r\n<br />\r\nダンジョンを踏破してもとに戻せるのか、それとも……?", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01553000/RJ01552039/b8b2354c7257d6e1f619849ab2443f4f.jpg", "alt": "レディーナイト-淫魔の迷宮- [アイオライト]", "title": "レディーナイト-淫魔の迷宮- [アイオライト]"}, "position": "over"}]}, {"type": "image", "title": "エロステータス", "body": [{"intro": "イディスが受けたいやらしい出来事によって<br />\r\nエロステータスが記録されていきます！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01553000/RJ01552039/b7e537c262c7395ab856fb02f485e7b5.jpg", "alt": "レディーナイト-淫魔の迷宮- [アイオライト]", "title": "レディーナイト-淫魔の迷宮- [アイオライト]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01553000/RJ01552039/2f52b93f39852349ec89a90a8b394cc7.jpg", "alt": "レディーナイト-淫魔の迷宮- [アイオライト]", "title": "レディーナイト-淫魔の迷宮- [アイオライト]"}, "position": "over"}]}], "description": "ダンジョンに挑む女騎士に襲い来る容赦ないエロバステの数々！！", "short_introduction": "ダンジョンに挑む女騎士に襲い来る容赦ないエロバステの数々！！", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01552039.html", "site_id": "maniax", "fetched_at": 1794944935}