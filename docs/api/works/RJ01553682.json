{"id": "RJ01553682", "title": "Nibbling・Clover", "title_romaji": "niburingukuroobaa", "circle": {"id": "RG57222", "name": "テディ✕3", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG57222.html"}, "type": {"code": "RPG", "name": "ロールプレイング", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 770, "official_jpy": 770, "currencies": {"USD": 4.825380750741511, "EUR": 4.38502576345007, "GBP": 3.6586559523481443, "TWD": 159.0810486953288, "CNY": 32.222291967442935, "KRW": 6443.514644351465, "IDR": 88201.6036655212, "VND": 124193.54838709677, "THB": 163.52014270848818, "SEK": 48.70982230403786, "HKD": 37.86537629332389, "SGD": 6.218885381904174, "CAD": 6.898745234714127, "MYR": 19.758839514599728, "BRL": 27.456461896136126, "AUD": 7.154192356721039, "PHP": 308.4194504526156, "MXN": 89.51510712749509, "NZD": 8.764620981364367, "INR": 453.31449428941477}}, "point": {"point_amount": 42, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1771484400, "file": {"type": "EXE", "size": 508495457}, "tags": [{"key": "068", "name": "淫語"}, {"key": "061", "name": "鬱"}, {"key": "235", "name": "エルフ/妖精"}, {"key": "526", "name": "快楽堕ち"}, {"key": "048", "name": "寝取られ"}, {"key": "323", "name": "アヘ顔"}, {"key": "154", "name": "超ひどい"}, {"key": "200", "name": "人体改造"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 4.54, "count": 50}, "review_count": 0, "dl_count": 254, "wishlist_count": 465, "ranking": [{"category": "game", "period": "day", "rank": 30, "date": "2026-02-20"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01554000/RJ01553682_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01554000/RJ01553682_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01554000/RJ01553682_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01554000/RJ01553682_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01554000/RJ01553682_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01554000/RJ01553682_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01554000/RJ01553682_img_smp5.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01554000/RJ01553682_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01554000/RJ01553682_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01554000/RJ01553682_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01554000/RJ01553682_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01554000/RJ01553682_img_smp5_100x100.jpg"], "alt": "Nibbling・Clover [テディ✕3]"}, "introductions": [{"type": "text", "title": "(作品紹介)", "body": [{"intro": "※本作品をご購入する際は、事前に体験版にて動作確認を行ってください。<br />\r\n※不具合を見つけた際は、Ci-enの専用記事にてご報告いただけると助かります。<br />\r\n※本ゲームの詳しい更新情報については、Ci-enサイト専用記事にてご確認ください。<br />\r\n　サイトURL　:　<a href=\"https://ci-en.dlsite.com/creator/10117/article\" target=\"_blank\">https://ci-en.dlsite.com/creator/10117/article</a><br />\r\n<br />\r\n<br />\r\n〈一口内容紹介〉<br />\r\n<br />\r\n<br />\r\nボリューム　　:■■■□□<br />\r\nストーリー性　:■■■■□<br />\r\nゲームの難易度:■■■■□<br />\r\n超ひどい　　　:■■■■■<br />\r\nアブノーマル　:■■■■■<br />\r\n寝取られ　　　:■■□□□<br />\r\n<br />\r\n<br />\r\n<br />\r\n&lt;あらすじ&gt;<br />\r\n<br />\r\n<br />\r\nこれは地球によく似た、とある異世界の物語。<br />\r\n<br />\r\n貴方は田舎の村で暮らす、平民の青年だ。<br />\r\n村長の息子として育ち、剣の腕も立つため、村人達から慕われている。<br />\r\n<br />\r\nそんな貴方の家には、他とは違う特別な奉公人がいる。<br />\r\nそれは世にも珍しい、ハーフエルフの女だ。<br />\r\n<br />\r\n彼女とは幼い頃から共に過ごし、やがて互いを想い合うようになった。<br />\r\n貴方は村での穏やかな日々が、いつまでも続くと信じていた。<br />\r\n<br />\r\nだが、ある日の朝。貴方の父は病に倒れてしまう。<br />\r\n魔法で一命を取り留めたものの、病が癒える気配はない。<br />\r\n<br />\r\n父を救うには、幻の霊薬《エリクサー》を手に入れる他ない。<br />\r\n貴方は彼女に父を託し、霊薬を求めて王都へと旅立つのであった。<br />\r\n<br />\r\n<br />\r\n&lt;登場人物&gt;<br />\r\n<br />\r\n<br />\r\n主人公:プレイヤーの分身。病に倒れた父を救うため、一人、王都で奔走する。<br />\r\n<br />\r\nフリヘット(ヒロイン):ハーフエルフの女。その生い立ち故に、何かと苦労が多い。<br />\r\n<br />\r\n盗賊団:あらゆる悪事に手を染める犯罪集団。主人公が留守の間に村を襲撃する。"}]}, {"type": "image", "title": "(システム紹介)", "body": [{"intro": "〈基本システム〉<br />\r\n<br />\r\n<br />\r\n・本作は〝次元シリーズ〟のナンバリング作品ですが、設定を共有した別の世界線の物語です。<br />\r\n<br />\r\n・単体で完結した作品となっているため、過去作を未プレイの方でも安心してお楽しみいただけます。<br />\r\n<br />\r\n・本作は時間経過によってエンディングが分岐するアクションRPGです。<br />\r\n　主人公は病に倒れた父を救うべく、冒険者として様々な依頼をこなしていきます。<br />\r\n<br />\r\n・本作は現実時間に合わせてゲーム内の時間が進行していきます。<br />\r\n　現実での1分がゲーム内の1時間に相当します。<br />\r\n<br />\r\n・一日に行動できる時間には限りがあります。<br />\r\n　制限時間を過ぎると拠点に帰還となるため、常に時間を意識して行動しましょう。<br />\r\n(※一部のイベント中は時間経過が止まります)<br />\r\n<br />\r\n・本作のクリア目標は、火山の山頂に住まう〝ファイアドラゴン〟の討伐です。<br />\r\n　ファイアドラゴンは伝説の魔物です。準備を整えてから決戦に挑みましょう。<br />\r\n<br />\r\n・本作のコンセプトは、〝貴方の知らぬ間に〟。<br />\r\n　貴方が王都で奔走する間、ヒロイン側でもイベントが発生します。<br />\r\n　主人公の帰りが遅くなるほど、ヒロインの身に災いが降りかかります。<br />\r\n　最良の結末を迎えるため、最短でゲームクリアを目指しましょう。<br />\r\n<br />\r\n<br />\r\n<br />\r\n〈戦闘システム〉<br />\r\n<br />\r\n<br />\r\n・魔物の体は頑丈なため、並の剣では直ぐに折れてしまいます。<br />\r\n　そのため、本作では剣が消耗品として扱われます。<br />\r\n<br />\r\n・主人公は剣の達人であり、三種の技を使用できます。<br />\r\n　ただし強力な技ほど、剣の耐久値を大きく消耗します。<br />\r\n　状況に応じて技を使い分けましょう。<br />\r\n<br />\r\n・持ち運べる剣と回復薬の数には上限があります。<br />\r\n　剣と回復薬は店で買う他、ダンジョン内の〝木樽〟からも稀にドロップします。<br />\r\n(※所持する剣が全て折れた場合、拳で戦うことができます)", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01554000/RJ01553682/b65f520d18ae871fa878307094ae4b32.jpg", "alt": "Nibbling・Clover [テディ✕3]", "title": "Nibbling・Clover [テディ✕3]"}, "position": "under"}]}, {"type": "image_list", "title": "(Hシーン紹介)", "body": [{"intro": "～全てのシーンが凌○！～<br />\r\n貴方が一人奔走する間、ヒロインは盗賊達の毒牙にかかります。<br />\r\n帰りが遅れるほど、プレイは更に過激に……。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01554000/RJ01553682/778236b4c4e0490237e70c2fa97ae33e.jpg", "alt": "Nibbling・Clover [テディ✕3]", "title": "Nibbling・Clover [テディ✕3]"}}, {"intro": "～全ての穴を犯し尽くす！～<br />\r\n膣、口、肛門、果てには尿道や乳首まで。<br />\r\n今作も穴という穴を犯します。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01554000/RJ01553682/9e1431e92b2388b472508f7e028da47c.jpg", "alt": "Nibbling・Clover [テディ✕3]", "title": "Nibbling・Clover [テディ✕3]"}}, {"intro": "～時には無様に！～<br />\r\n今作は心を抉るシーンをいくつかご用意しています。<br />\r\nヒロインは体だけでなく、心まで弄ばれます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01554000/RJ01553682/fee691c7ad6c10a78a178938f3f913ea.jpg", "alt": "Nibbling・Clover [テディ✕3]", "title": "Nibbling・Clover [テディ✕3]"}}, {"intro": "～過激な人体改造！～<br />\r\n魔物の力でヒロインの体は3段階に変異していきます。<br />\r\n変異が進むほどに性器が巨大化し、最後は見るも無残な姿に……。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01554000/RJ01553682/70fda5b5a9b29a88c00775c063e5b030.jpg", "alt": "Nibbling・Clover [テディ✕3]", "title": "Nibbling・Clover [テディ✕3]"}}]}, {"type": "text", "title": "(仕様)", "body": [{"intro": "～Hシーン～<br />\r\n・人体改造<br />\r\n・ハードプレイ<br />\r\n・寝取られ<br />\r\n・ニプルファック<br />\r\n・道具責め等々…………。<br />\r\n<br />\r\n～内容～<br />\r\n・ゲームジャンル:アクションRPG<br />\r\n・解像度:1280×720<br />\r\n・基本HCG数:12(差分100枚以上)<br />\r\n　※立ち絵などは含みません。<br />\r\n・総Hシーン数:44(※非Hシーンを除く)<br />\r\n・回想部屋、全開放スイッチ完備<br />\r\n・プレイ時間:約3時間<br />\r\n<br />\r\n～製作ツール～<br />\r\n　RPGツクールMZ"}]}], "description": "貴方の知らぬ間に、乙女は堕ちる。", "short_introduction": "貴方の知らぬ間に、乙女は堕ちる。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01553682.html", "site_id": "maniax", "fetched_at": 1794945114}