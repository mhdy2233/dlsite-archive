p/modpub/images2/parts/RJ01556000/RJ01555483/9c02fe3d24c799faba50b38254e7e554.jpg", "alt": "「力」が全ての世界で「合法」レ●プの旅 [しおとはな]", "title": "「力」が全ての世界で「合法」レ●プの旅 [しおとはな]"}}, {"intro": "穏やかな魔物", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01556000/RJ01555483/fdf0c855f3650bb8da0069c4392cb565.jpg", "alt": "「力」が全ての世界で「合法」レ●プの旅 [しおとはな]", "title": "「力」が全ての世界で「合法」レ●プの旅 [しおとはな]"}}, {"intro": "シャイな魔法使い", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01556000/RJ01555483/74ff53c8ac7f8a945a219c671f2cb177.jpg", "alt": "「力」が全ての世界で「合法」レ●プの旅 [しおとはな]", "title": "「力」が全ての世界で「合法」レ●プの旅 [しおとはな]"}}]}, {"type": "image_list", "title": "イベント例+機能紹介", "body": [{"intro": "薬屋を痺れさせて・・・", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01556000/RJ01555483/16ee5503a636f63250c753fa49d5d7ef.jpg", "alt": "「力」が全ての世界で「合法」レ●プの旅 [しおとはな]", "title": "「力」が全ての世界で「合法」レ●プの旅 [しおとはな]"}}, {"intro": "とりあえずエロいポーズさせて踊り子をどう○すか考え中・・・", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01556000/RJ01555483/125cdea82ddb24eef18a4fa4f61bd0cf.jpg", "alt": "「力」が全ての世界で「合法」レ●プの旅 [しおとはな]", "title": "「力」が全ての世界で「合法」レ●プの旅 [しおとはな]"}}, {"intro": "・ミニイベント<br />\n旅の道中では犯されている女の子もいます。特に自分に関係なくこの世界では普通なのでミニイベントとして消化されます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01556000/RJ01555483/336ed07a0e1d57d78d2a924f49082819.jpg", "alt": "「力」が全ての世界で「合法」レ●プの旅 [しおとはな]", "title": "「力」が全ての世界で「合法」レ●プの旅 [しおとはな]"}}, {"intro": "回想部屋ではイベントだけでなく立ち絵も！ウィンドウを消して楽しむこともできます。登場キャラ20人全員着衣からレ●プ後まであります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01556000/RJ01555483/cef11b8672ecc4dc863d1be32903e4c6.jpg", "alt": "「力」が全ての世界で「合法」レ●プの旅 [しおとはな]", "title": "「力」が全ての世界で「合法」レ●プの旅 [しおとはな]"}}]}, {"type": "text", "title": "", "body": [{"intro": "登場キャラクター　20人　全員裸差分あり<br />\n回想部屋あり<br />\n<br />\n20人+イベントCG28枚<br />\n合計　CG48枚　<br />\n<br />\n※本作はRPGツクールMZで制作しています。<br />\n　動作環境などについては、体験版をプレイしてご確認下さい。<br />\n<br />\n※体験版の内容、不具合の修正をしました"}]}], "description": "魔物がはびこる世界で何より重要なのは力！力さえ証明できれば何をしても