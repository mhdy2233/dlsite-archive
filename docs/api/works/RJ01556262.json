ages2/work/doujin/RJ01557000/RJ01556262_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01557000/RJ01556262_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01557000/RJ01556262_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01557000/RJ01556262_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01557000/RJ01556262_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01557000/RJ01556262_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01557000/RJ01556262_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01557000/RJ01556262_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01557000/RJ01556262_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01557000/RJ01556262_img_smp9.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01557000/RJ01556262_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01557000/RJ01556262_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01557000/RJ01556262_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01557000/RJ01556262_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01557000/RJ01556262_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01557000/RJ01556262_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01557000/RJ01556262_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01557000/RJ01556262_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01557000/RJ01556262_img_smp9_100x100.jpg"], "alt": "夏休みの自由研究#1～#3 まとめパック [citore]"}, "introductions": [{"type": "text", "title": "作品概要", "body": [{"intro": "自由研究シリーズ #1〜#3をまとめて収録した総集編パックです。<br />\r\n<br />\r\nLive2Dでぬるぬる動くヒロインを、段階的に観察・記録していく「観察シミュレーションR18」。<br />\r\n研究項目を選んで進めることで、ヒロインとの距離が少しずつ近づき、研究ノートが埋まっていきます。"}]}, {"type": "text_list", "title": "ゲームの特徴", "body": [{"intro": "フェーズ制の段階的進行:導入→観察拡大→クライマックスへ"}, {"intro": "研究項目の選択:反応の違いを見比べながら進行"}, {"intro": "研究ノート機能:観察結果が記録され、埋めていく達成感"}, {"intro": "快適なUI:シンプルで直感的な操作"}, {"intro": "Live2Dアニメーション:表情・視線・身体の反応を重視した演出"}]}, {"type": "image_list", "title": "収録作品", "body": [{"intro": "自由研究 #1<br />\r\n清楚で真面目な優等生(結月)<br />\r\n<br />\r\n夏休み、自由研究を手伝いに来た真面目なクラスメイトを“研究対象”として観察していく物語。<br />\r\n最初は軽い接触から始まり、進行とともに観察範囲が拡大していきます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01557000/RJ01556262/904aadb1059be5a5a1126755388b90e1.jpg", "alt": "夏休みの自由研究#1～#3 まとめパック [citore]", "title": "夏休みの自由研究#1～#3 まとめパック [citore]"}}, {"intro": "自由研究 #2<br />\r\n日焼けギャル(学校の各所が舞台)<br />\r\n<br />\r\n明るく積極的で、からかいながらも反応してしまうギャルを相手に、学校内の場所を選びながら研究を進めます。<br />\r\n教室・美術室・屋上など、舞台による雰囲気の違いも楽しめます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01557000/RJ01556262/03941cffc8f6d38dfe5a45da8e6abde4.jpg", "alt": "夏休みの自由研究#1～#3 まとめパック [citore]", "title": "夏休みの自由研究#1～#3 まとめパック [citore]"}}, {"intro": "自由研究 #3<br />\r\n陰キャ少女(黒川しずく)<br />\r\n<br />\r\n教室で“秘密の一面”を目撃したことをきっかけに、地味で内気な少女を研究へ巻き込んでいく内容。<br />\r\n怯えた視線や小さな反応が、Live2Dで細かく描写されます。<br />\r\n※支配・強○を想起させる要素を含みます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01557000/RJ01556262/183d4f857f930523911513cf61cceb96.jpg", "alt": "夏休みの自由研究#1～#3 まとめパック [citore]", "title": "夏休みの自由研究#1～#3 まとめパック [citore]"}}]}, {"type": "image_list", "title": "ゲームシステム紹介", "body": [{"intro": "観察の順序は研究ノートに記録され、項目を達成するたびに新しい行動が解放。<br />\r\n　一つひとつの進捗が、ふたりの距離を少しずつ縮めていきます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01557000/RJ01556262/727c0e0cca1fef6a0c71c3e66a6b6c7c.jpg", "alt": "夏休みの自由研究#1～#3 まとめパック [citore]", "title": "夏休みの自由研究#1～#3 まとめパック [citore]"}}, {"intro": "自由研究ノート<br />\r\n研究成果はノートにしっかり記録。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01557000/RJ01556262/49f4f239e9027e439a4419c2b1e98f4c.jpg", "alt": "夏休みの自由研究#1～#3 まとめパック [citore]", "title": "夏休みの自由研究#1～#3 まとめパック [citore]"}}, {"intro": "自由観察モード搭載<br />\r\n　ストーリーを飛ばし、好きなフェーズから即プレイ可能。<br />\r\n　お気に入りのシーンだけ何度でも楽しめます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01557000/RJ01556262/ffb34002a8df5c6157c5adf27eba75b7.jpg", "alt": "夏休みの自由研究#1～#3 まとめパック [citore]", "title": "夏休みの自由研究#1～#3 まとめパック [citore]"}}, {"intro": "直感的な操作で誰でもすぐにプレイ可能。<br />\r\n　膣断面図を採用し、今どの位置を観察しているかがひと目でわかります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01557000/RJ01556262/4df69a6307bfd6f34b198e4a682a3d5d.jpg", "alt": "夏休みの自由研究#1～#3 まとめパック [citore]", "title": "夏休みの自由研究#1～#3 まとめパック [citore]"}}]}], "description": "自由研究シリーズ #1〜#3をまとめて収録した総集編パックです。 Live2Dでぬるぬる動くヒロインを、段階的に観察・記録していく「観察シミュレーションR18」。 研究項目を選んで進めることで、ヒロインとの距離が少しずつ近づき、研究ノートが埋まっていきます。", "short_introduction": "自由研究シリーズ #1〜#3をまとめて収録した総集編パックです。 Live2Dでぬるぬる動くヒロインを、段階的に観察・記録していく「観察シミュレーションR18」。 研究項目を選んで進めることで、ヒロインとの距離が少しずつ近づき、研究ノートが埋まっていきます。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01556262.html", "site_id": "maniax", "fetched_at": 1794945261}