age_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01558000/RJ01557831/99593a3e707969485d46b5187929605f.jpg", "alt": "奴を追い分からせる [ゑろきばたぁ]", "title": "奴を追い分からせる [ゑろきばたぁ]"}, "position": "left"}]}, {"type": "image_list", "title": "アイテム", "body": [{"intro": "門エナジー<br />\r\n<br />\r\nすこし速度が上がる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01558000/RJ01557831/9aa61a1d845785e9a2888ab269b2c16b.jpg", "alt": "奴を追い分からせる [ゑろきばたぁ]", "title": "奴を追い分からせる [ゑろきばたぁ]"}}, {"intro": "門エナジー+<br />\r\n<br />\r\nかなり速度が上がる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01558000/RJ01557831/09171566e5fbe6be61b792146ab7fa4a.jpg", "alt": "奴を追い分からせる [ゑろきばたぁ]", "title": "奴を追い分からせる [ゑろきばたぁ]"}}, {"intro": "トゲ<br />\r\n<br />\r\nいたい。<br />\r\n触れると速度が下がる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01558000/RJ01557831/aad70fa8f55abb01a088195f4661c640.jpg", "alt": "奴を追い分からせる [ゑろきばたぁ]", "title": "奴を追い分からせる [ゑろきばたぁ]"}}, {"intro": "くり<br />\r\n<br />\r\nとてもいたい。<br />\r\n触れると速度がかなり下がる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01558000/RJ01557831/82eb0544c2de2528b0829711a4683944.jpg", "alt": "奴を追い分からせる [ゑろきばたぁ]", "title": "奴を追い分からせる [ゑろきばたぁ]"}}]}], "description": "ただ、奴を追い、分からせるのみ。", "short_introduction": "ただ、奴を追い、分からせるのみ。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01557831.html", "site_id": "maniax", "fetched_at": 1794945267}