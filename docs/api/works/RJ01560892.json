_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01561000/RJ01560892/1914228d5fd0efa1ea4767426c4388de.jpg", "alt": "あの子を汚したい~野営~ [血液を愛しましょう]", "title": "あの子を汚したい~野営~ [血液を愛しましょう]"}}, {"intro": "服をめくったり、脱がせたりして自分好みにカスタマイズできます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01561000/RJ01560892/3210a712442f890af7f8aa242dacbe0f.jpg", "alt": "あの子を汚したい~野営~ [血液を愛しましょう]", "title": "あの子を汚したい~野営~ [血液を愛しましょう]"}}, {"intro": "専用ボタンで、簡単に女の子へぶっかけることができます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01561000/RJ01560892/45b82522e02ffec0323b4e6163918729.jpg", "alt": "あの子を汚したい~野営~ [血液を愛しましょう]", "title": "あの子を汚したい~野営~ [血液を愛しましょう]"}}]}], "description": "星空の下で眠る美少女にぶっかけシミュレーションゲーム！！マウス一つで着衣も視点も自由自在。野営中に行うストレスフリーすやすやえっち！", "short_introduction": "星空の下で眠る美少女にぶっかけシミュレーションゲーム！！マウス一つで着衣も視点も自由自在。野営中に行うストレスフリーすやすやえっち！", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01560892.html", "site_id": "maniax", "fetched_at": 1794945065}