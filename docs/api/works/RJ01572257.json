ank": 80, "date": "2026-03-30"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01573000/RJ01572257_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01573000/RJ01572257_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01573000/RJ01572257_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01573000/RJ01572257_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01573000/RJ01572257_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01573000/RJ01572257_img_smp4.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01573000/RJ01572257_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01573000/RJ01572257_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01573000/RJ01572257_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01573000/RJ01572257_img_smp4_100x100.jpg"], "alt": "修学旅行の夜 [イヌのすみか]"}, "introductions": [{"type": "text", "title": "修学旅行でこっそり。すやすやえっちおさわりシミュ。", "body": [{"intro": "昼は無邪気に、楽しくわいわい。<br />\n夜はすやすや、こっそりおさわり……。<br />\n<br />\nおさななじみの女子の身体に、いろんなえっちなことをしてしまいましょう。<br />\n<br />\n※作者のci-enで攻略情報を掲載予定です。<br />\n<a href=\"https://ci-en.dlsite.com/creator/16348/article/1742486\" target=\"_blank\">https://ci-en.dlsite.com/creator/16348/article/1742486</a>"}]}, {"type": "image", "title": "昼は楽しく修学旅行シミュ", "body": [{"intro": "昼は一緒に、修学旅行を楽しみましょう。<br />\n<br />\nハイキングをしたり、寺社仏閣をまわったり……。<br />\n2人の間に「信頼」を育んでいきましょう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01573000/RJ01572257/cabeb7c7faf93a5ae3f73c811418601f.jpg", "alt": "修学旅行の夜 [イヌのすみか]", "title": "修学旅行の夜 [イヌのすみか]"}, "position": "over"}]}, {"type": "image", "title": "夜はこっそり、すやすやえっちシミュ", "body": [{"intro": "おっぱいを触ったり、服を脱がせたり……。<br />\n眠っている女子の身体に、あんなことやこんなことをしちゃいましょう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01573000/RJ01572257/19c3df7d84fc5ccdc58a4341ac2e4891.jpg", "alt": "修学旅行の夜 [イヌのすみか]", "title": "修学旅行の夜 [イヌのすみか]"}, "position": "over"}]}, {"type": "image", "title": "バスの中でも……", "body": [{"intro": "バスの中でもおさわり可能。<br />\nこっそり脱がせて、おさわりしちゃいましょう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01573000/RJ01572257/e3e20ca0f78efb3a5d1845ccefb6eeac.jpg", "alt": "修学旅行の夜 [イヌのすみか]", "title": "修学旅行の夜 [イヌのすみか]"}, "position": "over"}]}, {"type": "image", "title": "睡眠中に記録される、えっちステータス", "body": [{"intro": "おさわりすると、「開発度」が上がっていきます。<br />\n無邪気な女子の身体を、こっそりえっちにしちゃいましょう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01573000/RJ01572257/17246fa7804ad51bd77aabac7c75f11e.jpg", "alt": "修学旅行の夜 [イヌのすみか]", "title": "修学旅行の夜 [イヌのすみか]"}, "position": "over"}]}], "description": "おさななじみ女子と、すやすやえっちシミュ。", "short_introduction": "おさななじみ女子と、すやすやえっちシミュ。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01572257.html", "site_id": "maniax", "fetched_at": 1794944967}