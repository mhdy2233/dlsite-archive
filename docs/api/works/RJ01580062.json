mples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01581000/RJ01580062_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01581000/RJ01580062_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01581000/RJ01580062_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01581000/RJ01580062_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01581000/RJ01580062_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01581000/RJ01580062_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01581000/RJ01580062_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01581000/RJ01580062_img_smp8.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01581000/RJ01580062_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01581000/RJ01580062_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01581000/RJ01580062_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01581000/RJ01580062_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01581000/RJ01580062_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01581000/RJ01580062_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01581000/RJ01580062_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01581000/RJ01580062_img_smp8_100x100.jpg"], "alt": "Seeking Dorinta - Way of the Warrior [カミカンパニーC&B]"}, "introductions": [{"type": "text", "title": "オーソドックスなRPG", "body": [{"intro": "旅の途中に立ち寄った町にあるダンジョンに武者修行として攻略する<br />\r\n町では依頼を受けてお金を稼ぎ武器を買う<br />\r\nオーソドックスなRPG<br />\r\nでも依頼はエッチなものばかり！?"}]}, {"type": "image", "title": "【ゲーム紹介】", "body": [{"intro": "ダンジョンを攻略して進むオーソドックスなRPG<br />\n負ければもちろんぶち犯される<br />\n町で依頼を聞いてお金を稼ぐ<br />\nでも内容はエッチなものばかり・・・<br />\n悪いことをすれば当然捕まって檻に叩き込まれます<br />\n身体検査で無様なかんかん踊りを披露したり土下座したり、おいたが過ぎればキツイ○問まで・・・<br />\nでも一切挫けずダンジョン最奥を目指して突き進め！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01581000/RJ01580062/27023a89076beec93bdacbcb504b4097.jpg", "alt": "Seeking Dorinta - Way of the Warrior [カミカンパニーC&B]", "title": "Seeking Dorinta - Way of the Warrior [カミカンパニーC&B]"}, "position": "left"}]}, {"type": "image", "title": "レナ", "body": [{"intro": "【主人公】<br />\n一人前の剣士になるべく武者修行の旅を続ける少女<br />\n体は頑丈だが頭はちょっと弱いかも・・・<br />\n戦士職の特徴として体が丈夫でHPが毎ターン少しずつ回復するぞ<br />\n様々な苦難を乗り越えて成長する彼女に期待だ<br />\n(心も体も結構タフなのでボロ雑巾のようにしばいて鍛えよう)", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01581000/RJ01580062/55a0dbe0d4c6512dc8e84e399f7e79b0.jpg", "alt": "Seeking Dorinta - Way of the Warrior [カミカンパニーC&B]", "title": "Seeking Dorinta - Way of the Warrior [カミカンパニーC&B]"}, "position": "left"}]}, {"type": "image", "title": "シチュエーション", "body": [{"intro": "セックス、アナル、フェラチオはもちろん<br />\n肉便器にされたり全裸土下座かましたり<br />\n電流攻めや鞭打ちなど<br />\n結構ハードな仕打ちがレナを待ち受けている", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01581000/RJ01580062/6f4c21b88bc7eddbac254df2279f53bf.jpg", "alt": "Seeking Dorinta - Way of the Warrior [カミカンパニーC&B]", "title": "Seeking Dorinta - Way of the Warrior [カミカンパニーC&B]"}, "position": "left"}]}], "description": "少女剣士の修行の旅", "short_introduction": "少女剣士の修行の旅", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01580062.html", "site_id": "maniax", "fetched_at": 1794944817}