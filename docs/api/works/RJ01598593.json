ate": "2026-07-30"}, {"category": "game", "period": "day", "rank": 5, "date": "2026-07-04"}, {"category": "game", "period": "week", "rank": 12, "date": "2026-07-10"}, {"category": "game", "period": "month", "rank": 33, "date": "2026-07-28"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01599000/RJ01598593_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01599000/RJ01598593_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01599000/RJ01598593_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01599000/RJ01598593_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01599000/RJ01598593_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01599000/RJ01598593_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01599000/RJ01598593_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01599000/RJ01598593_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01599000/RJ01598593_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01599000/RJ01598593_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01599000/RJ01598593_img_smp9.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01599000/RJ01598593_img_smp10.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01599000/RJ01598593_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01599000/RJ01598593_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01599000/RJ01598593_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01599000/RJ01598593_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01599000/RJ01598593_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01599000/RJ01598593_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01599000/RJ01598593_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01599000/RJ01598593_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01599000/RJ01598593_img_smp9_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01599000/RJ01598593_img_smp10_100x100.jpg"], "alt": "NTRAGON QUEST [ATN]"}, "introductions": [{"type": "image", "title": "異種に寝取られるファンタジーゲーム", "body": [{"intro": "主人公の大切な母親や幼馴染が、敵である魔物に堕ちてしまいます。<br />\r\n※今作では汚いおっさんも竿役として登場しますが、最終的にヒロインたちが堕ちるのは魔物です。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01599000/RJ01598593/f22e9e698a2cb260d64153a0cb6d85c1.jpg", "alt": "NTRAGON QUEST [ATN]", "title": "NTRAGON QUEST [ATN]"}, "position": "under"}]}, {"type": "image_list", "title": "どこかで見たことがあるヒロインたち紹介", "body": [{"intro": "・ヒロイン1<br />\r\n幼馴染ヒロインです。<br />\r\n幼年期からずっと主人公のことが大好きで主人公と結ばれますが、最後は魔物に寝取られます。<br />\r\n対応する竿役は馬魔物です。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01599000/RJ01598593/e32fd3a724b83a386be1b99c60202155.jpg", "alt": "NTRAGON QUEST [ATN]", "title": "NTRAGON QUEST [ATN]"}}, {"intro": "・ヒロイン2<br />\r\n母親ヒロインです。<br />\r\n夫のかたきを討つために旅をしています。<br />\r\n主人公のことを誰よりも愛していますが、最後は魔物に寝取られます。<br />\r\n対応する竿役はワニ魔物です。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01599000/RJ01598593/237d457198c98078bb190b1562d6386e.jpg", "alt": "NTRAGON QUEST [ATN]", "title": "NTRAGON QUEST [ATN]"}}]}, {"type": "image", "title": "シーン数は31！", "body": [{"intro": "おっさんにセクハラされたり、魔物に堕とされたりします。<br />\r\nクリア後にはおまけもあり、追加のシーンも解放されます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01599000/RJ01598593/2f872958f082b06e34c39ee6ce742c03.jpg", "alt": "NTRAGON QUEST [ATN]", "title": "NTRAGON QUEST [ATN]"}, "position": "over"}]}, {"type": "image", "title": "物語の各段階でエロステが更新されます！", "body": [{"intro": "物語中にヒロインたちのエロステータスが更新されていきます。<br />\r\nヒロインの各部位の開発度や配合表、思っていることなどの情報を閲覧可能です。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01599000/RJ01598593/5a53602e3ea2a0697fe9dbe078163bce.jpg", "alt": "NTRAGON QUEST [ATN]", "title": "NTRAGON QUEST [ATN]"}, "position": "under"}]}, {"type": "image_list", "title": "ゲームの特徴", "body": [{"intro": "・自由に名前を設定できます<br />\r\n主人公やヒロイン・竿役たちは自由に名前を設定することが可能です。<br />\r\n※名前入力画面で何も入力せずに決定すると、デフォルトネームが適用されます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01599000/RJ01598593/24efb267c54dc1749acc9f71a0b06903.jpg", "alt": "NTRAGON QUEST [ATN]", "title": "NTRAGON QUEST [ATN]"}}, {"intro": "・マップやイベントなど<br />\r\nできる限り原作を再現して制作しており、当時プレイ中に妄想したあれこれを具現化しています。<br />\r\nもちろんクリア後にはおまけダンジョンも追加されます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01599000/RJ01598593/f3b6169fa75d7bca2b6cfc74943c1596.jpg", "alt": "NTRAGON QUEST [ATN]", "title": "NTRAGON QUEST [ATN]"}}, {"intro": "・視点切り替え可能！<br />\r\n今作ももちろん視点切り替え可能です。<br />\r\n主人公視点と全体視点を自由に切り替えられます。<br />\r\n主人公視点では、知らない間に変わっていくヒロインたちの変化を楽しむことができます。<br />\r\n(※主人公視点で物語を進めても、回想は登録されます。)", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01599000/RJ01598593/3d530412eddab72312295d2af1b73d98.jpg", "alt": "NTRAGON QUEST [ATN]", "title": "NTRAGON QUEST [ATN]"}}, {"intro": "・サクサク戦闘<br />\r\nフィールドやダンジョンでは、敵シンボルに触れることで瞬時に戦闘が終了しますので、忙しい方でも安心！<br />\r\nボス戦闘では従来のRPGのようにコマンド選択式バトルとなります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01599000/RJ01598593/2a6423529f7c1836157146f6bb96378b.jpg", "alt": "NTRAGON QUEST [ATN]", "title": "NTRAGON QUEST [ATN]"}}]}, {"type": "text", "title": "毎週土曜日にci-enで進捗公開中！", "body": [{"intro": "毎週土曜日にci-enにて進捗を公開していますので、ぜひお越しください！<br />\r\n<a href=\"https://ci-en.dlsite.com/creator/13432\" target=\"_blank\">https://ci-en.dlsite.com/creator/13432</a><br />\r\n※完全クリアセーブデータは、当サークルのci-enページ(このページの上部にもリンクがあります)にて配布しております。"}]}], "description": "どこかで見たことのある主人公の大切な母親や幼馴染が、敵である魔物に堕ちてしまう異種NTRゲームです。", "short_introduction": "どこかで見たことのある主人公の大切な母親や幼馴染が、敵である魔物に堕ちてしまう異種NTRゲームです。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01598593.html", "site_id": "maniax", "fetched_at": 1794942749}