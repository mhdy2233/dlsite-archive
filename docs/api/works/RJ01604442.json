}, {"category": "game", "period": "day", "rank": 6, "date": "2026-05-15"}, {"category": "game", "period": "week", "rank": 18, "date": "2026-05-21"}, {"category": "game", "period": "month", "rank": 45, "date": "2026-06-02"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01605000/RJ01604442_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01605000/RJ01604442_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01605000/RJ01604442_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01605000/RJ01604442_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01605000/RJ01604442_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01605000/RJ01604442_img_smp4.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01605000/RJ01604442_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01605000/RJ01604442_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01605000/RJ01604442_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01605000/RJ01604442_img_smp4_100x100.jpg"], "alt": "退魔部 ハメ撮り活動記録 [まぜ]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "・寝取られ・BSS系RPG<br />\r\n<br />\r\n・あらすじ<br />\r\n一人前の退魔師を目指して<br />\r\n退魔部へ入ることを決めた友と凛奈<br />\r\n<br />\r\n頼りがいのある部長、優しい副部長に迎えられ<br />\r\n退魔師として、悪霊との戦いに身を投じていく。<br />\r\n<br />\r\nしかし、この部には秘密があった……<br />\r\n<br />\r\n<br />\r\n・キャラクター紹介<br />\r\n「友」<br />\r\n退魔部に入部したばかりの新入部員<br />\r\n幼馴染の凛奈を守るため、<br />\r\n強くなろうと日夜奮闘している。<br />\r\n<br />\r\n「凛奈」<br />\r\n友の幼馴染の少女。<br />\r\n彼の事は気になっているが<br />\r\nお互いに一歩踏み込めない関係<br />\r\n<br />\r\n「丈二」<br />\r\n退魔部の部長<br />\r\n堂々として頼りがいのある青年<br />\r\n退魔師としての実力も折り紙付きだが<br />\r\n女癖だけが悪い。趣味はハメ撮り<br />\r\n<br />\r\n「雫」<br />\r\n退魔部の副部長<br />\r\nいつも優しく部員の皆をサポートしている。<br />\r\n丈二の悪癖を承知の上で手を貸している。<br />\r\n<br />\r\n「レオナ」<br />\r\n退魔部の女子部員<br />\r\n気だるげな態度が目立つが、面倒見はいい。<br />\r\n丈二の悪癖を承知の上で手を貸している。<br />\r\n<br />\r\n<br />\r\n基本CG数 23枚<br />\r\n回想部屋と全開放スイッチ付き"}]}], "description": "寝取られRPG", "short_introduction": "寝取られRPG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01604442.html", "site_id": "maniax", "fetched_at": 1794944276}