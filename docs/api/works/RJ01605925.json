od": "month", "rank": 75, "date": "2026-06-02"}, {"category": "game", "period": "day", "rank": 4, "date": "2026-05-10"}, {"category": "game", "period": "week", "rank": 9, "date": "2026-05-16"}, {"category": "game", "period": "month", "rank": 33, "date": "2026-06-02"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01606000/RJ01605925_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01606000/RJ01605925_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01606000/RJ01605925_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01606000/RJ01605925_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01606000/RJ01605925_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01606000/RJ01605925_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01606000/RJ01605925_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01606000/RJ01605925_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01606000/RJ01605925_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01606000/RJ01605925_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01606000/RJ01605925_img_smp9.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01606000/RJ01605925_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01606000/RJ01605925_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01606000/RJ01605925_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01606000/RJ01605925_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01606000/RJ01605925_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01606000/RJ01605925_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01606000/RJ01605925_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01606000/RJ01605925_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01606000/RJ01605925_img_smp9_100x100.jpg"], "alt": "イニシエの騎士とイケニエの巫女 [へるめす]"}, "introductions": [{"type": "text", "title": "物語", "body": [{"intro": "とある時代のとある王国は、謎の物質、魔霞&lt;マカ&gt;に覆われ、さらに魔物による侵略を受けていた。<br />\nその状況を打破すべく、かつて王国を救い導いた伝説の女騎士、アルカを復活させる。<br />\nしかし、アルカの復活は不完全な状態となってしまい、アルカに生命エネルギー&lt;マナ&gt;を注入し続けなくてはいけない。<br />\nそこで、王国が研究しているホムンクルス製造の技術によって、使い捨ての巫女を用意し、凌○することによりマナを絞り出しアルカの戦闘を援護する事となる。<br />\n<br />\n巫女の凌○を知らされていないアルカは、最果ての地に住む魔女を討伐し、世界を救えるのか。<br />\nそして、世界に隠された真実とは――?<br />\n<br />\n王国の未来を賭けた戦いが今、<br />\nイニシエの騎士、アルカと<br />\nイケニエの巫女の肩に重く伸し掛かかった――。"}]}, {"type": "image", "title": "イニシエの騎士　アルカ", "body": [{"intro": "「ーーー受けて立つ…！」<br />\n<br />\nかつて、数多の災厄から王国を守り続けてきた伝説の騎士。<br />\n再び王国に危機が訪れた時に国民を守るため、自らの意志で封印された。<br />\n相手が未知の敵であろうと、怯むことなく前へ進む。<br />\n<br />\n守ることが正義なのか。<br />\n倒すべき敵は正しいのか。<br />\nそれはわからない。<br />\n<br />\nそれでも国王の命令に従い、王国と人々を守るために戦い続ける。<br />\n<br />\nたとえその先にあるものが、望んだ真実でなくとも、<br />\n歩みを止めることはない。<br />\n<br />\nその手に、大剣を携えて。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01606000/RJ01605925/1d6dc8b5593b3c4195278f065c17e691.jpg", "alt": "イニシエの騎士とイケニエの巫女 [へるめす]", "title": "イニシエの騎士とイケニエの巫女 [へるめす]"}, "position": "left"}]}, {"type": "image", "title": "イケニエの巫女　ニーナ", "body": [{"intro": "「ーーーアルカさま、はじめまして。<br />\n　　　　　　　　　ニーナともうします。」<br />\n<br />\n戦いに赴くアルカにマナを送り続けるために製造されたホムンクルスの少女。<br />\n生まれた理由も、これから自分に何が起こるかもわかっていない。<br />\n<br />\nただ、アルカのために在ると教えられた。<br />\n<br />\nだから少女は受け入れる。<br />\nマナを生み出すために、その身を穢されていくことを。<br />\n<br />\nそれでも、きっともうすぐ終わると信じている。<br />\nアルカを、信じている。<br />\n<br />\nそして最後は――", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01606000/RJ01605925/a3371bd20cd2002a13429482ad50ac03.jpg", "alt": "イニシエの騎士とイケニエの巫女 [へるめす]", "title": "イニシエの騎士とイケニエの巫女 [へるめす]"}, "position": "left"}]}, {"type": "image", "title": "???", "body": [{"intro": "「ーーーやっぱりニンゲンは、<br />\n　　　　　身勝手で残酷なイキモノ…。」<br />\n<br />\n人間を憎む、謎の女性。<br />\n人の形をしているが、その存在はどこか歪んでいて、人とも魔物ともつかない。<br />\n<br />\n彼女はすべてを見届けてきたかのように、静かに、悲しそうに笑う。<br />\n<br />\n救いを求めているのか、全てを諦めているのか。<br />\n<br />\nその感情が、憎しみなのか、哀しみなのか。<br />\n<br />\n彼女は見届ける、アルカの選択、そしてニーナの行く末を。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01606000/RJ01605925/0c6aecd1c20f94051dad9e5fc08e84b4.jpg", "alt": "イニシエの騎士とイケニエの巫女 [へるめす]", "title": "イニシエの騎士とイケニエの巫女 [へるめす]"}, "position": "left"}]}, {"type": "image", "title": "クリックアドベンチャー！", "body": [{"intro": "・巫女をクリックして生命エネルギーをマナに変換！！<br />\n・マナを消費して、調教アイテムを購入！より効率的にマナを集めろ！！<br />\n・購入した調教アイテムは左のメニューから巫女に装着できる！！<br />\n　よりエッチに、より過激に巫女を調教せよ！！！<br />\n・アルカは自動的に敵を攻撃してくれる！クリック連打でダメージアップ！！<br />\n・アルカが敵に負けると強○レ〇プ！?！?クリック連打で抜け出そう！！<br />\n・敵を倒すことによってステージの進捗ゲージが上昇！！<br />\n　ボスを倒して物語の終焉を見届けろ！！！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01606000/RJ01605925/ce356ef13d0f4add87d0a20b3ad3cfb3.jpg", "alt": "イニシエの騎士とイケニエの巫女 [へるめす]", "title": "イニシエの騎士とイケニエの巫女 [へるめす]"}, "position": "over"}]}], "description": "イニシエの騎士、アルカ。そしてイケニエの巫女、ニーナの物語。王国の危機によって蘇った伝説の騎士であるアルカは、生贄になるためだけに生み出されたホムンクルスのニーナと出会い…そして…", "short_introduction": "イニシエの騎士、アルカ。そしてイケニエの巫女、ニーナの物語。王国の危機によって蘇った伝説の騎士であるアルカは、生贄になるためだけに生み出されたホムンクルスのニーナと出会い…そして…", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01605925.html", "site_id": "maniax", "fetched_at": 1794944317}