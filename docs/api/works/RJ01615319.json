, "period": "day", "rank": 12, "date": "2026-05-10"}, {"category": "game", "period": "week", "rank": 22, "date": "2026-05-16"}, {"category": "game", "period": "month", "rank": 45, "date": "2026-06-01"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01616000/RJ01615319_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01616000/RJ01615319_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01616000/RJ01615319_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01616000/RJ01615319_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01616000/RJ01615319_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01616000/RJ01615319_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01616000/RJ01615319_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01616000/RJ01615319_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01616000/RJ01615319_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01616000/RJ01615319_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01616000/RJ01615319_img_smp9.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01616000/RJ01615319_img_smp10.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01616000/RJ01615319_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01616000/RJ01615319_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01616000/RJ01615319_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01616000/RJ01615319_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01616000/RJ01615319_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01616000/RJ01615319_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01616000/RJ01615319_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01616000/RJ01615319_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01616000/RJ01615319_img_smp9_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01616000/RJ01615319_img_smp10_100x100.jpg"], "alt": "【中英日】細胞崩壊 [境界遊楽]"}, "introductions": [{"type": "text", "title": "背景ストーリー", "body": [{"intro": "近未来、人類は「プロメテウス細胞計画」を始動させた。遺伝子編集と人工知能を融合させ、人体強化と文明の進化を目指す壮大な計画である。<br />\n<br />\nしかし実験は完全に制御を失い、未知の「崩壊因子」が実験サンプルから流出した。この因子は有機細胞や電子機器を侵食し、生物の変異や機械の暴走を引き起こし、ついに「大崩壊」を誘発した。<br />\n<br />\n都市は荒廃し、自然は歪み、科学技術は機能停止。人類は絶滅寸前にまで追い込まれた。<br />\n<br />\n唯一生き残った「星核」AI 指揮台は、当時の実験基地が遺した人工知能であり、一部の実験データと崩壊後の世界情報を保管している。微弱な電波で生存者であるプレイヤーと接触し、崩壊の根源を探し出し、災厄を覆す道を探すよう誘導する。<br />\nプレイヤーは改造人間の最後の生き残りであり、体内に崩壊因子耐性因子が埋め込まれている。崩壊濃度の高い環境でも正常に行動でき、唯一災厄の拡大を食い止める可能性を持つ存在だ。"}]}, {"type": "image", "title": "戦闘シーン", "body": [{"intro": "これはSF風の横スクロールアクションゲームです。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01616000/RJ01615319/9f9d57f664b1ae0ecf530f177ff5baaa.jpg", "alt": "【中英日】細胞崩壊 [境界遊楽]", "title": "【中英日】細胞崩壊 [境界遊楽]"}, "position": "over"}]}, {"type": "image_list", "title": "多彩な遊び方で、世界を探索しよう。", "body": [{"intro": "必要な解除アイテムを集めると、新たなエリアが開放される。多彩な遊び方で、世界を探索しよう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01616000/RJ01615319/cc89518b549a18d50663891fc8700344.jpg", "alt": "【中英日】細胞崩壊 [境界遊楽]", "title": "【中英日】細胞崩壊 [境界遊楽]"}}, {"intro": "エリア内で様々な資料文書を入手可能。これらの資料を通じて、本作の世界観を徐々に知ることができる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01616000/RJ01615319/294e495ccd6bf311d737f82faf0f4824.jpg", "alt": "【中英日】細胞崩壊 [境界遊楽]", "title": "【中英日】細胞崩壊 [境界遊楽]"}}, {"intro": "クリスタルを収集することで、ステータスを強化。レベルアップとともにキャラクターを成長させていきます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01616000/RJ01615319/15829042a49b7f16520b3d2e3d7c0da8.jpg", "alt": "【中英日】細胞崩壊 [境界遊楽]", "title": "【中英日】細胞崩壊 [境界遊楽]"}}, {"intro": "多種多様な敵を撃破し、各種アニメーションを解放せよ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01616000/RJ01615319/e459944ea56bf3421a507f7666dd88c5.jpg", "alt": "【中英日】細胞崩壊 [境界遊楽]", "title": "【中英日】細胞崩壊 [境界遊楽]"}}]}, {"type": "image", "title": "多彩な敵キャラクターとフルアニメーションHCGを搭載", "body": [{"intro": "ゾンビ、昆虫、獣、触手、蜘蛛、植物、さまざまなモンスターが登場。<br />\n各敵には、主人公が倒された際に発生する専用のイベントが用意されています。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01616000/RJ01615319/ca5c4e3bcaafcf9e9d0f6c4c44415054.jpg", "alt": "【中英日】細胞崩壊 [境界遊楽]", "title": "【中英日】細胞崩壊 [境界遊楽]"}, "position": "over"}]}, {"type": "image", "title": "多彩な敵キャラクターとフルアニメーションHCGを搭載", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01616000/RJ01615319/289e2514918af2b85ae4daae8f76ebde.jpg", "alt": "【中英日】細胞崩壊 [境界遊楽]", "title": "【中英日】細胞崩壊 [境界遊楽]"}, "position": "over"}]}, {"type": "image", "title": "多彩で美麗な各種ステージ", "body": [{"intro": "森や地下下水道、実験室、宇宙、多彩なステージが登場し、<br />\nそれぞれが美しさと神秘に満ちた探索を楽しめます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01616000/RJ01615319/d14648d06529b65b92920996fb10678d.jpg", "alt": "【中英日】細胞崩壊 [境界遊楽]", "title": "【中英日】細胞崩壊 [境界遊楽]"}, "position": "over"}]}], "description": "近未来、人類は「プロメテウス細胞計画」を始動させた。遺伝子編集と人工知能を融合させ、人体強化と文明の進化を目指す壮大な計画である。プレイヤーは改造人間の最後の生き残りであり、体内に崩壊因子耐性因子が埋め込まれている。崩壊濃度の高い環境でも正常に行動でき、唯一災厄の拡大を食い止める可能性を持つ存在だ。", "short_introduction": "近未来、人類は「プロメテウス細胞計画」を始動させた。遺伝子編集と人工知能を融合させ、人体強化と文明の進化を目指す壮大な計画である。プレイヤーは改造人間の最後の生き残りであり、体内に崩壊因子耐性因子が埋め込まれている。崩壊濃度の高い環境でも正常に行動でき、唯一災厄の拡大を食い止める可能性を持つ存在だ。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01615319.html", "site_id": "maniax", "fetched_at": 1794944309}