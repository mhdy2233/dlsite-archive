{"id": "RJ01624458", "title": "神の血:The Blood of Yidhra", "title_romaji": "kaminochizaburaddoobuiidora", "circle": {"id": "RG44896", "name": "WhitePeach", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG44896.html"}, "type": {"code": "ACN", "name": "アクション", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 3410, "official_jpy": 3410, "currencies": {"USD": 21.369543324712403, "EUR": 19.419399809564595, "GBP": 16.20261921754178, "TWD": 704.5017870793132, "CNY": 142.69872157010442, "KRW": 28535.564853556487, "IDR": 390607.1019473081, "VND": 550000, "THB": 724.1606319947334, "SEK": 215.71492734645335, "HKD": 167.6895235847201, "SGD": 27.540778119861343, "CAD": 30.551586039448278, "MYR": 87.50343213608451, "BRL": 121.59290268288856, "AUD": 31.682851865478884, "PHP": 1365.8575662901546, "MXN": 396.42404585033535, "NZD": 38.81475006032791, "INR": 2007.5356175674083}}, "point": {"point_amount": 186, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1782313200, "file": {"type": "EXE", "size": 917828411}, "tags": [{"key": "073", "name": "アニメ"}, {"key": "432", "name": "女主人公"}, {"key": "533", "name": "戦闘エロ"}, {"key": "414", "name": "ゾンビ"}, {"key": "114", "name": "命令/無理矢理"}, {"key": "134", "name": "屈辱"}, {"key": "113", "name": "合意なし"}, {"key": "313", "name": "リョナ"}], "languages": ["CHI_HANS", "CHI_HANT", "JPN", "ENG", "CHI"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 4.51, "count": 1302}, "review_count": 30, "dl_count": 13519, "wishlist_count": 28073, "ranking": [{"category": "all", "period": "day", "rank": 1, "date": "2026-06-25"}, {"category": "all", "period": "week", "rank": 1, "date": "2026-06-27"}, {"category": "all", "period": "month", "rank": 5, "date": "2026-07-19"}, {"category": "all", "period": "total", "rank": 464, "date": "2026-11-16"}, {"category": "game", "period": "day", "rank": 1, "date": "2026-06-25"}, {"category": "game", "period": "week", "rank": 1, "date": "2026-06-27"}, {"category": "game", "period": "month", "rank": 5, "date": "2026-07-19"}, {"category": "game", "period": "total", "rank": 390, "date": "2026-11-16"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01625000/RJ01624458_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01625000/RJ01624458_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01625000/RJ01624458_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01625000/RJ01624458_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01625000/RJ01624458_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01625000/RJ01624458_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01625000/RJ01624458_img_smp5.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01625000/RJ01624458_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01625000/RJ01624458_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01625000/RJ01624458_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01625000/RJ01624458_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01625000/RJ01624458_img_smp5_100x100.jpg"], "alt": "神の血:The Blood of Yidhra [WhitePeach]"}, "introductions": [{"type": "image", "title": "◆概要", "body": [{"intro": "※恐れ入りますが、体験版のセーブデータは正式版へ引き継ぐことができません。<br />\n<br />\n本作は、銃器・近接武器・特殊武器を使い分けながら、理性を失った感染者たちを撃破していく2D横スクロールACTゲームです。<br />\n<br />\n前作『The Shadow of Yidhra』の物語を補完する内容となっており、デルタ、双葉、真紀たちを中心に、イドラをめぐる真実が描かれます。<br />\n<br />\n本作では、通常の銃器や近接武器に加え、<br />\n火炎放射器、グレネードランチャー、コンパウンドボウなどの特殊武器も追加。<br />\n<br />\n武器ごとに異なる攻撃表現が用意されており、敵の部位欠損演出や、R18G要素を含むCG・Hシーンアニメーションも収録されています。<br />\n<br />\n※R18G要素は初期設定ではONになっています。設定画面からOFFにすることで非表示されます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01625000/RJ01624458/3e786be170e30cd8e72c38fc23b8211c.jpg", "alt": "神の血:The Blood of Yidhra [WhitePeach]", "title": "神の血:The Blood of Yidhra [WhitePeach]"}, "position": "over"}]}, {"type": "image_list", "title": "◆システム紹介", "body": [{"intro": "◆Hアニメーション<br />\r\n<br />\r\n本作には、以下のHアニメーションを収録しています。<br />\r\n<br />\r\n・ヒロイン関連の戦闘Hアニメーション<br />\r\n・NPC敵同士のHアニメーション<br />\r\n・ステージ演出用の環境Hアニメーション<br />\r\n<br />\r\n総数は100種類以上です。<br />\r\n<br />\r\n※一部のHアニメーションにはR18G要素が含まれます。<br />\r\n※R18G要素は設定画面でONにした場合のみ表示されます。<br />\r\n※R18G要素には、流血・部位欠損などの表現が含まれます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01625000/RJ01624458/7d217e31c7b01614d2ffb8c1d311b85a.jpg", "alt": "神の血:The Blood of Yidhra [WhitePeach]", "title": "神の血:The Blood of Yidhra [WhitePeach]"}}, {"intro": "◆環境Hアニメーション<br />\r\n<br />\r\n多くの環境用Hアニメーションはクリックすることで拡大表示が可能です。<br />\r\n高精細な大きな画像で確認できます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01625000/RJ01624458/b4af496b8d5c5ff948884852b000e71e.jpg", "alt": "神の血:The Blood of Yidhra [WhitePeach]", "title": "神の血:The Blood of Yidhra [WhitePeach]"}}, {"intro": "◆CG<br />\r\n<br />\r\n・全動態CG<br />\r\n・ヒロイン関連CG:30枚<br />\r\n・ストーリー用CG:3枚<br />\r\n・R18G差分:12枚", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01625000/RJ01624458/bb611dee20519d857659289222be9070.jpg", "alt": "神の血:The Blood of Yidhra [WhitePeach]", "title": "神の血:The Blood of Yidhra [WhitePeach]"}}, {"intro": "◆新規武器紹介<br />\r\n<br />\r\n·火炎放射器<br />\r\n<br />\r\n炎を連続で噴射し、敵を焼き尽くします。<br />\r\n<br />\r\n·電撃銃<br />\r\n<br />\r\n電流を放ち、敵を麻痺させながらダメージを与えます。<br />\r\n<br />\r\n·グレネードランチャー<br />\r\n<br />\r\nグレネード弾を発射し、小範囲に爆発ダメージを与えます。<br />\r\n<br />\r\n·レーザーガン<br />\r\n<br />\r\n高エネルギーの光線を放ち、敵に継続ダメージを与えます。<br />\r\n<br />\r\nそのほかにも、重機関銃、コンパウンドボウなどの特殊武器・特殊アイテムを収録しています。<br />\r\nぜひ実際に使い比べてみてください。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01625000/RJ01624458/6f19ca1733a1a97431738772a5572d8f.jpg", "alt": "神の血:The Blood of Yidhra [WhitePeach]", "title": "神の血:The Blood of Yidhra [WhitePeach]"}}]}, {"type": "image", "title": "◆ゲーム紹介", "body": [{"intro": "イドラの血。<br />\r\nそれは、イドラの身体から絶え間なく流れ出す血液を採取し、さまざまな物質を加えることで作られた薬剤です。<br />\r\n<br />\r\n特殊な薬剤を加えた「神血」は、人間を若返らせ、強靭にし、精力を増幅させ、さらには強大な能力すら与えることができます。<br />\r\n<br />\r\nしかし、神血を注射された者たちは、少しずつ異常を見せ始めます。<br />\r\n<br />\r\n最初は、ほんの短い精神錯乱。<br />\r\n周囲の人々は、ただ一時的に感情が荒れているだけだと思っていました。<br />\r\n<br />\r\nけれど時間が経つにつれ、理性を保てる時間は短くなり、やがて彼らは本能だけで行動する存在へと変わっていきます。<br />\r\n<br />\r\n科学者たちは神血の製造方法を知っていました。<br />\r\nしかし、その原理を最後まで解明することはできませんでした。<br />\r\n<br />\r\n一方で、古い文献を所有する貴族たちは、それを科学ではなく、魔法――あるいは呪いだと考えていました。<br />\r\n<br />\r\n記憶を持つ実験体デルタは、改造実験の中で高濃度の神血を注射されます。<br />\r\n<br />\r\nすべての人間から欺かれ、真実を隠されたまま、デルタは第2研究所の特別行動班の一員となります。<br />\r\n<br />\r\nそしてデルタは、もう一人の自分と出会います。<br />\r\nその出会いをきっかけに、彼女はイドラをめぐる真実へと近づいていくことになります。<br />\r\n<br />\r\n◆ゲームスクリーンショット<br />\r\n※物語上のつながりがあるため、一部の研究所ステージおよび野外工場ステージには、前作『The Shadow of Yidhra』の一部ステージ素材を使用しています。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01625000/RJ01624458/dd3b0017cd7ae81ef1f131ad2b836a63.jpg", "alt": "神の血:The Blood of Yidhra [WhitePeach]", "title": "神の血:The Blood of Yidhra [WhitePeach]"}, "position": "under"}]}, {"type": "image_list", "title": "◆登場キャラクター", "body": [{"intro": "【操作可能ヒロイン】双葉<br />\n<br />\nデルタが学生だった頃の姿であり、最初の感染事件を経験することになります。<br />\n<br />\nCV:本多未季", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01625000/RJ01624458/c3f0765b8b23baab4f8a618454c03bd7.jpg", "alt": "神の血:The Blood of Yidhra [WhitePeach]", "title": "神の血:The Blood of Yidhra [WhitePeach]"}}, {"intro": "【操作可能ヒロイン】実験体デルタ<br />\n<br />\n目覚めた実験体。<br />\nいくつかの偽りの記憶を植え付けられており、<br />\n周囲からの欺瞞と隠蔽によって、自分自身の正体に疑問を抱き始めます。<br />\n<br />\nCV:本多未季", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01625000/RJ01624458/94670bb19370f252b61aaedbf4cef816.jpg", "alt": "神の血:The Blood of Yidhra [WhitePeach]", "title": "神の血:The Blood of Yidhra [WhitePeach]"}}, {"intro": "【操作可能ヒロイン】真紀<br />\n<br />\n双葉、つまりデルタの母親。<br />\nかつてイドラの発掘計画に参加していました。<br />\n<br />\nデルタは真紀の記憶へと入り込み、当時の発掘計画と、伊德海拉をめぐる真実を知ることになります。<br />\n<br />\nCV:本多未季", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01625000/RJ01624458/8ffaec1176a338d24008f22d48400699.jpg", "alt": "神の血:The Blood of Yidhra [WhitePeach]", "title": "神の血:The Blood of Yidhra [WhitePeach]"}}, {"intro": "趙 美琴<br />\n<br />\nかつて連合政府に所属していたエージェント。<br />\n協力者として研究所の訓練に参加していました。<br />\n<br />\nCV:御子柴泉", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01625000/RJ01624458/1754ade134cc4a0a4abc457e0c2191ec.jpg", "alt": "神の血:The Blood of Yidhra [WhitePeach]", "title": "神の血:The Blood of Yidhra [WhitePeach]"}}]}, {"type": "image_list", "title": "", "body": [{"intro": "一乃<br />\n<br />\nデルタの仲間。<br />\nあらゆる物事に強い好奇心を持っています。<br />\nしかし、自分自身の存在に関する真実を知った時、彼女は大きな現実と向き合うことになります。<br />\n<br />\nCV:道楽みぃ", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01625000/RJ01624458/685885cf733aa4e985a4eee7e7785333.jpg", "alt": "神の血:The Blood of Yidhra [WhitePeach]", "title": "神の血:The Blood of Yidhra [WhitePeach]"}}, {"intro": "壹<br />\n<br />\n第2研究所のメインコントロールAI。<br />\n<br />\nCV:おしりぺちぺちか", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01625000/RJ01624458/4329ce4f495a911c388d1b1efbcdf167.jpg", "alt": "神の血:The Blood of Yidhra [WhitePeach]", "title": "神の血:The Blood of Yidhra [WhitePeach]"}}, {"intro": "アルカナ<br />\n<br />\n第2研究所の主任博士。<br />\n長年にわたり、イドラに関する研究を続けています。<br />\n<br />\nCV:御子柴泉", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01625000/RJ01624458/3b46f99329248f44e0d1a0771f5b1049.jpg", "alt": "神の血:The Blood of Yidhra [WhitePeach]", "title": "神の血:The Blood of Yidhra [WhitePeach]"}}, {"intro": "黒蜘蛛の女伯爵<br />\n<br />\n古き血筋を受け継ぐ貴族であり、蜘蛛の巣組織の実質的な支配者。<br />\n大量の歴史文献と研究資料を所有しています。<br />\n<br />\nしかし、神血の影響により、意識がはっきりしている時間は次第に少なくなっていきます。<br />\n<br />\nCV:道楽みぃ", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01625000/RJ01624458/115093ea5dbeb0730331a379d55e52c6.jpg", "alt": "神の血:The Blood of Yidhra [WhitePeach]", "title": "神の血:The Blood of Yidhra [WhitePeach]"}}]}, {"type": "image", "title": "◆操作方法", "body": [{"intro": "左クリック:攻撃<br />\n右クリック:照準<br />\n1 / 2 / 3キー:武器切り替え<br />\nFキー:次の会話へ進む<br />\nAキー:左へ移動<br />\nDキー:右へ移動<br />\nSキー:下へ移動<br />\nFキー:拾う / 決定<br />\nQキー:手榴弾を使用<br />\nRキー:リロード<br />\nCキー:医療キットを使用<br />\nEキー:装備欄を開く<br />\nスペースキー:ジャンプ / 二段ジャンプ<br />\nShiftキー:ダッシュ<br />\nESCキー:メニューを開く / 戻る / 会話を閉じる<br />\nCtrl + F4:HP固定<br />\n<br />\n※セーブデータ引き継ぎ方法<br />\n以前のバージョンの下記フォルダ内にある cgdata.sav および Save フォルダを、新しいバージョンの同じ場所へ上書きすることで、セーブデータを引き継ぐことができます。<br />\n<br />\nThe Blood of Yidhra_Data/StreamingAssets<br />\n<br />\n※体験版のセーブデータは使用しないでください。<br />\n※体験版のフォルダを上書きしないようご注意ください。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01625000/RJ01624458/a81ced0b33213eee221e14688f035cb1.jpg", "alt": "神の血:The Blood of Yidhra [WhitePeach]", "title": "神の血:The Blood of Yidhra [WhitePeach]"}, "position": "over"}]}], "description": "前作『The Shadow of Yidhra』の物語を補完する、2D横スクロールACT。銃器・近接武器・特殊武器を使い分け、理性を失った感染者と戦う。100以上のH演出と全動態CGを収録し、R18G要素は設定で切替可能。", "short_introduction": "前作『The Shadow of Yidhra』の物語を補完する、2D横スクロールACT。銃器・近接武器・特殊武器を使い分け、理性を失った感染者と戦う。100以上のH演出と全動態CGを収録し、R18G要素は設定で切替可能。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01624458.html", "site_id": "maniax", "fetched_at": 1794943907}