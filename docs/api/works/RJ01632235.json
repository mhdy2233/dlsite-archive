": [{"intro": "基本CG:7枚(アニメーション)<br />\r\nその他アニメーション:小さなアニメーションが約50種！<br />\r\nプレイ時間:20、30分程", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01633000/RJ01632235/9f20449786c79824c1fc03c741253fd9.jpg", "alt": "触手クリッカー～感覚遮断で女の子を苗床化～ [セリネット]", "title": "触手クリッカー～感覚遮断で女の子を苗床化～ [セリネット]"}, "position": "over"}]}, {"type": "image", "title": "冒険者ちゃんを苗床化しよう！", "body": [{"intro": "感覚遮断で本人は気づいてません。しかし、体は無意識に抵抗してます。<br />\r\nHPを減らし苗床化しましょう！<br />\r\nまたHPが減ると魔法(MP)を使って自動回復するので、触手強化、アイテム、淫紋解放を駆使しがんばりましょう！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01633000/RJ01632235/61d2f11242f91bbfd5e94abeeb32011c.jpg", "alt": "触手クリッカー～感覚遮断で女の子を苗床化～ [セリネット]", "title": "触手クリッカー～感覚遮断で女の子を苗床化～ [セリネット]"}, "position": "over"}]}, {"type": "image", "title": "クリックして開発しよう！", "body": [{"intro": "女の子の部位(性器)をクリックすることでポイント(DP)が貯まります。<br />\r\n貯まったポイントを使うことで触手強化やスキルを獲得することができます。<br />\r\nまたクリックをすると素材を得るできます。<br />\r\n強化することで効率よくHPを減らしたり、<br />\r\nスキルを獲得することで素材を多く得ることができます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01633000/RJ01632235/24e05f3a5d2dadbeab65527808951093.jpg", "alt": "触手クリッカー～感覚遮断で女の子を苗床化～ [セリネット]", "title": "触手クリッカー～感覚遮断で女の子を苗床化～ [セリネット]"}, "position": "over"}]}, {"type": "image_list", "title": "得られた素材でアイテムを合成しよう！", "body": [{"intro": "部位から得られる素材はアイテムリストに！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01633000/RJ01632235/44ddad2d0fd9940bff6da852c45c8175.jpg", "alt": "触手クリッカー～感覚遮断で女の子を苗床化～ [セリネット]", "title": "触手クリッカー～感覚遮断で女の子を苗床化～ [セリネット]"}}, {"intro": "大釜(子宮)を使って、2種類の素材でアイテムを合成しよう！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01633000/RJ01632235/40a554fa37317fc8475d8b092a9f76ab.jpg", "alt": "触手クリッカー～感覚遮断で女の子を苗床化～ [セリネット]", "title": "触手クリッカー～感覚遮断で女の子を苗床化～ [セリネット]"}}, {"intro": "合成アイテムしたアイテムを使用するとアニメーションが流れます", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01633000/RJ01632235/f488600a25dfef3877c2f79829f9556a.jpg", "alt": "触手クリッカー～感覚遮断で女の子を苗床化～ [セリネット]", "title": "触手クリッカー～感覚遮断で女の子を苗床化～ [セリネット]"}}, {"intro": "また特殊アイテムを合成すると特別なアニメーションが見れるぞ！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01633000/RJ01632235/a9cb88cfa56945e365b29e60e7a89c35.jpg", "alt": "触手クリッカー～感覚遮断で女の子を苗床化～ [セリネット]", "title": "触手クリッカー～感覚遮断で女の子を苗床化～ [セリネット]"}}]}, {"type": "image", "title": "淫紋の解放機能", "body": [{"intro": "クリックをすることで淫紋(絶頂ゲージ)が浮き上がります！<br />\r\n淫紋を解放することで女の子を絶頂することができ、ポイントや素材が一定時間多く獲得できます！<br />\r\n好きなタイミングで解放しましょう！<br />\r\n<br />\r\n<br />\r\nゆっくりまったりやりたい方向けに時間制限がないフリーモードあります！(チートモードもあります)<br />\r\n<br />\r\n※ゲーム内で起きた不具合などございましたら、下記のci-enページにてご報告ください。<br />\r\nci-en:<a href=\"https://ci-en.dlsite.com/creator/32205\" target=\"_blank\">https://ci-en.dlsite.com/creator/32205</a>", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01633000/RJ01632235/2d1d33a2dd65856f430685751ac02b70.jpg", "alt": "触手クリッカー～感覚遮断で女の子を苗床化～ [セリネット]", "title": "触手クリッカー～感覚遮断で女の子を苗床化～ [セリネット]"}, "position": "over"}]}], "description": "女の子に寄生して苗床に！?感覚遮断で気づかれないように冒険者の肉体を魔改造しよう！", "short_introduction": "女の子に寄生して苗床に！?感覚遮断で気づかれないように冒険者の肉体を魔改造しよう！", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01632235.html", "site_id": "maniax", "fetched_at": 1794944075}