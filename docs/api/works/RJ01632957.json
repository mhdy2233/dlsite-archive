": "all", "period": "month", "rank": 43, "date": "2026-08-28"}, {"category": "game", "period": "day", "rank": 6, "date": "2026-07-31"}, {"category": "game", "period": "week", "rank": 18, "date": "2026-08-05"}, {"category": "game", "period": "month", "rank": 29, "date": "2026-08-28"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01633000/RJ01632957_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01633000/RJ01632957_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01633000/RJ01632957_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01633000/RJ01632957_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01633000/RJ01632957_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01633000/RJ01632957_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01633000/RJ01632957_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01633000/RJ01632957_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01633000/RJ01632957_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01633000/RJ01632957_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01633000/RJ01632957_img_smp9.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01633000/RJ01632957_img_smp10.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01633000/RJ01632957_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01633000/RJ01632957_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01633000/RJ01632957_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01633000/RJ01632957_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01633000/RJ01632957_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01633000/RJ01632957_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01633000/RJ01632957_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01633000/RJ01632957_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01633000/RJ01632957_img_smp9_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01633000/RJ01632957_img_smp10_100x100.jpg"], "alt": "ゆいゆいのドキドキ♡おなにー配信日記 [和童快珍]"}, "introductions": [{"type": "image", "title": "ゆいゆいのドキドキ♡おなにー配信日記 ～投げ銭で壊れていく配信者～", "body": [{"intro": "ゲーム実況者の結菜(ゆいな)は、現在絶賛伸び悩み中。<br />\r\n増えない視聴者数に、減っていく貯金……。<br />\r\nそんな鬱々とした日々を送っていたある日、配信を切り忘れて「オナニー配信」をしてしまうという、まさかの事故が彼女の運命を狂わせる！<br />\r\n<br />\r\n「もっと見たい！」<br />\r\n「次もこの感じで頼む！」<br />\r\n「お金投げるからもう一回やって！」<br />\r\n<br />\r\n予想外のコメントの嵐、フォロワーの急増、そして飛び交う投げ銭。<br />\r\n最初は恥じらっていた結菜も、視聴者からの甘い声と報酬に背中を押され、エロ配信者「ゆいゆい」として一線を超えていく……。<br />\r\n<br />\r\nあなたの選択で、彼女の運命は激変。<br />\r\n配信を繰り返すたびに過激なプレイが次々と解放されていき、気がつけば、ゆいゆいは取り返しのつかないところまで堕ちていく！<br />\r\n<br />\r\n【スタッフ・サークル】<br />\r\nサークル:和童快珍(@wado_kaichin_3d)<br />\r\nキャラクターデザイン:メメ50(@meme50)<br />\r\n結菜 CV:犀川ささめ(@sasame_saikawa)<br />\r\nクリエイター:Genz(@Genz_3D)", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01633000/RJ01632957/902a89d54cd3b9cc3ca339385aaef199.jpg", "alt": "ゆいゆいのドキドキ♡おなにー配信日記 [和童快珍]", "title": "ゆいゆいのドキドキ♡おなにー配信日記 [和童快珍]"}, "position": "over"}]}, {"type": "image", "title": "◆どんどん配信して「プレイ」を解放！", "body": [{"intro": "どんな配信をするかはあなた次第。<br />\r\n配信を繰り返すと、新しいプレイがどんどん解放されます！<br />\r\n<br />\r\n着衣オナニー、エアフェラ、くぱぁ、手コキ、フェラ、足コキ、パイズリ、イラマチオ、電マ、バイブ、ASMR配信、拘束プレイ、ピストンマシン、オーガズムチェアなど、<br />\r\n全36種類のプレイを収録。<br />\r\nさらに、リスナー参加企画など、配信者としての一線を越えていくシチュエーションも展開されていきます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01633000/RJ01632957/a3ec93f0b353af11f28566ad4c4804b0.jpg", "alt": "ゆいゆいのドキドキ♡おなにー配信日記 [和童快珍]", "title": "ゆいゆいのドキドキ♡おなにー配信日記 [和童快珍]"}, "position": "over"}]}, {"type": "image", "title": "◆「連続イキシステム」も実装！", "body": [{"intro": "本作では、同じプレイを続けていると、絶頂を重ねるごとにゆいゆいの反応が激しくなっていきます。<br />\r\n一度イったら終わりではありません！！<br />\r\nそのあとも続けることで、ゆいゆいの反応がどんどん変わっていきます。<br />\r\n<br />\r\n連続イキシステムは、大きく分けて4段階！<br />\r\n同じ電マやバイブでも、何度もイカせるうちにどんどん激しくなっていきます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01633000/RJ01632957/e252f32e6a4a08602c4c09f2cb507cd0.jpg", "alt": "ゆいゆいのドキドキ♡おなにー配信日記 [和童快珍]", "title": "ゆいゆいのドキドキ♡おなにー配信日記 [和童快珍]"}, "position": "over"}]}, {"type": "image", "title": "◆3段階に堕ちていく「ゆいゆい」の姿", "body": [{"intro": "配信を重ねるごとに、彼女の振る舞いも見た目もどんどん変わっていきます。<br />\r\n本作では、ゆいゆいの姿が3段階に変化。<br />\r\nエクストラモードでは、好きな段階の姿に切り替えて楽しむことも可能です。<br />\r\n<br />\r\n「もう少しだけなら」<br />\r\n「前より過激じゃないと、見てもらえない」<br />\r\n「これだけ稼げるなら、まだ大丈夫」<br />\r\n<br />\r\nそんな言い訳を重ねるたびに、彼女はより大胆に、より危うく、より後戻りできない姿へと変わっていきます。<br />\r\n<br />\r\n投げ銭に振り回され、「誰かに求められる自分」を演じ続けるうちに、彼女は本来の自分を見失っていく……。<br />\r\n視聴者の欲望に応え続けるか、それとも自分を保つか。<br />\r\nどこまで堕ちるかは、あなたの選択次第です！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01633000/RJ01632957/b7457f1b0797dd3daf3628da373dc11e.jpg", "alt": "ゆいゆいのドキドキ♡おなにー配信日記 [和童快珍]", "title": "ゆいゆいのドキドキ♡おなにー配信日記 [和童快珍]"}, "position": "over"}]}, {"type": "image", "title": "◆「エクストラモード」も実装！", "body": [{"intro": "本編ADVで解放したオナニーシーンを、あとから自由に楽しめるエクストラモードを実装！<br />\r\n解放済みのプレイの中から好きなシチュエーションを選び、さらに好きな段階のゆいゆいの姿で再生可能！<br />\r\n<br />\r\nお気に入りのシーンをじっくり見返したり、違う姿のゆいゆいで楽しんだりと、クリア後もたっぷり遊べます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01633000/RJ01632957/b523b33b1b0cb948cda42203b4c539e6.jpg", "alt": "ゆいゆいのドキドキ♡おなにー配信日記 [和童快珍]", "title": "ゆいゆいのドキドキ♡おなにー配信日記 [和童快珍]"}, "position": "over"}]}, {"type": "text_list", "title": "【こんな人におすすめ！】", "body": [{"intro": "女の子のオナニーシーンが好きな人 ※シナリオ上、男性との絡みも発生します。"}, {"intro": "配信者がだんだん壊れていく様子をじっくり見守りたい人"}, {"intro": "「清純派」が「大胆」になっていくギャップが大好物な人"}, {"intro": "選択肢次第で物語やプレイが変わるADVがやりたい人"}, {"intro": "ただ明るいだけではなく、どこか壊れそうなヒロインの堕落をじっくり見届けたい人"}, {"intro": "※本作にハッピーエンドはありません。"}]}], "description": "うっかり見せちゃった初配信から、投げ銭とコメントに煽られて――“ゆいゆい”は今日も少しずつえっちに壊れていく♡", "short_introduction": "うっかり見せちゃった初配信から、投げ銭とコメントに煽られて――“ゆいゆい”は今日も少しずつえっちに壊れていく♡", "url": "https://www.dlsite.com/maniax/work/