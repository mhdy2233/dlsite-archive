}, {"category": "game", "period": "day", "rank": 15, "date": "2026-06-01"}, {"category": "game", "period": "week", "rank": 19, "date": "2026-06-06"}, {"category": "game", "period": "month", "rank": 39, "date": "2026-06-23"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01639000/RJ01638705_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01639000/RJ01638705_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01639000/RJ01638705_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01639000/RJ01638705_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01639000/RJ01638705_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01639000/RJ01638705_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01639000/RJ01638705_img_smp5.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01639000/RJ01638705_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01639000/RJ01638705_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01639000/RJ01638705_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01639000/RJ01638705_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01639000/RJ01638705_img_smp5_100x100.jpg"], "alt": "睡眠○ ～地下アイドルたちとの合宿生活～ [KO社]"}, "introductions": [{"type": "text", "title": "【ゲーム概要】", "body": [{"intro": "三人の地下アイドルとマネージャー、秘密の同居生活。<br />\r\n<br />\r\n昼は仕事をサポート。夜は誘惑に負けて…イケナイ関係へ。<br />\r\n<br />\r\n進行度に応じて、アイドルたちとの“特別な”イベントが続々解放！"}]}, {"type": "image", "title": "【こだわりのポイント】", "body": [{"intro": "メインはもちろん、三人のアイドルが眠る夜のひととき。<br />\r\n<br />\r\n最初は一人から。でもゲームが進むにつれて、選択できる子はどんどん増えていく…。<br />\r\n最終的には、あなた好みの組み合わせで彼女たちに“夜襲”できるように！<br />\r\n<br />\r\nさらにお楽しみ――マネージャーも含めた4人でのご褒美CGを複数収録！<br />\r\n<br />\r\n全シーンLive2Dでアニメーション。 揺れて、動いて、感じて…。<br />\r\n<br />\r\n三人まとめて、幸せな時間を。<br />\r\n<br />\r\n操作も演出も、“三人一緒”にこだわりました。<br />\r\n<br />\r\nアイドルごとに敏感帯が違うって知ってた?<br />\r\n同じ場所を触っても、感じ方は一人ひとり全然違うんだ…。<br />\r\n<br />\r\nさらに、4Pご褒美CGは特別に力作！ 四人の絡みはもう、見逃せない仕上がりです。<br />\r\n<br />\r\nそして音声――三人が同時に感じているあの声、臨場感たっぷりに収録しました。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01639000/RJ01638705/e50a1cf2372207c5fe6238e4a16dbfee.jpg", "alt": "睡眠○ ～地下アイドルたちとの合宿生活～ [KO社]", "title": "睡眠○ ～地下アイドルたちとの合宿生活～ [KO社]"}, "position": "under"}]}, {"type": "image", "title": "【プレイ時間・収録内容】", "body": [{"intro": "ゲーム時間は約1時間。サクッと遊べるボリュームながら、内容はたっぷり濃厚です。<br />\n<br />\n収録シーンは睡眠シーンを含む全4シーンと決して多くはありませんが、<br />\nそのすべてにLive2Dアニメーションを実装。<br />\n<br />\nしかも、全てのシーンで3人のアイドルが同時に登場します！<br />\n<br />\n「数より質」――三人一緒の刺激を、じっくりお楽しみください。<br />\n<br />\n・多言語対応(日本語/英語/中国語/韓語)<br />\n<br />\n・全CG即時開放ショートカットキー搭載<br />\n※ゲーム内の特定キー操作で、全CGシーンをすぐに閲覧可能<br />\n<br />\n・セーブ機能あり(設定メニューからセーブ可能)<br />\n<br />\n・体験版について:<br />\n※体験版では、アイテム解放およびCGシーンの進行はできません。<br />\n製品版にて、すべての機能とシーンをお楽しみください。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01639000/RJ01638705/f498d5bc7799c82f988e47120dbe0e9d.jpg", "alt": "睡眠○ ～地下アイドルたちとの合宿生活～ [KO社]", "title": "睡眠○ ～地下アイドルたちとの合宿生活～ [KO社]"}, "position": "left"}]}], "description": "地下アイドルとマネージャーの同居生活×睡眠○ゲーム", "short_introduction": "地下アイドルとマネージャーの同居生活×睡眠○ゲーム", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01638705.html", "site_id": "maniax", "fetched_at": 1794944120}