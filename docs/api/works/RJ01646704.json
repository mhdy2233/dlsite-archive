": "game", "period": "day", "rank": 2, "date": "2026-08-09"}, {"category": "game", "period": "week", "rank": 4, "date": "2026-08-10"}, {"category": "game", "period": "month", "rank": 14, "date": "2026-08-31"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01647000/RJ01646704_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01647000/RJ01646704_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01647000/RJ01646704_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01647000/RJ01646704_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01647000/RJ01646704_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01647000/RJ01646704_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01647000/RJ01646704_img_smp5.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01647000/RJ01646704_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01647000/RJ01646704_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01647000/RJ01646704_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01647000/RJ01646704_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01647000/RJ01646704_img_smp5_100x100.jpg"], "alt": "Succubus Raid [DHM]"}, "introductions": [{"type": "image", "title": "はじめに", "body": [{"intro": "・PC環境によっては動作しない可能性がございますので、必ず体験版をプレイして動作確認の上ご購入下さい。<br />\n<br />\n・ドット絵とSpineアニメーションを用いた、サバイバーライクのアクションゲームです。<br />\n・操作キャラクターは男性、敵キャラクターは魔物娘です。<br />\n・敵キャラクター数 12体、各キャラクターに「ドット絵アニメーション」と「アニメーションカットイン」。<br />\n・各敵キャラクターに複数の拘束段階があり、それに応じてドット絵が変化し、アニメーションカットインが表示されます。<br />\n・1プレイ 30分程度の構成です。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01647000/RJ01646704/1bd2d7f385f00fd4d1cb77775f733444.jpg", "alt": "Succubus Raid [DHM]", "title": "Succubus Raid [DHM]"}, "position": "over"}]}, {"type": "image", "title": "ゲーム概要", "body": [{"intro": "見下ろし型サバイバーライクアクションです。<br />\r\n武器は自動で発射されるので、プレイヤーが操作する部分は移動のみです。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01647000/RJ01646704/5e81908d8d4719b456c0f213b4bdbe4a.jpg", "alt": "Succubus Raid [DHM]", "title": "Succubus Raid [DHM]"}, "position": "left"}]}, {"type": "image", "title": "こだわりポイント / Hシステム", "body": [{"intro": "【こだわりポイント】 <br />\r\n拘束Hは、戦闘画面のドット絵拘束とSpineアニメーションの2層構成です。<br />\r\n複数の魔物娘に拘束された場合、人数に応じてドット絵が変化します。 <br />\r\n<br />\r\n【Hシステム】 <br />\r\n魔物娘との接触で拘束が開始します。 <br />\r\n拘束中は戦闘画面上にドット絵の拘束アニメーションが表示されます。<br />\r\n 拘束段階が進むと、アニメーションカットインが表示されます。<br />\r\n 方向キー(W/A/S/D)を連打してもがき、ゲージを満タンにすると拘束から脱出できます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01647000/RJ01646704/4389f1055a3e326aec70643190505183.jpg", "alt": "Succubus Raid [DHM]", "title": "Succubus Raid [DHM]"}, "position": "left"}]}], "description": "魔物娘逆レ○プ2D見下ろしサバイバー風アクション", "short_introduction": "魔物娘逆レ○プ2D見下ろしサバイバー風アクション", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01646704.html", "site_id": "maniax", "fetched_at": 1794942561}