{"id": "RJ01647149", "title": "見習い魔法使いの特訓", "title_romaji": "minaraimahoutsukainotokkun", "circle": {"id": "RG01045711", "name": "アメマワリ庭園", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG01045711.html"}, "type": {"code": "RPG", "name": "ロールプレイング", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 1100, "official_jpy": 1100, "currencies": {"USD": 6.8934010724878725, "EUR": 6.264322519214385, "GBP": 5.226651360497349, "TWD": 227.25864099332685, "CNY": 46.03184566777561, "KRW": 9205.020920502093, "IDR": 126002.29095074456, "VND": 177419.3548387097, "THB": 233.60020386926882, "SEK": 69.5854604343398, "HKD": 54.09339470474841, "SGD": 8.88412197414882, "CAD": 9.855350335305896, "MYR": 28.226913592285324, "BRL": 39.223516994480185, "AUD": 10.22027479531577, "PHP": 440.599214932308, "MXN": 127.87872446785012, "NZD": 12.52088711623481, "INR": 647.5921346991639}}, "point": {"point_amount": 60, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1780844400, "file": {"type": "EXE", "size": 651509669}, "tags": [{"key": "502", "name": "男主人公"}, {"key": "510", "name": "ツクール"}, {"key": "016", "name": "ファンタジー"}, {"key": "128", "name": "中出し"}, {"key": "138", "name": "フェラチオ"}, {"key": "123", "name": "和姦"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 4.43, "count": 7}, "review_count": 0, "dl_count": 22, "wishlist_count": 139, "ranking": [], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01648000/RJ01647149_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01648000/RJ01647149_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01648000/RJ01647149_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01648000/RJ01647149_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01648000/RJ01647149_img_smp3.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01648000/RJ01647149_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01648000/RJ01647149_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01648000/RJ01647149_img_smp3_100x100.jpg"], "alt": "見習い魔法使いの特訓 [アメマワリ庭園]"}, "introductions": [{"type": "text", "title": "ゲーム概要", "body": [{"intro": "【あらすじ】<br />\r\n<br />\r\n魔法使いを目指すクロウは、魔法使い養成学園に入学するが、実力が足りずに特別課題を出されてしまう。<br />\r\n<br />\r\nそこで四人の女の子に特訓を付けてもらい、課題に臨むことに。<br />\r\n<br />\r\n女の子たちと交流を深めながら課題をクリアしていくが、何やら怪しい影が蠢くのだった……。"}]}, {"type": "image", "title": "基本システム", "body": [{"intro": "ストーリーに沿ってダンジョンを攻略するRPGです。<br />\r\nダンジョンはマップ形式ではなく、【進む】アイコンをクリックすることで、ランダムで敵が出現したり、ゴールドを得たりする形式です。<br />\r\n<br />\r\nレベルや経験値はなく、女の子たちとの特訓でステータスが上昇したり、魔法を覚えたりします。<br />\r\n<br />\r\n勝てないときは、装備やアイテムも駆使してボスの討伐を目指しましょう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01648000/RJ01647149/abc73b67c909936f76fb4f2257a998c8.jpg", "alt": "見習い魔法使いの特訓 [アメマワリ庭園]", "title": "見習い魔法使いの特訓 [アメマワリ庭園]"}, "position": "left"}]}, {"type": "image", "title": "Hシーン", "body": [{"intro": "・Hシーン数、基本CG数ともに30個以上<br />\n・一部サブキャラにもHシーンあり。<br />\n・ダンジョンで手に入るアイテムを渡すと好感度が上がります。<br />\n　好感度が一定の数値に達するとHシーンが解放されます。<br />\n・回想機能あり。<br />\n・回想全開放スイッチあり。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01648000/RJ01647149/0d3c70c66778e52bce2a77d370f9ca0c.jpg", "alt": "見習い魔法使いの特訓 [アメマワリ庭園]", "title": "見習い魔法使いの特訓 [アメマワリ庭園]"}, "position": "left"}]}, {"type": "image_list", "title": "キャラクター紹介", "body": [{"intro": "【リンネ】<br />\r\n事故の結果クロウと契約を結ぶこととなった淫魔。<br />\r\n淫魔の中では素直で聞き分けが良い。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01648000/RJ01647149/bfa5460d5c46d42029a300fb52411f52.jpg", "alt": "見習い魔法使いの特訓 [アメマワリ庭園]", "title": "見習い魔法使いの特訓 [アメマワリ庭園]"}}, {"intro": "【グラシア】<br />\r\nクロウの幼馴染。1学年上。<br />\r\n学内の情報に詳しく、課題についても色々と教えてくれる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01648000/RJ01647149/70b50792b7bedf0ee0b43674d8fca50d.jpg", "alt": "見習い魔法使いの特訓 [アメマワリ庭園]", "title": "見習い魔法使いの特訓 [アメマワリ庭園]"}}, {"intro": "【メア】<br />\r\nクロウと同級生。成績優秀。<br />\r\n物静かだが、人との交流には積極的。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01648000/RJ01647149/4004f533c077114119c48ce031efe1df.jpg", "alt": "見習い魔法使いの特訓 [アメマワリ庭園]", "title": "見習い魔法使いの特訓 [アメマワリ庭園]"}}, {"intro": "【ペルフェ】<br />\r\n町中で偶然出会った魔法研究者。<br />\r\n落ち着いた性格で、面倒見がよい。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01648000/RJ01647149/a274a6958f803a926632351e6a08a2e5.jpg", "alt": "見習い魔法使いの特訓 [アメマワリ庭園]", "title": "見習い魔法使いの特訓 [アメマワリ庭園]"}}]}, {"type": "text", "title": "注意事項", "body": [{"intro": "・推定プレイ時間:2～3時間<br />\r\n・体験版のセーブデータを製品版に引き継ぐことはできません。<br />\r\n<br />\r\n※本ゲームはRPGツクールMV製です。動作はRPGツクールMV推奨環境に準拠します。<br />\r\n※必ず体験版にて、動作確認をお願いします。<br />\r\n※動作不良等がありましたら、以下のURLにご連絡いただけますと幸いでございます。<br />\r\n　<a href=\"https://ci-en.dlsite.com/creator/38102\" target=\"_blank\">https://ci-en.dlsite.com/creator/38102</a>"}]}], "description": "魔法使いを目指すクロウは、4人の女の子に特訓を付けてもらうことに。女の子たちと交流を重ねていくと……。", "short_introduction": "魔法使いを目指すクロウは、4人の女の子に特訓を付けてもらうことに。女の子たちと交流を重ねていくと……。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01647149.html", "site_id": "maniax", "fetched_at": 1794944038}