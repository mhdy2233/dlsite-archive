les": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01650000/RJ01649707_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01650000/RJ01649707_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01650000/RJ01649707_img_smp3.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01650000/RJ01649707_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01650000/RJ01649707_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01650000/RJ01649707_img_smp3_100x100.jpg"], "alt": "蒼穹の退魔師 [宴]"}, "introductions": [{"type": "text", "title": "戦いに敗れた退魔師を陵○するテキスト付きCG集。", "body": [{"intro": "退魔師に選ばれた三人の美少女は、夜の闇に紛れて街を守るべく密かに戦っていた。<br />\r\nだが、そんな彼女たちが敗れる日がやってくる……<br />\r\n「籠の中の鳥」となった三人に対して、宿敵である異形のモノが欲望の毒牙を向けてくる……<br />\r\nそして、彼女たちが守りたかった人たちも、心の底で思っていた本心をむき出しにして襲い掛かる……<br />\r\n<br />\r\n・三人の退魔師が触手や人間に徹底的に陵○されるノベル付きCG集です。<br />\r\n・CGは基本17枚、差分込みで40枚以上。<br />\r\n・一部は部活コスチューム差分あり。<br />\r\n・基本一本道ですが、どのキャラから襲うかの選択ができます。"}]}, {"type": "image_list", "title": "小雀 渚咲(こすずめ なぎさ)", "body": [{"intro": "退魔師になることで人助けができることに喜びを覚えている。<br />\r\n学園では競技かるた部の部員として一目置かれている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01650000/RJ01649707/6dfed1ab869ba293f2b300c03e927070.jpg", "alt": "蒼穹の退魔師 [宴]", "title": "蒼穹の退魔師 [宴]"}}, {"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01650000/RJ01649707/69ee4c01c687eb09cb868fc2764bd04d.jpg", "alt": "蒼穹の退魔師 [宴]", "title": "蒼穹の退魔師 [宴]"}}]}, {"type": "image_list", "title": "天鷲 茜(あまわし あかね)", "body": [{"intro": "三人のまとめ役で姉的な存在。<br />\r\n普段はテニス部で後輩の男子たちからも「姉さん先輩」と慕われている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01650000/RJ01649707/73c3dc178a7c5efeed20147a3cbc68b3.jpg", "alt": "蒼穹の退魔師 [宴]", "title": "蒼穹の退魔師 [宴]"}}, {"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01650000/RJ01649707/c9d61459e177d9fc5cc1bd8963044682.jpg", "alt": "蒼穹の退魔師 [宴]", "title": "蒼穹の退魔師 [宴]"}}]}, {"type": "image_list", "title": "秋鷹 汐里(あきたか ゆうり)", "body": [{"intro": "陸上部のエースだったが、最近急に成長した胸のせいで伸び悩んでいる、その鬱憤を晴らすかのように夜は退魔師として戦っている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01650000/RJ01649707/51aafe1c052dbb6c03efcbc411c87313.jpg", "alt": "蒼穹の退魔師 [宴]", "title": "蒼穹の退魔師 [宴]"}}, {"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01650000/RJ01649707/7aa82aab33065303b54429fc355a9295.jpg", "alt": "蒼穹の退魔師 [宴]", "title": "蒼穹の退魔師 [宴]"}}]}], "description": "退魔師に選ばれた三人の美少女は、夜の闇に紛れて街を守るべく密かに戦っていた。 だが、そんな彼女たちが敗れる日がやってくる…… 「籠の中の鳥」となった三人に対して、宿敵である異形のモノが、そして彼女たちが守りたかった人達が、欲望をむき出しにして襲い掛かる……", "short_introduction": "退魔師に選ばれた三人の美少女は、夜の闇に紛れて街を守るべく密かに戦っていた。 だが、そんな彼女たちが敗れる日がやってくる…… 「籠の中の鳥」となった三人に対して、宿敵である異形のモノが、そして彼女たちが守りたかった人達が、欲望をむき出しにして襲い掛かる……", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01649707.html", "site_id": "maniax", "fetched_at": 1794944016}