}, {"category": "game", "period": "week", "rank": 29, "date": "2026-07-11"}, {"category": "game", "period": "month", "rank": 49, "date": "2026-08-03"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01662000/RJ01661931_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01662000/RJ01661931_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01662000/RJ01661931_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01662000/RJ01661931_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01662000/RJ01661931_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01662000/RJ01661931_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01662000/RJ01661931_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01662000/RJ01661931_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01662000/RJ01661931_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01662000/RJ01661931_img_smp8.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01662000/RJ01661931_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01662000/RJ01661931_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01662000/RJ01661931_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01662000/RJ01661931_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01662000/RJ01661931_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01662000/RJ01661931_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01662000/RJ01661931_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01662000/RJ01661931_img_smp8_100x100.jpg"], "alt": "デレさせろ！人間不信の姪っ子との生活 [てこめんと]"}, "introductions": [{"type": "image", "title": "一つ屋根の下、好感度マイナスから始まる同棲生活", "body": [{"intro": "ある日突然、俺は一人の少女を引き取ることになった。<br />\n両親の事情で行き場を失った姪っ子「凛(りん)」。<br />\n彼女は大人を激しく拒絶し、誰にも心を開かない極度の「人間不信」だった。<br />\n<br />\n冷たい視線。交わらない会話。<br />\n息が詰まるような、絶対零度の同居生活。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01662000/RJ01661931/0fe18765d8eac980be95e681c5b0f1fb.jpg", "alt": "デレさせろ！人間不信の姪っ子との生活 [てこめんと]", "title": "デレさせろ！人間不信の姪っ子との生活 [てこめんと]"}, "position": "over"}]}, {"type": "image", "title": "美麗CGと蕩けきったイチャラブHシーン", "body": [{"intro": "警戒している姿から、無防備に頬を染める表情まで、濃密な日常を美麗に描写！<br />\n<br />\n完全に心を開き「デレ」た後に待ち受けるのは、<br />\n普段の冷たさからは想像もつかないほど熱く蕩けきった極上のHシーン。<br />\n<br />\n心の距離が0になった二人だけの、甘く淫らな時間をお届けします。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01662000/RJ01661931/0fce990d45bd27e394f6f74ca90a9cf5.jpg", "alt": "デレさせろ！人間不信の姪っ子との生活 [てこめんと]", "title": "デレさせろ！人間不信の姪っ子との生活 [てこめんと]"}, "position": "over"}]}, {"type": "image", "title": "仲良くなると反応が可愛くなっていく！?", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01662000/RJ01661931/a9d4b205ecdccca6928ba23f4fb24a04.jpg", "alt": "デレさせろ！人間不信の姪っ子との生活 [てこめんと]", "title": "デレさせろ！人間不信の姪っ子との生活 [てこめんと]"}, "position": "over"}]}, {"type": "image", "title": "豪華CV！", "body": [{"intro": "「乙倉ゆい」様が演じる、極上のギャップボイス！<br />\nヒロイン「凛」のCVは、乙倉ゆい様が担当！<br />\n<br />\n序盤の冷え切ったトーンから、快楽に溺れて甘くすがる<br />\n狂おしい喘ぎ声への「圧倒的ギャップ」を熱演。<br />\n※フルボイスではなく、Hシーンの喘ぎ声とパートボイスです。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01662000/RJ01661931/4c98cf6422b6aa7546c72c881563045d.jpg", "alt": "デレさせろ！人間不信の姪っ子との生活 [てこめんと]", "title": "デレさせろ！人間不信の姪っ子との生活 [てこめんと]"}, "position": "over"}]}, {"type": "image", "title": "作業感を徹底排除！", "body": [{"intro": "「生活の選択」で心を溶かすリアル同棲シミュレーション<br />\n好感度を稼ぐための「単調なアイテム貢ぎ」や<br />\n「頭を撫でるだけのクリッカー要素」は極力排除！<br />\n<br />\nスマホの「ネットスーパー」で買い物をしたり<br />\n休日の何気ない声かけを変えたり……。<br />\n<br />\nあなたの生活に根差した“リアルな選択”だけが、<br />\n彼女の心を少しずつ動かしていきます。<br />\n<br />\n生々しい感情の変化と「デレ」への過程を体験してください！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01662000/RJ01661931/299df885751c45b91d6cac8b3074c251.jpg", "alt": "デレさせろ！人間不信の姪っ子との生活 [てこめんと]", "title": "デレさせろ！人間不信の姪っ子との生活 [てこめんと]"}, "position": "over"}]}, {"type": "image", "title": "羞恥、アナル、野外露出、ソフトSM", "body": [{"intro": "不器用な彼女の心が、あなただけに開いていく。<br />\n極甘な同棲生活が、今始まる――<br />\n<br />\n<br />\n----追記7月6日-----<br />\n【重要なお知らせ】無料追加アップデートの制作が決定いたしました！<br />\n<br />\n皆様、本作をお手に取っていただき誠にありがとうございます。<br />\nおかげさまで、発売直後からこちらの想像を遥かに超えるダウンロード数を記録しており、大変驚きつつも深く感謝しております。<br />\n<br />\n一方で、「もっと楽しみたかった」「シナリオが物足りない」<br />\nといったお声も真摯に受け止めております。<br />\nサクサク進行する構成を目指したものの、結果としてボリューム不足を感じさせてしまったプレイヤーの皆様には、申し訳ございません。<br />\n<br />\n皆様からのご期待にお応えし、より深くヒロインとの生活を楽しんでいただくため、【シナリオおよびCGの無料追加アップデート】の制作を決定いたしました！<br />\n<br />\n▼アップデート予定内容(8月〜9月頃配信予定)<br />\n・新規イラスト(CG)の追加<br />\n・新規シチュエーションシナリオ(4種類ほど)の追加<br />\n<br />\n現在、全力で追加コンテンツの制作を進めております。<br />\nすでに遊んでいただいた方も、これからプレイされる方も、<br />\nぜひアップデートを楽しみにお待ちいただけますと幸いです！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01662000/RJ01661931/40de9addea3f4f26ff051041d96bc604.jpg", "alt": "デレさせろ！人間不信の姪っ子との生活 [てこめんと]", "title": "デレさせろ！人間不信の姪っ子との生活 [てこめんと]"}, "position": "over"}]}], "description": "誰にも触れさせなかった彼女の心が、あなただけの熱を帯びていく――人間不信の姪っ子をとことん甘やかして絆す同棲生活。", "short_introduction": "誰にも触れさせなかった彼女の心が、あなただけの熱を帯びていく――人間不信の姪っ子をとことん甘やかして絆す同棲生活。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01661931.html", "site_id": "maniax", "fetched_at": 1794942745}