mples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01676000/RJ01675941_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01676000/RJ01675941_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01676000/RJ01675941_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01676000/RJ01675941_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01676000/RJ01675941_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01676000/RJ01675941_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01676000/RJ01675941_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01676000/RJ01675941_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01676000/RJ01675941_img_smp9.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01676000/RJ01675941_img_smp10.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01676000/RJ01675941_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01676000/RJ01675941_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01676000/RJ01675941_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01676000/RJ01675941_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01676000/RJ01675941_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01676000/RJ01675941_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01676000/RJ01675941_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01676000/RJ01675941_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01676000/RJ01675941_img_smp9_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01676000/RJ01675941_img_smp10_100x100.jpg"], "alt": "【約6GBボリューム】〜戦術バトル〜今夜の犠牲はバ○オハザードからジル【画像100枚超え、動画5本】 [パラレル]"}, "introductions": [{"type": "text", "title": "概要欄", "body": [{"intro": "【背景とサムネ以外はAI未使用です。※背景は素材やさんなので不明】<br />\n<br />\n本格的な戦術バトル、ガンビットシステムを搭載した戦闘RPGとなります<br />\n<br />\n<br />\nアダルトコンテンツ<br />\nエッチシーンは動画だけでなんと1時間半を超え<br />\n画像だけで100枚を余裕で超える圧倒的ボリューム<br />\n<br />\n<br />\nダンジョン1はうまくやればLV1でもクリアできます<br />\nダンジョン2は戦略必須レベル。ここから先は一発クリアはまずない<br />\nダンジョン3は更に属性が絡みついてきて<br />\nダンジョン4が敵のデバフが増え<br />\nダンジョン5は、即死対策まで必須<br />\n<br />\nここまでが本編<br />\n<br />\nレベルで言うとLV200の仲間3人の無装備でギリ倒せる調整にしてありますが<br />\nちゃんとガンビット使えばLv50くらいでも倒せます<br />\n<br />\nダンジョン6〜10はエンドコンテンツとして楽しめます<br />\n<br />\n全スキル、全行動にセリフがあるので<br />\n組み合わせると1万を超えるセリフ量が<br />\nそれが3キャラ分なので膨大な量です<br />\n<br />\n日数システムがあるので<br />\nダンジョン5クリア到達時の<br />\nレベルと日数をレビューでくれたら嬉しいです"}]}, {"type": "image", "title": "【安心設計】", "body": [{"intro": "当サークル、ゲームではほぼ星4以上です<br />\n<br />\n過去にマイナス評価を貰ったのは「着衣プレイメインで乳首すら見れなかった」という低評価以外は<br />\n星4↑を獲得し続けてるのでご安心を<br />\n<br />\nそして今回は乳首見えます<br />\n<br />\nそして嬉しいことにセ〇ラームーンのウサギバージョンもあるのですが<br />\nそちらはなんと★5！<br />\nフルスコアをいただいています！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01676000/RJ01675941/52dc47538f3ff72022597be055788c73.jpg", "alt": "【約6GBボリューム】〜戦術バトル〜今夜の犠牲はバ○オハザードからジル【画像100枚超え、動画5本】 [パラレル]", "title": "【約6GBボリューム】〜戦術バトル〜今夜の犠牲はバ○オハザードからジル【画像100枚超え、動画5本】 [パラレル]"}, "position": "over"}]}, {"type": "image", "title": "【ガンビットバトルって?】", "body": [{"intro": "予め味方の行動を決め、自動で行われるバトル<br />\n<br />\nHPの80%以下の仲間に回復<br />\n敵に火属性付与！<br />\n火属性の敵にファイア！などなど<br />\n<br />\n超細かく動きを設定することが出来ます<br />\n<br />\n組んだ戦略でコンボと攻略が決まるAIバトルがやりたいが為に作りこみました<br />\n<br />\n<br />\n相当厳しい戦闘になったので緩和として<br />\n・商売シミュレーションシステム<br />\n・レベルアップシステムをお金で運用<br />\n・装備を強く<br />\n<br />\nこの3つが補助システムで入っています<br />\n<br />\nアルバムもゲーム内の商売で解放できるので<br />\nコンテンツが見れないということはないのでご安心を<br />\n<br />\n動画はダンジョンクリアのみですが<br />\nレベル200まで上げれば解放できます！<br />\n<br />\nが、低レベルクリアのほうが面白いゲームなので力試し推奨です", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01676000/RJ01675941/94df629c1dbceed27bf8fc960779740c.jpg", "alt": "【約6GBボリューム】〜戦術バトル〜今夜の犠牲はバ○オハザードからジル【画像100枚超え、動画5本】 [パラレル]", "title": "【約6GBボリューム】〜戦術バトル〜今夜の犠牲はバ○オハザードからジル【画像100枚超え、動画5本】 [パラレル]"}, "position": "over"}]}, {"type": "image", "title": "動画がなんと5本", "body": [{"intro": "合計分数 1時間半超え<br />\n画像は100枚超え<br />\n<br />\nアダルト部分だけでも約6GBと、圧倒的なボリュームを誇ります<br />\n<br />\n普通に当サークルの基準で言えば<br />\n4500円～6000位の量です<br />\n(実際に動画として発売している基準です)<br />\n<br />\n二穴プレイ<br />\nアナル<br />\n拘束プレイ<br />\nボテ腹プレイなど多岐にわたるジャンルを抑え<br />\nバ○オハザードらしいプレイに仕上げ<br />\n実験体に侵されるなどのプレイも同封<br />\n<br />\n単純に動画としてのみを考えても異次元の量となりました", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01676000/RJ01675941/96c4986176f412eff032af8365607f67.jpg", "alt": "【約6GBボリューム】〜戦術バトル〜今夜の犠牲はバ○オハザードからジル【画像100枚超え、動画5本】 [パラレル]", "title": "【約6GBボリューム】〜戦術バトル〜今夜の犠牲はバ○オハザードからジル【画像100枚超え、動画5本】 [パラレル]"}, "position": "over"}]}, {"type": "image", "title": "超お買い得です", "body": [{"intro": "どっちが本体だよとつっこみたくなる<br />\n超詰め込みパックです<br />\n<br />\n定価3500円なので”動画だけ”で割ってもなんと700円<br />\nどう見てもお得にさせていただきました", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01676000/RJ01675941/ac4c6d7599a6683873683137e5ed5178.jpg", "alt": "【約6GBボリューム】〜戦術バトル〜今夜の犠牲はバ○オハザードからジル【画像100枚超え、動画5本】 [パラレル]", "title": "【約6GBボリューム】〜戦術バトル〜今夜の犠牲はバ○オハザードからジル【画像100枚超え、動画5本】 [パラレル]"}, "position": "over"}]}], "description": "超本格的な頭脳バトルゲームです", "short_introduction": "超本格的な頭脳バトルゲームです", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01675941.html", "site_id": "maniax", "fetched_at": 1794942672}