tegory": "all", "period": "month", "rank": 20, "date": "2026-10-15"}, {"category": "game", "period": "day", "rank": 2, "date": "2026-09-16"}, {"category": "game", "period": "week", "rank": 6, "date": "2026-09-21"}, {"category": "game", "period": "month", "rank": 15, "date": "2026-10-13"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01698000/RJ01697116_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01698000/RJ01697116_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01698000/RJ01697116_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01698000/RJ01697116_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01698000/RJ01697116_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01698000/RJ01697116_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01698000/RJ01697116_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01698000/RJ01697116_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01698000/RJ01697116_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01698000/RJ01697116_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01698000/RJ01697116_img_smp9.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01698000/RJ01697116_img_smp10.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01698000/RJ01697116_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01698000/RJ01697116_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01698000/RJ01697116_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01698000/RJ01697116_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01698000/RJ01697116_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01698000/RJ01697116_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01698000/RJ01697116_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01698000/RJ01697116_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01698000/RJ01697116_img_smp9_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01698000/RJ01697116_img_smp10_100x100.jpg"], "alt": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]"}, "introductions": [{"type": "text", "title": "作品紹介(ci-enにて開発状況紹介中)", "body": [{"intro": "仕事帰りの夜、道端に捨てられていた一匹の狐娘を拾った主人公。<br />\n<br />\n連れ帰ったものの、狐娘は人間を強く警戒している様子。<br />\nまずは頭を優しく撫でながら、少しずつ距離を縮めていくことになります。<br />\n<br />\n本作は、画面上の狐娘に直接触れて絆を深めていく「おさわり×懐きシミュレーション」です。<br />\n<br />\n最初に触れられるのは頭だけ。<br />\n撫でたり、キスをしたり、触れ合いを重ねていくことで警戒心が解け、触れられる場所や狐娘の反応も少しずつ変化していきます。<br />\n<br />\nどうしてこの狐娘は捨てられていたのか。<br />\nそして、どうしてこれほど人間を警戒しているのか。<br />\n<br />\n一晩の短い物語の中で、心を閉ざしていた狐娘が少しずつ懐いていく変化をお楽しみください。<br />\n<br />\n何か不具合がございましたら以下のページにお問い合わせください。<br />\n<a href=\"https://ci-en.dlsite.com/creator/34539\" target=\"_blank\">https://ci-en.dlsite.com/creator/34539</a>"}]}, {"type": "image", "title": "ストーリー&amp;キャラクター紹介", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01698000/RJ01697116/ddb857ed9908958cde8f11800d706c31.jpg", "alt": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]", "title": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]"}, "position": "over"}]}, {"type": "image_list", "title": "ゲームシステム(1)", "body": [{"intro": "クリック操作でコミュニケーション。管理できるパラメータが増えていきます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01698000/RJ01697116/7f6b877d82f075686eae70f6476efc0e.jpg", "alt": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]", "title": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]"}}, {"intro": "信頼度→親愛度→愛情怒→熱愛度のパラメータを管理。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01698000/RJ01697116/89dcdda72d103441939177d306552155.jpg", "alt": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]", "title": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]"}}, {"intro": "メインのゲームUI", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01698000/RJ01697116/120101014d2c9d3e019c85131306f6c7.jpg", "alt": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]", "title": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]"}}, {"intro": "絆を深めていくことで反応が変わります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01698000/RJ01697116/3c7740614373cd18e6013b9b24ab52cd.jpg", "alt": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]", "title": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]"}}]}, {"type": "image_list", "title": "ゲームシステム(2)", "body": [{"intro": "絆を深め、スタンプを溜めることによってHシーンに入ります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01698000/RJ01697116/f6694479e588c6ea46828d557de36823.jpg", "alt": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]", "title": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]"}}, {"intro": "Hシーンでも触れる箇所は4か所。それぞれ正常位、フェラ、パイズリ、クンニに派生。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01698000/RJ01697116/ed012550955c5b01b9b69f91c7047737.jpg", "alt": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]", "title": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]"}}, {"intro": "通常シーンのアニメーション。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01698000/RJ01697116/356199ea05465ef90d3ebe469d2ff1ff.jpg", "alt": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]", "title": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]"}}, {"intro": "Hシーンのアニメーション。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01698000/RJ01697116/d12c9964c8f1f66a55a010b296756260.jpg", "alt": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]", "title": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]"}}]}, {"type": "image", "title": "ゲーム仕様", "body": [{"intro": "【製品版仕様】<br />\n・想定プレイ時間: 30分～1時間程度<br />\n・基本シーン数: おさわりシーン1(差分除く) + Hおさわりシーン1 (差分除く)<br />\n　立ち絵CG1枚(差分4枚)HCG一枚(差分4枚)<br />\n　漫画コマCG6枚(キス、胸揉み、指入れ、フェラ、胸吸い、クンニ)<br />\n・シナリオ総文字数: 5000文字くらい<br />\n・部分的にボイスあり(喘ぎ声や短いHボイスのみ)<br />\n・オートセーブ対応、Ctrlキーによりメッセージスキップ<br />\n・狐娘と絆を結ぶのが目的のイチャラブ短編AVG。ED1種。<br />\n・RPGツクールMZにて制作しています。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01698000/RJ01697116/7618c624a0a6031462a1b27c7bc555fc.jpg", "alt": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]", "title": "拾った狐娘が少しずつ懐いてくる夜 [天国か地獄か]"}, "position": "over"}]}], "description": "拾った狐娘に触れながら、少しずつ心の距離を縮めていくおさわり×懐きシミュレーション。頭を撫で、キスを重ね、絆が深まるほど触れられる場所や反応が変化。警戒していた狐娘が、やがて心を開いていく一夜をお楽しみください。", "short_introduction": "拾った狐娘に触れながら、少しずつ心の距離を縮めていくおさわり×懐きシミュレーション。頭を撫で、キスを重ね、絆が深まるほど触れられる場所や反応が変化。警戒していた狐娘が、やがて心を開いていく一夜をお楽しみください。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01697116.html", "site_id": "maniax", "fetched_at": 1794942380}