{"id": "RJ01718709", "title": "二択勇者", "title_romaji": "nitakuyuusha", "circle": {"id": "RG01044089", "name": "Night Knight", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG01044089.html"}, "type": {"code": "SLN", "name": "シミュレーション", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 1650, "official_jpy": 1650, "currencies": {"USD": 10.340101608731809, "EUR": 9.396483778821578, "GBP": 7.839977040746024, "TWD": 340.8879614899903, "CNY": 69.04776850166343, "KRW": 13807.531380753138, "IDR": 189003.43642611685, "VND": 266129.03225806454, "THB": 350.4003058039033, "SEK": 104.37819065150968, "HKD": 81.14009205712263, "SGD": 13.32618296122323, "CAD": 14.783025502958845, "MYR": 42.34037038842799, "BRL": 58.835275491720274, "AUD": 15.330412192973654, "PHP": 660.8988223984619, "MXN": 191.81808670177517, "NZD": 18.781330674352215, "INR": 971.3882020487459}}, "point": {"point_amount": 90, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1790866800, "file": {"type": "EXE", "size": 121678284}, "tags": [{"key": "432", "name": "女主人公"}, {"key": "016", "name": "ファンタジー"}, {"key": "324", "name": "異種えっち"}, {"key": "162", "name": "触手"}, {"key": "128", "name": "中出し"}, {"key": "118", "name": "レズ/女同士"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 4.43, "count": 7}, "review_count": 0, "dl_count": 68, "wishlist_count": 185, "ranking": [], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01719000/RJ01718709_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01719000/RJ01718709_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01719000/RJ01718709_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01719000/RJ01718709_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01719000/RJ01718709_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01719000/RJ01718709_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01719000/RJ01718709_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01719000/RJ01718709_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01719000/RJ01718709_img_smp7.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01719000/RJ01718709_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01719000/RJ01718709_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01719000/RJ01718709_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01719000/RJ01718709_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01719000/RJ01718709_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01719000/RJ01718709_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01719000/RJ01718709_img_smp7_100x100.jpg"], "alt": "二択勇者 [Night Knight]"}, "introductions": [{"type": "image", "title": "◆ストーリー◆", "body": [{"intro": "旅の果てに倒れた戦士に何者かが語り掛ける、<br />\r\n助かりたければ私の授ける力を受け入れ<br />\r\n勇者となり魔王を倒せと。<br />\r\n<br />\r\nその力とは魔物と交わり子をなす力だと、<br />\r\n魔物の力を次代へと引き継ぐ力だと何者かは語った。<br />\r\n<br />\r\n自らを「神」だと語るその者の提案を戦士は―――。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01719000/RJ01718709/461cfef5a73e4489a4caba77eeb2d793.jpg", "alt": "二択勇者 [Night Knight]", "title": "二択勇者 [Night Knight]"}, "position": "over"}]}, {"type": "image", "title": "◆システム◆", "body": [{"intro": "本ゲームはマウスのみを使って操作します。<br />\r\nまたタイトルにもある通り、このゲームは全て二択によって進行します。<br />\r\n<br />\r\nこのゲームの基本的な流れは<br />\r\n<br />\r\n1.行き先選択フェイズで行き先を選ぶ<br />\r\n2.選んだ先で発生するイベントをこなす<br />\r\n3.死ななければ1に戻る<br />\r\n<br />\r\nです。<br />\r\nこの流れを繰り返し、最終的に魔王の元に辿り着き倒す事が目的となっています。<br />\r\nまたこのゲームの大きな特徴は魔物と交わり、<br />\r\nその力を代々受け継いで強くなっていくという所です。<br />\r\n<br />\r\n行き先選択フェイズでは上の画像のように二択が提示されます。<br />\r\nこの時提示される選択肢はゲーム内の「感覚」ステータスによって内容が左右されます。<br />\r\n「感覚」の値が高ければ左の画像のように行き先に何が起こるかはっきり分かりますが、<br />\r\n低い場合は何も分からない状況で行き先を選ばなければならなくなります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01719000/RJ01718709/4e3b16316f0e56fa8d9d71b48e4d95f2.jpg", "alt": "二択勇者 [Night Knight]", "title": "二択勇者 [Night Knight]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "このゲームのメインとなる戦闘イベントも当然進行は二択で行われます。<br />\r\nこの時提示される選択肢もゲーム内のステータスである「知力」によって変化し、<br />\r\n「知力」が低い状態だと、上の画像のように意味のない行動が提示される事もあります。<br />\r\n<br />\r\nレベルアップも当然二択で提示されます。<br />\r\nこの時上がりの良い能力値は青く表示され、悪い能力値は赤く表示されます。<br />\r\n<br />\r\nスキルの習得も二択で提示され、選ばれなかった方は習得できません。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01719000/RJ01718709/ea8cb18b9b412450252fa208bab83970.jpg", "alt": "二択勇者 [Night Knight]", "title": "二択勇者 [Night Knight]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "アイテムイベントは宝箱から装備を手に入れるイベントです。<br />\r\n当然、手に入れた装備と現在の装備どちらも持っていくかは二択で選ぶことになります。<br />\r\nまたレア度の高い装備にはエンチャントがつきます。<br />\r\nエンチャントの数はレア度によって増加し、最大4つまでつきます。<br />\r\nエンチャントの効果は装備のランクが良くなるほど効果が高くなるので、<br />\r\n後半で手に入る装備の方が序盤に手に入る装備より格段に性能が良くなります。<br />\r\n<br />\r\n回復イベントは温泉で身体を休ませるイベントです。<br />\r\nこのゲームではレベルアップで全快する事はありません。<br />\r\n回復はイベント終了時の割合回復が主です(難易度によって回復量は増減)<br />\r\nそのため消耗した際にはこのイベントで回復する必要があります。<br />\r\n<br />\r\n罠イベントは罠でダメージを食らうイベントです。<br />\r\nマイナスイベントでしかないので分かっていれば選ぶ必要のないイベントですが、<br />\r\n「感覚」の値が低く、行き先で起こるイベントが判明していない場合は、<br />\r\nこのイベントと遭遇してしまう事があるかもしれません。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01719000/RJ01718709/4c0069bb6a6602e5baa2d085018c18f7.jpg", "alt": "二択勇者 [Night Knight]", "title": "二択勇者 [Night Knight]"}, "position": "over"}]}, {"type": "image", "title": "", "body": [{"intro": "このゲームは一度も死なずにクリア出来るようには作られていません。<br />\r\n勇者が死んだ場合は上の画像のような選択肢が表示されます。<br />\r\nこれは勇者がこれまで交わった相手の遺伝子で、<br />\r\nその最後の二つから一つを選んで次代の勇者に力を受け継ぎ強化していくのです。<br />\r\n<br />\r\nまたゲームが進んでいくと、<br />\r\n勇者が手にした装備の一部を次代に引き継げるようになります。<br />\r\n<br />\r\n勇者が死に次代の勇者が育つまでの間には20年の年月が掛かります。<br />\r\nその間、一年毎に様々なイベントが発生し判定が行われます。<br />\r\nそれに成功すると国が発展し、ゲームに有利な効果が発揮されます。<br />\r\n<br />\r\nまた勇者が一定の年齢に達すると育成イベントが発生し、<br />\r\n二択の中から一つを選んで次代の勇者を育成することが出来ます。<br />\r\nこの育成イベントが開始される年齢は、<br />\r\n国が発展する事によって建てられる施設によって下がっていきます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01719000/RJ01718709/9390eaac0e2ebae950dd21aebcbee3fc.jpg", "alt": "二択勇者 [Night Knight]", "title": "二択勇者 [Night Knight]"}, "position": "over"}]}, {"type": "image", "title": "◆エロイベント◆", "body": [{"intro": "魔物は戦闘の際に一度だけ勇者に対して襲い掛かります。<br />\r\nそれを受け入れるとエロイベントが始まります。<br />\r\nセックスをして満足した魔物は脱力し、<br />\r\n1ターンの間無防備になるため、戦闘的にも有利に働きます。<br />\r\nただ勇者が保持できる遺伝子は二つまでで新たな遺伝子が手に入った場合、<br />\r\n古い遺伝子は消されてしまう点は注意が必要です。<br />\r\n<br />\r\n魔物の遺伝子を受け継いで生まれて来た子供は<br />\r\n見た目も普通とは異なる姿で生まれてきます。<br />\r\n<br />\r\nそしてその見た目の変化はエロイベントでも引き継がれます。<br />\r\n<br />\r\nまた一度遭遇した魔物の情報はタイトルの魔物図鑑で確認でき、<br />\r\nそこでエロイベントを回想する事も可能となっています。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01719000/RJ01718709/3c13727d1f5c52d88f552b3f545cf289.jpg", "alt": "二択勇者 [Night Knight]", "title": "二択勇者 [Night Knight]"}, "position": "over"}]}], "description": "ゲームの全てを二択で選択し、魔王打倒を目指して進め！  旅の果てに倒れた戦士に何者かが語り掛ける、 助かりたければ私の授ける力を受け入れ 勇者となり魔王を倒せと。  その力とは魔物と交わり子をなす力だと、 魔物の力を次代へと引き継ぐ力だと何者かは語った。  自らを「神」だと語るその者の提案を戦士は―――。", "short_introduction": "ゲームの全てを二択で選択し、魔王打倒を目指して進め！  旅の果てに倒れた戦士に何者かが語り掛ける、 助かりたければ私の授ける力を受け入れ 勇者となり魔王を倒せと。  その力とは魔物と交わり子をなす力だと、 魔物の力を次代へと引き継ぐ力だと何者かは語った。  自らを「神」だと語るその者の提案を戦士は―――。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01718709.html", "site_id": "maniax", "fetched_at": 1794942266}