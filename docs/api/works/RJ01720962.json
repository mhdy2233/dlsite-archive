01720962_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01721000/RJ01720962_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01721000/RJ01720962_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01721000/RJ01720962_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01721000/RJ01720962_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01721000/RJ01720962_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01721000/RJ01720962_img_smp9.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01721000/RJ01720962_img_smp10.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01721000/RJ01720962_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01721000/RJ01720962_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01721000/RJ01720962_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01721000/RJ01720962_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01721000/RJ01720962_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01721000/RJ01720962_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01721000/RJ01720962_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01721000/RJ01720962_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01721000/RJ01720962_img_smp9_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01721000/RJ01720962_img_smp10_100x100.jpg"], "alt": "スライムレギオン [ニワトリハート]"}, "introductions": [{"type": "text", "title": "スライムを召喚し、育て、編成して洞窟の奥を目指す 育成×ノード探索RPG『スライムレギオン』。", "body": [{"intro": "洞窟では、戦闘・宝箱・回復・行商人など様々なノードを選びながら進軍。<br />\n戦闘はオートで進行し、速度変更や薬草による支援で部隊を助けることができます。<br />\n<br />\n個体ごとに異なる能力やスキルを持つスライムたちを育成し、<br />\nより強い部隊を作りながら30Fの最深部を目指してください。<br />\n<br />\nその道の先で待っているのは、<br />\nかつて人々が忘れてしまった、スライムたちの「ふるさと」です。"}]}, {"type": "image", "title": "お気に入りの3体で主力部隊を編成", "body": [{"intro": "召喚したスライムの中から、主力となる3体を選んで部隊を編成。<br />\n<br />\nそれぞれの能力やスキル、個性を見ながら、<br />\n自分なりの組み合わせで洞窟攻略に挑みます。<br />\n<br />\n戦いを重ねて成長するスライムたちと、<br />\n少しずつ強い部隊を作り上げていきましょう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01721000/RJ01720962/7c761828b2a59d061ed1007bc02a8e35.jpg", "alt": "スライムレギオン [ニワトリハート]", "title": "スライムレギオン [ニワトリハート]"}, "position": "over"}]}, {"type": "image", "title": "ルートを選んで洞窟の奥へ", "body": [{"intro": "遠征では、分岐するノードから進むルートを選択。<br />\n<br />\n戦闘だけでなく、宝箱や回復、行商人など<br />\nさまざまな出来事を乗り越えながら先へ進みます。<br />\n<br />\n部隊の残りHPや状況を見極め、<br />\nどの道を進むかを選ぶことが攻略のカギです。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01721000/RJ01720962/a9dbc8911bdec818315fbc4c23c3fe11.jpg", "alt": "スライムレギオン [ニワトリハート]", "title": "スライムレギオン [ニワトリハート]"}, "position": "over"}]}, {"type": "image", "title": "育てた3体が挑むオートバトル", "body": [{"intro": "戦闘は、編成した3体のスライムが自動で進行。<br />\n<br />\nそれぞれの能力やスキルを活かして敵と戦い、<br />\nプレイヤーは戦況を見ながら速度変更や薬草による支援ができます。<br />\n<br />\n育てた部隊がどこまで戦えるか、<br />\nその成長を見届けながら洞窟の奥を目指します。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01721000/RJ01720962/0155548a7ceb7729d7b03fbdd0475483.jpg", "alt": "スライムレギオン [ニワトリハート]", "title": "スライムレギオン [ニワトリハート]"}, "position": "over"}]}, {"type": "image", "title": "増えたスライムを管理して、次の戦力へ", "body": [{"intro": "召喚したスライムは一体ずつ名前や種族、レベルなどを管理。<br />\n<br />\n主力として育てる個体を選ぶだけでなく、<br />\n条件を満たしたスライムは合成に利用することもできます。<br />\n<br />\n集めた仲間を整理しながら、<br />\n自分だけの部隊を少しずつ強くしていきましょう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01721000/RJ01720962/e45ed2b23e2232092cfb76746b8cfbf5.jpg", "alt": "スライムレギオン [ニワトリハート]", "title": "スライムレギオン [ニワトリハート]"}, "position": "over"}]}, {"type": "image", "title": "訓練で個体ごとの強みを伸ばす", "body": [{"intro": "成長したスライムは、個体訓練でさらに能力を強化できます。<br />\n<br />\n体力・攻勢・堅牢から伸ばしたい方向を選び、<br />\nお気に入りの個体を自分好みに育成。<br />\n<br />\n同じ種類のスライムでも、<br />\n育て方によってそれぞれ違った戦力へ成長していきます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01721000/RJ01720962/bbb69e5c7c13737b3f63ab658d7d1505.jpg", "alt": "スライムレギオン [ニワトリハート]", "title": "スライムレギオン [ニワトリハート]"}, "position": "over"}]}], "description": "スライムを集め、育て、編成して洞窟を攻略。自動戦闘とノード探索で進む、育成重視のスライムRPG。", "short_introduction": "スライムを集め、育て、編成して洞窟を攻略。自動戦闘とノード探索で進む、育成重視のスライムRPG。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01720962.html", "site_id": "home", "fetched_at": 1794942378}