parts/RJ01753000/RJ01752389/27bcff4e799ab0d8fec0b6ec154ae2d2.jpg", "alt": "妹はルームメイト！ [お前も猫になるんだよ]", "title": "妹はルームメイト！ [お前も猫になるんだよ]"}, "position": "over"}]}, {"type": "image", "title": "バイトに買い物、休日のお出かけ", "body": [{"intro": "バイトで生活費を稼ぐのも、家でゲームをして過ごすのも自由。時間とお金をやりくりしながら生活しましょう。休日には結衣を誘って出かけたり、一緒に買い物を楽しんだりすることもできます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01753000/RJ01752389/ca9d0d23404fa8085721da2ebfc0fc66.jpg", "alt": "妹はルームメイト！ [お前も猫になるんだよ]", "title": "妹はルームメイト！ [お前も猫になるんだよ]"}, "position": "over"}]}, {"type": "image", "title": "Live2Dで動く結衣", "body": [{"intro": "会話に合わせて変わる表情や何気ない仕草をLive2Dで描いています。食事中のやり取りから帰宅したときの反応、Hシーンに至るまで、一緒に暮らす結衣の様子を楽しめます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01753000/RJ01752389/41f2ad070ee572d7a94b6ab877345624.jpg", "alt": "妹はルームメイト！ [お前も猫になるんだよ]", "title": "妹はルームメイト！ [お前も猫になるんだよ]"}, "position": "left"}]}, {"type": "text", "title": "接し方によって会話やイベントが変化", "body": [{"intro": "毎日どう接するかによって結衣の態度が変わります。約束を守るか、相手を気遣えるか。普段の行動がイベントの発生や物語の結末にも影響します。"}]}, {"type": "text", "title": "バグ報告はこちらまで↓", "body": [{"intro": "<a href=\"https://ci-en.dlsite.com/creator/36404/article/2001345\" target=\"_blank\">https://ci-en.dlsite.com/creator/36404/article/2001345</a>"}]}], "description": "そっけない妹とひとつ屋根の下。会話と選択で毎日が変わる、同居生活シミュレーション！", "short_introduction": "そっけない妹とひとつ屋根の下。会話と選択で毎日が変わる、同居生活シミュレーション！", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01752389.html", "site_id": "maniax", "fetched_at": 1794941306, "local_images": {"main": "RJ01752389/main.jpg", "thumb": "RJ01752389/thumb.jpg", "samples": ["RJ01752389/smp1.jpg", "RJ01752389/smp2.jpg", "RJ01752389/smp3.jpg", "RJ01752389/smp4.jpg", "RJ01752389/smp5.jpg", "RJ01752389/smp6.jpg"]}}