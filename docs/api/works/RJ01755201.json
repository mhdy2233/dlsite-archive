od": "month", "rank": 2, "date": "2026-11-16"}, {"category": "game", "period": "day", "rank": 1, "date": "2026-11-03"}, {"category": "game", "period": "week", "rank": 1, "date": "2026-11-04"}, {"category": "game", "period": "month", "rank": 2, "date": "2026-11-16"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01756000/RJ01755201_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ01756000/RJ01755201_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01756000/RJ01755201_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01756000/RJ01755201_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01756000/RJ01755201_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01756000/RJ01755201_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01756000/RJ01755201_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01756000/RJ01755201_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01756000/RJ01755201_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01756000/RJ01755201_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01756000/RJ01755201_img_smp9.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01756000/RJ01755201_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01756000/RJ01755201_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01756000/RJ01755201_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01756000/RJ01755201_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01756000/RJ01755201_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01756000/RJ01755201_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01756000/RJ01755201_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01756000/RJ01755201_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01756000/RJ01755201_img_smp9_100x100.jpg"], "alt": "幸子の幸福論 [ハニージャム]"}, "introductions": [{"type": "text", "title": "◆夫が眠る寝室の、ドア一枚向こうで――。", "body": [{"intro": "お隣に越してきた、若い人妻・幸子。<br />\n明るくて、人懐っこくて、優しい。<br />\n「お隣同士って、仲良くするものですよね」<br />\n※全編モノクロ(白黒)のグラフィックです。<br />\n<br />\nある夜、あなたは彼女の家を訪ねる。<br />\n夫は――ドア一枚向こうの寝室で、眠っている。<br />\n<br />\n声を出させてはいけない。<br />\n気づかれてはいけない。<br />\n<br />\n30分で遊べる、背徳とホラーの短編おさわりゲーム"}]}, {"type": "image", "title": "■ 触れて、反応を楽しむ", "body": [{"intro": "胸、耳、首すじ、太もも、秘部……<br />\nクリックで触れ、ドラッグでなでる。<br />\n触れる場所によって、彼女の表情も声も変わっていきます。<br />\n快感ゲージが満ちれば、関係は次の段階へ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01756000/RJ01755201/5a1815154802674bfa51a88e72e676fd.jpg", "alt": "幸子の幸福論 [ハニージャム]", "title": "幸子の幸福論 [ハニージャム]"}, "position": "left"}]}, {"type": "image", "title": "■ 交わる", "body": [{"intro": "パートが進むと、セックス・アナル・パイズリ・フェラを自由に切り替え。<br />\nペースは3段階。射精ゲージが満ちれば――中に、口に、胸に。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01756000/RJ01755201/62f5f48892f4a0bbb934e231e47716bc.jpg", "alt": "幸子の幸福論 [ハニージャム]", "title": "幸子の幸福論 [ハニージャム]"}, "position": "left"}]}, {"type": "image_list", "title": "◆ ゲームの特徴", "body": [{"intro": "■ 夜ごとに、深まっていく関係<br />\n最初は、触れることさえ拒んでいた彼女。<br />\n夜を重ねるたびに、声は甘く、腰は自分から――。<br />\n物語パートでは、イベントCGで二人の夜を描きます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01756000/RJ01755201/706344f7eb1ece14a6587422aca07943.jpg", "alt": "幸子の幸福論 [ハニージャム]", "title": "幸子の幸福論 [ハニージャム]"}}, {"intro": "■ 声を殺す背徳感<br />\n夫は、ドア一枚向こうで眠っています。<br />\n彼女の口をふさぎ、手を止め、息をひそめながら、最後まで。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01756000/RJ01755201/2abe7f28f12357d4050a63e6649f3187.jpg", "alt": "幸子の幸福論 [ハニージャム]", "title": "幸子の幸福論 [ハニージャム]"}}, {"intro": "■ じわじわと侵食する気配<br />\n部屋の灯りが揺らぎ、画面の縁から黒い染みがにじみ、文字が崩れていく。<br />\nそして彼女も、ときどき……どこか、おかしい。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01756000/RJ01755201/1ab240454e8f3dea32daa5c0f17063b7.jpg", "alt": "幸子の幸福論 [ハニージャム]", "title": "幸子の幸福論 [ハニージャム]"}}, {"intro": "■ 4種のエンディング<br />\nあなたの選択と、彼女をどれだけ「見ていた」かで、結末が変わります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01756000/RJ01755201/c6e1da3e8a80ea81b8a7c5099fd165fe.jpg", "alt": "幸子の幸福論 [ハニージャム]", "title": "幸子の幸福論 [ハニージャム]"}}]}, {"type": "image", "title": "◆キャラクター", "body": [{"intro": "幸子(さちこ)<br />\n<br />\nお隣に越してきた、若い人妻。<br />\n明るくて人懐っこく、誰にでも優しい。<br />\n<br />\n「お隣同士って、仲良くするものですよね」<br />\n<br />\nお隣同士は仲良く。努力は報われる。<br />\n優しい人は愛される。<br />\n――そんな言葉を、心から信じている。<br />\n<br />\n夫と二人、静かに暮らしている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01756000/RJ01755201/85d3acf1485ad52d680c4b3814d99525.jpg", "alt": "幸子の幸福論 [ハニージャム]", "title": "幸子の幸福論 [ハニージャム]"}, "position": "left"}]}, {"type": "image", "title": "", "body": [{"intro": "◆ 収録内容<br />\n・触れるパート:3シーン(差分パーツ200以上の組み合わせで表情・体が変化)<br />\n・イベントCG:15枚(差分込み 68枚)<br />\n・エンディング:4種<br />\n・プレイ時間:約30分<br />\n・ギャラリー(CG回想・エンディング回想)<br />\n・言語:日本語/中文(繁體)/English<br />\n・音声:なし(効果音あり)<br />\n<br />\n◆ 収録プレイ<br />\nキス、耳責め、乳揉み、乳首責め、手マン、クリ責め、フェラ、パイズリ、セックス、アナル、中出し、口内射精、ぶっかけ<br />\n<br />\n◆ ご注意<br />\n※一部のエンディングに、輪○・触手(異種姦)の描写があります。<br />\n※点滅や画面の揺れ、ノイズなどの演出があります。<br />\n<br />\n◆ 体験版<br />\n「夜の訪問」から、2つ目の触れるパートの最後まで遊べます。<br />\n※体験版のセーブデータは製品版には引き継げません。<br />\n<br />\n◆【Ver1.10】2026/11/08<br />\n・ギャラリーに「回想」機能を追加しました。<br />\n　CGの「▶回想」から、そのシーンの物語を最初から見返せます。<br />\n・タイトル画面に「フリーモード」を追加しました。<br />\n　好きなステージを選んで、触れるパートを遊べます。<br />\n　「夫の目覚め:なし」に設定すると、夫が目覚めることなく<br />\n　幸子さんとの時間をお楽しみいただけます。<br />\n　※いずれかのエンディングを見ると解放されます。<br />\n・アニメーション中に動作が重くなることがある問題を改善しました。<br />\n<br />\n◆ 動作環境<br />\nWindows 10 / 11(64bit)<br />\nOpenGL 3.3 に対応したグラフィック(ほとんどのPCで動作します)<br />\n※体験版で動作をご確認のうえ、ご購入ください。<br />\n<br />\n不具合・質問・要望等がございましたら、こちらのメールまでお願いします。<br />\n<br />\n1995rocketdog@gmail.com<br />\n<br />\n幸子ちゃんとの時間、ぜひお楽しみください！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01756000/RJ01755201/e793ddfb8a3e7c250df0ac79a0f8f654.jpg", "alt": "幸子の幸福論 [ハニージャム]", "title": "幸子の幸福論 [ハニージャム]"}, "position": "under"}]}], "description": "夫が眠る寝室の、ドア一枚向こうで――。背徳と恐怖のおさわりシミュレーション。", "short_introduction": "夫が眠る寝室の、ドア一枚向こうで――。背徳と恐怖のおさわりシミュレーション。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01755201.html", "site_id": "maniax", "fetched_at": 1794942060}