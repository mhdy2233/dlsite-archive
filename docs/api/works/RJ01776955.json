images2/work/doujin/RJ01777000/RJ01776955_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01777000/RJ01776955_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01777000/RJ01776955_img_smp3.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01777000/RJ01776955_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01777000/RJ01776955_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01777000/RJ01776955_img_smp3_100x100.jpg"], "alt": "魔法学園の守護者 [すたじおプラク]"}, "introductions": [{"type": "text", "title": "■ゲーム内容", "body": [{"intro": "数年前、生まれ育った村を魔物に滅ぼされた主人公――<br />\n<br />\nその復讐のため、兵士たちを率いて戦いを挑むことに。"}]}, {"type": "image_list", "title": "■戦闘システム", "body": [{"intro": "戦闘は照準をマウスで操作！<br />\nマウスの場所を自動で攻撃し続ける。<br />\n上から押し寄せる魔物の大群を、防衛線にたどり着く前に撃破しよう！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01777000/RJ01776955/77ba851ede27675a64c555e66ad68d1e.jpg", "alt": "魔法学園の守護者 [すたじおプラク]", "title": "魔法学園の守護者 [すたじおプラク]"}}, {"intro": "兵士たちを雇用し、鍛え上げて戦場に！<br />\n兵士たちは自動で敵を攻撃するぞ。<br />\n敵の移動速度を遅くしたりノックバックさせるなど特殊な能力を持つ味方も。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01777000/RJ01776955/3492ea3376b00a85b7add4b07dd0b712.jpg", "alt": "魔法学園の守護者 [すたじおプラク]", "title": "魔法学園の守護者 [すたじおプラク]"}}]}, {"type": "image_list", "title": "■ゲームの流れ", "body": [{"intro": "■Phase1:拠点<br />\n主人公の強化やスキルの装備などをここで。<br />\n強化には戦闘で得たマナが必要だ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01777000/RJ01776955/4313c60d5f3d6fffd100c2b0443ca9fb.jpg", "alt": "魔法学園の守護者 [すたじおプラク]", "title": "魔法学園の守護者 [すたじおプラク]"}}, {"intro": "■Phase2:戦闘<br />\n育成型タワーディフェンスADV！<br />\n全10面のマップをクリアしよう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01777000/RJ01776955/4b1525f9c194359730712fbdbb071dc6.jpg", "alt": "魔法学園の守護者 [すたじおプラク]", "title": "魔法学園の守護者 [すたじおプラク]"}}, {"intro": "■Phase3:交流<br />\n主人公とヒロイン達との出会い、また彼女たちとのHイベントをここで閲覧しよう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01777000/RJ01776955/a78aa7b3e25c8d6708bcc3704fa6d093.jpg", "alt": "魔法学園の守護者 [すたじおプラク]", "title": "魔法学園の守護者 [すたじおプラク]"}}]}, {"type": "text", "title": "■その他", "body": [{"intro": "◆基本情報<br />\n難易度:イージー～ハードの3種類<br />\n◆想定プレイ時間<br />\nメインシナリオ:1～1.5時間<br />\n◆その他<br />\n・回想全開放機能あり<br />\n<br />\n※本作はRPGツクールMZで制作されています"}]}], "description": "育成型タワーディフェンスADV。戦闘は照準をマウスで操作！ 兵士たちを雇用し、鍛え上げて戦場に！ 拠点に迫り来る魔物の軍勢を迎え撃て！", "short_introduction": "育成型タワーディフェンスADV。戦闘は照準をマウスで操作！ 兵士たちを雇用し、鍛え上げて戦場に！ 拠点に迫り来る魔物の軍勢を迎え撃て！", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01776955.html", "site_id": "maniax", "fetched_at": 1795462885}