{"id": "RJ036390", "title": "ねこぽり～ねこのおまわりさん～", "title_romaji": "nekoporinekonoomawarisan", "circle": {"id": "RG03512", "name": "櫻プロジェクト", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG03512.html"}, "type": {"code": "ADV", "name": "アドベンチャー", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 1650, "official_jpy": 1650, "currencies": {"USD": 10.35242802082281, "EUR": 9.413294995550078, "GBP": 7.841605276402329, "TWD": 340.9513576063148, "CNY": 69.1151584203207, "KRW": 13830.67896060352, "IDR": 189241.88553733227, "VND": 266214.9080348499, "THB": 350.281286487634, "SEK": 104.74261881939198, "HKD": 81.22796998995727, "SGD": 13.34313447210921, "CAD": 14.79969288394888, "MYR": 42.377996316966865, "BRL": 59.92395105847488, "AUD": 15.367335192315215, "PHP": 659.9208095028596, "MXN": 190.91698004049755, "NZD": 18.830672312064184, "INR": 968.0258140217073}}, "point": {"point_amount": 90, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1198767600, "file": {"type": "EXE", "size": 379867032}, "tags": [{"key": "086", "name": "コスプレ"}, {"key": "074", "name": "制服"}, {"key": "007", "name": "コメディ"}, {"key": "159", "name": "放尿/おしっこ"}, {"key": "182", "name": "巨乳/爆乳"}, {"key": "175", "name": "ネコミミ"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 3.99, "count": 123}, "review_count": 2, "dl_count": 194, "wishlist_count": 299, "ranking": [{"category": "all", "period": "day", "rank": 23, "date": "2007-12-29"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ037000/RJ036390_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ037000/RJ036390_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ037000/RJ036390_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ037000/RJ036390_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ037000/RJ036390_img_smp3.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ037000/RJ036390_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ037000/RJ036390_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ037000/RJ036390_img_smp3_100x100.jpg"], "alt": "ねこぽり～ねこのおまわりさん～ [櫻プロジェクト]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "猫見町にある「猫見町交番」。<br />\r\nそこで町の平和の為に腐心する主人公・古田総一郎。<br />\r\n文字通り猫の手も借りたい忙しさの彼を見かねたのか、<br />\r\n新人さんが追加されることになりました。<br />\r\nやれやれ、ちょっとは楽になるのか……そう思った総一郎でしたが、配属された二人の新人さんを見た瞬間目が丸くなります。<br />\r\nそれこそ猫のように。<br />\r\n<br />\r\n『ちょっ!　おまっ!　その……み、耳は…………!?』<br />\r\n『この耳が、どうかしましたかぁ?』<br />\r\n<br />\r\n彼女——寒川えるざの頭部に生えているのはどう見ても猫の耳です。<br />\r\n<br />\r\n本当にありがとうございました。<br />\r\n<br />\r\n『ったく、ここんとこ連続痴○魔だの下着ドロだので忙しいってのに、上は何を考えてるんだ……?』<br />\r\n『にゃ〜』<br />\r\n<br />\r\n文字どころか本当にネコミミな二人の新米婦警に振り回される総一郎は、猫見町の平和を守ることができるのでしょうか。<br />\r\n<br />\r\n萌えでかわゆすな猫耳婦警さんと町の平和を守るアドベンチャーゲームです。<br />\r\nとんでも事件やエッチな事件、はてはメイド喫茶潜入捜査と萌え要素ばっちりです。<br />\r\nエッチはエッチでしっかりたっぷりありますので、どうぞどうぞお楽しみに。<br />\r\n<br />\r\nオナニー、放尿、コスプレ、屋外プレイ、3Pと、いろんなシチュエーションでお待ちしています。<br />\r\n<br />\r\nキャスト<br />\r\n寒川えるざ:梨本悠里<br />\r\n天野志緒:長瀬ゆずは<br />\r\n<br />\r\nProjectSAKURA<br />\r\n<a href=\"http://karen.saiin.net/~projectsakura/index.html\" target=\"_blank\">http://karen.saiin.net/~projectsakura/index.html</a><br />\r\n作品紹介をしているウェブラジオ<br />\r\n<a href=\"http://www.voiceblog.jp/projectsakura/\" target=\"_blank\">http://www.voiceblog.jp/projectsakura/</a>"}]}], "description": "猫のおまわりさん達とかわいくエッチに町の平和を守ります。", "short_introduction": "猫のおまわりさん達とかわいくエッチに町の平和を守ります。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ036390.html", "site_id": "maniax", "fetched_at": 1794972204}