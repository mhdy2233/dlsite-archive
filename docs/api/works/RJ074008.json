{"id": "RJ074008", "title": "ドラゴンダンジョン", "title_romaji": "doragondanjon", "circle": {"id": "RG14192", "name": "ランクスソフト", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG14192.html"}, "type": {"code": "RPG", "name": "ロールプレイング", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 1540, "official_jpy": 1540, "currencies": {"USD": 9.662266152767957, "EUR": 8.78574199584674, "GBP": 7.3188315913088395, "TWD": 318.22126709922713, "CNY": 64.50748119229931, "KRW": 12908.633696563285, "IDR": 176625.75983484345, "VND": 248467.24749919327, "THB": 326.92920072179174, "SEK": 97.75977756476586, "HKD": 75.81277199062679, "SGD": 12.453592173968596, "CAD": 13.813046691685622, "MYR": 39.55279656250241, "BRL": 55.92902098790989, "AUD": 14.3428461794942, "PHP": 615.9260888693357, "MXN": 178.18918137113104, "NZD": 17.57529415792657, "INR": 903.4907597535935}}, "point": {"point_amount": 84, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1298473200, "file": {"type": "EXE", "size": 476334223}, "tags": [{"key": "135", "name": "オナニー"}, {"key": "128", "name": "中出し"}, {"key": "138", "name": "フェラチオ"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 3.5, "count": 447}, "review_count": 1, "dl_count": 764, "wishlist_count": 545, "ranking": [{"category": "all", "period": "day", "rank": 4, "date": "2011-02-24"}, {"category": "all", "period": "week", "rank": 13, "date": "2011-03-01"}, {"category": "all", "period": "month", "rank": 66, "date": "2011-03-26"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ075000/RJ074008_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ075000/RJ074008_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ075000/RJ074008_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ075000/RJ074008_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ075000/RJ074008_img_smp3.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ075000/RJ074008_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ075000/RJ074008_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ075000/RJ074008_img_smp3_100x100.jpg"], "alt": "ドラゴンダンジョン [ランクスソフト]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "【あらすじ】<br />\r\n魔界の封印が解け、世界はモンスターだらけになってしまった。<br />\r\nあなたは勇者をあやつり、世界に散らばる封印の石を取り戻す旅に出ます。<br />\r\nそして、モンスターたちの親玉ドラゴンを討伐し、世界に平和を取り戻そう!<br />\r\n<br />\r\n<br />\r\n【カジノシステム】<br />\r\n本格的なカジノゲーム(ポーカー)が楽しめます。<br />\r\nまた、カジノで得たお金は、そのままゲーム中で使用できます。<br />\r\nカジノでしか手に入らないアイテムを使って、冒険を有利に進めよう!<br />\r\n<br />\r\n<br />\r\n【風俗システム】<br />\r\nゲーム中には風俗があり、そこでは登場する全ての女性キャラとHができます。<br />\r\n<br />\r\n<br />\r\n【マルチエンディングシステム】<br />\r\n冒険の最後には、気に入った女性キャラを選択して、エンディングを迎えられます。<br />\r\n<br />\r\n<br />\r\n【ボイス付きアニメーション】<br />\r\nゲームに登場する女性キャラ、全員とHが出来ます(年寄り以外)。<br />\r\n全てのエッチシーンに、アニメがあります。<br />\r\nまた、いやらしいボイスと効果音が、あなたを魅了します。<br />\r\nHイベント中では、アニメを繰り返し見られる選択肢があります。<br />\r\n<br />\r\n・高台でビア○カの公開オナニー<br />\r\n・フ○ーラ宅に侵入しレ○プ<br />\r\n・デボ○に襲われる<br />\r\n　など他多数<br />\r\n<br />\r\nHシーンは15箇所あり、CGは基本13枚で、差分を含めると400枚を超えるボリューム。<br />\r\n<br />\r\n<br />\r\n【システム】<br />\r\nマップが広大なためクリアには時間がかかり、難易度は高めかもしれませんが、<br />\r\n最初から最強になれるイベントや、ボスにも有効な死の呪文が搭載されています。<br />\r\nまた、攻略の手引きをしてくれるNPCがいますので、RPGが苦手という方でも、<br />\r\nクリアしやすいように作られています。<br />\r\n<br />\r\nインストール不要で、レジストリを汚しません。<br />\r\nアンインストールは、ファイルを削除するだけ!<br />\r\n<br />\r\n<br />\r\n【体験版】<br />\r\n動作確認やシステム把握のために、まずは体験版のプレイをおすすめします。<br />\r\n<br />\r\n☆製品版との相違点<br />\r\n・敵が1種類しか登場しない<br />\r\n・Hシーンが1つしかなく、ショートバージョンでアニメが無い<br />\r\n・まちやダンジョンなど、行ける範囲がかなり限られている。<br />\r\n・レベル制限がある<br />\r\n<br />\r\n<br />\r\n■バグ修正等でデータを差し替えることがあります。その際は、再ダウンロードをお願いします。<br />\r\n<br />\r\n2011/7/8　バグを修正しました。現在のバージョンは1.01です。"}]}], "description": "本格RPGを求めるあなたへ!\r\nドラゴンを討伐し、世界に平和を取り戻そう!", "short_introduction": "本格RPGを求めるあなたへ!\r\nドラゴンを討伐し、世界に平和を取り戻そう!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ074008.html", "site_id": "maniax", "fetched_at": 1794970516}