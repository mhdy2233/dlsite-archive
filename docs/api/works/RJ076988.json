ng": ["ENG"]}], "rating": {"average": 3.87, "count": 326}, "review_count": 2, "dl_count": 761, "wishlist_count": 586, "ranking": [{"category": "all", "period": "day", "rank": 11, "date": "2011-05-15"}, {"category": "all", "period": "week", "rank": 29, "date": "2011-05-20"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ077000/RJ076988_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ077000/RJ076988_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ077000/RJ076988_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ077000/RJ076988_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ077000/RJ076988_img_smp3.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ077000/RJ076988_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ077000/RJ076988_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ077000/RJ076988_img_smp3_100x100.jpg"], "alt": "BIO SEEKER vol.1 [A THIRD DIMENSION]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "BIO SEEKER STORY<br />\r\n<br />\r\nかつて世界に蔓延した恐怖のT-ウイルス。<br />\r\n<br />\r\n事態は収束したかにみえた。しかし、細菌兵器の開発は途絶えることなく極秘裏に進められ、最終段階、その研究の成否は”アリス”という少女の抗体に委ねられる・・<br />\r\n<br />\r\nアリスの体内に眠る抗体はT-ウイルスを駆逐する唯一の発見ではあったが、研究を引き継いだ軍の制御コンピュータ「レッドクイーン」は恐るべき可能性をはじきだしていた・・<br />\r\n<br />\r\nそれは、アンデッド化による腐食、劣化を抑えるばかりでなく、食欲中枢をコントロール可能にし、理性と知性を持ちあわせた究極の生態の誕生を示唆していた。<br />\r\nそして、それは完全な有性生殖により、かぎりなくヒトに近い生殖行動をとる。つまり感染だけにとどまらず、増殖し、飛躍的に個体数を増やしていく恐るべき予言を語っていた。<br />\r\n<br />\r\n軍事利用が最優先事項というアナウンスの最中、21番目の実験体”PHI(ファイ)”は誕生する。それはアリスによく似た姿をしていた・・・<br />\r\n<br />\r\nBIO SEEKERシリーズ第一弾、SS付きCG集です。<br />\r\n内容<br />\r\nss付きフラッシュ前編・後編(BGM付き)<br />\r\n劇中使用画像(jpg)364枚、差分含む<br />\r\nボーナス画像(tiff,bmp)28枚<br />\r\n<br />\r\nまずは体験版で動作確認よろしくお願いします。"}]}], "description": "BIO SEEKERシリーズ第一弾、SS付きCG集です。まずは体験版で動作確認よろしくお願いします。", "short_introduction": "BIO SEEKERシリーズ第一弾、SS付きCG集です。まずは体験版で動作確認よろしくお願いします。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ076988.html", "site_id": "maniax", "fetched_at": 1794970432}