humb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ102000/RJ101677_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ102000/RJ101677_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ102000/RJ101677_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ102000/RJ101677_img_smp3.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ102000/RJ101677_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ102000/RJ101677_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ102000/RJ101677_img_smp3_100x100.jpg"], "alt": "三色王女日記 [十字路]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "ドラ●エ5の三人の王女、金髪王女、青髪王女、黒髪王女のエッチな日記帳。<br />\n<br />\n台詞によって進行するノベル形式です。<br />\n<br />\n基本CG数21枚。差分総数は2000以上になります。<br />\n<br />\n彼女達はある日、お店でお買い物をしている最中に、うとうとと眠りに落ちてしまい、<br />\n眠っているのをいい事に、店主からイタズラを・・・。<br />\n<br />\nまたある日、馬車の中で従者のサン●ョと二人きり。<br />\nサン●ョは突然王女に迫ってきて、ついには・・・。<br />\n<br />\n純真で天真爛漫な金髪王女。<br />\n上手い事言いくるめられて・・・。<br />\n<br />\nおとなしくて引っ込み思案な青髪王女。<br />\n強引に迫られて・・・。<br />\n<br />\nおませでちょっぴりドSな黒髪王女。<br />\nいつの間にか主導権を握られて・・・。<br />\n<br />\nと、それぞれ三様の展開が待っています。<br />\n<br />\nおかあさん達もちょっぴり出演。<br />\n<br />\n2020年11月追記:<br />\nFLASHのサポート終了に伴い、過去販売時のswf・htmlから単体起動可能なexeへと起動形式を変更しました。<br />\n動作保証はされませんが旧バージョンもおまけとして同梱されています。<br />\n起動可能な環境をお持ちの方はそのままお楽しみ頂けます。"}]}, {"type": "image_list", "title": "調教される王女たち。", "body": [{"intro": "寝ているところにイタズラ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ102000/RJ101677/RJ101677_PTS0000002468_1.jpg", "alt": "三色王女日記 [十字路]", "title": "三色王女日記 [十字路]"}}, {"intro": "一線を越えて・・・。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ102000/RJ101677/RJ101677_PTS0000002468_2.jpg", "alt": "三色王女日記 [十字路]", "title": "三色王女日記 [十字路]"}}, {"intro": "露出調教。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ102000/RJ101677/RJ101677_PTS0000002468_3.jpg", "alt": "三色王女日記 [十字路]", "title": "三色王女日記 [十字路]"}}, {"intro": "3Pなども。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ102000/RJ101677/RJ101677_PTS0000002468_4.jpg", "alt": "三色王女日記 [十字路]", "title": "三色王女日記 [十字路]"}}]}, {"type": "image", "title": "三色王女の物語", "body": [{"intro": "いろんな格好も。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ102000/RJ101677/RJ101677_PTS0000002469_0.jpg", "alt": "三色王女日記 [十字路]", "title": "三色王女日記 [十字路]"}, "position": "under"}]}, {"type": "image_list", "title": "おかあさんといっしょ", "body": [{"intro": "ふたり一緒に。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ102000/RJ101677/RJ101677_PTS0000002470_1.jpg", "alt": "三色王女日記 [十字路]", "title": "三色王女日記 [十字路]"}}, {"intro": "拘束されて無理やり。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ102000/RJ101677/RJ101677_PTS0000002470_2.jpg", "alt": "三色王女日記 [十字路]", "title": "三色王女日記 [十字路]"}}, {"intro": "ふたりがかりで責められ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ102000/RJ101677/RJ101677_PTS0000002470_3.jpg", "alt": "三色王女日記 [十字路]", "title": "三色王女日記 [十字路]"}}, {"intro": "三人いっぺんに?", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ102000/RJ101677/RJ101677_PTS0000002470_4.jpg", "alt": "三色王女日記 [十字路]", "title": "三色王女日記 [十字路]"}}]}], "description": "ドラ●エ5の三人王女のエッチな日記帳。", "short_introduction": "ドラ●エ5の三人王女のエッチな日記帳。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ101677.html", "site_id": "maniax", "fetched_at": 1794969414}