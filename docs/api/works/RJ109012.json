{"id": "RJ109012", "title": "対魔忍アサギ3", "title_romaji": "taimaninasagisurii", "circle": {"id": "RG02397", "name": "Lilith [リリス]", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG02397.html"}, "type": {"code": "ADV", "name": "アドベンチャー", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 7480, "official_jpy": 7480, "currencies": {"USD": 46.931007027730075, "EUR": 42.67360397982703, "GBP": 35.54861058635722, "TWD": 1545.6461544819604, "CNY": 313.3220515054538, "KRW": 62699.077954735956, "IDR": 857896.5477692396, "VND": 1206840.916424653, "THB": 1587.9418320772743, "SEK": 474.833205314577, "HKD": 368.233463954473, "SGD": 60.48887627356175, "CAD": 67.0919410739016, "MYR": 192.11358330358314, "BRL": 271.65524479841946, "AUD": 69.66525287182898, "PHP": 2991.64100307963, "MXN": 865.4903095169221, "NZD": 85.36571448135763, "INR": 4388.38369023174}}, "point": {"point_amount": 408, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1358434800, "file": {"type": "EXE", "size": 1918795725}, "tags": [{"key": "269", "name": "変身ヒロイン"}, {"key": "146", "name": "拘束"}, {"key": "149", "name": "羞恥/恥辱"}, {"key": "162", "name": "触手"}, {"key": "200", "name": "人体改造"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 4.55, "count": 4113}, "review_count": 27, "dl_count": 8869, "wishlist_count": 7009, "ranking": [{"category": "all", "period": "day", "rank": 2, "date": "2013-01-18"}, {"category": "all", "period": "week", "rank": 5, "date": "2013-01-24"}, {"category": "all", "period": "month", "rank": 12, "date": "2014-08-10"}, {"category": "all", "period": "year", "rank": 7, "date": "2013"}, {"category": "all", "period": "total", "rank": 28, "date": "2018-10-11"}, {"category": "game", "period": "day", "rank": 8, "date": "2020-11-16"}, {"category": "game", "period": "week", "rank": 19, "date": "2020-11-16"}, {"category": "game", "period": "month", "rank": 84, "date": "2020-11-27"}, {"category": "game", "period": "year", "rank": 7, "date": "2013"}, {"category": "game", "period": "total", "rank": 28, "date": "2018-10-11"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ110000/RJ109012_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ110000/RJ109012_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ110000/RJ109012_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ110000/RJ109012_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ110000/RJ109012_img_smp3.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ110000/RJ109012_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ110000/RJ109012_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ110000/RJ109012_img_smp3_100x100.jpg"], "alt": "対魔忍アサギ3 [Lilith [リリス]]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "■リリス10周年記念作品!<br />\r\nシリーズ累計22万本の大ヒット作品がリリス10周年記念作品として“フル”領域で登場!<br />\r\n『2』より6年の時を超えてついに『対魔忍アサギ3』発売!<br />\r\n不撓不屈の対魔忍たちと不死の王エドウィン・ブラックとの死闘が最終局面へ。シリーズのファンはもちろん、『3』からでも楽しめる危険アヘすぎる近未来くノ一調教アドベンチャー!!!<br />\r\n<br />\r\n■気高く美しき対魔忍たちは魔の姦計に惨めなるアヘ地獄へ堕とされる!<br />\r\nシリーズお馴染みのリョナ表現やりんかん、肉体改造をはじめ、“新”闇の闘技場で行われる公開懲罰責めや催○奴○となっての『操作』『書換』などの恥辱シチュエーションの数々を110種類以上、500枚以上のビジュアル&amp;差分、総ビジュアル数1800点以上のリリス最高ボリュームで描く!<br />\r\n<br />\r\n■最強の対魔忍アサギを追い込む最凶の姦計!<br />\r\nエドウィン・ブラックはアサギを絶望へ追い込むため、全てを奪おうと邪悪なる姦計を巡らせる!<br />\r\nさくらと紫は豚のように扱われ不撓不屈の精神で逆らうも再起不能な肉体改造を施され闇のオークションへ、また守るべきものたちは悉く処刑され、自らは闇の闘技場で恥辱に塗れながら最も軽蔑すべきものたちの催○奴○として仔まで孕ませる事に……!　シリーズ最凶の地獄に無様な死か!?　恥辱に塗れた狂おしい生か!?　アサギの運命は如何に!?<br />\r\n<br />\r\n■スタッフ<br />\r\n企画\t\t:笹山逸刀斎<br />\r\n原作\t\t:笹山逸刀斎<br />\r\n原画\t\t:カガミ、葵渚<br />\r\nシナリオ\t:そのだまさき<br />\r\nサブシナリオ\t:笹山逸刀斎、フレーム、松本竜、ZEQU<br />\r\nグラフィック\t:チームリリスオールスターズ<br />\r\n背景美術\t:C'est moi<br />\r\n音楽\t\t:六弦A助(六弦アリス)<br />\r\n演出\t\t:巫浄スウ、EDEN<br />\r\n監督\t\t:笹山逸刀斎<br />\r\n<br />\r\n■キャスト<br />\r\n井河アサギ:中瀬ひな<br />\r\n甲河アスカ:手塚りょうこ<br />\r\n井河さくら:黒岩心々<br />\r\n八津紫:水瀬沙季<br />\r\n朧:児玉さとみ<br />\r\nイングリッド:榊木春乃<br />\r\n<br />\r\n詳細は<br />\r\n↓↓↓<br />\r\n<a href=\"http://www.lilith-soft.com/anime/product10/index.html\" target=\"_blank\">http://www.lilith-soft.com/anime/product10/index.html</a><br />\r\n<br />\r\n--<br />\r\n<br />\r\nサポート用メールアドレス: support@lilith-soft.com"}]}, {"type": "image_list", "title": "キャラクター紹介", "body": [{"intro": "井河アサギ（CV:中瀬ひな）<br />\r\n<br />\r\n本作の主人公。<br />\r\n対魔忍を率いる隊長にして最強の対魔忍と目されている正義のくノ一。<br />\r\n自身も死闘の中で朧に囚われ、邪悪な魔界医療技術によって肉体を淫らに改造されるも、６年前に捕虜にした魔科医・桐生の手によって元の肉体に治療される。<br />\r\n天才的な剣術と体術、人知を超える光速のスピードが武器。<br />\r\nまた、東京キングダムの死闘では対魔忍の中に潜む魔の力に覚醒し、<br />\r\nその能力を格段に向上させて「隼の術」極意を体得する。<br />\r\n政府によって設立された対魔忍養成学校・五車学園の校長を務めている。<br />\r\n肉親を亡くした遺児、沢木浩介と甲河アスカを引き取り育てる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ110000/RJ109012/RJ109012_PTS0000003642_1.jpg", "alt": "対魔忍アサギ3 [Lilith [リリス]]", "title": "対魔忍アサギ3 [Lilith [リリス]]"}}, {"intro": "甲河アスカ（CV:手塚りょうこ）<br />\r\n<br />\r\n孤高の“抜け”対魔忍。<br />\r\n忍びの名門・甲河家の若き当主であり唯一の生き乗り。<br />\r\n14の時には頭角を現し、対魔忍として認められてさくら、<br />\r\n紫とともに危険な任務に投入され多くの戦果をあげる。<br />\r\nしかしエドウィン・ブラックに単身挑むが敗北して両腕両脚に重傷を負い、その後失踪して抜け忍となる。<br />\r\n長らく行方不明であった彼女だが、ある時、両腕に義手＜アンドロイド・アーム＞両脚に義足＜アンドロイド・レッグ＞をした姿で復活を果たし、人魔問わず闇の勢力に加担するものを次々と葬ってゆく事に。<br />\r\n得物はアンドロイドアーム＆レッグの中に仕込まれた鎌状の対魔ブレード。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ110000/RJ109012/RJ109012_PTS0000003642_2.jpg", "alt": "対魔忍アサギ3 [Lilith [リリス]]", "title": "対魔忍アサギ3 [Lilith [リリス]]"}}, {"intro": "井河さくら（CV:黒岩心々）<br />\r\n<br />\r\nアサギの妹。<br />\r\nいつも明るく陽気で人懐っこい印象を受ける美女。<br />\r\n当初、アサギには対魔忍となる事を反対されていたが、<br />\r\n姉のように正義のために戦いたいとアサギの反対を押し切って対魔忍となる。<br />\r\nその後、カオス・アリーナ、東京キングダムでの死闘ではよく姉を助け、目立たないが優秀な対魔忍として、その名を連ねるまでに。<br />\r\n姉同様、カオス・アリーナで淫らな改造を受けたが桐生の手によって治癒している。<br />\r\n五車学園で教師を務めている。<br />\r\n得物は忍者小太刀の二刀流。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ110000/RJ109012/RJ109012_PTS0000003642_3.jpg", "alt": "対魔忍アサギ3 [Lilith [リリス]]", "title": "対魔忍アサギ3 [Lilith [リリス]]"}}, {"intro": "八津紫（CV:水瀬沙季）<br />\r\n<br />\r\n対魔忍の一人。<br />\r\n戦闘能力はアサギに次ぐと目されているクール美女。<br />\r\nアサギが頭領を務める一派の下忍の出。兄は同じく対魔忍の八津九郎。<br />\r\n政府によって設立された対魔忍養成学校・五車学園で教師も務める。<br />\r\n得物の大斧を軽々と操る。<br />\r\nアサギに憧れ以上の強い感情を抱いており、<br />\r\nクールな彼女もアサギの前ではシドロモドロになる。<br />\r\nアサギに対してだけガチレズ。<br />\r\n子供の頃の将来の夢はアサギお姉さまの妹になること。<br />\r\n本当に妹であるさくらに対して強いコンプレックスを持っていて、何かときつく当たっている。<br />\r\nある任務で魔科医・桐生と死闘の末に桐生を捕虜にする。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ110000/RJ109012/RJ109012_PTS0000003642_4.jpg", "alt": "対魔忍アサギ3 [Lilith [リリス]]", "title": "対魔忍アサギ3 [Lilith [リリス]]"}}]}, {"type": "image", "title": "サンプル画像", "body": [{"intro": "【追加分】サンプル画像", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ110000/RJ109012/RJ109012_PTS0000003720_0.jpg", "alt": "対魔忍アサギ3 [Lilith [リリス]]", "title": "対魔忍アサギ3 [Lilith [リリス]]"}, "position": "top"}]}, {"type": "image", "title": "サンプル画像", "body": [{"intro": "【追加分】サンプル画像", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ110000/RJ109012/RJ109012_PTS0000003721_0.jpg", "alt": "対魔忍アサギ3 [Lilith [リリス]]", "title": "対魔忍アサギ3 [Lilith [リリス]]"}, "position": "top"}]}], "description": "シリーズ累計22万本の大ヒット作品がリリス10周年記念作品として“フル”領域で登場!", "short_introduction": "シリーズ累計22万本の大ヒット作品がリリス10周年記念作品として“フル”領域で登場!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ109012.html", "site_id": "maniax", "fetched_at": 1794968997}