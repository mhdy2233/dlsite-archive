{"id": "RJ113583", "title": "姪ッ娘3DKit", "title_romaji": "meikkosuriidhikitto", "circle": {"id": "RG10078", "name": "第一実験室", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG10078.html"}, "type": {"code": "ADV", "name": "アドベンチャー", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 1650, "official_jpy": 1650, "currencies": {"USD": 10.35242802082281, "EUR": 9.413294995550078, "GBP": 7.841605276402329, "TWD": 340.9513576063148, "CNY": 69.1151584203207, "KRW": 13830.67896060352, "IDR": 189241.88553733227, "VND": 266214.9080348499, "THB": 350.281286487634, "SEK": 104.74261881939198, "HKD": 81.22796998995727, "SGD": 13.34313447210921, "CAD": 14.79969288394888, "MYR": 42.377996316966865, "BRL": 59.92395105847488, "AUD": 15.367335192315215, "PHP": 659.9208095028596, "MXN": 190.91698004049755, "NZD": 18.830672312064184, "INR": 968.0258140217073}}, "point": {"point_amount": 90, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1365778800, "file": {"type": "EXE", "size": 2785243821}, "tags": [{"key": "509", "name": "3D作品"}, {"key": "073", "name": "アニメ"}, {"key": "212", "name": "妹"}, {"key": "206", "name": "少女"}, {"key": "208", "name": "ぷに"}, {"key": "207", "name": "つるぺた"}, {"key": "074", "name": "制服"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 3.89, "count": 185}, "review_count": 1, "dl_count": 373, "wishlist_count": 239, "ranking": [], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ114000/RJ113583_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ114000/RJ113583_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ114000/RJ113583_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ114000/RJ113583_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ114000/RJ113583_img_smp3.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ114000/RJ113583_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ114000/RJ113583_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ114000/RJ113583_img_smp3_100x100.jpg"], "alt": "姪ッ娘3DKit [第一実験室]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "傷が癒えるまで楽しい山田屋家で過す事になった叔父…<br />\r\nしかし…<br />\r\n姪姉妹家族と彼には秘密があった<br />\r\n好意を寄せる姪姉妹家族と叔父の行く末は…<br />\r\n<br />\r\nキャラクターボイス:口谷亜夜、織田リコ、撫子、月下美玖<br />\r\nサークル:パイプで大暴れより販売中の姪ッ娘5〜疑惑編〜(RJ076857)が…、3Dアニメーションノベルゲームとなって復活!?フラグを起てる事によって開放されるふり〜えっちモードを完備しており、自由に観覧、様々な視点から見る事もできます。また、ふり〜えっちモードには本編に無いシュチュエーションも用意されており、開放されれば更に多くのアニメを楽しむ事が出来ます。<br />\r\n<br />\r\n過去作品=作品番号RJ076857とテキスト部分及び音声が一部重複しております。<br />\r\nCGは全て新規の3Dアニメとなり、本作品は未リリースの〜解決編〜等、その他の要素を追加アップデートファイルとして販売しています。<br />\r\n<br />\r\n下記URLに画像サンプル等、沢山ありますので興味のある方は来て見てください。<br />\r\nよろしくお願いします!　<a href=\"http://ieame.x.fc2.com/index3.htm\" target=\"_blank\">http://ieame.x.fc2.com/index3.htm</a><br />\r\n<br />\r\n■動作環境■<br />\r\n CPU     : Pentium 以降<br />\r\n OS      : Windows XP以降<br />\r\n VIDEO   : 65536 色以上<br />\r\n DirectX 9 以降が導入されている環境を推奨します。"}]}, {"type": "image_list", "title": "山田屋　琴子(姪姉妹の姉)", "body": [{"intro": "■山田屋　琴子　(やまだや　ことこ)<br />\r\ncv.口谷亜夜<br />\r\n双子の姪姉妹の姉、お兄ちゃん(叔父)が大好きなちょっと太めの元気な女の子。<br />\r\n高学年の頃から大きくなり始めた胸はお母さんに追いつきそうな勢い…身体の方も太くなり始め焦り始める年頃の女の子。<br />\r\n友達と楽しく過せる学校生活にこれといった不満も無く、明るく元気に過している。(成績はあまり良くないが)", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ114000/RJ113583/RJ113583_PTS0000003823_1.jpg", "alt": "姪ッ娘3DKit [第一実験室]", "title": "姪ッ娘3DKit [第一実験室]"}}, {"intro": "フラグを起てる事によって開放されるふり〜えっちモードを完備しており、", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ114000/RJ113583/RJ113583_PTS0000003823_2.jpg", "alt": "姪ッ娘3DKit [第一実験室]", "title": "姪ッ娘3DKit [第一実験室]"}}, {"intro": "自由に観覧、様々な視点から見る事もできます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ114000/RJ113583/RJ113583_PTS0000003823_3.jpg", "alt": "姪ッ娘3DKit [第一実験室]", "title": "姪ッ娘3DKit [第一実験室]"}}, {"intro": "また、ふり〜えっちモードには本編に無いシュチュエーションも用意されており、", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ114000/RJ113583/RJ113583_PTS0000003823_4.jpg", "alt": "姪ッ娘3DKit [第一実験室]", "title": "姪ッ娘3DKit [第一実験室]"}}]}, {"type": "image_list", "title": "山田屋　鈴子(姪姉妹の妹)", "body": [{"intro": "■山田屋　鈴子　(やまだや　すずこ)<br />\r\ncv.口谷亜夜<br />\r\n双子の姪姉妹の妹、お兄ちゃんが気になる真面目な女の子。<br />\r\n髪はピッグテール、姉と比べるとスマートだが胸はそれなりにあって、美少女キャラ的な感じ。小さな時から可愛いとか、良い子とか、言われて育ち、優等生的で真面目な印象を持つように育った。(学業成績優秀)<br />\r\nその反面、「いつも退屈で飽き飽き」とも思いながらも普通に過してきた。突飛な事を考えたり行動に移す事も間々有るが、普段はその世間体感や社会性感の抑圧から、人前ではその行動を控えている事が多い…　本当は好奇心旺盛で突飛な少女だが、それを抑えて今までの日々を生活していた。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ114000/RJ113583/RJ113583_PTS0000003824_1.jpg", "alt": "姪ッ娘3DKit [第一実験室]", "title": "姪ッ娘3DKit [第一実験室]"}}, {"intro": "開放されれば更に多くのアニメを楽しむ事が出来ます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ114000/RJ113583/RJ113583_PTS0000003824_2.jpg", "alt": "姪ッ娘3DKit [第一実験室]", "title": "姪ッ娘3DKit [第一実験室]"}}, {"intro": "当初は完全版として復活、全ての内容を収めるつもりでしたが、", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ114000/RJ113583/RJ113583_PTS0000003824_3.jpg", "alt": "姪ッ娘3DKit [第一実験室]", "title": "姪ッ娘3DKit [第一実験室]"}}, {"intro": "アニメシーン満載で容量約1.91Gでも半分しか入りませんでした。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ114000/RJ113583/RJ113583_PTS0000003824_4.jpg", "alt": "姪ッ娘3DKit [第一実験室]", "title": "姪ッ娘3DKit [第一実験室]"}}]}, {"type": "image_list", "title": "その他", "body": [{"intro": "その為、前回と同様に分割する運びとなりました(次回アップデートは〜解決編〜予定)。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ114000/RJ113583/RJ113583_PTS0000003825_1.jpg", "alt": "姪ッ娘3DKit [第一実験室]", "title": "姪ッ娘3DKit [第一実験室]"}}, {"intro": "〜解決編〜の前にもマイナーアップデートにてアニメを追加する予定がありますので、そちらも楽しむ事が出来る予定。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ114000/RJ113583/RJ113583_PTS0000003825_2.jpg", "alt": "姪ッ娘3DKit [第一実験室]", "title": "姪ッ娘3DKit [第一実験室]"}}, {"intro": "ホームページに画像サンプル等、沢山ありますので興味のある方は来て見てください。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ114000/RJ113583/RJ113583_PTS0000003825_3.jpg", "alt": "姪ッ娘3DKit [第一実験室]", "title": "姪ッ娘3DKit [第一実験室]"}}, {"intro": "よろしくお願いします!　<a href=\"https://ci-en.dlsite.com/creator/3487\" target=\"_blank\">https://ci-en.dlsite.com/creator/3487</a>", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ114000/RJ113583/RJ113583_PTS0000003825_4.jpg", "alt": "姪ッ娘3DKit [第一実験室]", "title": "姪ッ娘3DKit [第一実験室]"}}]}], "description": "傷が癒えるまで楽しい山田屋家で過す事になった叔父…しかし…姪姉妹家族と彼には秘密があった。好意を寄せる姪姉妹家族と叔父の行く末は…", "short_introduction": "傷が癒えるまで楽しい山田屋家で過す事になった叔父…しかし…姪姉妹家族と彼には秘密があった。好意を寄せる姪姉妹家族と叔父の行く末は…", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ113583.html", "site_id": "maniax", "fetched_at": 1794968785}