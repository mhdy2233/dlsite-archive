{"id": "RJ145373", "title": "星屑", "title_romaji": "hoshikuzu", "circle": {"id": "RG21771", "name": "RPGつくり隊", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG21771.html"}, "type": {"code": "RPG", "name": "ロールプレイング", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 1650, "official_jpy": 1650, "currencies": {"USD": 10.35242802082281, "EUR": 9.413294995550078, "GBP": 7.841605276402329, "TWD": 340.9513576063148, "CNY": 69.1151584203207, "KRW": 13830.67896060352, "IDR": 189241.88553733227, "VND": 266214.9080348499, "THB": 350.281286487634, "SEK": 104.74261881939198, "HKD": 81.22796998995727, "SGD": 13.34313447210921, "CAD": 14.79969288394888, "MYR": 42.377996316966865, "BRL": 59.92395105847488, "AUD": 15.367335192315215, "PHP": 659.9208095028596, "MXN": 190.91698004049755, "NZD": 18.830672312064184, "INR": 968.0258140217073}}, "point": {"point_amount": 90, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1472569200, "file": {"type": "EXE", "size": 733177596}, "tags": [{"key": "317", "name": "人外娘/モンスター娘"}, {"key": "207", "name": "つるぺた"}, {"key": "440", "name": "浮気"}, {"key": "048", "name": "寝取られ"}, {"key": "324", "name": "異種えっち"}, {"key": "134", "name": "屈辱"}, {"key": "121", "name": "回し"}, {"key": "113", "name": "合意なし"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 4.24, "count": 5144}, "review_count": 65, "dl_count": 10291, "wishlist_count": 7034, "ranking": [{"category": "all", "period": "day", "rank": 1, "date": "2016-08-31"}, {"category": "all", "period": "week", "rank": 1, "date": "2016-09-03"}, {"category": "all", "period": "month", "rank": 4, "date": "2016-09-25"}, {"category": "all", "period": "year", "rank": 91, "date": "2016"}, {"category": "game", "period": "year", "rank": 53, "date": "2016"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ146000/RJ145373_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ146000/RJ145373_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ146000/RJ145373_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ146000/RJ145373_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ146000/RJ145373_img_smp3.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ146000/RJ145373_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ146000/RJ145373_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ146000/RJ145373_img_smp3_100x100.jpg"], "alt": "星屑 [RPGつくり隊]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "最新版はver1.90です!<br />\n攻略情報やリクエストに関する質問は、ブログにお願いします。<br />\n<a href=\"https://yuruyururpg.fanbox.cc/\" target=\"_blank\">https://yuruyururpg.fanbox.cc/</a><br />\n<br />\n●えっちなことができる、王道長編RPGです。<br />\n<br />\nヒロインに関しては純愛・寝取られ・覗き・(他の男に)触られ・陵○他。<br />\nプレイヤーはモン娘・姫・○リ系・天使・人魚・巨乳っ娘等、<br />\n色んな女の子たちと浮気ができます。<br />\n浮気をするかどうかは、プレイヤーの自由です。<br />\n(体験版では、一部のHシーンと<br />\n　二人の旅立ちまでをプレイできます)<br />\nH関連の基本CG枚数は70枚以上です。<br />\n差分や立ち絵等も含めると100枚以上になります。<br />\n<br />\n●作品としてのテーマ<br />\n『純愛を経てからの寝取られ』です。<br />\nプレイヤーの行動が最適ではなかった場合、<br />\n本編後半で、ヒロインの心身は汚されていきます。<br />\n<br />\n※純愛を貫くことも可能です(難易度高)。<br />\n※前半でもヒロインが触られる展開がありますが、必須イベントではありません。<br />\n※EDは、バッド/グッドの二種類です。<br />\n　作品の趣旨として、普通のプレイングでは<br />\n　ほとんどの方がバッドエンドになるであろう<br />\n　難易度調整をしてあります。<br />\n<br />\n　&lt;長旅を通じて、<br />\n　 プレイヤーとヒロインは確固たる純愛で結ばれる。<br />\n　 だが、終盤二人は引き裂かれ――&gt;<br />\n<br />\n※両方のエンドを見るための総プレイ時間は、20時間前後が予想されます。<br />\n<br />\n●ゲームシステム<br />\n・スター○ーシャンシリーズに代表される、<br />\n　PA(仲間が街で『自由行動』する)システムに<br />\n　近いものを採用しています。<br />\n　『自由行動』とは、いったんパーティを解除し、<br />\n　仲間キャラもプレイヤーも一人で街を楽しめるモードです。<br />\n　仲間と話したり、街のなかで特別なイベントが起こったり……<br />\n　パーティ状態では体験できない何かが起こるかもしれません。<br />\n　また、街を出ると自動的にパーティに戻ります。<br />\n・バトル時、『合成技』という項目があります。<br />\n　これは、仲間の持つスキルを組み合わせて、<br />\n　新たな一つの技を発動させるものです。<br />\n　代表として一人のキャラが発動させます。<br />\n・戦闘不能状態はバトル後回復します(HP1)が、<br />\n　バトル中に全員が戦闘不能になると<br />\n　一部の特別な戦闘を除いてゲームオーバーです。<br />\n・ある特殊な森では、自分が常にどの方向を向いているか<br />\n　慎重に把握しながら進むことをおすすめします。　<br />\n・Hシーンにおける断面図は、on/offが可能です。<br />\n　デフォルトではonになっているので、<br />\n　offにしたい場合、最初から持っている<br />\n　『断面図ON/OFF』アイテムをご使用ください。<br />\n・ver1.12にて、システムセーブを搭載しました!<br />\n・メッセージスキップ機能有り。<br />\n・今回は、Hシーンの演出にウェイトがかかっておらず、<br />\n　スキップしやすい仕様になっています。<br />\n・クリア後、データを引き継ぐかたちで、<br />\n　『つよくてニューゲーム』が可能です。<br />\n・過去作のキャラも少し登場しますが、<br />\n　該当作を未プレイでも、本作は問題なくお楽しみいただけます。<br />\n・長編なので、特にじっくり遊びたい方にお勧めです。<br />\n<br />\n※体験版がほぼチュートリアルになっているので、<br />\n実際にプレイしながらご確認いただければと思います。<br />\nまた、より詳細な情報は同梱のReadme.txtをご覧ください。<br />\n<br />\n※このゲームはRPGツクールVXaceで製作しています。<br />\n　プレイするにはRPGツクールVXaceのRTP(無料)が必要です。<br />\n<br />\n※現段階では、体験版からの、<br />\n製品版へのセーブデータ引き継ぎはサポートしておりません。<br />\n(現行の体験版では、どれだけレベルを上げても、<br />\n最低限のスキルしか修得できません)"}]}, {"type": "image_list", "title": "星屑　登場人物", "body": [{"intro": "ヒロインです。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ146000/RJ145373/RJ145373_PTS0000011084_1.jpg", "alt": "星屑 [RPGつくり隊]", "title": "星屑 [RPGつくり隊]"}}, {"intro": "サブヒロインたちです。全員H関連のシーンがあります。<br />\r\n本編では、この他にも色々な女の子が登場します。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ146000/RJ145373/RJ145373_PTS0000011084_2.jpg", "alt": "星屑 [RPGつくり隊]", "title": "星屑 [RPGつくり隊]"}}]}, {"type": "image", "title": "世界マップ", "body": [{"intro": "『星屑』の世界マップです。<br />\r\n前半はこのマップを巡りながら冒険をしていきます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ146000/RJ145373/RJ145373_PTS0000011108_0.jpg", "alt": "星屑 [RPGつくり隊]", "title": "星屑 [RPGつくり隊]"}, "position": "under"}]}], "description": "純愛を経てこそ、寝取られが輝く。あなたは、彼女を守れますか? モン娘・姫・○リ系・天使・人魚・巨乳っ娘他、様々な相手と浮気も可能。自由行動・合成技システム。", "short_introduction": "純愛を経てこそ、寝取られが輝く。あなたは、彼女を守れますか? モン娘・姫・○リ系・天使・人魚・巨乳っ娘他、様々な相手と浮気も可能。自由行動・合成技システム。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ145373.html", "site_id": "maniax", "fetched_at": 1794965585}