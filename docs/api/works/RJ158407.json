{"id": "RJ158407", "title": "ID -identity-Rewrite", "title_romaji": "aidhiiaidenthithiriraito", "circle": {"id": "RG30391", "name": "neoProtocol", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG30391.html"}, "type": {"code": "ADV", "name": "アドベンチャー", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 1980, "official_jpy": 1980, "currencies": {"USD": 12.422913624987373, "EUR": 11.295953994660096, "GBP": 9.409926331682794, "TWD": 409.14162912757774, "CNY": 82.93819010438483, "KRW": 16596.814752724225, "IDR": 227090.26264479873, "VND": 319457.88964181993, "THB": 420.33754378516085, "SEK": 125.69114258327038, "HKD": 97.47356398794874, "SGD": 16.01176136653105, "CAD": 17.759631460738657, "MYR": 50.85359558036024, "BRL": 71.90874127016986, "AUD": 18.440802230778257, "PHP": 791.9049714034315, "MXN": 229.10037604859704, "NZD": 22.59680677447702, "INR": 1161.6309768260487}}, "point": {"point_amount": 108, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1454166000, "file": {"type": "EXE", "size": 1906271737}, "tags": [{"key": "296", "name": "シリーズもの"}, {"key": "022", "name": "サスペンス"}, {"key": "015", "name": "シリアス"}, {"key": "016", "name": "ファンタジー"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 4.35, "count": 93}, "review_count": 2, "dl_count": 294, "wishlist_count": 239, "ranking": [], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ159000/RJ158407_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ159000/RJ158407_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ159000/RJ158407_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ159000/RJ158407_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ159000/RJ158407_img_smp3.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ159000/RJ158407_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ159000/RJ158407_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ159000/RJ158407_img_smp3_100x100.jpg"], "alt": "ID -identity-Rewrite [neoProtocol]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "---------------------------------------------------------------------<br />\r\nシーン追加・再演出アップデート「ID-Identity-Rewrite」適用済み<br />\r\n---------------------------------------------------------------------<br />\r\n<br />\r\n緑桐学園に通う秋月修二。<br />\r\n1週間の停学を終え、再び代わり映えのしない日々へ戻ろうとしていた。<br />\r\n<br />\r\nだが……ある時を境に日常は崩れ去り、それは確実な歪みとして表面化し始める。<br />\r\n<br />\r\n違和感に蝕まれていく世界の中で、<br />\r\n彼と彼の周りの人達は「自分らしさ」を守れるのだろうか。<br />\r\n<br />\r\n──いつからか雲に覆われてしまった空の下、<br />\r\n　　彼の日常たる「咲深町」を揺るがす出来事が今始まろうとしていた。<br />\r\n<br />\r\n<br />\r\n・綿密に作りこまれた設定、世界観を元に繰り広げられる物語<br />\r\n<br />\r\n・主人公以外フルボイス(男女共)<br />\r\n<br />\r\n・CG枚数　60枚以上(差分含まず)<br />\r\n<br />\r\n・環境に依存しないAdobeAIRベースの独自ゲームエンジンを採用<br />\r\n<br />\r\n・!!作品中、一部流血など過激な表現が含まれます!!"}]}, {"type": "image_list", "title": "キャラクター紹介", "body": [{"intro": "秋月　修二<br />\r\n<br />\r\n本編の主人公。緑桐学園の2年。<br />\r\n<br />\r\n<br />\r\n2学期が始まって早々に問題を起こし、停学処分を受けていた。<br />\r\n沙良や健吾など気心の知れた相手以外との会話になると、途端に口ベタになるため周囲から誤解されやすい。<br />\r\nただし、気心知れた相手にはかなり義理堅い。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ159000/RJ158407/2d220f654bb3b61823a37e9518b61fc8.jpg", "alt": "ID -identity-Rewrite [neoProtocol]", "title": "ID -identity-Rewrite [neoProtocol]"}}, {"intro": "松本　沙良　CV.杏樹<br />\r\n<br />\r\n緑桐学園の2年。修二と同じクラスのクラスメート。<br />\r\n<br />\r\n<br />\r\n才色兼備の優等生で男女問わず人気が高く、教師受けもいい。<br />\r\n修二とまともな会話が成立する数少ない女子で、<br />\r\nよく行動を共にするため二人の間柄の噂は絶えない。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ159000/RJ158407/c1d3e799071f4f04b74a1460c14f4624.jpg", "alt": "ID -identity-Rewrite [neoProtocol]", "title": "ID -identity-Rewrite [neoProtocol]"}}, {"intro": "宮田　健吾　CV.真堂隼人<br />\r\n<br />\r\n緑桐学園の2年。修二と同じクラスのクラスメートかつ、悪友。<br />\r\n<br />\r\n<br />\r\n一見チャラい印象の見た目だが、実際にチャラい。<br />\r\n修二とは対照的に交友関係は広く、ムードメーカー的な存在。<br />\r\n可愛い子ランキングから時事ニュース等々、情報通の一面も。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ159000/RJ158407/56fa03889a4b07a91ee278a0331d468e.jpg", "alt": "ID -identity-Rewrite [neoProtocol]", "title": "ID -identity-Rewrite [neoProtocol]"}}, {"intro": "有坂　未央　CV.井上こころ<br />\r\n<br />\r\n緑桐学園の3年。<br />\r\n<br />\r\n<br />\r\n日本人離れした美貌の持ち主で、憧れる女子も多い。<br />\r\nまた想いを寄せる男子も多く、告白された回数は学園一。<br />\r\n口数が少なく、いつもツンとして愛想がない。<br />\r\n<br />\r\n特に修二とはお互いを苦手としているが、<br />\r\n何故かよく顔を合わせる。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ159000/RJ158407/761297f5bbca751b0cd567bea8e176c8.jpg", "alt": "ID -identity-Rewrite [neoProtocol]", "title": "ID -identity-Rewrite [neoProtocol]"}}]}, {"type": "image_list", "title": "キャラクター紹介2", "body": [{"intro": "アニス　CV.鹿瀬紫卯<br />\r\n<br />\r\n緑桐学園の1年。<br />\r\n<br />\r\n<br />\r\n修二に話しかける数少ない後輩の一人。<br />\r\n明るく元気で積極的、思った事がすぐ口から出てしまう性格。<br />\r\nその為、暴走してしまう事もある。<br />\r\nクラスメイトで仲の良い早苗とは、大体ワンセット。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ159000/RJ158407/5c96d4cfc846f33110a62b7b43b61a89.jpg", "alt": "ID -identity-Rewrite [neoProtocol]", "title": "ID -identity-Rewrite [neoProtocol]"}}, {"intro": "尾田　早苗　CV.美咲桃子<br />\r\n<br />\r\n緑桐学園の1年。<br />\r\n<br />\r\n<br />\r\n修二に話しかける?　数少ない後輩の一人。<br />\r\n気が弱く、引っ込み思案だが、芯を持った頑張り屋さん。<br />\r\n密かに修二に対して、淡い恋心を抱いている。<br />\r\nだが、殆ど会話が成立せずに、謝って逃げ出してしまう事が悩み。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ159000/RJ158407/ded36602f2f34e38ade63d4220fd1673.jpg", "alt": "ID -identity-Rewrite [neoProtocol]", "title": "ID -identity-Rewrite [neoProtocol]"}}, {"intro": "北原　綾　CV.長瀬ゆずは<br />\r\n<br />\r\n緑桐学園の2年。修二が停学中に転校してきた。<br />\r\n<br />\r\n<br />\r\n物腰柔らかく、上品な立ち振る舞いで、<br />\r\n転校して早々に男子生徒から絶大な支持を得ている。<br />\r\nしかし、完璧過ぎて女生徒からはやや敬遠されている側面もある。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ159000/RJ158407/9f24b65e693c8596dd3dbc83d22ae7f3.jpg", "alt": "ID -identity-Rewrite [neoProtocol]", "title": "ID -identity-Rewrite [neoProtocol]"}}, {"intro": "佐伯　香織　CV.南村留伊<br />\r\n<br />\r\n緑桐学園　理事長代理。<br />\r\n<br />\r\n<br />\r\n大人の女性で寛容な精神の持ち主。<br />\r\n学園の問題児である修二を頭から否定しない良き理解者。<br />\r\n公私にわたり修二にサポートや助言を施す等接点は多いものの、<br />\r\n彼女の持つ独特な世界観は、付き合いが古い修二にも<br />\r\n理解出来ない事がある。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ159000/RJ158407/20f43ad1da50879ab95f82c4825b86c6.jpg", "alt": "ID -identity-Rewrite [neoProtocol]", "title": "ID -identity-Rewrite [neoProtocol]"}}]}, {"type": "image_list", "title": "キャラクター紹介3", "body": [{"intro": "テッド(エドワード・フラットマン)　CV.畑耕平<br />\r\n<br />\r\n咲深町を訪れているフリージャーナリスト。<br />\r\n<br />\r\n<br />\r\n人懐っこくておしゃべり好きな外国人。<br />\r\n日本語は完璧に習得していて日常会話どころか<br />\r\n多少込み入った話でも流暢にこなしてしまう。<br />\r\n<br />\r\n特に女の子との会話を好み、仕事を忘れてしまうことも。<br />\r\n<br />\r\nしかし、仕事となると強力な独自の情報網を武器に<br />\r\nどんな記者にも負けたりはしない。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ159000/RJ158407/c2c30401440d84d275e822c7e1552e56.jpg", "alt": "ID -identity-Rewrite [neoProtocol]", "title": "ID -identity-Rewrite [neoProtocol]"}}, {"intro": "リグレット　CV.秋篠ナナメ<br />\r\n<br />\r\n神出鬼没な銀髪の青年。<br />\r\n<br />\r\n<br />\r\n彼の素性は不明だが、犬を探しているところを目撃されている。<br />\r\n飄々とした掴みどころのない性格をしており、<br />\r\n独特な思考や喋り口で、人をけむにまくような事を好む。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ159000/RJ158407/fb3cde134b1afabaea9714c4bce0d05d.jpg", "alt": "ID -identity-Rewrite [neoProtocol]", "title": "ID -identity-Rewrite [neoProtocol]"}}, {"intro": "シルエラ　CV.水野うみ<br />\r\n<br />\r\n時折病院で見かける少女。<br />\r\n<br />\r\n<br />\r\n一見して快活な少女だがどこか不思議な雰囲気をまとっている。<br />\r\n修二の前に幾度と無く現れ、意味深なことを言って<br />\r\n行方を眩ます不思議な少女。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ159000/RJ158407/575fa37599bf54932ea3dc95cc0addf2.jpg", "alt": "ID -identity-Rewrite [neoProtocol]", "title": "ID -identity-Rewrite [neoProtocol]"}}]}], "description": "違和感に蝕まれていく世界の中で、\r\n彼と彼の周りの人達は「自分らしさ」を守れるのだろうか。", "short_introduction": "違和感に蝕まれていく世界の中で、\r\n彼と彼の周りの人達は「自分らしさ」を守れるのだろうか。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ158407.html", "site_id": "maniax", "fetched_at": 1794966062}