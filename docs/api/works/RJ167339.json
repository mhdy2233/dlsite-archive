: ["ENG"]}], "rating": {"average": 4.38, "count": 5910}, "review_count": 52, "dl_count": 15605, "wishlist_count": 9548, "ranking": [{"category": "all", "period": "day", "rank": 2, "date": "2015-12-23"}, {"category": "all", "period": "week", "rank": 6, "date": "2015-12-26"}, {"category": "all", "period": "month", "rank": 17, "date": "2016-01-16"}, {"category": "all", "period": "year", "rank": 185, "date": "2017"}, {"category": "all", "period": "total", "rank": 472, "date": "2019-01-30"}, {"category": "game", "period": "year", "rank": 132, "date": "2017"}, {"category": "game", "period": "total", "rank": 426, "date": "2018-11-27"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ168000/RJ167339_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ168000/RJ167339_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ168000/RJ167339_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ168000/RJ167339_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ168000/RJ167339_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ168000/RJ167339_img_smp4.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ168000/RJ167339_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ168000/RJ167339_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ168000/RJ167339_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ168000/RJ167339_img_smp4_100x100.jpg"], "alt": "ライジングプレイ [Robi]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "とある体育倉庫で目覚めた一人の少女<br />\nそして始まる狂気の快楽○問<br />\n<br />\n■リアルタイム3D<br />\n本作はリアルタイム3Dによる最高峰のビジュアルを実現。<br />\nリアルタイムならではのカメラワークや直感的なマウス操作でプレイ可能です。<br />\n<br />\n■自動生成モーション<br />\n自動生成モーションによる完全ランダムなキャラクターの動き<br />\nさらに自動カメラ、自動体位切り替えを使って一切繰り返しのないビジュアルを実現。<br />\n<br />\n■組み合わせで多彩なプレイ<br />\n3人のキャラクターを使って責め、受け、陵○等設定可能。<br />\nレズプレイ、ふたなりプレイ、逆レ○プ等も作成可能、ボイスも状況にあわせて変化します。<br />\n<br />\n■大ボリューム<br />\n女性2人、男性1人、を収録。それぞれに着衣、半裸、全裸を選択可能。<br />\n自キャラ不要という方は半透明人間も使用可能です。<br />\nシチュエーションは騎乗位、正乗位、バック、手マン、クンニ、フェラ、手コキ、電マ、バイブの9つがプレイ可能。<br />\n<br />\n■自動プレイ搭載<br />\n自動プレイを使えば動画のように楽しめます。<br />\nさらに簡単なAIを使って自分好みのプレイをさせることもできます。<br />\n<br />\n■2つのゲームモードを用意<br />\nゲームルール重視のシナリオプレイ<br />\n実用と自由度重視のフリープレイ<br />\n<br />\n■VR<br />\n全編VRでプレイ可能!等身大のキャラクターが繰り広げるエッチシーンはまさに圧巻。<br />\n臨場感を出すために冬設定に変更。女の子の吐く息がプレイヤーにかかります。<br />\n対応機種　OculusRiftCV1　　HTC Vive<br />\nOculusTouchやVIVEコントローラーを上下または前後に振ってプレイ(マウスでも操作できます)<br />\n<br />\n■電動オナホ<br />\nCycloneX10に対応<br />\n<a href=\"http://cyclone.co.jp/\" target=\"_blank\">http://cyclone.co.jp/</a><br />\nキャラクターの動きに連動してオナホが動きます。<br />\n<br />\n■MODツール<br />\n自作もしくはネット等で入手した3Dモデルをライジングプレイで遊べるようにします。<br />\nUnityと同梱のMODツールを使ってキャラクターや音声を製作可能です。<br />\nかなり簡単に作ったのでUnity未経験者でもできると思います。詳細は↓<br />\n<a href=\"http://robi.starfree.jp/mod/mod_index.html\" target=\"_blank\">http://robi.starfree.jp/mod/mod_index.html</a><br />\n<br />\n■追加キャラクター<br />\nImagineGirlsよりアイリス、ヴィエンヌ、リナのの3キャラクターを追加<br />\nフリープレイで使用可能。(ボイスは現行キャラと同じになります)<br />\n<br />\n■CV<br />\n桃井子鈴　・・・　津山　恋<br />\n綾風凛花　・・・　雪乃みさと<br />\n月島瞬斗　・・・　相模一樹 <br />\n<br />\n■体験版<br />\n体験版でプレイできるシチュエーションは騎乗位、クンニ、手コキ(ストーリーのみ手マン)となります。<br />\nそれ以外は製品版と同じ内容になります。<br />\n<br />\n■その他<br />\n※ご購入前に体験版での動作確認を強く推奨します。<br />\n※アップデートは再DLとなります。<br />\n<br />\n-------------------------------------------------------------------------------------------<br />\n■追加情報<br />\n・NVIDIA製GPUを搭載していてもパフォーマンスが出ない場合(作者のゲーミングノートで確認)<br />\n⇒CPU内蔵のGPUが使われているようです。以下の方法で対処してください<br />\n「デスクトップ右クリック」→「NVIDIAコントロールパネル」→「3D設定の管理」→「優先するグラフィックプロセッサ」タブで「高パフォーマンスNVIDIAプロセッサ」を選択<br />\n<br />\n・再DLの再にセーブデータを引き継ぐ方法<br />\n本作の以下のフォルダ内のファイルをすべてコピーすることでセーブデータを引き継げます。<br />\nwrithingplay_Data\\StreamingAssets\\_save<br />\nVR版<br />\nwrithingplayVR_Data\\StreamingAssets\\_save"}]}, {"type": "image_list", "title": "キャラクター紹介", "body": [{"intro": "桃井子鈴<br />\r\n生真面目で引っ込み思案なごく普通の一年生。<br />\r\n綾風凜花の罠にかかり体育倉庫で陵○される。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ168000/RJ167339/RJ167339_PTS0000009360_1.jpg", "alt": "ライジングプレイ [Robi]", "title": "ライジングプレイ [Robi]"}}, {"intro": "綾風凜花<br />\r\n生徒会長を務める優等生で生徒たちの憧れ。<br />\r\nしかし正体は少女趣味の異常者である。<br />\r\nライジングという媚薬を使い桃井子鈴を陵○する。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ168000/RJ167339/RJ167339_PTS0000009360_2.jpg", "alt": "ライジングプレイ [Robi]", "title": "ライジングプレイ [Robi]"}}, {"intro": "月島瞬斗<br />\r\nスポーツ万能な学生。<br />\r\n少し口が悪い。<br />\r\n男子生徒らしく悶々とした生活を送っていたが、<br />\r\nある日体育倉庫での一件を目撃。<br />\r\n綾風凜花を脅して今回の異常なプレイに参加。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ168000/RJ167339/RJ167339_PTS0000009360_3.jpg", "alt": "ライジングプレイ [Robi]", "title": "ライジングプレイ [Robi]"}}]}], "description": "とある体育倉庫で目覚めた一人の少女\r\n最高峰のリアルタイム3Dで描かれる狂気の快楽○問", "short_introduction": "とある体育倉庫で目覚めた一人の少女\r\n最高峰のリアルタイム3Dで描かれる狂気の快楽○問", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ167339.html", "site_id": "maniax", "fetched_at": 1794966172}