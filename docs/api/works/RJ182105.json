g": ["ENG"]}], "rating": {"average": 3.86, "count": 621}, "review_count": 6, "dl_count": 1299, "wishlist_count": 1187, "ranking": [{"category": "all", "period": "day", "rank": 6, "date": "2016-08-09"}, {"category": "all", "period": "week", "rank": 17, "date": "2016-08-14"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ183000/RJ182105_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ183000/RJ182105_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ183000/RJ182105_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ183000/RJ182105_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ183000/RJ182105_img_smp3.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ183000/RJ182105_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ183000/RJ182105_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ183000/RJ182105_img_smp3_100x100.jpg"], "alt": "サキュバスナイトメア [Animism]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "&lt;Ver1.02にバージョンアップしました&gt;<br />\r\n<br />\r\n・回想モードでサキュバスの前に行くと体位が表示されるようになりました。<br />\r\n<br />\r\n<br />\r\n&lt;Ver1.01にバージョンアップしました&gt;<br />\r\n<br />\r\n・移動速度(難易度)を変更できるようにしました。<br />\r\n・エッチシーンを2種類追加しました。<br />\r\n<br />\r\n<br />\r\n★概要<br />\r\n<br />\r\n夢の世界で迫りくるサキュバスから逃走し、現実世界を目指すゲームです。<br />\r\n<br />\r\nサキュバスに捕まると、快楽攻撃を受け搾り取られてしまいます。<br />\r\n<br />\r\n<br />\r\n★システム<br />\r\n<br />\r\nアクションRPGに近い作りになっています。<br />\r\n<br />\r\nゲームはサキュバスから逃走しながら進めていきます。<br />\r\n<br />\r\nサキュバスに捕まるとエッチシーンが始まります。<br />\r\n<br />\r\nエッチシーンは全てアニメーションで進行し、シーン中はフルボイスとなっています。<br />\r\n<br />\r\nエッチシーンを続けるかどうかは任意のタイミングで選択でき、<br />\r\n射精させられるとゲームオーバーになります。<br />\r\n<br />\r\nダンジョンは全部で50フロアあります。<br />\r\n<br />\r\n回想モードを搭載しています。<br />\r\n<br />\r\nゲームクリア後は、取りこぼしたシーンも含めて全て解放されます。<br />\r\n<br />\r\n回想モードではエッチシーンの数が非常に多いので、驚かれるかも知れません。<br />\r\n<br />\r\n<br />\r\n★エッチシーン<br />\r\n<br />\r\nエッチシーンは全て、なめらかな3Dアニメーション+フルボイスで進行します。<br />\r\n<br />\r\n同じアングルは含めず、100種類以上のアニメーションとエッチシーンがあります。<br />\r\n<br />\r\nエッチのシチュエーションは、<br />\r\nフェラ、パイズリ、足コキ、69、騎乗位、座位など、他にも多数存在します。<br />\r\n<br />\r\nエッチシーンのアニメーションは途中で止まることはなく、<br />\r\nノンストップで永遠に行われます。<br />\r\n<br />\r\n任意のタイミングで射精できるので、実用性を重視する方には便利かと思います。<br />\r\n<br />\r\n<br />\r\n★その他<br />\r\n<br />\r\n多数のエッチシーンを搭載しています。<br />\r\n<br />\r\n1本のソフトで多くのエッチを楽しみたいという方には、ご満足頂けるかと思います。<br />\r\n<br />\r\n逆レ○プ、搾り取られるのが好きなど、Mシチュがお好きな方にお勧めできる作品です。<br />\r\n<br />\r\n本作品は、Wolf RPG エディターを使用し制作されています。<br />\r\n動作はこちらのソフトに準拠します。<br />\r\n<br />\r\n体験版を用意しました。<br />\r\n動作確認のためにも、まずは体験版からプレイすることをお勧めします。"}]}], "description": "サキュバスに搾り取られるゲームです。アニメーションでエッチシーンを見たい方にお勧め!", "short_introduction": "サキュバスに搾り取られるゲームです。アニメーションでエッチシーンを見たい方にお勧め!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ182105.html", "site_id": "maniax", "fetched_at": 1794965629}