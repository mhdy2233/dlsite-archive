amples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ191000/RJ190041_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ191000/RJ190041_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ191000/RJ190041_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ191000/RJ190041_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ191000/RJ190041_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ191000/RJ190041_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ191000/RJ190041_img_smp7.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ191000/RJ190041_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ191000/RJ190041_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ191000/RJ190041_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ191000/RJ190041_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ191000/RJ190041_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ191000/RJ190041_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ191000/RJ190041_img_smp7_100x100.jpg"], "alt": "CHAOS CROWN [宴]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "【二人の主人公の野望が交錯するとき、戦場に悲劇がうまれる】<br />\r\nそれぞれの運命を背負った二人の帝国将軍を中心に、物語は展開。<br />\r\n最初に選んだ主人公によって、物語は大きく分岐。<br />\r\n戦場で起こる様々な「悲劇」を乗り越え、主人公たちは野望の道を歩みだす。<br />\r\n<br />\r\nそして、2つの物語を終えた時、あなたの前に現れるのは……<br />\r\n<br />\r\n●イベントはすべて陵○シーン、その数は37に及び、ストーリー上必ず通るので取りこぼすことはありません。<br />\r\n●「オープニング→出陣準備→戦場マップ→戦闘終了→陵○イベント」で1シナリオとなり、これを繰り返す一本道ストーリーとなっています。<br />\r\n●ランダムダンジョン、女性型の敵に悪夢を見せるといったサブ陵○CGは30枚。(過去差分)<br />\r\n●戦場では、さまざまな戦いが展開され、「士気」が変化していく。同じ敵でも、士気によってその強さは変わっていきます。"}]}, {"type": "image_list", "title": "キャラクター紹介", "body": [{"intro": "グラスシード<br />\r\n野望に燃える主人公の一人。<br />\r\nしかし、彼の守るべき姉妹、仲間たちにも戦場の毒牙は迫る。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ191000/RJ190041/a87ca5176472f143992977b7b674ea59.jpg", "alt": "CHAOS CROWN [宴]", "title": "CHAOS CROWN [宴]"}}, {"intro": "シルフィ<br />\r\nグラスシードの義姉、互いに血が繋がっていないと知った時、二人の間に沸いた感情は……", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ191000/RJ190041/19bf450a83a2f0611c005b09b87ae5f9.jpg", "alt": "CHAOS CROWN [宴]", "title": "CHAOS CROWN [宴]"}}, {"intro": "リーナ<br />\r\nグラスシードの妹。<br />\r\n姉に憧れ、兄に嫉妬する微妙なバランスで成り立つ兄妹。<br />\r\nそんな姉妹にも、悲劇が待ち受ける。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ191000/RJ190041/490688140fb3254a936539ea840671e8.jpg", "alt": "CHAOS CROWN [宴]", "title": "CHAOS CROWN [宴]"}}, {"intro": "セリカ<br />\r\n敵国の将軍でありながら、主人公と偶然出会う少女。<br />\r\n戦いを嫌いながら、戦いの才能をもって生まれてしまったばかりに、戦場で彼女を待つのは……", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ191000/RJ190041/RJ190041_PTS0000011766_4.jpg", "alt": "CHAOS CROWN [宴]", "title": "CHAOS CROWN [宴]"}}]}], "description": "それぞれの運命を背負った二人の帝国将軍を中心に展開する陵○イベント満載RPG。\r\n戦場で起こる様々な「悲劇」を乗り越え、主人公たちは野望の道を歩みだす。", "short_introduction": "それぞれの運命を背負った二人の帝国将軍を中心に展開する陵○イベント満載RPG。\r\n戦場で起こる様々な「悲劇」を乗り越え、主人公たちは野望の道を歩みだす。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ190041.html", "site_id": "maniax", "fetched_at": 1794965310}