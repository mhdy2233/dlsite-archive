{"id": "RJ191323", "title": "おぺんぎんの野望", "title_romaji": "openginnoyabou", "circle": {"id": "RG30824", "name": "にゃーんわーくす", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG30824.html"}, "type": {"code": "SLN", "name": "シミュレーション", "category": "game"}, "category": "doujin", "age": "all", "sex": 1, "price": {"jpy": 330, "official_jpy": 330, "currencies": {"USD": 2.070485604164562, "EUR": 1.8826589991100158, "GBP": 1.5683210552804656, "TWD": 68.19027152126296, "CNY": 13.823031684064139, "KRW": 2766.135792120704, "IDR": 37848.377107466455, "VND": 53242.98160696999, "THB": 70.05625729752681, "SEK": 20.948523763878395, "HKD": 16.245593997991456, "SGD": 2.668626894421842, "CAD": 2.959938576789776, "MYR": 8.475599263393374, "BRL": 11.984790211694976, "AUD": 3.073467038463043, "PHP": 131.98416190057193, "MXN": 38.18339600809951, "NZD": 3.7661344624128366, "INR": 193.60516280434146}}, "point": {"point_amount": 18, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1483110000, "file": {"type": "EXE", "size": 119347660}, "tags": [], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 4.54, "count": 13}, "review_count": 0, "dl_count": 29, "wishlist_count": 42, "ranking": [], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ192000/RJ191323_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ192000/RJ191323_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ192000/RJ191323_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ192000/RJ191323_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ192000/RJ191323_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ192000/RJ191323_img_smp4.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ192000/RJ191323_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ192000/RJ191323_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ192000/RJ191323_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ192000/RJ191323_img_smp4_100x100.jpg"], "alt": "おぺんぎんの野望 [にゃーんわーくす]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "おぺんぎんたちを出撃させて、画面右からやってくる敵を倒しながら秋葉原を目指す!<br />\r\nそんな感じのラインディフェンスゲーム(タワーディフェンスの防衛軸が1次元になったようなやつ)です。<br />\r\n<br />\r\nステージが進むにつれて敵も強くなってくるので、おぺんぎんたちをレベルアップさせていったり新しい仲間を開発したりすることで対抗していきましょう。<br />\r\n<br />\r\n残念ながらかわいい女の子キャラ的なやつは出ません。"}]}, {"type": "image", "title": "どんなゲーム？", "body": [{"intro": "おぺんぎんの野望はラインディフェンスゲームというジャンルだそうです。<br />\r\nピンとこない方もいらっしゃるかと思いますので画面写真をご覧ください。<br />\r\n<br />\r\n画面の右側に「てき」と書いてある敵の基地があります。これを撃破することがゲームの目的です。<br />\r\nゲームが始まると敵の基地からたくさんの敵が出てきます。<br />\r\nこちらもおぺんぎんたちを出撃させて迎撃しましょう！<br />\r\n<br />\r\nどんどんステージをクリアして「あきはばら」までおぺんぎんたちを連れて行きましょう！<br />\r\n<br />\r\nもっと詳しい情報がにゃーんわーくす特設ページにもあります！<br />\r\nぜひご覧ください。<br />\r\n", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ192000/RJ191323/RJ191323_PTS0000012006_0.jpg", "alt": "おぺんぎんの野望 [にゃーんわーくす]", "title": "おぺんぎんの野望 [にゃーんわーくす]"}, "position": "right"}]}, {"type": "image_list", "title": "キャラクター紹介", "body": [{"intro": "ふつうおぺんぎん（味方キャラ）<br />\r\n<br />\r\nいたってふつうのおぺんぎん。<br />\r\nみんなでお出かけしたり踊ったりするのが大好き。<br />\r\n<br />\r\n<br />\r\nなにもつけなくていいので早く安く出撃できます。<br />\r\nリーズナブルなおねだんでレベルアップできるので序盤を進めるのに有利です。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ192000/RJ191323/RJ191323_PTS0000012007_1.jpg", "alt": "おぺんぎんの野望 [にゃーんわーくす]", "title": "おぺんぎんの野望 [にゃーんわーくす]"}}, {"intro": "ふとましおぺんぎん（味方キャラ）<br />\r\n<br />\r\n最近ちょっとふとましくなってきたおぺんぎん。<br />\r\nでも秋葉原に行ったらケバブが食べたい模様。<br />\r\n<br />\r\n<br />\r\nちょっと出撃に時間とおかねがかかるものの、恵まれた体格により耐久力は段違い。<br />\r\n攻撃性能もそこそこあるので壁もアタッカーもできる万能タイプです。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ192000/RJ191323/RJ191323_PTS0000012007_2.jpg", "alt": "おぺんぎんの野望 [にゃーんわーくす]", "title": "おぺんぎんの野望 [にゃーんわーくす]"}}, {"intro": "ダニ山さん（敵キャラ）<br />\r\n<br />\r\nとうきょうの大学に通うおだわら在住ダニ山さん。<br />\r\n親戚縁者みんな似たような顔をしている。<br />\r\n<br />\r\n<br />\r\nゲームの序盤に登場。<br />\r\n攻撃力が高いので、おぺんぎんを鍛えていないと一発で吹っ飛ばされてしまうぞ！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ192000/RJ191323/RJ191323_PTS0000012007_3.jpg", "alt": "おぺんぎんの野望 [にゃーんわーくす]", "title": "おぺんぎんの野望 [にゃーんわーくす]"}}, {"intro": "ごふまんゆーほー（敵キャラ）<br />\r\n<br />\r\nいつも何かに不満をぶつけているゆーほー。<br />\r\n不満が高まるとプルプルする。<br />\r\n<br />\r\n<br />\r\nゲームの中盤に登場。<br />\r\n超高速で迫ってきておぺんぎん基地に不満をぶつけだすのでこちらも強いおぺんぎんを出撃させてご退散願おう！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ192000/RJ191323/RJ191323_PTS0000012007_4.jpg", "alt": "おぺんぎんの野望 [にゃーんわーくす]", "title": "おぺんぎんの野望 [にゃーんわーくす]"}}]}], "description": "おぺんぎんたちを出撃させてなみいる敵を倒しながら秋葉原を目指す!そんな感じのラインディフェンスゲームです。", "short_introduction": "おぺんぎんたちを出撃させてなみいる敵を倒しながら秋葉原を目指す!そんな感じのラインディフェンスゲームです。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ191323.html", "site_id": "home", "fetched_at": 1794965241}