HANS"]}], "rating": {"average": 4.67, "count": 306}, "review_count": 6, "dl_count": 812, "wishlist_count": 871, "ranking": [], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192037_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192037_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192037_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192037_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192037_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192037_img_smp4.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192037_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192037_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192037_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192037_img_smp4_100x100.jpg"], "alt": "SHOTAxMONSTERS [砂糖加糖]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "★ご購入前に体験版での動作確認をお願いします。(製品版へのセーブデータの引継ぎ可能)<br />\n★バージョンアップでのバグ対応があるかもしれませんので、会員登録をしての購入を強く推奨します。<br />\n<br />\n☆バージョン1.50にアップデートされました。(2025/5/26)<br />\n　イベントシーンスキップ、服破壊表示の制限、奥義カットシーンなどSxM2準拠の機能の追加<br />\n<br />\n☆バージョン1.41にアップデートされました。(2019/9/27)<br />\n　軽微なバランス調整<br />\n<br />\n☆バージョン1.40にアップデートされました。(2019/9/22)<br />\n　新ゲームモード、スペシャルバトル、オマケイベントシーンの追加<br />\n　不具合修正やバランス調整など<br />\n<br />\n☆バージョン1.30にアップデートされました。(2018/2/8)<br />\n　負けイベントシーン、オマケイベントシーンの追加<br />\n　特定の条件でメインキャラクター達(の姿をしたモンスター)が仲間になるように<br />\n　その他バランス調整、不具合修正など<br />\n<br />\n　アップデート以前に購入された方は再ダウンロードで新バージョンに出来ます。(現在のセーブデータは引継ぎできます)<br />\n<br />\n★あらすじ<br />\n不思議な世界に迷い込んでしまった主人公が<br />\n可愛いモンスターを仲間にしながら迷宮の最深部を目指します<br />\n街の宿屋さんや雑貨屋さん、謎の魔法使いとエッチな体験をしたりもします<br />\n<br />\n★どんなゲーム?<br />\n・街とダンジョンを行き来しながらダンジョンを探索していくタイプのゲームです。<br />\n・ゲーム性を重視したRPGで、ゲームオーバーあり。セーブは街の中でのみ可能です。<br />\n・3段階の難易度が選べるので、RPGが苦手な方も安心です。<br />\n<br />\n・ダメージを受けていくと、敵味方ともに2段階で服が壊れます。<br />\n・総勢103体のオリジナルモンスターが仲間になります。<br />\n・主人公の服とパンツの着替えが出来ます。(服52種類、パンツ131種類)<br />\n<br />\n・3人のメインキャラから1人を選んで、階層クリアごとにエッチシーンを見ることが出来ます。<br />\n・ダンジョン探索中のエッチシーンもあります。<br />\n・ギャラリーモードを搭載。1度見たシーンとCGをいつでも見ることができます。<br />\n<br />\n★CG枚数<br />\n・基本CG:30枚(差分含めて105枚)<br />\n<br />\n★製作ツール:RPGツクールVXACE<br />\n<br />\n★サポート用掲示板(質問、感想、バグ報告などはこちらへ)<br />\n<a href=\"http://jbbs.shitaraba.net/game/60050/\" target=\"_blank\">http://jbbs.shitaraba.net/game/60050/</a>"}]}], "description": "ショタxエロxBL本格RPG!可愛いモンスターを仲間にして冒険しよう!", "short_introduction": "ショタxエロxBL本格RPG!可愛いモンスターを仲間にして冒険しよう!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ192037.html", "site_id": "maniax", "fetched_at": 1794965203}