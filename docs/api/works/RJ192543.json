{"id": "RJ192543", "title": "烙園～ラクエン～", "title_romaji": "rakuen", "circle": {"id": "RG14449", "name": "POTENCY", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG14449.html"}, "type": {"code": "RPG", "name": "ロールプレイング", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 1980, "official_jpy": 1980, "currencies": {"USD": 12.40812193047817, "EUR": 11.275780534585895, "GBP": 9.407972448895228, "TWD": 409.06555378798834, "CNY": 82.85732220199611, "KRW": 16569.037656903765, "IDR": 226804.12371134022, "VND": 319354.83870967745, "THB": 420.4803669646839, "SEK": 125.25382878181162, "HKD": 97.36811046854714, "SGD": 15.991419553467876, "CAD": 17.739630603550612, "MYR": 50.808444466113585, "BRL": 70.60233059006433, "AUD": 18.396494631568384, "PHP": 793.0785868781543, "MXN": 230.1817040421302, "NZD": 22.53759680922266, "INR": 1165.6658424584953}}, "point": {"point_amount": 108, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1689145200, "file": {"type": "EXE", "size": 291350066}, "tags": [{"key": "256", "name": "首輪/鎖/拘束具"}, {"key": "265", "name": "薬物"}, {"key": "006", "name": "退廃/背徳/インモラル"}, {"key": "151", "name": "閉じ込め"}, {"key": "114", "name": "命令/無理矢理"}, {"key": "149", "name": "羞恥/恥辱"}, {"key": "134", "name": "屈辱"}, {"key": "143", "name": "露出"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 4.14, "count": 1138}, "review_count": 10, "dl_count": 3230, "wishlist_count": 7004, "ranking": [{"category": "all", "period": "day", "rank": 2, "date": "2023-07-13"}, {"category": "all", "period": "week", "rank": 11, "date": "2023-07-16"}, {"category": "all", "period": "month", "rank": 36, "date": "2023-08-01"}, {"category": "game", "period": "day", "rank": 2, "date": "2023-07-13"}, {"category": "game", "period": "week", "rank": 8, "date": "2023-07-15"}, {"category": "game", "period": "month", "rank": 20, "date": "2023-07-31"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192543_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192543_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192543_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192543_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192543_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192543_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192543_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192543_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192543_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192543_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192543_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192543_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192543_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192543_img_smp6_100x100.jpg"], "alt": "烙園～ラクエン～ [POTENCY]"}, "introductions": [{"type": "text", "title": "マップ探索型の日常崩壊RPG", "body": [{"intro": "烙園～ラクエン～<br />\n<br />\n本作はマップ探索型の日常体験RPGです。<br />\n<br />\n■おしらせ<br />\n・回想部屋を実装しました。<br />\n　雪理の家の隣の建物から移動可能です。<br />\n・組織本部のイベントにおいて、特定の条件下で推薦状が揃っているにも関わらず進行できない場合に対する修正と、<br />\n　救済処置(抜け道)を用意しました。<br />\n　※ストーリーをスキップして使用もできるため、利用により物語の整合性に齟齬が生じる場合があります。<br />\n・いくつかの不具合を修正しました。<br />\n<br />\n※本作は体験版発表から、6年半以上が経っての発売となりました。<br />\n　現在たくさんの方にプレイしていただけていること、本当に心より嬉しく思います。<br />\n　期待に添えない部分も多々ありますが、適宜改善して参りますのでよろしくお願いいたします。<br />\n<br />\n■動作確認と体験版(重要)<br />\n今作はRPGツクールMVで制作されています。<br />\n動作の安定性は各環境により変わるため、必ず体験版での動作確認をお願い致します。<br />\n<br />\n※体験版ではシナリオ進行を含んだチュートリアルの終了後、<br />\n　本格的な自由探索開放までのプレイが可能です。<br />\n　なお、本編とのセーブデータの互換性はありません。<br />\n※AIは不使用です。"}]}, {"type": "image", "title": "\"もう一人の自分\"を救うため、破綻した日常を足掻く", "body": [{"intro": "■ストーリー<br />\nゴールデンウィークを目前にした、ある日の出来事。<br />\n学校へ向かっていた双子の姉妹は、突如、見知らぬ男達に誘拐されてしまう。<br />\nそして監禁と薬漬けの陵○の後、呆気なく開放された妹の雪理。<br />\nしかし彼女は、既に\"薬”無しでは自分を保てない状態に陥っていた――。<br />\n<br />\n禁断症状に炙られる心と体。<br />\nそれを抑えるために、さらなる薬物や犯罪に身を染める。<br />\nそれでも行方知れずの最愛の姉を助ける為、彼女は過酷で淫らな日常を藻掻いていく。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ193000/RJ192543/4ea49855259d44aca2dc88e5a4243fbb.jpg", "alt": "烙園～ラクエン～ [POTENCY]", "title": "烙園～ラクエン～ [POTENCY]"}, "position": "over"}]}, {"type": "image", "title": "行動により変化する心と体、そして世界の状態", "body": [{"intro": "▼淫らに背徳的な\"日常パート\"<br />\n雪理には様々なパラメータが存在し、<br />\nその変動が周りからの反応や自らの行動、イベントの分岐に繋がっていきます。<br />\nまた、それらによって立ち絵やUIがリアルタイムで変化し、<br />\nプレイヤーの没入感を高めるように作ってあります。<br />\nまた少しゲームを進めれば、ただマップ内を移動しているだけで、<br />\nパラメータを変化させる様々なイベントに直面するはずです。<br />\nプレイヤーの操作次第で徐々に、<br />\nあるいは急激に崩れていく、彼女の日常を体験できるでしょう。<br />\n<br />\n▼探索の面白みを倍増させる\"時間と日数\"の概念<br />\nゲーム内には\"午前\"\"午後\"\"深夜\"の時間帯が存在し、<br />\nそれぞれにイベントやキャラクターが大きく変わります。<br />\n夜間の外出が危険であると言った他、<br />\n日中に行けなかった場所に午後から訪れてみたり。<br />\n深夜には施錠されてしまう場所に、特定のイベント後に忍び込めたり……。<br />\nまた、日数によって引き起こされるイベントも多数あります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ193000/RJ192543/c70649caca1b937be4ba427933fe4b9e.jpg", "alt": "烙園～ラクエン～ [POTENCY]", "title": "烙園～ラクエン～ [POTENCY]"}, "position": "over"}]}, {"type": "image", "title": "敗北と凌○、それでも日常は続いていく", "body": [{"intro": "▼\"重量制限\"と\"準備\"、そして\"全損\"<br />\nレベルとゲームオーバーは存在しません。<br />\nまた戦闘は、ほぼマップ画面のまま短時間に決着するようになっています。<br />\n主人公の強さはレベルではなく、装備・道具とスキルに依存しており、<br />\n重量制限内でそれを整えるために、日常パートがとても大切になってきます。<br />\n<br />\n戦闘で敗北した場合、所持金や装備品は、ほぼ\"全損\"してしまいます。<br />\nこれにより日常パートでの準備や、その為の資金工面に常に動機が与えられ、<br />\n自然とアブノーマルな行為に手を染めることになるでしょう。<br />\n<br />\n例えば体を売ったり犯罪行為を行えば、<br />\n簡単にお金を稼げて装備を整えられるようにります。<br />\nその反面、犯罪組織や警察から狙われたり、<br />\n友好的だった人物たちが敵対したりと、全損のリスクが上昇します。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ193000/RJ192543/f3dd1c81eb2a61acc8caf51288ee3627.jpg", "alt": "烙園～ラクエン～ [POTENCY]", "title": "烙園～ラクエン～ [POTENCY]"}, "position": "over"}]}, {"type": "image", "title": "登場人物としてのNPC", "body": [{"intro": "▼多彩に反応する\"NPC”<br />\n本作のNPC達は、主人公の状態・状況によって多彩に反応を変えます。<br />\n例えば、主人公が裸で街中を歩き周ろうものなら、写真を取られて噂を広められたり、服を着るようたしなめられたり。<br />\n汚物のような状態であれば、会話するのも嫌がることでしょう。<br />\nもし、主人公のそういった噂が既に広まっている状態だったなら……。<br />\n逮捕されたり、路地裏に連れ込まれることもあるかも知れません。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ193000/RJ192543/4825680bb5ca22b6824418675468b209.jpg", "alt": "烙園～ラクエン～ [POTENCY]", "title": "烙園～ラクエン～ [POTENCY]"}, "position": "over"}]}, {"type": "image", "title": "能動的に発生するイベント、探索そのものがエロシーン", "body": [{"intro": "■エロシーン概要<br />\n文章によるシナリオ展開と一枚絵の演出は踏襲しつつも、<br />\nパラメータによる状態・状況変化やNPCの反応といった、<br />\n操作時のリアルタイム変化によるエロシーンに注力しています。<br />\nカットインやドット絵も使用し、<br />\n単なる紙芝居にならないようなプレイ内容を目指しました。<br />\n<br />\n※注意※<br />\n矢継ぎ早にエッチなシチュエーションが発生するため、<br />\n各シーンは短めになっています。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ193000/RJ192543/4d9849dcef4780135fb867730a3d9ce8.jpg", "alt": "烙園～ラクエン～ [POTENCY]", "title": "烙園～ラクエン～ [POTENCY]"}, "position": "over"}]}], "description": "淫らに、過酷に……破綻した日常を足掻く。時間や環境、様々なパラメータによる状態変化が特徴の探索型RPG。", "short_introduction": "淫らに、過酷に……破綻した日常を足掻く。時間や環境、様々なパラメータによる状態変化が特徴の探索型RPG。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ192543.html", "site_id": "maniax", "fetched_at": 1794952875}