b/images2/work/doujin/RJ193000/RJ192936_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192936_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192936_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192936_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192936_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192936_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192936_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ193000/RJ192936_img_smp9.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192936_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192936_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192936_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192936_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192936_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192936_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192936_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192936_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ193000/RJ192936_img_smp9_100x100.jpg"], "alt": "地獄のヘリコマンドー [OBLIQUEGLASS]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "軍事系B級洋画劇場風2Dヘリシューティングの決定版!<br />\r\n特殊作戦ヘリを駆り、極秘任務を遂行せよ!<br />\r\n<br />\r\n実在兵器をモチーフにしたリアルな機体に、<br />\r\nキーボード+マウスによるマルチレンジ戦闘を展開!<br />\r\n<br />\r\n武装と拡張パーツを組み合わせた独自のカスタマイズが可能。<br />\r\n技術向上により新たな武装を自分だけの機体を開発せよ!<br />\r\n<br />\r\n密林や渓谷、海上と様々な戦場で展開される、<br />\r\n殲滅、追撃、潜入、防衛等などの多彩なミッションを攻略せよ!"}]}, {"type": "image", "title": "ストーリー", "body": [{"intro": "―西暦198X年。<br />\r\n<br />\r\n東西冷戦のさなか、軍事技術の進歩によって<br />\r\n特殊作戦ヘリが戦場の主役となった時代。<br />\r\n<br />\r\n西大洋の島国「ベル・バルド」で軍事クーデターが勃発、<br />\r\n連合国の介入による多国籍艦隊の派遣が決定された！<br />\r\n<br />\r\n新開発の特殊作戦ヘリ、XOH-1「ニンジャ・コマンドー」を駆り、<br />\r\n数々の軍事ミッションを攻略せよ！", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ193000/RJ192936/RJ192936_PTS0000012069_0.jpg", "alt": "地獄のヘリコマンドー [OBLIQUEGLASS]", "title": "地獄のヘリコマンドー [OBLIQUEGLASS]"}, "position": "top"}]}, {"type": "image", "title": "操作説明", "body": [{"intro": "キーボードまたはゲームパッドとマウスを組み合わせて操作します。<br />\r\n<br />\r\nキーボード（またはパッド）で機体を動かし、<br />\r\nマウスで照準して射撃してください。<br />\r\n<br />\r\n●WASDキーまたは方向パッド<br />\r\n　機体を上下左右に動かします。<br />\r\n<br />\r\n●左クリック<br />\r\n　機銃を発射します。押しっぱなしで連射します。<br />\r\n<br />\r\n●右クリック<br />\r\n　ミサイルを使用します。<br />\r\n　押し続けると照準を展開し、敵をロックオンして離すと発射します。<br />\r\n<br />\r\n●中央（ホイール）クリック<br />\r\n　対地兵装（ロケット弾・爆弾・遠距離砲など）を発射します。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ193000/RJ192936/RJ192936_PTS0000012070_0.jpg", "alt": "地獄のヘリコマンドー [OBLIQUEGLASS]", "title": "地獄のヘリコマンドー [OBLIQUEGLASS]"}, "position": "top"}]}, {"type": "image_list", "title": "システム解説", "body": [{"intro": "▼ミッション選択▼<br />\r\n<br />\r\nまずは出撃するミッションを選択します。<br />\r\n殲滅戦、潜入、防衛、追撃戦と、<br />\r\n多彩な目標が用意されています。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ193000/RJ192936/RJ192936_PTS0000012071_1.jpg", "alt": "地獄のヘリコマンドー [OBLIQUEGLASS]", "title": "地獄のヘリコマンドー [OBLIQUEGLASS]"}}, {"intro": "▼機体のカスタマイズ▼<br />\r\n<br />\r\nミッションに合わせて、<br />\r\nプレイヤー独自のカスタマイズが可能です。<br />\r\n3種類の武器装備と、<br />\r\n機体を強化する拡張パーツを組み合わせ、<br />\r\n自分だけの機体を作り上げましょう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ193000/RJ192936/RJ192936_PTS0000012071_2.jpg", "alt": "地獄のヘリコマンドー [OBLIQUEGLASS]", "title": "地獄のヘリコマンドー [OBLIQUEGLASS]"}}, {"intro": "▼ミッション結果▼<br />\r\n<br />\r\nミッション終了時には<br />\r\nその結果を飛行履歴で表示します。<br />\r\n進行度と成功評価に応じて、<br />\r\nメダルが授与されます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ193000/RJ192936/RJ192936_PTS0000012071_3.jpg", "alt": "地獄のヘリコマンドー [OBLIQUEGLASS]", "title": "地獄のヘリコマンドー [OBLIQUEGLASS]"}}, {"intro": "▼技術の向上▼<br />\r\n<br />\r\n集めたメダルを消費して、<br />\r\n任意のテクノロジーを向上することが可能。<br />\r\n向上した技術に応じて、<br />\r\n新たな武装・パーツが解禁されます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ193000/RJ192936/RJ192936_PTS0000012071_4.jpg", "alt": "地獄のヘリコマンドー [OBLIQUEGLASS]", "title": "地獄のヘリコマンドー [OBLIQUEGLASS]"}}]}], "description": "軍事系B級洋画劇場風ヘリSTGの決定版!\r\n特殊作戦ヘリを駆り、極秘任務を遂行せよ!\r\n実在兵器をモチーフにしたリアルな機体でマルチレンジ戦闘を展開!", "short_introduction": "軍事系B級洋画劇場風ヘリSTGの決定版!\r\n特殊作戦ヘリを駆り、極秘任務を遂行せよ!\r\n実在兵器をモチーフにしたリアルな機体でマルチレンジ戦闘を展開!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ192936.html", "site_id": "home", "fetched_at": 1794965172}