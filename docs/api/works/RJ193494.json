]}], "rating": {"average": 4.28, "count": 3790}, "review_count": 27, "dl_count": 6427, "wishlist_count": 7487, "ranking": [{"category": "all", "period": "day", "rank": 2, "date": "2017-03-18"}, {"category": "all", "period": "week", "rank": 2, "date": "2017-03-21"}, {"category": "all", "period": "month", "rank": 10, "date": "2017-03-29"}, {"category": "game", "period": "week", "rank": 50, "date": "2019-04-08"}, {"category": "game", "period": "year", "rank": 149, "date": "2017"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ194000/RJ193494_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ194000/RJ193494_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ194000/RJ193494_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ194000/RJ193494_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ194000/RJ193494_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ194000/RJ193494_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ194000/RJ193494_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ194000/RJ193494_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ194000/RJ193494_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ194000/RJ193494_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ194000/RJ193494_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ194000/RJ193494_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ194000/RJ193494_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ194000/RJ193494_img_smp6_100x100.jpg"], "alt": "見習い淫魔と騎士のお仕事 [サークルいーえっち]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "【更新】<br />\r\n2017.03.21<br />\r\n詰む可能性のあるシステムについての改修を行いました。<br />\r\n評判をリセットする救済アイテムを入手できるようにしました。詳しくはDL後、ファイル内にある説明書をご覧下さい。<br />\r\n<br />\r\n<br />\r\n<br />\r\n<br />\r\n<br />\r\n【あらすじ】<br />\r\n街の護衛のために派遣された新米騎士の主人公。<br />\r\nしかし、不覚にも初任務でオークに襲われ、窮地に立たされてしまう。<br />\r\n<br />\r\nその時ぐうぜん通りかかった妖精に魔力を分けてもらい、主人公は一命を取り留める。<br />\r\nだが、その妖精はなんと――「淫魔」だった!?<br />\r\n<br />\r\n<br />\r\n「淫魔と魔力を共有しちゃったら……なにをするか、分かるよね?」<br />\r\n<br />\r\n<br />\r\nこうして、淫魔と騎士の共同生活がはじまった――。<br />\r\n<br />\r\n<br />\r\n<br />\r\n【ゲームシステム】<br />\r\nクエストを受注し、ダンジョンに潜り、アイテムを収集するハクスラ風味のRPGです。<br />\r\n装備強化、アイテム合成、牧場などのやりこみ要素もあり。<br />\r\nHPが減少すると衣装も破れていきます。<br />\r\nアイテム500種類以上(体験版ver1現在)<br />\r\n<br />\r\n<br />\r\n■バグ修正やイベント追加などのアップデートを予定しておりますので、<br />\r\nDLsiteの会員登録をして購入することを推奨します。<br />\r\nバグ修正は、製品版を優先させていただきます。<br />\r\n<br />\r\n■体験版から製品版へのデータ引継ぎはできません。<br />\r\n<br />\r\n■このゲームはRPGツクールVXAceによって作成されています。<br />\r\n本作品をプレイするにはRPGツクールVXAceのRTPが必要になりますので、<br />\r\n以下のサイトでダウンロードし、インストールして下さい。<br />\r\n<a href=\"https://tkool.jp/products/rtp.html\" target=\"_blank\">https://tkool.jp/products/rtp.html</a>"}]}], "description": "新米騎士の主人公が見習い淫魔に取り憑かれて、住民のために健気に頑張るハクスラRPGです。", "short_introduction": "新米騎士の主人公が見習い淫魔に取り憑かれて、住民のために健気に頑張るハクスラRPGです。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ193494.html", "site_id": "maniax", "fetched_at": 1794965066}