{"id": "RJ193848", "title": "ドリューの幻想", "title_romaji": "doryuunogensou", "circle": {"id": "RG31430", "name": "VIR-LAND", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG31430.html"}, "type": {"code": "RPG", "name": "ロールプレイング", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 770, "official_jpy": 770, "currencies": {"USD": 4.831133076383979, "EUR": 4.39287099792337, "GBP": 3.6594157956544198, "TWD": 159.11063354961357, "CNY": 32.253740596149655, "KRW": 6454.316848281643, "IDR": 88312.87991742173, "VND": 124233.62374959663, "THB": 163.46460036089587, "SEK": 48.87988878238293, "HKD": 37.90638599531339, "SGD": 6.226796086984298, "CAD": 6.906523345842811, "MYR": 19.776398281251204, "BRL": 27.964510493954943, "AUD": 7.1714230897471, "PHP": 307.96304443466784, "MXN": 89.09459068556552, "NZD": 8.787647078963285, "INR": 451.74537987679673}}, "point": {"point_amount": 42, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1487948400, "file": {"type": "EXE", "size": 104280148}, "tags": [{"key": "317", "name": "人外娘/モンスター娘"}, {"key": "096", "name": "シスター"}, {"key": "016", "name": "ファンタジー"}, {"key": "114", "name": "命令/無理矢理"}, {"key": "179", "name": "ムチムチ"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 3.53, "count": 17}, "review_count": 0, "dl_count": 25, "wishlist_count": 166, "ranking": [], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ194000/RJ193848_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ194000/RJ193848_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ194000/RJ193848_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ194000/RJ193848_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ194000/RJ193848_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ194000/RJ193848_img_smp4.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ194000/RJ193848_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ194000/RJ193848_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ194000/RJ193848_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ194000/RJ193848_img_smp4_100x100.jpg"], "alt": "ドリューの幻想 [VIR-LAND]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "■　ストーリー　■<br />\r\n人と魔族と魔物が住む『エグゼリード大陸』。<br />\r\n神聖歴100年。魔王軍の進撃により、人の領域が侵されようとしていた。<br />\r\n人はこれに対抗するために『勇者制度』を作った。<br />\r\n<br />\r\nそして時は流れ神聖歴2000年。<br />\r\n孤児だったエクスは、育ててくれた教会に恩を返すため勇者となった。<br />\r\nそして同じく勇者であり幼馴染でもあるリアノと共に魔王軍討伐のため旅立とうとしていた――。<br />\r\n<br />\r\n■　概要　■<br />\r\n主人公であるエクスを操作してエグゼリード大陸にあるゴルドラド国に侵攻している<br />\r\n魔王軍の幹部を倒すのが目的です。<br />\r\n魔物と戦い経験値とお金を稼いで装備を整え来るべき決戦に備えましょう。<br />\r\n<br />\r\n■　世界観・用語　■<br />\r\n【勇者制度】<br />\r\n・教会に認められた者は勇者としての称号を与えられ、魔王軍討伐に必要とあれば何をしても許される特権を持つ。<br />\r\n【深淵の腕輪】<br />\r\n・神が作りし腕輪。勇者の証として教会から与えられる。体力や魔力の増加に加えて、神の加護を受けられる。<br />\r\n【カーリーシャハド神】<br />\r\n・創造と慈愛の神。ほとんどの人間はカーリーシャハド神を信仰している。<br />\r\n【KS教会】<br />\r\n・カーリーシャハド教会。勇者の選定を行うだけでなく、<br />\r\n　医療、流通の分野を実質的に支配しており絶大な権力を持っている。<br />\r\n<br />\r\n■　戦闘　■<br />\r\nシンボルエンカウント方式のフロントビュータイプで戦うなどのコマンドを選んで進めていきます。<br />\r\n敵の弱点を突くことで戦闘を有利に進めます。<br />\r\n<br />\r\n■　システム　■<br />\r\n一度見たHイベントはタイトルのシーン回想とCG閲覧でいつでも見ることができます(体験版にはありません)。<br />\r\n文章スキップ機能もあります。<br />\r\n<br />\r\n■　内容等　■<br />\r\n・Hイベント基本CG枚数10枚+差分。<br />\r\n・プレイ時間は5～6時間ほど。<br />\r\n<br />\r\n■　注意事項　■<br />\r\n※ご購入の前に動作確認のため、体験版のプレイをおすすめします。<br />\r\n※バグ修正などのため、作品を完全に差し替える場合があります。<br />\r\n　ご購入の際は販売サイトでのユーザー登録をお願いします。<br />\r\n※体験版のセーブデータは本編に引き継ぎ出来ません。"}]}, {"type": "image_list", "title": "登場人物", "body": [{"intro": "・エクス<br />\r\n本編の主人公。<br />\r\n捨て子だった自分を育ててくれた教会に<br />\r\n恩を返すために勇者になった。<br />\r\n魔物達の侵攻を防ぐために討伐の旅に出る。<br />\r\n", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ194000/RJ193848/RJ193848_PTS0000012223_1.jpg", "alt": "ドリューの幻想 [VIR-LAND]", "title": "ドリューの幻想 [VIR-LAND]"}}, {"intro": "・リアノ<br />\r\nエクスの幼馴染。<br />\r\nエクスにとっては姉のような存在で、頭が上がらない。<br />\r\nエクスと共に旅に出る。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ194000/RJ193848/RJ193848_PTS0000012223_2.jpg", "alt": "ドリューの幻想 [VIR-LAND]", "title": "ドリューの幻想 [VIR-LAND]"}}, {"intro": "・サラマンダー<br />\r\n最強種族ドラゴンの娘。<br />\r\n誇り高く、他種族を見下している。<br />\r\nしかし、その態度は確かな実力に裏付けされたもの。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ194000/RJ193848/RJ193848_PTS0000012223_3.jpg", "alt": "ドリューの幻想 [VIR-LAND]", "title": "ドリューの幻想 [VIR-LAND]"}}, {"intro": "・アリス<br />\r\n各地の村を巡礼しているシスター。<br />\r\n優しく穏やかな性格をしている。<br />\r\n神を深く敬愛している。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ194000/RJ193848/RJ193848_PTS0000012223_4.jpg", "alt": "ドリューの幻想 [VIR-LAND]", "title": "ドリューの幻想 [VIR-LAND]"}}]}], "description": "道中にエロイベント満載の王道RPGです。", "short_introduction": "道中にエロイベント満載の王道RPGです。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ193848.html", "site_id": "maniax", "fetched_at": 1794965119}