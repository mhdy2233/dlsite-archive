/images2/work/doujin/RJ203000/RJ202009_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ203000/RJ202009_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ203000/RJ202009_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ203000/RJ202009_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ203000/RJ202009_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ203000/RJ202009_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ203000/RJ202009_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ203000/RJ202009_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ203000/RJ202009_img_smp9.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ203000/RJ202009_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ203000/RJ202009_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ203000/RJ202009_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ203000/RJ202009_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ203000/RJ202009_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ203000/RJ202009_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ203000/RJ202009_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ203000/RJ202009_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ203000/RJ202009_img_smp9_100x100.jpg"], "alt": "えいごのじかん [DAIDO]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "ノベルゲームと英語の学習が合体 !?<br />\r\n　新感覚、英語学習アプリが登場!<br />\r\n<br />\r\n<br />\r\n●\t主人公はあなた自身です。<br />\r\n\tまずは名前を登録しましょう!<br />\r\n<br />\r\n●\t全6章、問題総数150問以上、あなたは何問正解できるでしょうか?<br />\r\n\t1回のテストにつき10問出題されます。1問あたり2～4個の選択肢が表示されますので、その中から正しい答えを選びましょう!<br />\r\n<br />\r\n●\t各章の冒頭に会話パートが発生!\t\t<br />\r\n\t各章は、会話パート、テスト、採点の順で進んでいきます。<br />\r\n<br />\r\n●\tテストの点数によって次の章が開放!<br />\r\n\tテストの点数が基準点に達すると次の章が開放されます。<br />\r\n\tテストは何度でも受けれますので、繰り返し学習し、すべての章を開放しましょう!<br />\r\n<br />\r\n●\t難易度の選択が可能です!<br />\r\n\t本アプリでは、「やさしい」、「普通」、「難しい」の3つの難易度が用意されていますので、無理なく次の章に進むことも可能です!<br />\r\n<br />\r\n■\tストーリー<br />\r\n\t「このままじゃ、本当に留年しちゃうよ」<br />\r\n\t幼馴染のヒロインに本気で心配されるあなた。<br />\r\n\tキュートでちょっとやんちゃな彼女とともに<br />\r\n\tテスト勉強をはじめることになりました。<br />\r\n\t悪戦苦闘にすえ迎えたテスト本番。<br />\r\n\tはたして、無事、進学できるのでしょうか。<br />\r\n\t\t\t<br />\r\n\t※本アプリにボイスは含まれておりません。"}]}], "description": "ノベルゲームと英語の学習が合体 !? 新感覚、英語学習アプリが登場!", "short_introduction": "ノベルゲームと英語の学習が合体 !? 新感覚、英語学習アプリが登場!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ202009.html", "site_id": "home", "fetched_at": 1794964940}