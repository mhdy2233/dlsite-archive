告お願いします。<br />\r\n<a href=\"http://blog.livedoor.jp/windwave24/\" target=\"_blank\">http://blog.livedoor.jp/windwave24/</a>"}]}], "description": "触手服×トラップ×オークの迷宮脱出RPG", "short_introduction": "触手服×トラップ×オークの迷宮脱出RPG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ205600.html", "site_id": "maniax", "fetched_at": 1794964768}