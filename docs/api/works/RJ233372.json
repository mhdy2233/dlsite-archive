21-04-27"}, {"category": "all", "period": "year", "rank": 187, "date": "2021"}, {"category": "game", "period": "day", "rank": 1, "date": "2021-04-01"}, {"category": "game", "period": "week", "rank": 2, "date": "2021-04-04"}, {"category": "game", "period": "month", "rank": 4, "date": "2021-04-27"}, {"category": "game", "period": "year", "rank": 124, "date": "2021"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ234000/RJ233372_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ234000/RJ233372_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ234000/RJ233372_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ234000/RJ233372_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ234000/RJ233372_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ234000/RJ233372_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ234000/RJ233372_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ234000/RJ233372_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ234000/RJ233372_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ234000/RJ233372_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ234000/RJ233372_img_smp9.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ234000/RJ233372_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ234000/RJ233372_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ234000/RJ233372_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ234000/RJ233372_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ234000/RJ233372_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ234000/RJ233372_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ234000/RJ233372_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ234000/RJ233372_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ234000/RJ233372_img_smp9_100x100.jpg"], "alt": "赤髪の鬼神 [ぬこ魔神]"}, "introductions": [{"type": "text", "title": "無表情最強系主人公RPG第二弾", "body": [{"intro": "【ストーリー】<br />\n<br />\n魔物の局所的異常増殖現象『次元の穴』<br />\n通常、軍隊をもって当たるこの災害を<br />\n単騎で解決する超戦力を『魔殲将』と呼ぶ…<br />\n<br />\n炎の魔殲将アグニス・フレアバイト。<br />\n――彼女の魔力が奪われてしまった……<br />\n<br />\n奪われた魔力回収のためと副官が<br />\n取り出したのは『人の欲望』が聞こえるという<br />\n不気味な指輪だった……<br />\n<br />\n―――――――――――――――――――――――――――――<br />\n無表情系最強主人公第2弾。<br />\nこれっぽっちも喘ぎませんのでご注意ください<br />\n<br />\n【Hイベント】<br />\n*ほぼ対人です<br />\n<br />\n・挑発した相手を誘惑し…<br />\n・寝たふりをしてわざと襲わせ…<br />\n・名前も知らない男について行き…<br />\n・復讐として、他の男との行為を見せつけ<br />\n・ゴブリン達に体を晒して…<br />\n・他、女性上位<br />\n<br />\nver.2.0<br />\n回想イベントと一部イベントを修正、追加しました<br />\n<br />\nver.2.1<br />\nイベント修正、画面暗転バグ修正<br />\n<br />\n本作品はRPGツクールMVにて制作しております<br />\nPCの環境などで動作不良、突然の処理落ちなどが起こる可能性があります。<br />\nかならず体験版にてご確認ください。<br />\n<br />\n製品版購入後のPCに関連した問題は当サークルでは対応できません<br />\n重ねて体験版での動作確認を強く推奨させていただきます。"}]}, {"type": "image_list", "title": "登場人物", "body": [{"intro": "【アグニス・フレアバイト】<br />\n現行最強の魔殲将軍。<br />\n普段は厳めしい全身鎧を纏って<br />\nいるためその素顔を知る者は<br />\n少ない。<br />\n<br />\n殆ど無表情で感情が読みずらいが<br />\n義に熱く、情に弱いところがある", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ234000/RJ233372/5f7d40b1da642c2cc6f2edd80dd824f5.jpg", "alt": "赤髪の鬼神 [ぬこ魔神]", "title": "赤髪の鬼神 [ぬこ魔神]"}}, {"intro": "【ゴルド・オーガル】<br />\nアグニスの副官。<br />\nスケベ筋肉の愉快なおっさん。<br />\n普段からアグニスに熱烈な<br />\nセクハラをする命知らず。<br />\n<br />\n今回の騒動で、あわよくばと<br />\n画策する…<br />\n<br />\nクルスが嫌い", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ234000/RJ233372/a07c77c4bf2de25485f999eae324981f.jpg", "alt": "赤髪の鬼神 [ぬこ魔神]", "title": "赤髪の鬼神 [ぬこ魔神]"}}, {"intro": "【クルス・ヴレイブハート】<br />\nアグニスの頼れる副官。<br />\n文武両道、魔術にも長けた超人<br />\nアグニスを崇拝し自他共に認める狂信者。<br />\n<br />\n彼女が是とするものは、全て是である。<br />\n<br />\nゴルドが嫌い", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ234000/RJ233372/32a23700bfc44e3ce65f30e605039be0.jpg", "alt": "赤髪の鬼神 [ぬこ魔神]", "title": "赤髪の鬼神 [ぬこ魔神]"}}, {"intro": "【大臣】<br />\n<br />\n騒動の元凶。<br />\nアグニスから魔力を奪った張本人<br />\n<br />\n政や交渉の手腕は見事であり<br />\nアグニスもそれは認めている…", "image_info": null}]}], "description": "『屈せず〇ス』の『くっころ』を掲げるRPG。\r\n無表情最強女主人公RPG第2弾です。", "short_introduction": "『屈せず〇ス』の『くっころ』を掲げるRPG。\r\n無表情最強女主人公RPG第2弾です。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ233372.html", "site_id": "maniax", "fetched_at": 1794960705}