rank": 1, "date": "2019-01-23"}, {"category": "game", "period": "week", "rank": 4, "date": "2019-01-25"}, {"category": "game", "period": "month", "rank": 10, "date": "2019-01-29"}, {"category": "game", "period": "year", "rank": 174, "date": "2019"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ241000/RJ240331_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ241000/RJ240331_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ241000/RJ240331_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ241000/RJ240331_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ241000/RJ240331_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ241000/RJ240331_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ241000/RJ240331_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ241000/RJ240331_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ241000/RJ240331_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ241000/RJ240331_img_smp8.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ241000/RJ240331_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ241000/RJ240331_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ241000/RJ240331_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ241000/RJ240331_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ241000/RJ240331_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ241000/RJ240331_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ241000/RJ240331_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ241000/RJ240331_img_smp8_100x100.jpg"], "alt": "村娘のNTR冒険 [毛ガニ研究室]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "世界を冒険するNTRPG!!<br />\r\n<br />\r\n◆ストーリー<br />\r\n　村で平和に暮らしていたヒロインと主人公は、<br />\r\n　不思議な力で勇者にされてしまった<br />\r\n　<br />\r\n　魔王を倒すために村を出た二人は、<br />\r\n　世界各地を巡り魔王の種を討伐する<br />\r\n　　<br />\r\n　そんな二人に勇者の力を利用しようと、<br />\r\n　様々な間男たちが待ち構える<br />\r\n<br />\r\n　二人は無事、間男たちの手から逃げられるのか!?<br />\r\n　あるいは間男たちに身も心も陥落してしまうのか!!<br />\r\n　そして待ち受ける魔王の正体とは?<br />\r\n<br />\r\n◆システム<br />\r\n<br />\r\n　〇テンポの良いカードバトル<br />\r\n　　カードゲームとTRPGを混ぜたオリジナルゲーム。<br />\r\n　　カードを集めて、自分だけのデッキを作成しよう。<br />\r\n<br />\r\n　〇リプレイ性<br />\r\n　　複数の間男に加えて、11のクラスを選べるので、<br />\r\n　　何度もプレイが可能。<br />\r\n<br />\r\n　〇冒険感のあるマップ<br />\r\n　　マップを自由に駆け回って、強敵と戦おう<br />\r\n　　またダンジョンに潜ってレアカードをゲットしよう<br />\r\n<br />\r\n　〇複数の間男<br />\r\n　　間男によってヒロインが様々に堕とされてしまうぞ　　<br />\r\n<br />\r\n　〇間男と結婚<br />\r\n　　一部の間男と結婚してしまうことがあります。<br />\r\n　　宿に泊まる度に隣の部屋では間男とセックスを……。　　<br />\r\n<br />\r\n　〇性の履歴<br />\r\n　　間男とのセックス回数やアナル回数はもちろん、<br />\r\n　　子宮の状態までもわかる性の履歴システム<br />\r\n<br />\r\n　〇妊娠<br />\r\n　　間男により妊娠させられてしまいます<br />\r\n　　しばらくすると出産します<br />\r\n<br />\r\n　〇衣装差分<br />\r\n　　ダメージ差分や、裸などの差分があります。<br />\r\n<br />\r\n　〇CG枚数<br />\r\n　　基本CGは約20枚+影絵が約10枚ほどです<br />\r\n　　<br />\r\n　〇その他<br />\r\n　　シーン回想<br />\r\n　　シーンスキップ<br />\r\n　　クリア後シーン解放<br />\r\n　　三段階の難易度選択<br />\r\n　　etc<br />\r\n<br />\r\n●動作環境<br />\r\n　※※-----必ず体験版にて動作確認を行って下さい-----※※<br />\r\n<br />\r\n　必須解像度は1280×720以上必要です。<br />\r\n　推奨　1920×1080以上の解像度。<br />\r\n　　　　CPU Intel(R) Core(TM)i5-6600 CPU @ 3.30GHz以上。<br />\r\n　　　　メモリ　16GB以上。<br />\r\n　　　　ビデオ　GeForce GTX 750 Ti以上。"}]}], "description": "世界を冒険するNTRPG!!", "short_introduction": "世界を冒険するNTRPG!!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ240331.html", "site_id": "maniax", "fetched_at": 1794962481}