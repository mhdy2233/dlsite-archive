_id": 3654, "display_label": "簡体中文", "dl_count": 462, "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ302968.html", "lang": ["CHI_HANS"]}], "rating": {"average": 4.33, "count": 2477}, "review_count": 23, "dl_count": 5008, "wishlist_count": 3155, "ranking": [{"category": "all", "period": "day", "rank": 5, "date": "2019-03-09"}, {"category": "all", "period": "week", "rank": 10, "date": "2019-03-13"}, {"category": "all", "period": "month", "rank": 26, "date": "2019-03-30"}, {"category": "game", "period": "day", "rank": 4, "date": "2019-03-09"}, {"category": "game", "period": "week", "rank": 7, "date": "2019-03-11"}, {"category": "game", "period": "month", "rank": 10, "date": "2019-03-30"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ243000/RJ242095_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ243000/RJ242095_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ243000/RJ242095_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ243000/RJ242095_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ243000/RJ242095_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ243000/RJ242095_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ243000/RJ242095_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ243000/RJ242095_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ243000/RJ242095_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ243000/RJ242095_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ243000/RJ242095_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ243000/RJ242095_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ243000/RJ242095_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ243000/RJ242095_img_smp6_100x100.jpg"], "alt": "眠り妹姫 [うまのあれ]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "睡眠中の妹の部屋に夜○いして、エッチなイタズラをするゲームです。<br />\r\n夜○いプレイは全編Live2Dアニメーションでヌルヌル動きます。<br />\r\nマウス操作で、両手、舌、チ○ポを同時に、自由自在に使って、寝てる妹を責め立てることができます。<br />\r\n<br />\r\n●最大4箇所の『同時責め』<br />\r\n<br />\r\n左手で乳首を愛撫しながら、右手でオマ○コを責めつつ、喘いでる女の子にキスをする。<br />\r\nたとえばそんなプレイも可能です。<br />\r\n当然、挿入しながらアレコレすることも!<br />\r\n<br />\r\nチ○ポ、右手、左手、口(舌)で、最大4箇所を同時に責めることができます。<br />\r\n<br />\r\n●夜○いエッチ後のエピローグは10種類<br />\r\n<br />\r\nエッチ後は、プレイの内容によって変わる妹の感想(抗議?)が聞けます。<br />\r\n寝てる間に中に出されたり、起こされて無理やりエッチされた後の、妹の反応を楽しむことができます。<br />\r\n<br />\r\n■ストーリー<br />\r\n妹さんは、年の離れたお兄ちゃんと二人で暮らしています。<br />\r\n妹さんは毎日お仕事をがんばってくれてるお兄ちゃんにとてもとても感謝していました。<br />\r\nですがある日……妹さんは、毎晩お兄ちゃんが部屋に入って自分の寝顔を覗き見していたらしいことに気付いてしまいます。<br />\r\n妹さんはお兄ちゃんの変態性に呆れつつも、今までの感謝とお返しの気持ちとして、部屋の鍵を開けておくことにしたのですが……。<br />\r\n<br />\r\n<br />\r\n♪こんな人にオススメ♪<br />\r\n・2Dでヌルヌル動くエロアニメーションを楽しみたい。<br />\r\n・寝てる女の子にイタズラしたい。<br />\r\n・気絶してる女の子を好き放題犯したい。<br />\r\n・本当にセックスしてるような臨場感を楽しみたい。<br />\r\n・色んなところにザーメンをぶっかけたい。<br />\r\n・妹が好き。<br />\r\n・妹とラブラブエッチをするのが好き。<br />\r\n・妹を無理やり○すのも好き。<br />\r\n・エッチをされた後の妹の反応を楽しみたい。"}]}], "description": "寝てる妹に夜○いをかけて悪戯エッチ。ぶっかけ、睡姦、起こしてエッチも……フルアニメーションで自由自在に楽しめます", "short_introduction": "寝てる妹に夜○いをかけて悪戯エッチ。ぶっかけ、睡姦、起こしてエッチも……フルアニメーションで自由自在に楽しめます", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ242095.html", "site_id": "maniax", "fetched_at": 1794962386}