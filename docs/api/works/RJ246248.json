_id": 1318, "display_label": "中国語（簡）", "dl_count": 156, "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ340803.html", "lang": ["CHI_HANS"]}, {"product_id": "RJ340806", "edition_id": 1318, "display_label": "韓国語", "dl_count": 30, "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ340806.html", "lang": ["KO_KR"]}], "rating": {"average": 3.68, "count": 123}, "review_count": 1, "dl_count": 258, "wishlist_count": 981, "ranking": [{"category": "game", "period": "day", "rank": 18, "date": "2019-02-16"}, {"category": "game", "period": "week", "rank": 44, "date": "2019-02-21"}, {"category": "game", "period": "month", "rank": 69, "date": "2019-02-26"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ247000/RJ246248_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ247000/RJ246248_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ247000/RJ246248_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ247000/RJ246248_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ247000/RJ246248_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ247000/RJ246248_img_smp4.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ247000/RJ246248_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ247000/RJ246248_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ247000/RJ246248_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ247000/RJ246248_img_smp4_100x100.jpg"], "alt": "ビッチガバメント [猫尺]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "●シナリオ<br />\r\n<br />\r\nガーパ王国は危機に瀕していた。<br />\r\n近隣のデミア帝国といつ戦争してもおかしくない緊張関係が続く中、<br />\r\n王国はエステリア公国と同盟を結ぼうとしていたが、<br />\r\nあまりいい成果を得られていなかった。<br />\r\n<br />\r\nそこで、国王は苦渋の決断の末、<br />\r\n愛する娘であるシャリー姫を帝国に外交へ向かわせることになった。<br />\r\n重大な任務を負ったシャリー姫。<br />\r\n<br />\r\n彼女は王国のために体を売って外交し、他国との融和を図りにかかる……!<br />\r\nそして彼女は体を売っているうちに、どんどん股が緩くなり、ビッチ化していくのだった……。<br />\r\n<br />\r\n<br />\r\n●キャラクター<br />\r\n<br />\r\n主人公:シャリー<br />\r\n<br />\r\nガーパ王国の姫<br />\r\n王国の未来や民の幸福を案じる、心優しき女性。<br />\r\n責任感が強く、姫として外交し、責務を果たさなければならないと思っている。<br />\r\n<br />\r\n体を売ることも、王国のためならばしかたないと安易に考えている。<br />\r\nはじめは外交のために性行為をすることに少し抵抗があったが、<br />\r\nだんだん快楽にのめりこみ、股も思考もガバガバなビッチ姫になっていく。<br />\r\n<br />\r\n典型的なおバカな思考で墜ちていく……。<br />\r\n<br />\r\n<br />\r\n●ゲーム<br />\r\n<br />\r\nアドベンチャーRPGになります。<br />\r\n外交をしながら、国交を結んでいく物語になります。"}]}], "description": "外交のために安易に体を使い始めたお姫様。しかし、だんだん快楽にのめりこみ、股も思考もガバガバなビッチ姫になっていく。", "short_introduction": "外交のために安易に体を使い始めたお姫様。しかし、だんだん快楽にのめりこみ、股も思考もガバガバなビッチ姫になっていく。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ246248.html", "site_id": "maniax", "fetched_at": 1794962447}