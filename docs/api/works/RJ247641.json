: "all", "period": "year", "rank": 6, "date": "2019"}, {"category": "all", "period": "total", "rank": 12, "date": "2026-05-22"}, {"category": "game", "period": "day", "rank": 1, "date": "2019-08-31"}, {"category": "game", "period": "week", "rank": 1, "date": "2019-09-01"}, {"category": "game", "period": "month", "rank": 1, "date": "2019-09-01"}, {"category": "game", "period": "year", "rank": 6, "date": "2019"}, {"category": "game", "period": "total", "rank": 2, "date": "2026-08-18"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ248000/RJ247641_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ248000/RJ247641_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ248000/RJ247641_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ248000/RJ247641_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ248000/RJ247641_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ248000/RJ247641_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ248000/RJ247641_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ248000/RJ247641_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ248000/RJ247641_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ248000/RJ247641_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ248000/RJ247641_img_smp9.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ248000/RJ247641_img_smp10.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ248000/RJ247641_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ248000/RJ247641_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ248000/RJ247641_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ248000/RJ247641_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ248000/RJ247641_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ248000/RJ247641_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ248000/RJ247641_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ248000/RJ247641_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ248000/RJ247641_img_smp9_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ248000/RJ247641_img_smp10_100x100.jpg"], "alt": "シニシスタ SiNiSistar [ウー]"}, "introductions": [{"type": "text", "title": "概要", "body": [{"intro": "教会から呪われた地に派遣されたシスター「ラビアン」がモンスター退治に挑む、<br />\nシンプルな2Dアクションゲームです。<br />\n<br />\n恐ろしい存在に襲われる絶望感や、死への憧れ、被虐的な官能がテーマです。<br />\n<br />\n往年のドット製ゲームをイメージしつつ現代風に仕上げられた綿密なドット絵で、<br />\n当時想像の中にあったゲームオーバーの先までを描写します。<br />\n<br />\n※このゲームには性的・暴力的なシーンやグロテスクな表現が含まれます。<br />\n<br />\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━<br />\n<br />\nゲーム中にポーズメニュー(Esc)を開くことで、音量やキー設定が行えます。<br />\nキーボードとゲームパッドに対応しています。<br />\n<br />\nWindows版とMac版の2バージョンを同梱しています。<br />\n必ず体験版で動作確認を行ってください。<br />\n<br />\nゲーム内のテキストは通常、英語と日本語が使われていますが、<br />\nポーズメニューから簡体中文と繁体中文に切り替えることができます。"}]}, {"type": "image", "title": "主人公", "body": [{"intro": "ラビアン<br />\nCV:天知遥<br />\n<br />\n魔物はびこる廃都ケッサリアへ遣わされた聖職者。<br />\n寂れた教会を拠点として、単身魔物の住処へと乗り込んでいく。<br />\nおっぱいがデカい。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ248000/RJ247641/c46d1b352895f8201b85b05856fc022c.jpg", "alt": "シニシスタ SiNiSistar [ウー]", "title": "シニシスタ SiNiSistar [ウー]"}, "position": "over"}]}, {"type": "image", "title": "アクション", "body": [{"intro": "主人公のラビアンは、剣と弓が使えます。<br />\n攻撃が早く使いやすいがリーチの短い剣と、<br />\n狙うのが難しく矢に限りはあるものの、高所や遠くを攻撃できる弓を駆使して、<br />\nステージクリアを目指しましょう。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ248000/RJ247641/1ee86049d5bdf348cf18cb24753e94af.jpg", "alt": "シニシスタ SiNiSistar [ウー]", "title": "シニシスタ SiNiSistar [ウー]"}, "position": "over"}]}, {"type": "image", "title": "モンスター", "body": [{"intro": "様々なモンスターがラビアンを見るなり襲いかかってきます。<br />\nもし倒されてしまえば、ラビアンは餌となるか繁殖のための苗床となり果てることになります。<br />\n<br />\nほぼ全てのモンスターに専用のやられアニメーションが用意されており、<br />\n中には専用のシーンに発展するものもあります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ248000/RJ247641/1756506c3bf796e8791413d23f68a51f.jpg", "alt": "シニシスタ SiNiSistar [ウー]", "title": "シニシスタ SiNiSistar [ウー]"}, "position": "over"}]}, {"type": "image", "title": "立ち絵", "body": [{"intro": "ドットアニメーションの他に、体力の変化や状態異常時、<br />\nまたゲームオーバー時にも立ち絵が変化し、ラビアンの状況を大きく描写します。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ248000/RJ247641/c697b59dcf3755c99f7b25c5e24bca6a.jpg", "alt": "シニシスタ SiNiSistar [ウー]", "title": "シニシスタ SiNiSistar [ウー]"}, "position": "over"}]}, {"type": "image", "title": "ステージ", "body": [{"intro": "深い森や地下水路など、ドットで描かれた重く暗いステージが絶望感を演出します。<br />\nリリース時は全部で6ステージを予定しています。<br />\n<br />\n現在アップデートにより「畜産区画」と「実験室」ステージが追加されました。<br />\n<br />\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━<br />\nサークル:Uu(ウー)<br />\nDesigner:ねんない<br />\nEngineer:みーくん", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ248000/RJ247641/6e0ace592b66785e93215c8554b37c78.jpg", "alt": "シニシスタ SiNiSistar [ウー]", "title": "シニシスタ SiNiSistar [ウー]"}, "position": "over"}]}], "description": "シンプルなドット製2Dアクションゲーム。恐ろしい存在に襲われる絶望感や、死への憧れ、被虐的な官能がテーマです。Win・Mac両バージョン同梱。", "short_introduction": "シンプルなドット製2Dアクションゲーム。恐ろしい存在に襲われる絶望感や、死への憧れ、被虐的な官能がテーマです。Win・Mac両バージョン同梱。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ247641.html", "site_id": "maniax", "fetched_at": 1794961963}