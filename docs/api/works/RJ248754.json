ory": "game", "period": "day", "rank": 2, "date": "2019-05-02"}, {"category": "game", "period": "week", "rank": 4, "date": "2019-05-08"}, {"category": "game", "period": "month", "rank": 9, "date": "2019-05-30"}, {"category": "game", "period": "year", "rank": 145, "date": "2019"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ249000/RJ248754_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ249000/RJ248754_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ249000/RJ248754_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ249000/RJ248754_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ249000/RJ248754_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ249000/RJ248754_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ249000/RJ248754_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ249000/RJ248754_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ249000/RJ248754_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ249000/RJ248754_img_smp8.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ249000/RJ248754_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ249000/RJ248754_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ249000/RJ248754_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ249000/RJ248754_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ249000/RJ248754_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ249000/RJ248754_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ249000/RJ248754_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ249000/RJ248754_img_smp8_100x100.jpg"], "alt": "爆乳エルフ嫁と早漏くん  ～催○寝取られ盗み見録～ [AVANTGARDE]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "特設サイト公開中!<br />\r\n<a href=\"https://bwjohann.wixsite.com/bakunyuelf\" target=\"_blank\">https://bwjohann.wixsite.com/bakunyuelf</a><br />\r\n<br />\r\n■基本情報・システム<br />\r\nジャンル:ドスケベ催○寝取られRPG<br />\r\n解像度:1280×720<br />\r\n基本CG数:20枚(差分、立ち絵など除く)<br />\r\nアニメーション数:15種類(差分除く)<br />\r\nボイス:Hシーンのヒロイン、メインストーリー<br />\r\nRPGツクールMV1.6.1で制作。<br />\r\n※体験版で動作確認をお願い致します。<br />\r\n<br />\r\n■ストーリー<br />\r\n1911年、とある地方都市。<br />\r\n主人公「エリオ」はエルフの妻「ロレッタ」と幸せな結婚生活を送っていた。<br />\r\nエリオの政治家としての仕事も秘書であるロレッタのサポートもあり、<br />\r\n機関紙の編集長に選ばれるほどの順調である。<br />\r\n<br />\r\nただ、エッチなことが苦手のロレッタと、とあるコンプレックスのあるエリオたちは<br />\r\n夜の方はまだまだこれからだった。<br />\r\nだがエリオは勇気を絞り出し、近い内に誘おうと決意していた。<br />\r\n<br />\r\nしかし突如現れた、エリオと同じ党員の「ファブロ」によって、全ての歯車は狂わされていく。<br />\r\nファブロが仕掛ける催○に、ロレッタは最後まで抗えるか。<br />\r\nそれとも、どこまでも淫らに堕ちてしまうのか……。<br />\r\n<br />\r\n<br />\r\n■Hシーン特徴<br />\r\n認識変更、身体だけ強○的に動かすなどのさまざまな催○シチュエーション!<br />\r\n最愛の妻の身体が開発されていく様を、主人公視点とヒロイン視点で体験出来ます。<br />\r\nHシーンヒロインフルボイスで、卑語隠語無修正!<br />\r\n妊娠、触手の要素があります。<br />\r\n<br />\r\n■その他システム<br />\r\nエンディング分岐あり<br />\r\nメッセージスキップ<br />\r\nウインドウ消し<br />\r\nバックログ<br />\r\n回想モード(体験版未実装)<br />\r\n立ち絵服装変更あり"}]}, {"type": "image", "title": "ヒロイン紹介", "body": [{"intro": "-", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ249000/RJ248754/RJ248754_PTS0000018093_0.jpg", "alt": "爆乳エルフ嫁と早漏くん  ～催○寝取られ盗み見録～ [AVANTGARDE]", "title": "爆乳エルフ嫁と早漏くん  ～催○寝取られ盗み見録～ [AVANTGARDE]"}, "position": "over"}]}], "description": "催○によって妻を寝取られるRPG!\r\n主人公とヒロイン2つの視点でプレイ可能!", "short_introduction": "催○によって妻を寝取られるRPG!\r\n主人公とヒロイン2つの視点でプレイ可能!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ248754.html", "site_id": "maniax", "fetched_at": 1794962238}