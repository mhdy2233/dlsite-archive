 ["ENG"]}, {"product_id": "RJ01545982", "edition_id": 45859, "display_label": "簡体中文", "dl_count": 24, "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01545982.html", "lang": ["CHI_HANS"]}, {"product_id": "RJ01545986", "edition_id": 45859, "display_label": "韓国語", "dl_count": 19, "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01545986.html", "lang": ["KO_KR"]}], "rating": {"average": 3.94, "count": 159}, "review_count": 1, "dl_count": 333, "wishlist_count": 1456, "ranking": [{"category": "game", "period": "day", "rank": 22, "date": "2019-07-14"}, {"category": "game", "period": "month", "rank": 76, "date": "2019-07-30"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ259000/RJ258157_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ259000/RJ258157_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ259000/RJ258157_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ259000/RJ258157_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ259000/RJ258157_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ259000/RJ258157_img_smp4.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ259000/RJ258157_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ259000/RJ258157_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ259000/RJ258157_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ259000/RJ258157_img_smp4_100x100.jpg"], "alt": "プリンセスリベンジ～ラルダーラ姫の復讐～ [猫尺]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "●あらすじ<br />\r\n<br />\r\nバンデッタ王国とロベスト帝国、<br />\r\n長きにわたり戦争を繰り返していた両国が融和の路線へ踏み切ろうとしていた。<br />\r\nこの二国の穏健派の大臣たちは同盟への足掛かりとして、政略結婚を画策した。<br />\r\n<br />\r\nそれはバンデッタ王国の姫ラルダーラとロベスト帝国の王子アンドリーの婚姻である。<br />\r\nしかし、わがままな姫は、アンドリーとの結婚を嫌がった。<br />\r\nなぜなら彼女には愛し合っている恋人がいたからだ。<br />\r\nその名もハミルイス。<br />\r\n彼は帝国騎士団の騎士で、美男子の優しい男だった。<br />\r\n<br />\r\n<br />\r\n●プロローグ<br />\r\n<br />\r\n結婚式当日…。<br />\r\n式は、王国が誇る豪華絢爛な結婚式場で行われた。<br />\r\nその式の最中、ラルダーラ姫は結婚式場を抜け出してしまった。<br />\r\n一国の姫として、許されない行為。<br />\r\n<br />\r\nラルダーラが外に出ると、ハミルイスが待っていた。<br />\r\nハミルイスはラルダーラにプロポーズし、駆け落ちしようと持ち掛ける。<br />\r\n彼女はそれを歓喜の表情で受け入れた……<br />\r\nそして二人は王国を脱出した……<br />\r\n<br />\r\n姫が式場から抜け出したと言う知らせは瞬く間に結婚式場に広がった。<br />\r\n二国間の協調路線を是としていた帝国と王国の穏健派の大臣たちは焦る。<br />\r\nそんな中、帝国の強硬派の大臣たちは邪悪な笑みを浮かべていた。<br />\r\n彼らは王国をおとしめるための奸計をめぐらせていたのだ。<br />\r\n<br />\r\nかねてから帝国のタカ派の大臣たちは、王国との協調路線に反対しており、<br />\r\n彼らは戦争をし、植民地を獲得し、<br />\r\n領土を拡大することで帝国を豊かにするべきだというイデオロギーを持っていた。<br />\r\nそしてラルダーラは帝国のタカ派たちの権謀術数に嵌っていってしまう……。<br />\r\n<br />\r\n<br />\r\n●キャラクター<br />\r\n<br />\r\n名前:ラルダーラ<br />\r\n性格:平民を見下している高飛車な姫。<br />\r\nわがままで頭が悪く、考えなしの行動をとりがち。<br />\r\n自己中心的で姫でありながら国のことなどどうでもいいと考えている。<br />\r\nハミルイスという恋人がいて、政治的なしがらみから逃れて彼と一緒になりたいと考えている。<br />\r\n<br />\r\n<br />\r\n●Hシーン<br />\r\n<br />\r\nお姫様は奴○に墜ちたところからスタートします。<br />\r\n陵○されたり、大勢の前で青姦されたり、情報を得るために売春したり…<br />\r\n20シーンのHシーン。<br />\r\n回想部屋(裏技)あり。"}]}], "description": "結婚式当日…。式は、王国が誇る豪華絢爛な結婚式場で行われた。しかしその式の最中、ラルダーラ姫は結婚式場を抜け出してしまった。平民を見下している高飛車な姫の物語。", "short_introduction": "結婚式当日…。式は、王国が誇る豪華絢爛な結婚式場で行われた。しかしその式の最中、ラルダーラ姫は結婚式場を抜け出してしまった。平民を見下している高飛車な姫の物語。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ258157.html", "site_id": "maniax", "fetched_at": 1794962076}