, "edition_id": 3059, "display_label": "簡体中文", "dl_count": 667, "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ373534.html", "lang": ["CHI_HANS"]}, {"product_id": "RJ373536", "edition_id": 3059, "display_label": "韓国語", "dl_count": 248, "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ373536.html", "lang": ["KO_KR"]}], "rating": {"average": 4.3, "count": 5588}, "review_count": 44, "dl_count": 13402, "wishlist_count": 14831, "ranking": [{"category": "all", "period": "day", "rank": 9, "date": "2019-09-07"}, {"category": "all", "period": "week", "rank": 15, "date": "2019-10-03"}, {"category": "all", "period": "month", "rank": 26, "date": "2019-10-06"}, {"category": "game", "period": "day", "rank": 6, "date": "2019-09-07"}, {"category": "game", "period": "week", "rank": 6, "date": "2019-10-04"}, {"category": "game", "period": "month", "rank": 10, "date": "2019-10-06"}, {"category": "game", "period": "year", "rank": 131, "date": "2019"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ265000/RJ264206_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ265000/RJ264206_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ265000/RJ264206_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ265000/RJ264206_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ265000/RJ264206_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ265000/RJ264206_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ265000/RJ264206_img_smp5.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ265000/RJ264206_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ265000/RJ264206_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ265000/RJ264206_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ265000/RJ264206_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ265000/RJ264206_img_smp5_100x100.jpg"], "alt": "メイドの剣(つるぎ) [高温注意]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "【 物語 】<br />\r\n<br />\r\nご主人様であるあなたは、メイドを連れてダンジョンに潜ります。<br />\r\n<br />\r\n戦闘がありますが、MP(メイドパワー)によるスキップ機能あり。ON/OFFも切り替えられます。<br />\r\n<br />\r\nメイドは常にあなたの側に付いていき、クリックで声を掛けたり触れ合ったりする事が出来ます。<br />\r\n戦いはできませんが、日々の生活を支えてくれたり、冒険の補助や助言をしてくれたり、<br />\r\nイタズラやお触りを悦んで受け入れてくれたり、昂った体をえっちなご奉仕で鎮めてくれたりします。<br />\r\n<br />\r\nメイドは、開始から好感度100%MAXです。ご主人様が戦いの中で倒れれば、後を追う覚悟です。<br />\r\n彼女達の過去に何があったのでしょうか……?<br />\r\n<br />\r\nダンジョンを攻略して力を付けていく内に、あなたとメイドは、過去と向き合い、未来へと歩み始めます。<br />\r\n<br />\r\n<br />\r\n【 Hシーン 】<br />\r\n<br />\r\n全てメイドとのらぶらぶご奉仕えっちのみ!<br />\r\nあなたの側にいるメイドをクリックすれば、いつでもどこでもえっちなご奉仕が楽しめます。<br />\r\n家の中でも、野外でも、ダンジョンの中でさえも、メイドは、あなたに心からのご奉仕えっちをしてくれます。<br />\r\n<br />\r\nメイドの立ち絵をマウスでクリックすると、様々な反応を示してくれます。<br />\r\n相談や回復、時にはHまで…あなたの欲望を叶えてくれることでしょう。<br />\r\n<br />\r\n<br />\r\n【 制作・イラスト 】<br />\r\n<br />\r\nHa氏、けそシロウ氏との共同制作。<br />\r\n<br />\r\nシナリオ:Ha<br />\r\n<br />\r\nイラスト:けそシロウ<br />\r\n<br />\r\n<a href=\"https://www.pixiv.net/member.php?id=12255246\" target=\"_blank\">https://www.pixiv.net/member.php?id=12255246</a><br />\r\n<br />\r\n<a href=\"https://twitter.com/kesokeso_keso\" target=\"_blank\">https://twitter.com/kesokeso_keso</a><br />\r\n<br />\r\n<br />\r\n【 キャラクター 】<br />\r\n<br />\r\nヴァル:主人公。あなたの分身です。メイドのご主人様として、ダンジョンに潜って剣を振るいます。<br />\r\n<br />\r\nシーラ:あなたに付き従うメイドです。身も心も、全てをあなたに捧げてくれています。"}]}], "description": "のどかな山奥の村に突如ダンジョンが湧き出した。最近村に住み着いた冒険者の若者は、一振りの剣を携えて魔物の討伐に向かう。その隣には一人のメイドが付き従っていた。", "short_introduction": "のどかな山奥の村に突如ダンジョンが湧き出した。最近村に住み着いた冒険者の若者は、一振りの剣を携えて魔物の討伐に向かう。その隣には一人のメイドが付き従っていた。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ264206.html", "site_id": "maniax", "fetched_at": 1794961938}