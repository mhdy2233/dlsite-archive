mages2/work/doujin/RJ279000/RJ278492_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ279000/RJ278492_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ279000/RJ278492_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ279000/RJ278492_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ279000/RJ278492_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ279000/RJ278492_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ279000/RJ278492_img_smp7.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ279000/RJ278492_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ279000/RJ278492_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ279000/RJ278492_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ279000/RJ278492_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ279000/RJ278492_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ279000/RJ278492_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ279000/RJ278492_img_smp7_100x100.jpg"], "alt": "ラブ・ポーション [ロートカイザー]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "*注意事項<br />\r\n<br />\r\n静止画です。アニメーションではありません。<br />\r\nこの作品は3D少女カスタムのスクショで作られてます。<br />\r\n<br />\r\nゲームは、ただストーリーを読み進めていき選択肢を選ぶだけです。<br />\r\n<br />\r\n<br />\r\n<br />\r\n■あらすじ<br />\r\n<br />\r\n〇学生のマモルは学校で女子達から言葉のいじめを受けていた。<br />\r\nきっかけは女子のスカートの中が見えそうでパンツを<br />\r\nチラ見していたのが始まりだった。<br />\r\n<br />\r\n<br />\r\n不登校気味になったマモルを心配して担任の教師カオリは彼の<br />\r\n自宅を訪ねて説得するが上手くいかない所か<br />\r\n<br />\r\nマモルは女の身体に慣れてないのが悪いと思い込み先生にエッチな<br />\r\nお願いをしたり身体を触ろうとする。<br />\r\n<br />\r\n<br />\r\nそんな、ある日マモルは学校でオカルト研究部員の女子から怪しい液体を<br />\r\n受け取る<br />\r\n<br />\r\nその液体は惚れ薬だった。薬の実験の効果を報告してほしいと頼まれる。<br />\r\n<br />\r\n<br />\r\n惚れ薬を手に入れたマモルは一体誰に惚れ薬を使うのか!?<br />\r\n<br />\r\n<br />\r\n時代は90年代まだネットが普及し始めた時期<br />\r\n少年達が拾ったエロ本やエロビデオテープでオナニーを<br />\r\nしていた頃になります。<br />\r\n<br />\r\n<br />\r\n<br />\r\n■エロ<br />\r\n<br />\r\n主に惚れ薬による和姦?エッチになります。<br />\r\n<br />\r\n内容はパイズリ、足コキ、フェラ、69など色々<br />\r\n体位も正上位や騎乗位やバックから突いたり<br />\r\n<br />\r\nCG枚数は122枚<br />\r\n<br />\r\n<br />\r\n<br />\r\n■システム<br />\r\n<br />\r\n・メッセージスキップ Ctrl<br />\r\n<br />\r\n・ウィンドウの一時消去 右クリック<br />\r\n<br />\r\n・回想あり<br />\r\n<br />\r\n<br />\r\n--------------------------------------------------------------------<br />\r\n<br />\r\n・音楽　SE<br />\r\n<br />\r\n　魔王魂様　　OtoLogic様　音提集様<br />\r\n<br />\r\n<br />\r\n・シナリオ<br />\r\n<br />\r\n　ロートカイザー<br />\r\n<br />\r\n<br />\r\n・制作ツール<br />\r\n<br />\r\n　ツクールMV"}]}], "description": "不登校気味の〇学生の少年が惚れ薬を使って先生、いじめっ子、オカルト女、どんな娘ともエッチできちゃうお話し", "short_introduction": "不登校気味の〇学生の少年が惚れ薬を使って先生、いじめっ子、オカルト女、どんな娘ともエッチできちゃうお話し", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ278492.html", "site_id": "maniax", "fetched_at": 1794961647}