020-09-29"}, {"category": "all", "period": "year", "rank": 38, "date": "2020"}, {"category": "all", "period": "total", "rank": 161, "date": "2021-06-13"}, {"category": "game", "period": "day", "rank": 1, "date": "2020-09-04"}, {"category": "game", "period": "week", "rank": 1, "date": "2020-09-06"}, {"category": "game", "period": "month", "rank": 1, "date": "2020-09-14"}, {"category": "game", "period": "year", "rank": 31, "date": "2020"}, {"category": "game", "period": "total", "rank": 141, "date": "2021-06-13"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ284000/RJ283271_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ284000/RJ283271_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ284000/RJ283271_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ284000/RJ283271_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ284000/RJ283271_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ284000/RJ283271_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ284000/RJ283271_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ284000/RJ283271_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ284000/RJ283271_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ284000/RJ283271_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ284000/RJ283271_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ284000/RJ283271_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ284000/RJ283271_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ284000/RJ283271_img_smp6_100x100.jpg"], "alt": "アルディアの塔 [おっえむ]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "※注意<br />\nRPGツクールMVにて制作しております。<br />\n必ず体験版で動作確認をお願い致します。<br />\n<br />\n<br />\n不具合の修正やバージョンアップ等で、内容を差し替える可能性がありますので、<br />\n会員登録してからのご購入をお勧めします。<br />\n<br />\n■あらすじ<br />\n主人公レイラは病弱な妹ルティを元気にするために、<br />\nどんな願いでも叶えることができるという魔法「アルディア」を求めて<br />\nアルディアの塔の攻略に挑戦するのだった。<br />\n<br />\n■ゲーム内容<br />\n戦闘ありのダンジョン探索型RPGです。<br />\n<br />\nCV　主人公・妹役<br />\n砂糖しお様<br />\n<br />\n●Hシーン　60シーン以上+淫乱差分<br />\n●ED数　5種(内Hなし2)<br />\n●基本CG39枚(内Hなし2枚 立ち絵のぞく)+差分<br />\n<br />\n●Hシーン喘ぎボイスあり<br />\n●回想部屋あり　クリア後全開放可能<br />\n●淫乱度、露出あり<br />\n●イベントスキップあり<br />\n●エロステータスあり<br />\n●お手軽モードあり(戦闘軽減)<br />\n◆処女クリア可能<br />\n<br />\n■Hシチュエーション<br />\n触手・スライム・オーク・オーガ・人間<br />\nダンジョンでは戦闘、敗北、トラップメイン<br />\n町ではイベント探索、売春、セクハラなどのHシーンを楽しめます。<br />\n<br />\n凌〇系多め、売春、セクハラ、露出、ボテ腹、両穴、輪○など<br />\n<br />\n<br />\n■体験版について<br />\n<br />\n・体験版から製品版へのセーブデータの<br />\n　引き継ぎはできませんので、予めご了承下さい。<br />\n<br />\n・体験版の内容は製品版時に仕様が変更される場合があります。<br />\n<br />\n━━━━━━━━━━━━━━━━━<br />\n■イラスト　おっどろっど<br />\n■ツイッター　<a href=\"https://twitter.com/o_m_tou\" target=\"_blank\">https://twitter.com/o_m_tou</a><br />\n■HP <a href=\"https://ci-en.jp/creator/3468\" target=\"_blank\">https://ci-en.jp/creator/3468</a>"}]}], "description": "戦闘ありのダンジョン探索型RPG。", "short_introduction": "戦闘ありのダンジョン探索型RPG。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ283271.html", "site_id": "maniax", "fetched_at": 1794961211}