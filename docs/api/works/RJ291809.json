rk/=/product_id/RJ01262015.html", "lang": ["ENG"]}], "rating": {"average": 4.37, "count": 1139}, "review_count": 9, "dl_count": 2135, "wishlist_count": 3744, "ranking": [{"category": "all", "period": "day", "rank": 6, "date": "2020-08-15"}, {"category": "all", "period": "week", "rank": 25, "date": "2020-08-21"}, {"category": "all", "period": "month", "rank": 68, "date": "2020-09-10"}, {"category": "game", "period": "day", "rank": 3, "date": "2020-08-15"}, {"category": "game", "period": "week", "rank": 11, "date": "2020-08-20"}, {"category": "game", "period": "month", "rank": 20, "date": "2020-09-10"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ292000/RJ291809_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ292000/RJ291809_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ292000/RJ291809_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ292000/RJ291809_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ292000/RJ291809_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ292000/RJ291809_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ292000/RJ291809_img_smp5.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ292000/RJ291809_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ292000/RJ291809_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ292000/RJ291809_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ292000/RJ291809_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ292000/RJ291809_img_smp5_100x100.jpg"], "alt": "女勇者イリス [NAGINATA SOFT]"}, "introductions": [{"type": "image", "title": "2021年3月Ver1.10へ大型アップデート実施!", "body": [{"intro": "Ver1.10で「東の国編」、「深海編」、「さびれた大剣編」、「伝説の武器編」を追加。<br />\n<br />\n基本イベントスチル数13枚追加、イベントシーン数18シーン追加、差分含むCG数54枚追加と大幅増量です(モンスターレ○プ、妊娠、サブキャラ同士のカップリングなど)。<br />\n<br />\n新規マップやボス、新スキルもそれぞれ複数追加しており、ゲームとしてもさらに楽しく遊べるようになっています。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ292000/RJ291809/03cb1c1ae50233f4af6b2e2b0c36d78d.jpg", "alt": "女勇者イリス [NAGINATA SOFT]", "title": "女勇者イリス [NAGINATA SOFT]"}, "position": "over"}]}, {"type": "image", "title": "モンスターレ○プ+妊娠イベント豊富", "body": [{"intro": "「女神の剣を携えて魔王を倒す」という王道ストーリーのRPG。<br />\nボスモンスターのほとんどに敗北エロイベントが用意されている他、ザコモンスターについても8種類分敗北イベントを用意。<br />\nさらに、その内5種類は条件を満たすとモンスターの子を妊娠します。<br />\n<br />\n下記おねだりイベントと合わせると、基本イベントCG数は64枚の大ボリュームとなっています。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ292000/RJ291809/c241a471941909302dfd6ecd0d931232.jpg", "alt": "女勇者イリス [NAGINATA SOFT]", "title": "女勇者イリス [NAGINATA SOFT]"}, "position": "left"}]}, {"type": "image", "title": "女勇者がNPCに精液をおねだり", "body": [{"intro": "女神から受け取った剣を強くするには男性の精子が必要…<br />\n女神の剣を強くするため、女勇者イリスはNPCに手コキやフェラチオ、パイズリを「おねだり」します。<br />\n対NPCイベント数は26種類以上!<br />\n「淫乱度」システムもあり、一定値を超えるとエンディングが変化します。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ292000/RJ291809/4ce85bb1d582399630c91ef6c5f044b9.jpg", "alt": "女勇者イリス [NAGINATA SOFT]", "title": "女勇者イリス [NAGINATA SOFT]"}, "position": "left"}]}, {"type": "image", "title": "サブキャラクターにもエロイベントあり", "body": [{"intro": "本作には3名のメインキャラクター(女勇者含む)、5名のサブキャラクターが登場します。<br />\n内女性キャラクターは4名で、それぞれにエロイベントが用意されています。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ292000/RJ291809/01dcb35018fcd26c2579d55cd630427e.jpg", "alt": "女勇者イリス [NAGINATA SOFT]", "title": "女勇者イリス [NAGINATA SOFT]"}, "position": "left"}]}, {"type": "image", "title": "美麗サイドビュードット絵による戦闘", "body": [{"intro": "バトルはドット絵にこだわったサイドビューシステム!<br />\n計10名のキャラクター達はそれぞれ固有のスキルを持ち、美しいエフェクトと共に画面を動き回ります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ292000/RJ291809/42fa0a90319479b7000099c9ded5a529.jpg", "alt": "女勇者イリス [NAGINATA SOFT]", "title": "女勇者イリス [NAGINATA SOFT]"}, "position": "left"}]}, {"type": "image", "title": "女勇者のエロ履歴を確認できる「精子パラメータ」", "body": [{"intro": "メニュー画面にある「精子パラメータ」でいつでも女勇者の精子摂取状況を確認できます。<br />\nメインキャラクターとサブキャラクターの交流を描く「パーティチャット」や物語の進捗を確認できる「クエストジャーナル」で物語をより深く楽しむことができます。<br />\n戦闘ではダメージで女性キャラクターの服装が破れるアーマーブレイクもあり。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ292000/RJ291809/36170dc22e75f18a5f78478713e828bf.jpg", "alt": "女勇者イリス [NAGINATA SOFT]", "title": "女勇者イリス [NAGINATA SOFT]"}, "position": "left"}]}], "description": "美麗なサイドビュードット絵を採用した王道RPG!モンスターに敗北すると発生する多彩なエロイベント!妊娠もあり", "short_introduction": "美麗なサイドビュードット絵を採用した王道RPG!モンスターに敗北すると発生する多彩なエロイベント!妊娠もあり", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ291809.html", "site_id": "maniax", "fetched_at": 1794961261}