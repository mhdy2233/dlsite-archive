"samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ295000/RJ294796_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ295000/RJ294796_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ295000/RJ294796_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ295000/RJ294796_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ295000/RJ294796_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ295000/RJ294796_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ295000/RJ294796_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ295000/RJ294796_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ295000/RJ294796_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ295000/RJ294796_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ295000/RJ294796_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ295000/RJ294796_img_smp6_100x100.jpg"], "alt": "犬耳少女わんわんちゃん [おとめプラス]"}, "introductions": [{"type": "text", "title": "犬耳少女が主人公! 敗北レ○プメインRPG!", "body": [{"intro": "犬耳族の里で暮らす元気いっぱいの犬耳少女<br />\n<br />\n『わんわんちゃん』が<br />\n<br />\n盗まれてしまった犬耳族の宝物を取り戻すため…<br />\n<br />\nそして自分を育ててくれた格闘技の師匠(くんくん老師)からひとり立ちするため…<br />\n<br />\n敗北レ○プまみれの過酷な旅に出るHRPGです。<br />\n<br />\n<br />\n<br />\n腕には自信のあるわんわんちゃんですが、<br />\n<br />\n油断するとすぐモンスターにやられます。<br />\n<br />\nザコモンスターが相手だと犯されるだけですみますが、<br />\n<br />\n一部のボスモンスターにやられると、殺されてしまうこともあります。<br />\n<br />\n<br />\n<br />\n旅の中で、わんわんちゃんの味方になってくれる人もいれば、<br />\n<br />\nわんわんちゃんを騙そうとしたり、殺そうとしてくる人も…。<br />\n<br />\n<br />\n<br />\nわんわんちゃんが無事に旅をやり遂げることができるのか、<br />\n<br />\nそれとも非業の最後を遂げてしまうのか…<br />\n<br />\n全てはプレイヤーであるあなたにかかっています。<br />\n<br />\n<br />\n<br />\n※体験版について<br />\n<br />\n体験版での動作確認をお願いします。<br />\nセーブデータの引継ぎには対応しておりません。<br />\n体験版ではオープニングイベントと、最初のダンジョンに挑戦できます。<br />\n最初のダンジョンで敗北することで、Hシーンを一つ鑑賞できます。"}]}, {"type": "image", "title": "ストーリー", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ295000/RJ294796/8c770c85b80dd9cf6e4bbfb71f22ae4a.jpg", "alt": "犬耳少女わんわんちゃん [おとめプラス]", "title": "犬耳少女わんわんちゃん [おとめプラス]"}, "position": "over"}]}, {"type": "image", "title": "バトルシステム", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ295000/RJ294796/1ab3497edbf5c7a0c132b16eff81f268.jpg", "alt": "犬耳少女わんわんちゃん [おとめプラス]", "title": "犬耳少女わんわんちゃん [おとめプラス]"}, "position": "over"}]}, {"type": "image", "title": "Hシーン", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ295000/RJ294796/601cfe238a774656272ac47320f8c282.jpg", "alt": "犬耳少女わんわんちゃん [おとめプラス]", "title": "犬耳少女わんわんちゃん [おとめプラス]"}, "position": "over"}]}, {"type": "image", "title": "キャラクター", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ295000/RJ294796/c18627d826e676638c41d82373bf6188.jpg", "alt": "犬耳少女わんわんちゃん [おとめプラス]", "title": "犬耳少女わんわんちゃん [おとめプラス]"}, "position": "over"}]}, {"type": "image", "title": "やりこみ要素", "body": [{"intro": "", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ295000/RJ294796/1154cd967084e87ba70dd7e4bb7d2755.jpg", "alt": "犬耳少女わんわんちゃん [おとめプラス]", "title": "犬耳少女わんわんちゃん [おとめプラス]"}, "position": "over"}]}], "description": "犬耳少女が主人公!敗北レ○プメインHRPG!", "short_introduction": "犬耳少女が主人公!敗北レ○プメインHRPG!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ294796.html", "site_id": "maniax", "fetched_at": 1794961134}