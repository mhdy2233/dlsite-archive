ub/images2/parts/RJ308000/RJ307428/103d4a66ecfd7b29d7f46f0022576008.jpg", "alt": "ダウナー系美少女アサシンと過ごす一週間 [もっさもっさ〜ず]", "title": "ダウナー系美少女アサシンと過ごす一週間 [もっさもっさ〜ず]"}, "position": "over"}]}, {"type": "image", "title": "ダウナー系美少女アサシン「アオイ」と一週間生活をしよう", "body": [{"intro": "アオイと一週間ボロアパートで生活することになったおっさん(主人公)。<br />\r\n会話やデートをすることによってアオイと親密な関係を築くことも出来るかも?", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ308000/RJ307428/ee3322169da11178b2b3f043eb52f002.jpg", "alt": "ダウナー系美少女アサシンと過ごす一週間 [もっさもっさ〜ず]", "title": "ダウナー系美少女アサシンと過ごす一週間 [もっさもっさ〜ず]"}, "position": "over"}]}, {"type": "image", "title": "こだわりのHシステム", "body": [{"intro": "当サークルお馴染みのコスプレシステム!<br />\r\n今回は最初から全7種類のコスプレが楽しめる!<br />\r\n(コスプレに興味がない人向けに全裸も選択できます。)<br />\r\n<br />\r\n選んだコスチュームは当然その後のHにも反映される!<br />\r\n<br />\r\n色々な姿のアオイとHを楽しもう!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ308000/RJ307428/07a95b8c3de4bf053452fca5b66b9860.jpg", "alt": "ダウナー系美少女アサシンと過ごす一週間 [もっさもっさ〜ず]", "title": "ダウナー系美少女アサシンと過ごす一週間 [もっさもっさ〜ず]"}, "position": "over"}]}, {"type": "image", "title": "進化する多彩なHシーン!", "body": [{"intro": "好きなHを好きな時に楽しもう!!<br />\r\n<br />\r\nさらにアオイの快感度が上がっていけばHレベルが上がっていき、ダウナー系の<br />\r\nアオイがどんどんエッチになっていく姿を堪能できる!<br />\r\n<br />\r\n一つのHシーンにレベル1～3まであり、全部で30シーンのHが楽しめる!<br />\r\n(Hシーンは「Hをする」の行動以外でも発生します)", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ308000/RJ307428/22e348f3b99cc5717c07bad66c70b778.jpg", "alt": "ダウナー系美少女アサシンと過ごす一週間 [もっさもっさ〜ず]", "title": "ダウナー系美少女アサシンと過ごす一週間 [もっさもっさ〜ず]"}, "position": "over"}]}], "description": "ダウナー系美少女アサシンとひとつ屋根の下で一週間一緒に暮らすアドベンチャーゲームです", "short_introduction": "ダウナー系美少女アサシンとひとつ屋根の下で一週間一緒に暮らすアドベンチャーゲームです", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ307428.html", "site_id": "maniax", "fetched_at": 1794954405}