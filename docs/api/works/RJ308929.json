HANS"]}], "rating": {"average": 4.34, "count": 735}, "review_count": 5, "dl_count": 1994, "wishlist_count": 2378, "ranking": [{"category": "game", "period": "day", "rank": 26, "date": "2020-12-31"}, {"category": "game", "period": "week", "rank": 44, "date": "2021-01-05"}, {"category": "game", "period": "month", "rank": 42, "date": "2021-01-25"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ309000/RJ308929_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ309000/RJ308929_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ309000/RJ308929_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ309000/RJ308929_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ309000/RJ308929_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ309000/RJ308929_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ309000/RJ308929_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ309000/RJ308929_img_smp6.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ309000/RJ308929_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ309000/RJ308929_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ309000/RJ308929_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ309000/RJ308929_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ309000/RJ308929_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ309000/RJ308929_img_smp6_100x100.jpg"], "alt": "ふたなりマスターズ! [ながとうい]"}, "introductions": [{"type": "text", "title": "ふたなり×触手に特化!", "body": [{"intro": "本作品は玉付きのふたなり作品でございます。<br />\nHCGは100%ふたなりか触手で構成され、人物同士のHはありませんので注意してください。<br />\n主人公がぴっちりスーツを装備していますが、Hで脱げることはありません。<br />\n<br />\n戦闘はマップ上で敵に体当たりする昔懐かしのシステムと、<br />\n固定シンボルとのコマンド選択式フロントビュー戦闘の2種類!<br />\nこちらもハイブリッドになっている作品です。<br />\n<br />\nボス敗北Hシーンでは大御所声優様のフルボイスです!<br />\n戦闘中にもいろいろたくさん喋ります!<br />\n<br />\nCV:大山チロル様<br />\n<br />\nHシーンはボイスありの敗北Hとマップ上で敵に接触すると触手に絡まれる汎用Hシーンがあります。<br />\n<br />\n難易度は3段階から選べます。<br />\n☆プレイ想定時間☆<br />\nEasy:1時間　(進むだけでクリアできます)<br />\nNormal:2時間　(ある程度のレベル上げとお金集めが必要です。程良く負けることのできるオススメ)<br />\nHard:5時間　(敵がとても強いので、最初は選ばないの推奨。2周回以降用)<br />\n※敗北メインのため、最初にEasyを選ぶとHシーンを見ることなく終わる可能性もあります。<br />\n<br />\n☆回想部屋完備☆<br />\nHシーン回想はステージをクリアしていくと開放されるシステムです。<br />\n<br />\n卵植え付け、産卵シーンあり。<br />\nアナルHあり。<br />\nはく汰様のムチムチなキャラクターと、土ノ下かえる様が描く素晴らしい触手は見応えあり!"}]}, {"type": "text", "title": "ストーリー", "body": [{"intro": "光よりも早い物質が発見され、人類が火星に移り住むようになった時代のお話。<br />\r\n<br />\r\nある日突然、火星にある名門校「ゴースト学園」からの連絡が途絶えた。<br />\r\nさらに周辺では見たこともない生命体や触手が街を荒らし回っている。<br />\r\n新人のマスターズ(宇宙警備隊みたいなもん)である「ハヤテ」は、<br />\r\n「ナビ子」のサポートを受けながら、たった1人でゴースト学園へ調査に向かうのであった!"}]}], "description": "ぴっちりスーツの「ふたなり」ヒロインが火星で暴れる「触手」どもを退治しに行くお話。敗北Hはフルボイス!CV:大山チロル", "short_introduction": "ぴっちりスーツの「ふたなり」ヒロインが火星で暴れる「触手」どもを退治しに行くお話。敗北Hはフルボイス!CV:大山チロル", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ308929.html", "site_id": "maniax", "fetched_at": 1794960903}