{"id": "RJ318773", "title": "学淫伝記", "title_romaji": "gakuindenki", "circle": {"id": "RG48813", "name": "アンダーR+", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG48813.html"}, "type": {"code": "RPG", "name": "ロールプレイング", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 990, "official_jpy": 990, "currencies": {"USD": 6.204060965239085, "EUR": 5.637890267292947, "GBP": 4.703986224447614, "TWD": 204.53277689399417, "CNY": 41.428661100998056, "KRW": 8284.518828451883, "IDR": 113402.06185567011, "VND": 159677.41935483873, "THB": 210.24018348234196, "SEK": 62.62691439090581, "HKD": 48.68405523427357, "SGD": 7.995709776733938, "CAD": 8.869815301775306, "MYR": 25.404222233056792, "BRL": 35.30116529503216, "AUD": 9.198247315784192, "PHP": 396.53929343907714, "MXN": 115.0908520210651, "NZD": 11.26879840461133, "INR": 582.8329212292476}}, "point": {"point_amount": 54, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1629385200, "file": {"type": "EXE", "size": 121909634}, "tags": [{"key": "400", "name": "学生"}, {"key": "074", "name": "制服"}, {"key": "146", "name": "拘束"}, {"key": "162", "name": "触手"}, {"key": "128", "name": "中出し"}, {"key": "134", "name": "屈辱"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 3.98, "count": 59}, "review_count": 0, "dl_count": 146, "wishlist_count": 222, "ranking": [], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ319000/RJ318773_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ319000/RJ318773_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ319000/RJ318773_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ319000/RJ318773_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ319000/RJ318773_img_smp3.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ319000/RJ318773_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ319000/RJ318773_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ319000/RJ318773_img_smp3_100x100.jpg"], "alt": "学淫伝記 [アンダーR+]"}, "introductions": [{"type": "text", "title": "あらすじ", "body": [{"intro": "凛は入学したばかりの学園に「負の気配」が漂っていることに気付いた。<br />\r\n「負の気配」とはいにしえの魔物の類から発せられるもので、それらを封じ込めている石碑の存在を知っている。<br />\r\n学園内で噂話が広がり始め、その噂の内容から「負の気配」が原因だと判断した。<br />\r\n<br />\r\n凛は石碑から立ち込める「負の気配」を抑えることができるだろうか?"}]}, {"type": "text", "title": "", "body": [{"intro": "●シンボルエンカウント<br />\nマップ上に敵アイコンに触れると戦闘がはじまります<br />\n戦闘では経験値はもらえません<br />\nエリアボスの赤い敵アイコンは逃げられません<br />\n<br />\n<br />\n●ターン制のバトル<br />\n敵の特殊攻撃で拘束されると、服を溶かされ挿入されてしまいます<br />\n初めて挿入された場合、バトルは強制終了し処女消失イベントへ(敗北扱い)<br />\n処女消失後は、バトル中に挿入・中出しされても強制終了にはなりません<br />\n<br />\n<br />\n●日数期限あり<br />\nストーリーにおいて、ゲーム内に日数があります<br />\n6日経過してしまうとゲームオーバーになります<br />\n期限内に負の気配を解決する必要があります<br />\n<br />\n日数経過条件<br />\n・バトル中に処女消失<br />\n・HPが0になる<br />\n・石碑に話しかけ「戻る」を選択<br />\n<br />\n<br />\nエンディング<br />\n・通常エンディング<br />\n・セックス中毒エンディング<br />\n・日数経過オーバーエンディング<br />\n<br />\n<br />\n処女消失シーンリスト<br />\n・スライム<br />\n・ゲイズデーモン(触手系)<br />\n・人影(セックス)<br />\n・デュエル(3P)<br />\n・人影2(お尻)<br />\n・サキュバス(催○レズ系)<br />\n・インキュバス(催○系)"}]}, {"type": "image_list", "title": "登場人物", "body": [{"intro": "月瀬　凛(つきせりん)<br />\r\n<br />\r\n両親も凛が入学した学院の卒業生で、「負の気配」関連で戦っていた。<br />\r\nそんな両親のもとに凛が生まれたので、自然と入学先は決まっていた。<br />\r\n「負の気配」に対抗するために幼い頃から護身術を教える一方、勉学を教えるのをすっかり忘れていた両親が慌てて家庭教師を呼んでなんとか入学させることが出来た。<br />\r\n<br />\r\nそのせいか、入学して早々は勉学に追われる日々で体がなまっていた。<br />\r\nそんな時に今回の騒動に対応しなくてはならなくなってしまった。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ319000/RJ318773/814eb58d9ae2791d7b632b27c20588b3.jpg", "alt": "学淫伝記 [アンダーR+]", "title": "学淫伝記 [アンダーR+]"}}]}, {"type": "image", "title": "服がなくなったら一度戻る", "body": [{"intro": "バトル中に服を失うとその日は回復しないまま学園内を探索することなります<br />\r\n<br />\r\n裸で魔物に拘束されると挿入を試みてくるので、処女のままクリアするならば注意が必要<br />\r\nダンジョン内で服を戻す方法はないので、一度戻る必要がある", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ319000/RJ318773/58a3ad919e1bf7f182db99a29a98ca6d.jpg", "alt": "学淫伝記 [アンダーR+]", "title": "学淫伝記 [アンダーR+]"}, "position": "left"}]}, {"type": "image", "title": "エッチイベント", "body": [{"intro": "・処女消失イベントシーンは7種類<br />\r\n・魔物の種類は8種類<br />\r\n<br />\r\n※ゲーム中、処女消失シーンを1つ見ると他の魔物によるイベントはなくなりますが、通常クリアした後に回想ルームへ移動するので、そこで全て見れます", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ319000/RJ318773/39d4036cff3242e1560251e7132c23e7.jpg", "alt": "学淫伝記 [アンダーR+]", "title": "学淫伝記 [アンダーR+]"}, "position": "left"}]}, {"type": "image_list", "title": "マップ上のイベント", "body": [{"intro": "石碑<br />\n<br />\n石碑に話しかけるとダンジョンから抜け出せます。<br />\n服が脱げた場合、戻らないと服は戻りません。<br />\n※1日経過します", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ319000/RJ318773/b80692b9fc6d35ff64c4876a7d1d6b68.jpg", "alt": "学淫伝記 [アンダーR+]", "title": "学淫伝記 [アンダーR+]"}}, {"intro": "ポイント<br />\r\n<br />\r\nHP・MPが回復します。<br />\r\n回復後にセーブを行うことができます。<br />\r\n※服は元に戻りません", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ319000/RJ318773/07c3341ae7efdce486bb45ffa830a838.jpg", "alt": "学淫伝記 [アンダーR+]", "title": "学淫伝記 [アンダーR+]"}}, {"intro": "経験値<br />\r\n<br />\r\n経験値がもらえます。<br />\r\nダンジョン中に2か所置かれています。<br />\r\n一度話しかけるとなくなります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ319000/RJ318773/aad57da538dccde962064fe401735a55.jpg", "alt": "学淫伝記 [アンダーR+]", "title": "学淫伝記 [アンダーR+]"}}, {"intro": "ガイコツ君<br />\r\n<br />\r\n経験値がもらえます。<br />\r\nダンジョンの中にいます。<br />\r\n一度話しかけるとなくなります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ319000/RJ318773/70f0152bcc1e3046bb35f6d2c6685148.jpg", "alt": "学淫伝記 [アンダーR+]", "title": "学淫伝記 [アンダーR+]"}}]}], "description": "主人公の凛が「負の気配」を放つ魔物の類を抑え込むため、魔物を倒す為に夜の学院に挑むのであった", "short_introduction": "主人公の凛が「負の気配」を放つ魔物の類を抑え込むため、魔物を倒す為に夜の学院に挑むのであった", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ318773.html", "site_id": "maniax", "fetched_at": 1794960390}