23-12-04"}, {"category": "game", "period": "day", "rank": 1, "date": "2023-11-21"}, {"category": "game", "period": "week", "rank": 4, "date": "2023-11-25"}, {"category": "game", "period": "month", "rank": 16, "date": "2023-12-04"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ325000/RJ324700_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ325000/RJ324700_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ325000/RJ324700_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ325000/RJ324700_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ325000/RJ324700_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ325000/RJ324700_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ325000/RJ324700_img_smp5.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ325000/RJ324700_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ325000/RJ324700_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ325000/RJ324700_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ325000/RJ324700_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ325000/RJ324700_img_smp5_100x100.jpg"], "alt": "蒼天のステラ [大人の道楽]"}, "introductions": [{"type": "text", "title": "天からの使い、無垢な戦乙女は地上へ降り立つ!", "body": [{"intro": "--------------現在のバージョンは1.2です--------------<br />\n<br />\n神々による加護を受け人々が暮らすアルトラウム、<br />\nその片隅の小さな国に彼女は降り立った。<br />\n愛の神から受けた任務と、そして己の修行のために。<br />\n<br />\n人間に興味がなく慢心しやすいドジで無防備な乙女が<br />\n果たしてこの地で一人前になれるだろうか?<br />\n<br />\n半人前戦乙女のステラが、初めての何も知らない地上で<br />\n人間たちに翻弄されつつ成長する1人旅エロRPGです。<br />\n<br />\nえっちな知識はあるけどまだ処女で気の強い主人公が<br />\n勝手の分からない土地で流されセクハラされるシチュがメイン!<br />\n<br />\n◆女主人公のメインクエ1本道+サブクエな中編RPGです<br />\n◆戦闘は基本1対1のオーソドックスなフロントビューバトル<br />\n◆エロシーンはほぼ人間相手のセクハラと軽い凌○メイン<br />\n　+一部に特定男キャラとの恋愛要素も有り<br />\n◆エロCG基本47枚+攻略相手CG12枚<br />\n◆戦闘難易度選択、イケメンON/OFF機能あり<br />\n◆”セクハラ凌○なし”で遊べる乙女モードあり<br />\n<br />\n◆このゲームはRPGツクールMVで作られています<br />\n<br />\n<br />\n※体験版0.4以降のセーブデータは製品版に引き継げます。"}]}], "description": "女主人公がえっちな目にあったり和姦もできたりする中編RPG", "short_introduction": "女主人公がえっちな目にあったり和姦もできたりする中編RPG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ324700.html", "site_id": "maniax", "fetched_at": 1794952075}