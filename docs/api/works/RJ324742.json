tegory": "game", "period": "month", "rank": 16, "date": "2021-06-03"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ325000/RJ324742_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ325000/RJ324742_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ325000/RJ324742_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ325000/RJ324742_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ325000/RJ324742_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ325000/RJ324742_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ325000/RJ324742_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ325000/RJ324742_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ325000/RJ324742_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ325000/RJ324742_img_smp8.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ325000/RJ324742_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ325000/RJ324742_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ325000/RJ324742_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ325000/RJ324742_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ325000/RJ324742_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ325000/RJ324742_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ325000/RJ324742_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ325000/RJ324742_img_smp8_100x100.jpg"], "alt": "東方虹龍洞 〜 Unconnected Marketeers. [上海アリス幻樂団]"}, "introductions": [{"type": "text", "title": "", "body": [{"intro": "東方Project第18弾<br />\n上海アリス幻樂団による弾幕シューティング!<br />\n<br />\n花火のように色鮮やかな弾幕の数々を避けて、敵を撃破。<br />\nテクニックと記憶力を駆使して、短期集中決戦に挑め!<br />\n<br />\n本作では様々な効果を持つアビリティカードを装備してプレイできる。<br />\n<br />\nアビリティカードとは何なのか?<br />\n一体誰が作ったものなのか?<br />\n何故皆が売買しているのか?<br />\n果たして———<br />\n<br />\n全てが見当付かないまま、巫女は調査に出る。"}]}, {"type": "image_list", "title": "キャラクター紹介", "body": [{"intro": "楽園の素敵な巫女<br />\r\n博麗 霊夢<br />\r\n<br />\r\nちまたに不思議なカードが流通していた。<br />\r\nそのカードには人間、妖怪達の秘密が込められている様に感じ、調査に行くしかないと思った。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ325000/RJ324742/c89d8adf878bbd04a8d1beaab37a6099.jpg", "alt": "東方虹龍洞 〜 Unconnected Marketeers. [上海アリス幻樂団]", "title": "東方虹龍洞 〜 Unconnected Marketeers. [上海アリス幻樂団]"}}, {"intro": "普通の魔法使い<br />\r\n霧雨 魔理沙<br />\r\n<br />\r\nちまたに不思議なカードが流通していた。<br />\r\nカードには多種多様の魔力が込められていた。こんなに面白いカード、他の人よりも早く集めなければいけないと思った。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ325000/RJ324742/7766194a64d3fd8e3fdc81029d8e3ca7.jpg", "alt": "東方虹龍洞 〜 Unconnected Marketeers. [上海アリス幻樂団]", "title": "東方虹龍洞 〜 Unconnected Marketeers. [上海アリス幻樂団]"}}, {"intro": "瀟洒なメイド<br />\r\n十六夜 咲夜<br />\r\n<br />\r\nちまたに不思議なカードが流通していた。<br />\r\nそのカードにパチュリー様が非常に興味を持たれ、全て回収するように命じられた。中にはお嬢様の魔力が込められたカードもあり……", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ325000/RJ324742/4185854aa5474a774f8bda3712c19838.jpg", "alt": "東方虹龍洞 〜 Unconnected Marketeers. [上海アリス幻樂団]", "title": "東方虹龍洞 〜 Unconnected Marketeers. [上海アリス幻樂団]"}}, {"intro": "奇跡の現人神<br />\r\n東風谷 早苗<br />\r\n<br />\r\nちまたに不思議なカードが流通していた。<br />\r\nカードの売人は妖怪の山を中心に活動していた。推測するにカードの生産元も近くにあるのではないか。山にある守矢神社はそれを看過できなかった。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ325000/RJ324742/fad2c1fc0dd394ea256ec2b93e4731d2.jpg", "alt": "東方虹龍洞 〜 Unconnected Marketeers. [上海アリス幻樂団]", "title": "東方虹龍洞 〜 Unconnected Marketeers. [上海アリス幻樂団]"}}]}], "description": "買う、売る、貰う、手放す いつから人間は所有権を自由に扱えると勘違いしたのか レインボーでイマモリアルなシューティング幻想!", "short_introduction": "買う、売る、貰う、手放す いつから人間は所有権を自由に扱えると勘違いしたのか レインボーでイマモリアルなシューティング幻想!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ324742.html", "site_id": "home", "fetched_at": 1794960621}