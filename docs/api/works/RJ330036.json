es": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ331000/RJ330036_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ331000/RJ330036_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ331000/RJ330036_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ331000/RJ330036_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ331000/RJ330036_img_smp3.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ331000/RJ330036_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ331000/RJ330036_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ331000/RJ330036_img_smp3_100x100.jpg"], "alt": "ケモノの勉強会でイキヌキBJ [スタジオらびらば]"}, "introductions": [{"type": "text", "title": "作品概要", "body": [{"intro": "本作 ケモイキBJ は、メスケモとオスケモが勉強会の最中にお互いの身体をおべんきょうし、<br />\n気持ちよくし合う方法を学んでいくゲームです。 <br />\n<br />\nブラックジャックで勝つと女の子が攻めのシーンに、<br />\n逆に負ければ女の子が受けのシーンになります。"}]}, {"type": "image_list", "title": "ゲームシステム", "body": [{"intro": "お勉強は簡単。成績を伸ばしたい科目を選ぶだけ。<br />\r\nやる気がなくなったら、Hな「イキヌキ」でリフレッシュ!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ331000/RJ330036/ce70cf9576300a6129b09edd3d94a142.jpg", "alt": "ケモノの勉強会でイキヌキBJ [スタジオらびらば]", "title": "ケモノの勉強会でイキヌキBJ [スタジオらびらば]"}}, {"intro": "2本先取のブラックジャックで勝負。勝っても負けてもHシーンへ進むのでストレスなし!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ331000/RJ330036/999931615def38288247169ffa808a1c.jpg", "alt": "ケモノの勉強会でイキヌキBJ [スタジオらびらば]", "title": "ケモノの勉強会でイキヌキBJ [スタジオらびらば]"}}, {"intro": "ブラックジャックでの勝敗に応じてHイベントの内容が変化。<br />\r\n<br />\r\n回想機能から勝利バージョン・敗北バージョンのどちらも見られるので見逃すことはありません。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ331000/RJ330036/0e950dc31cfb592508a86fb7ed2bd7e7.jpg", "alt": "ケモノの勉強会でイキヌキBJ [スタジオらびらば]", "title": "ケモノの勉強会でイキヌキBJ [スタジオらびらば]"}}, {"intro": "プレイ内容を自由にチョイスできるフリーHモードも搭載。フリーHモードで追加される差分もあり!", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ331000/RJ330036/9828a98807bf556d5cccd4733b24f4ee.jpg", "alt": "ケモノの勉強会でイキヌキBJ [スタジオらびらば]", "title": "ケモノの勉強会でイキヌキBJ [スタジオらびらば]"}}]}, {"type": "text", "title": "ボリューム", "body": [{"intro": "基本Hシーン数　:8 (シーンごとに、ゲームでの勝敗に応じた展開変化あり)<br />\nオマケHイラスト　:1<br />\n差分　:多数<br />\n断面図差分　:あり<br />\nオノマトペ演出　:あり"}]}, {"type": "image_list", "title": "キャラクター", "body": [{"intro": "【星空 スス(ホシゾラ　スス)】<br />\r\n<br />\r\n今までノリと明るさで生きてきたおバカ。<br />\r\n成績が振るわず、除籍の危機に陥る。<br />\r\n<br />\r\n保健体育の学習で知ったエッチなことにキョウミシンシン。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ331000/RJ330036/1bb802c47abf34161bd3845808f284b7.jpg", "alt": "ケモノの勉強会でイキヌキBJ [スタジオらびらば]", "title": "ケモノの勉強会でイキヌキBJ [スタジオらびらば]"}}, {"intro": "", "image_info": null}, {"intro": "【守家  保(モリヤ　タモツ)】<br />\r\n<br />\r\n真面目に勉強してきた若者。<br />\r\n<br />\r\nススに泣き付かれ、勉強会で面倒をみることを約束してしまう。<br />\r\n<br />\r\n堅物のつもりだったが、性的なことに興味津々。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ331000/RJ330036/ed02335387c40de5181eed287487e953.jpg", "alt": "ケモノの勉強会でイキヌキBJ [スタジオらびらば]", "title": "ケモノの勉強会でイキヌキBJ [スタジオらびらば]"}}]}, {"type": "text", "title": "その他", "body": [{"intro": "本作はWOLF RPG エディターにて開発した作品です。<br />\r\n必ず体験版にて内容、動作を確認の後、購入をご検討ください。"}]}], "description": "メスケモとオスケモが勉強会の最中にお互いの身体をおべんきょうし、気持ちよくし合う方法を学んでいくゲームです。 ブラックジャックで勝つと女の子が攻めのシーンに、逆に負ければ女の子が受けのシーンになります。", "short_introduction": "メスケモとオスケモが勉強会の最中にお互いの身体をおべんきょうし、気持ちよくし合う方法を学んでいくゲームです。 ブラックジャックで勝つと女の子が攻めのシーンに、逆に負ければ女の子が受けのシーンになります。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ330036.html", "site_id": "maniax", "fetched_at": 1794960514}