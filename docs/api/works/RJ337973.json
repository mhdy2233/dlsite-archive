e", "period": "day", "rank": 3, "date": "2021-08-08"}, {"category": "game", "period": "week", "rank": 6, "date": "2021-08-14"}, {"category": "game", "period": "month", "rank": 9, "date": "2021-09-04"}, {"category": "game", "period": "year", "rank": 197, "date": "2021"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ338000/RJ337973_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ338000/RJ337973_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ338000/RJ337973_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ338000/RJ337973_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ338000/RJ337973_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ338000/RJ337973_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ338000/RJ337973_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ338000/RJ337973_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ338000/RJ337973_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ338000/RJ337973_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ338000/RJ337973_img_smp9.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ338000/RJ337973_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ338000/RJ337973_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ338000/RJ337973_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ338000/RJ337973_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ338000/RJ337973_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ338000/RJ337973_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ338000/RJ337973_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ338000/RJ337973_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ338000/RJ337973_img_smp9_100x100.jpg"], "alt": "爆乳天国エンジェルビッチーズ [みかん畑]"}, "introductions": [{"type": "text", "title": "『超高クオリティ』のエロシーン動画", "body": [{"intro": "◆『超高クオリティ』のエロシーン動画<br />\r\n本編で登場する爆乳娘たちのド迫力で揺れる爆乳エロシーン動画は必見!<br />\r\n体験版もありますので、動作確認も含めて体験版をプレイすることをおススメしています!<br />\r\n<br />\r\n◆『フルボイス』エロシーン<br />\r\nフルボイスエロシーン動画を多数収録!<br />\r\nそれに加えサブイベントやエロシーン以外でもボイスが流れます!<br />\r\n感情移入できること間違いなし!!<br />\r\n<br />\r\n◆分岐するエロシーン<br />\r\nバトルに勝っても負けてもそれぞれの結果に応じたエロシーンが見られます!<br />\r\nバトル相手が男性だったら・・・<br />\r\n勝ったらエンジェルビッチたちが搾り取っちゃう!負けたら逆に犯されちゃう!?<br />\r\nバトル相手が女性だったら・・・<br />\r\n勝ったら主人公の俺とセックス!負けたらエンジェルオークに犯されちゃう!?"}]}, {"type": "text", "title": "バトルと登場キャラ", "body": [{"intro": "◆バトル<br />\r\nスキルを駆使してダメージを与え、おっぱいをポロリさせよう!<br />\r\nポロリさせたあとはそのままやっつけて念願のセックス!<br />\r\nパーティーは4キャラから選択可能。個性あふれるキャラとスキルを駆使してバトルに勝利しよう!<br />\r\n<br />\r\n◆総勢12名の女性キャラ登場<br />\r\nビッチギャル、○リ爆乳、ケモミミ、くノ一、和服美人、バニーガール、競泳水着、チャイナドレス・・・等<br />\r\n豊富なジャンルの女の子たちが多数登場!!"}]}, {"type": "text", "title": "快適機能", "body": [{"intro": "◆さくさくプレイとじっくりプレイ<br />\nさくさくプレイしたい人は・・・<br />\n全部すっとばして『ハート』のマークだけ辿っていけばOK!<br />\nエロシーンをじゃんじゃん見ることができます!<br />\nじっくりプレイしたい人は・・・<br />\n『ビックリ』マークがついているサブイベントをすべて回収していこう!<br />\nキャラのいろいろなストーリーが見られるので、感情移入ができてよりエロシーンを楽しめます!<br />\n<br />\n◆その他<br />\n『AUTOモード』『回想モード』『スキップ機能』『シーン開放部屋』『AUTOバトル』を搭載!<br />\n<br />\n◆やりこみ要素<br />\nクリア後、裏ボスが待ち構えている!?<br />\nとても強いですがご褒美爆乳エロシーンを見るために倒そう!"}]}, {"type": "text", "title": "あらすじ", "body": [{"intro": "◆あらすじ<br />\r\n人間と天使の性行為は人間にとって常識を逸脱する快楽が得られる。<br />\r\nその代償として脱力感で2～3日立てなくなってしまうという。<br />\r\n過ちを○す人間に罰を与えるエンジェルビッチたちは<br />\r\n今日も兵隊を引き連れて人間の街に繰り出した。<br />\r\nその兵隊の一人が今回の物語の主役『俺』だ!<br />\r\nエンジェルビッチたちと共に、街の人間たちを犯しまくって罰を与えるのだ!!"}]}, {"type": "text", "title": "クリア済みセーブデータを配布中", "body": [{"intro": "◆ci-enにて「爆乳天国エンジェルビッチーズ」のクリア済みセーブデータを配布中<br />\n無料プランをフォローしてる方限定で「爆乳天国エンジェルビッチーズ」のクリア済みセーブデータを配布しております!<br />\n<a href=\"https://ci-en.dlsite.com/creator/9714/article/618142\" target=\"_blank\">https://ci-en.dlsite.com/creator/9714/article/618142</a><br />\n<br />\n◆仕様<br />\nRPGツクールMVにて制作していますので動作に必要なスペック等はRPGツクールの仕様に準じます。<br />\n体験版での動作確認を推奨致します。<br />\n<br />\n◆サークルサイト<br />\n『みかん畑』<br />\n<a href=\"https://ci-en.dlsite.com/creator/9714\" target=\"_blank\">https://ci-en.dlsite.com/creator/9714</a>"}]}], "description": "超ビッチな爆乳天使たちを引き連れてヤりまくれ!!", "short_introduction": "超ビッチな爆乳天使たちを引き連れてヤりまくれ!!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ337973.html", "site_id": "maniax", "fetched_at": 1794960409}