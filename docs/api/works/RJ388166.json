4-01-15"}, {"category": "all", "period": "month", "rank": 10, "date": "2024-01-31"}, {"category": "game", "period": "day", "rank": 1, "date": "2024-01-13"}, {"category": "game", "period": "week", "rank": 1, "date": "2024-01-15"}, {"category": "game", "period": "month", "rank": 7, "date": "2024-01-31"}, {"category": "game", "period": "year", "rank": 153, "date": "2024"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ389000/RJ388166_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ389000/RJ388166_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ389000/RJ388166_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ389000/RJ388166_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ389000/RJ388166_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ389000/RJ388166_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ389000/RJ388166_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ389000/RJ388166_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ389000/RJ388166_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ389000/RJ388166_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ389000/RJ388166_img_smp9.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ389000/RJ388166_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ389000/RJ388166_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ389000/RJ388166_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ389000/RJ388166_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ389000/RJ388166_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ389000/RJ388166_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ389000/RJ388166_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ389000/RJ388166_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ389000/RJ388166_img_smp9_100x100.jpg"], "alt": "エージェント・シリウス～快楽脆弱な彼女だって学園を洗脳怪人達から守りたい!～ [ルナリアン]"}, "introductions": [{"type": "text", "title": "学園を快楽洗脳で支配しようとする怪人と戦う美少女探偵!その正体は・・・敏腕エージェント!?", "body": [{"intro": "※ストーリー<br />\r\n<br />\r\n探偵部部長を務める朱雀紅(あけすずべに)は、学園に不穏な空気を感じ取っていた。<br />\r\n次々に起こる不可思議な事件・・・淫靡で不穏な出来事の数々・・・<br />\r\n秘密結社でエージェントも務めている紅はその正体を知っている。<br />\r\nそれは快楽洗脳で人々を支配しようとする怪人の暗躍だった。<br />\r\n<br />\r\n浮かび上がる8人の容疑者。<br />\r\n<br />\r\n学園が怪人に堕とされる前に、犯人を突き止めてその野望を阻止する・・・!<br />\r\nそして紅は、相棒でお目付け役の白虎撫子(しらとらなでしこ)とともに捜査を開始する!<br />\r\n<br />\r\n<br />\r\n※ゲーム概要<br />\r\n<br />\r\nこのゲームは探索型AVGです。<br />\r\nゲームの流れは聞き込み→犯人特定→戦闘→勝利という形で進んでいきます。<br />\r\n<br />\r\n戦闘にはもちろん敗北もあります。<br />\r\n負けてしまった時は快楽洗脳に屈して、怪人の手先になってしまう堕ちルートも!<br />\r\nその他にも収拾要素として、キャラノート(人物紹介)、怪人図鑑、ワールドガイド(世界設定)を集めていくのもあります。<br />\r\nゲーム本編では語られない、様々な設定の数々をお愉しみ頂ければ。<br />\r\n<br />\r\nノクターンノベルズで連載中の閃光超隊アイリスブレイドとキャラクターなどの世界観を同じにしています。<br />\r\n<a href=\"https://novel18.syosetu.com/n9555gp/\" target=\"_blank\">https://novel18.syosetu.com/n9555gp/</a> #narou #narouN9555GP<br />\r\n<br />\r\n※エロシーン<br />\r\n<br />\r\nメインヒロインである朱雀紅は、特殊体質の為に快楽汚染度がある程度上昇してしまうと、オナニーして発散する必要があります。<br />\r\nその為、快楽汚染度が上がるごとにオナニーイベントが発生します。<br />\r\nもちろん、汚染が酷くなると、その行為もエスカレートしていきます。<br />\r\n学園を支配しようとする怪人達に負けると、敗北H、そして堕ち後のご奉仕Hがある堕ちルートに入ります。<br />\r\n<br />\r\n具体例:ブラインドポイゾンの場合<br />\r\n<br />\r\n”目隠しフェチ”の快楽を増幅し、蔓延させる怪人に敗北すると・・・<br />\r\nコウモリマスクを付けられて、為す術もないまま弄ばれてしまう。<br />\r\nだが乳首いじりや、フェラなどで気持ちよくさせられて堕ちてしまう・・・<br />\r\n<br />\r\n先に堕ちていた相棒と共に、ご主人様に奉仕する。<br />\r\nそして他のヒロイン達をどうやって堕としたのかを、ご主人様に報告する・・・<br />\r\n<br />\r\n※体験版について<br />\r\n<br />\r\n本編の冒頭部分から、怪人との戦闘までを収録しています。<br />\r\n本編の内容と全て重複しております。<br />\r\nセーブデータの引き継ぎなどはありません。<br />\r\n<br />\r\n※バグについて<br />\r\n<br />\r\nもしバグなどをお気づきの際には、宜しければci-enのコメント欄などに<br />\r\nご一報ください。<br />\r\n確認して修正させて頂き、パッチを配布致します。<br />\r\n<a href=\"https://ci-en.dlsite.com/creator/11631\" target=\"_blank\">https://ci-en.dlsite.com/creator/11631</a>"}]}, {"type": "image_list", "title": "登場人物紹介", "body": [{"intro": "朱雀　紅(あけすず　べに)<br />\r\n<br />\r\n探偵部部長。<br />\r\n「番照」のエージェント・コードネームはシリウス。<br />\r\n大好きな撫子に素直になれずにいる・・・", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ389000/RJ388166/d154a669f4529f00e9a948edc0c89866.jpg", "alt": "エージェント・シリウス～快楽脆弱な彼女だって学園を洗脳怪人達から守りたい!～ [ルナリアン]", "title": "エージェント・シリウス～快楽脆弱な彼女だって学園を洗脳怪人達から守りたい!～ [ルナリアン]"}}, {"intro": "白虎　撫子(しらとら　なでしこ)<br />\r\n<br />\r\n探偵部副部長。<br />\r\n暴走しがちな紅のストッパー兼相棒。<br />\r\n怪人に襲われると、即堕ちしちゃう困った子。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ389000/RJ388166/2a9b52696f06cd1b662c3848a3510c3b.jpg", "alt": "エージェント・シリウス～快楽脆弱な彼女だって学園を洗脳怪人達から守りたい!～ [ルナリアン]", "title": "エージェント・シリウス～快楽脆弱な彼女だって学園を洗脳怪人達から守りたい!～ [ルナリアン]"}}, {"intro": "鬼塚　百合花(おにずか　ゆりか)<br />\r\n<br />\r\n生徒会長。<br />\r\n文武両道、頼りになるお嬢様。<br />\r\nだけど紅は超苦手・・・8人の容疑者の一人。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ389000/RJ388166/558eeb1109f005e5bdc2cfee68d215fd.jpg", "alt": "エージェント・シリウス～快楽脆弱な彼女だって学園を洗脳怪人達から守りたい!～ [ルナリアン]", "title": "エージェント・シリウス～快楽脆弱な彼女だって学園を洗脳怪人達から守りたい!～ [ルナリアン]"}}, {"intro": "犬飼・アンナ・メープル(いぬかいあんなめーぷる)<br />\r\n<br />\r\n探偵部顧問。<br />\r\n紅達のクラスの担任教師。<br />\r\n金髪ハーフの帰国子女。快楽洗脳には一応、抵抗するが・・・", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ389000/RJ388166/9ae3c4daa892e4c0e05b0100d2c2040c.jpg", "alt": "エージェント・シリウス～快楽脆弱な彼女だって学園を洗脳怪人達から守りたい!～ [ルナリアン]", "title": "エージェント・シリウス～快楽脆弱な彼女だって学園を洗脳怪人達から守りたい!～ [ルナリアン]"}}]}, {"type": "image_list", "title": "", "body": [{"intro": "鈴懸いるか(すずかけいるか)<br />\r\n<br />\r\n探偵部元部長。<br />\r\n紅達の1年先輩。<br />\r\n推理小説大好きだが、犯人を当てられたことがない・・・", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ389000/RJ388166/cb31eca6eb85bb70317940a09fa10474.jpg", "alt": "エージェント・シリウス～快楽脆弱な彼女だって学園を洗脳怪人達から守りたい!～ [ルナリアン]", "title": "エージェント・シリウス～快楽脆弱な彼女だって学園を洗脳怪人達から守りたい!～ [ルナリアン]"}}]}], "description": "学園を快楽洗脳で支配しようとする怪人と戦う美少女探偵!その正体は・・・敏腕エージェント!?", "sho