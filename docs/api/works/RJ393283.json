iod": "month", "rank": 3, "date": "2022-10-18"}, {"category": "all", "period": "year", "rank": 75, "date": "2022"}, {"category": "all", "period": "total", "rank": 356, "date": "2023-08-26"}, {"category": "game", "period": "day", "rank": 1, "date": "2022-09-30"}, {"category": "game", "period": "week", "rank": 2, "date": "2022-10-01"}, {"category": "game", "period": "month", "rank": 3, "date": "2022-10-18"}, {"category": "game", "period": "year", "rank": 61, "date": "2022"}, {"category": "game", "period": "total", "rank": 293, "date": "2023-08-26"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ394000/RJ393283_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ394000/RJ393283_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ394000/RJ393283_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ394000/RJ393283_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ394000/RJ393283_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ394000/RJ393283_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ394000/RJ393283_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ394000/RJ393283_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ394000/RJ393283_img_smp7.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ394000/RJ393283_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ394000/RJ393283_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ394000/RJ393283_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ394000/RJ393283_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ394000/RJ393283_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ394000/RJ393283_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ394000/RJ393283_img_smp7_100x100.jpg"], "alt": "竜姫ははらぺこなので [+蟹]"}, "introductions": [{"type": "image", "title": "", "body": [{"intro": "本作は、探索要素をメインとしたARPGです。<br />\r\n<br />\r\n&lt;ゲームの流れ&gt;<br />\r\n(1)MAPを探索したりモンスターを倒して、エーファへ送る食べ物を集める。<br />\r\n(2)エーファからご褒美としてスキルを受け取り強くなる。<br />\r\n(3)マップ内のボスを倒し、メインとなる食材を手に入れる。<br />\r\n<br />\r\n全5ステージ+αで構成され、体験版では1ステージ目をまるまる遊べます。<br />\r\n体験版Hシーン数:8シーン<br />\r\n内訳:エーファ1、雑魚3(差分2ずつ)、ボス1<br />\r\n<br />\r\n※Hシーンにアニメーションを起用しております。<br />\r\n若干の負荷がかかるため、お使いのPCで正しく表示されるかのご確認として、<br />\r\n購入前に体験版での動作確認を推奨いたします。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ394000/RJ393283/113de14544cb7efaefcac25117147663.jpg", "alt": "竜姫ははらぺこなので [+蟹]", "title": "竜姫ははらぺこなので [+蟹]"}, "position": "over"}]}, {"type": "image", "title": "スクリーンショット紹介", "body": [{"intro": "※アクションの難易度は比較的ゆるめですが、<br />\r\n楽々クリアしたいという人のために隠し最強武器も用意しています。<br />\r\n詳しくは同梱のreadme.txtにあるのでご参考ください。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ394000/RJ393283/d3733530af12f00d117251b0169718bf.jpg", "alt": "竜姫ははらぺこなので [+蟹]", "title": "竜姫ははらぺこなので [+蟹]"}, "position": "over"}]}, {"type": "image_list", "title": "キャラ紹介", "body": [{"intro": "■プフェル<br />\r\n<br />\r\n本作の主人公。<br />\r\n<br />\r\n執事。よく働く。<br />\r\n孤児だったところを拾われて、<br />\r\n物心つく前からエーファの屋敷で働いている。<br />\r\n<br />\r\nおどおどしているけれど、意外と楽観的。<br />\r\n小さい。ひ弱。むっつり。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ394000/RJ393283/be14af2b807319760ab5952b97b8ecaf.jpg", "alt": "竜姫ははらぺこなので [+蟹]", "title": "竜姫ははらぺこなので [+蟹]"}}, {"intro": "■エーファ<br />\r\n<br />\r\n本作のメインヒロイン。<br />\r\n<br />\r\n莫大な魔力を持つ竜族の姫。<br />\r\n強き種の責務として、世界の調和と均衡のため、<br />\r\n様々な争いや問題を解決することを生業としている。<br />\r\n<br />\r\n自由でマイペース。<br />\r\nよく食べよく眠る。<br />\r\n態度も体も胸も大きい。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ394000/RJ393283/2f3def7e41a0b15725d6136f1b78a232.jpg", "alt": "竜姫ははらぺこなので [+蟹]", "title": "竜姫ははらぺこなので [+蟹]"}}]}, {"type": "image", "title": "Hシーンについて", "body": [{"intro": "&lt;本編シーン数&gt;<br />\r\n総数:54シーン<br />\r\n<br />\r\n&lt;内訳&gt;<br />\r\n・メインヒロイン　:11シーン<br />\r\n・雑魚モンスター娘:31シーン(17キャラ)<br />\r\n・ボスモンスター娘:12シーン(12キャラ)<br />\r\n<br />\r\n<br />\r\nメインヒロインであるエーファとのシーンは、<br />\r\nストーリーの進行や、探索によって発見されるサブイベントで見ることが出来ます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ394000/RJ393283/58f52eb05fdee6e078cb474d0df7c33b.jpg", "alt": "竜姫ははらぺこなので [+蟹]", "title": "竜姫ははらぺこなので [+蟹]"}, "position": "under"}]}, {"type": "image", "title": "雑魚モンスター娘による様々な逆レ○プ", "body": [{"intro": "一部モンスター娘をのぞいて1種族につき2つのシーンがあります。<br />\r\nモンスター娘からの攻撃で戦闘不能になるとHシーンに移ります。<br />\r\n(一度見た後はスキップ可)", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ394000/RJ393283/112184190a2200dbfd2c22a61c401a9f.jpg", "alt": "竜姫ははらぺこなので [+蟹]", "title": "竜姫ははらぺこなので [+蟹]"}, "position": "under"}]}, {"type": "image", "title": "固有モンスター娘による徹底凌○", "body": [{"intro": "ステージボスや名前付きのモンスター娘が12体います。<br />\r\nボスモンスター娘に関しては撃破でも敗北でもHシーンが見られます。<br />\r\nそれ以外で出会うキャラはストーリー進行や探索で見ることが出来ます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ394000/RJ393283/cecd90461aa1412255ab1aa873322400.jpg", "alt": "竜姫ははらぺこなので [+蟹]", "title": "竜姫ははらぺこなので [+蟹]"}, "position": "under"}]}], "description": "モン娘×少年執事×はらぺこ姫!ゆるふわサバイバル奮闘記。おねショタ、いちゃラブ、逆レ○プ!さまざまなシチュエーションをアニメーションつきCGで!", "short_introduction": "モン娘×少年執事×はらぺこ姫!ゆるふわサバイバル奮闘記。おねショタ、いちゃラブ、逆レ○プ!さまざまなシチュエーションをアニメーションつきCGで!", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ393283.html", "site_id": "maniax", "fetched_at": 1794955590}