023-09-14"}, {"category": "game", "period": "day", "rank": 1, "date": "2023-08-16"}, {"category": "game", "period": "week", "rank": 4, "date": "2023-08-20"}, {"category": "game", "period": "month", "rank": 13, "date": "2023-09-10"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ412000/RJ411294_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ412000/RJ411294_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ412000/RJ411294_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ412000/RJ411294_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ412000/RJ411294_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ412000/RJ411294_img_smp4.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ412000/RJ411294_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ412000/RJ411294_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ412000/RJ411294_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ412000/RJ411294_img_smp4_100x100.jpg"], "alt": "ドミネートプラン [破顔研]"}, "introductions": [{"type": "text", "title": "両手フリー状態での戦闘", "body": [{"intro": "強いお姉さんが1対多数で嬲られて嬌声を上げてしまう。そんなゲーム。<br />\n<br />\n◆ストーリー<br />\n─────────────────────────<br />\n怪物駆除を行う組織に所属する「ウユハート」は、<br />\n単独で新型兵器のテストを行う。<br />\n手練れの彼女とはいえ、全く扱ったことのない武器を用いた<br />\n怪物駆除任務であるため、想像以上の困難が待ち受けていた。<br />\n<br />\n◆内容<br />\n─────────────────────────<br />\n戦闘中両手をフリーにしたい人。<br />\nそんな人たちに向けたゲームです。<br />\n<br />\n設定した攻撃を自動実施して戦う、<br />\nヒロインピンチ(ヒロピン)物の戦闘エロオンリーのRPGです<br />\n撤退時に操作が必要ですが、戦闘は自動進行します。<br />\n的確な攻撃を設定して怪物を素早く倒してください。<br />\n<br />\n◆エロ演出<br />\n─────────────────────────<br />\n怪物は口に侵入してきたり、胸に吸いつき母乳搾取を試みたり、<br />\n下部に侵入して触手で愛撫したり、尻に舌を挿入したり。<br />\n複数部位の愛撫や、エナジードレインを試みたりと<br />\n多彩な攻撃を行ってきます。<br />\n特に胸を積極的に狙ってきます。<br />\n<br />\n敵は1種類につき6種類の攻撃を持っており、<br />\nアニメーション付きの攻撃を5つ用意しています。<br />\n<br />\n怪物による執拗な攻撃で彼女の身体は次第に汚染・開発されてしまい、<br />\n最初は我慢できていた彼女も妖艶な声を上げるようになるかもしれません。<br />\n<br />\n◆キャラクター音声<br />\n─────────────────────────<br />\nウユハート 役:甘曽禰鈴音<br />\nHP: <a href=\"https://ringringamazone.wixsite.com/voice-sample\" target=\"_blank\">https://ringringamazone.wixsite.com/voice-sample</a><br />\nTwitterアカウント: @ring_amazone<br />\n<br />\n◆体験版<br />\n─────────────────────────<br />\n販売サイトにて登録されている体験版とは別に、<br />\n敵12体と戦える動作確認版をCi-enにて公開中(100円)です。<br />\n<br />\n◆注意事項<br />\n─────────────────────────<br />\n必ず体験版にて動作確認をお願いいたします。"}]}], "description": "本当は強いお姉さんが怪物に嬲られて悲鳴をあげちゃう系RPG", "short_introduction": "本当は強いお姉さんが怪物に嬲られて悲鳴をあげちゃう系RPG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ411294.html", "site_id": "maniax", "fetched_at": 1794952652}