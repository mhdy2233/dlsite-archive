5, "date": "2022-10-28"}, {"category": "game", "period": "day", "rank": 5, "date": "2022-09-30"}, {"category": "game", "period": "week", "rank": 12, "date": "2022-10-05"}, {"category": "game", "period": "month", "rank": 17, "date": "2022-10-24"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ415000/RJ414077_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ415000/RJ414077_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ415000/RJ414077_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ415000/RJ414077_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ415000/RJ414077_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ415000/RJ414077_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ415000/RJ414077_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ415000/RJ414077_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ415000/RJ414077_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ415000/RJ414077_img_smp8.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ415000/RJ414077_img_smp9.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ415000/RJ414077_img_smp10.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ415000/RJ414077_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ415000/RJ414077_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ415000/RJ414077_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ415000/RJ414077_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ415000/RJ414077_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ415000/RJ414077_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ415000/RJ414077_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ415000/RJ414077_img_smp8_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ415000/RJ414077_img_smp9_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ415000/RJ414077_img_smp10_100x100.jpg"], "alt": "エスカレーションプリンセス [猫缶]"}, "introductions": [{"type": "text", "title": "プリシラ姫がどんどんエロい方向に変わっていく", "body": [{"intro": "☆通常に加え処女・アナル・淫乱ルート追加です☆<br />\n<br />\nプリンセス・プリシラが国王から受けた魔術兵器起動任務を遂行するため<br />\n犯させたり犯されたりするRPGです。<br />\n<br />\n基本エロCG37枚+差分+アニメーション差分多数<br />\n<br />\nHシーンタイプ(約60+各ルート差分+5)<br />\n<br />\n☆フェラ<br />\n☆手コキ<br />\n☆対価フェラ<br />\n☆セックス<br />\n☆対価セックス<br />\n☆レ○プ<br />\n☆アナルセックス<br />\n☆姉や妹が犬・スライムに襲わせる事が可能<br />\n☆2穴セックス(レ○プ)<br />\n☆オネショタ<br />\n☆オネショタセックス<br />\n☆モンスター姦<br />\n他<br />\n<br />\n■☆ビッチ度でステータスが変わる☆<br />\n<br />\n　　心情変化やヒロインのイラストがエロく……<br />\n<br />\n■☆散策RPG+エロバトル☆<br />\n　<br />\n　　・シンプルなXPバトルをベースに基本エロで攻撃し合うスタイル。<br />\n　　・性技でエロ攻撃・通常攻撃も可<br />\n　　・メニュー画面でバトル短縮も可<br />\n　　<br />\n■☆嫌がらせをする姉や妹へ復讐しよう☆<br />\n<br />\n　　・衝撃的な寝取り!用事が終わったら捨てる!<br />\n　　・やりすぎな展開も!<br />\n<br />\n■☆痴○システム☆<br />\n<br />\n　　・街や村でプリシラを狙う魔の手!エロステをあげよう!<br />\n<br />\n■☆わかりやすい分岐システム☆<br />\n<br />\n　　・分岐点の前でセーブしてそれぞれのルートを!"}]}, {"type": "image_list", "title": "メインキャラクター", "body": [{"intro": "プリシラ(主人公)<br />\r\nバンダム王国の第2王女<br />\r\n性格はいたっておとなしく控えめ。<br />\r\nその性格が災いして自らの能力を抑えこんでいる。<br />\r\n性の知識に関しては人並みだが処女で経験無し<br />\r\n隣国に親が勝手に決めた許嫁がいるらしい。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ415000/RJ414077/9a4c2e57bf15ed8112e6ce19b34ab8b9.jpg", "alt": "エスカレーションプリンセス [猫缶]", "title": "エスカレーションプリンセス [猫缶]"}}, {"intro": "コリロ<br />\r\nバンダム王国の第3王女<br />\r\nプリシラの妹。性格はしたたかで陰湿。<br />\r\n何を考えているかわからない。<br />\r\n犬が好き。<br />\r\n戦闘力は無いが外出の際は頑強な鎧を着ている。<br />\r\n幼少期に可愛いとちやほやされた事で今も調子にのっている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ415000/RJ414077/d9928557a5f0dd98246b602ec0e376e4.jpg", "alt": "エスカレーションプリンセス [猫缶]", "title": "エスカレーションプリンセス [猫缶]"}}, {"intro": "ナヴィア<br />\r\nバンダム王国の第1王女<br />\r\nプリシラの姉。性格は高慢で自信家。<br />\r\n王国1の天才魔術者と呼ばれる。<br />\r\n3姉妹で最も巨乳。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ415000/RJ414077/d12aac3c6bd539134db00796764b9fb7.jpg", "alt": "エスカレーションプリンセス [猫缶]", "title": "エスカレーションプリンセス [猫缶]"}}]}, {"type": "image_list", "title": "フロントビューエロバトル", "body": [{"intro": "バトルはボイスあり<br />\r\nプリシラの魔法の鎧がバトルフィールドで逆バニースーツアーマー(エスカレーションスーツ)に!<br />\r\n敵の攻撃をエロくさせ死を免れる事ができます。<br />\r\nとにかくぶっかけ攻撃のゼリー系<br />\r\nから2穴ファックまで無茶苦茶するスライムまで", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ415000/RJ414077/7bec79864506460a64d6fd326ba1f2b9.jpg", "alt": "エスカレーションプリンセス [猫缶]", "title": "エスカレーションプリンセス [猫缶]"}}, {"intro": "ほとんどのモンスターにセックス・アナル完備<br />\r\nエロ攻撃パターンはモンスター1種に2～9", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ415000/RJ414077/8e7cd112e0be81f70dbb7bbd268d98a5.jpg", "alt": "エスカレーションプリンセス [猫缶]", "title": "エスカレーションプリンセス [猫缶]"}}, {"intro": "外注モンスターによる<br />\r\nアニメーションエロ攻撃で<br />\r\n状況が把握しやすく、エロく<br />\r\n表現できました。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ415000/RJ414077/136bd8a6b80f719738f659ab6b6564fd.jpg", "alt": "エスカレーションプリンセス [猫缶]", "title": "エスカレーションプリンセス [猫缶]"}}, {"intro": "強○魅了くぱあ拘束など<br />\r\n性的に逆らえないモンスター攻撃も多数<br />\r\n<br />\r\n通常・発情・超発情と変化していくモンスターも……", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ415000/RJ414077/d2fa212a338136a3c73a098c94c7cdd4.jpg", "alt": "エスカレーションプリンセス [猫缶]", "title": "エスカレーションプリンセス [猫缶]"}}]}, {"type": "image_list", "title": "時間をかけて進化したグラフィックと痴○システム", "body": [{"intro": "イベントCGのクオリティアップと共にセクハラ差分も豊富に", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ415000/RJ414077/f512b40a238adae943a681ad31187ec7.jpg", "alt": "エスカレーションプリンセス [猫缶]", "title": "エスカレーションプリンセス [猫缶]"}}, {"intro": "迫力の破瓜シーン。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ415000/RJ414077/e487d9cbe6f722c8b35d422f821ee90a.jpg", "alt": "エスカレーションプリンセス [猫缶]", "title": "エスカレーションプリンセス [猫缶]"}}, {"intro": "オネショタも。外注による高水準のエロも多数", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ415000/RJ414077/6479ad816876fbc82aac393240690f7a.jpg", "alt": "エスカレーションプリンセス [猫缶]", "title": "エスカレーションプリンセス [猫缶]"}}, {"intro": "立ち絵も2種あり痴○でもエロステを上昇させる遊びが豊富", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ415000/RJ414077/864338693759be8ce27862dcbd161df6.jpg", "alt": "エスカレーションプリンセス [猫缶]", "title": "エスカレーションプリンセス [猫缶]"}}]}, {"type": "image", "title": "エロステータス", "body": [{"intro": "プリシラの<br />\r\n羞恥<br />\r\n性癖<br />\r\n性器<br />\r\n尻穴<br />\r\nから関する<br />\r\n4つの心境コメントが<br />\r\nビッチ度で変わり臨場感をアップ。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ415000/RJ414077/653f1f4ee91c92f726cf40f070bec183.jpg", "alt": "エスカレーションプリンセス [猫缶]", "title": "エスカレーションプリンセス [猫缶]"}, "position": "over"}]}, {"type": "image", "title": "詳細エロステータス", "body": [{"intro": "各エロステ項目の数値を確認出来、<br />\r\n淫乱ランク<br />\r\nSEXテクニック<br />\r\n初めての相手<br />\r\n各種エロステータスの数値が確認出来、<br />\r\nビッチ度に合わせてプリシライラストも変化", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ415000/RJ414077/c8becbeb15ed190ab4811ef19b5d4e48.jpg", "alt": "エスカレーションプリンセス [猫缶]", "title": "エスカレーションプリンセス [猫缶]"}, "position": "over"}]}], "description": "姉妹と邪魔をし合いながら目的地を目指す姫のエロRPG", "short_introduction": "姉妹と邪魔をし合いながら目的地を目指す姫のエロRPG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ414077.html", "site_id": "maniax", "fetched_at": 1794955577}