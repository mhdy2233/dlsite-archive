": "all", "period": "month", "rank": 11, "date": "2022-10-31"}, {"category": "game", "period": "day", "rank": 2, "date": "2022-10-21"}, {"category": "game", "period": "week", "rank": 2, "date": "2022-10-24"}, {"category": "game", "period": "month", "rank": 6, "date": "2022-11-14"}, {"category": "game", "period": "year", "rank": 194, "date": "2022"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ417000/RJ416433_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ417000/RJ416433_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ417000/RJ416433_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ417000/RJ416433_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ417000/RJ416433_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ417000/RJ416433_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ417000/RJ416433_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ417000/RJ416433_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ417000/RJ416433_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ417000/RJ416433_img_smp8.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ417000/RJ416433_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ417000/RJ416433_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ417000/RJ416433_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ417000/RJ416433_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ417000/RJ416433_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ417000/RJ416433_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ417000/RJ416433_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ417000/RJ416433_img_smp8_100x100.jpg"], "alt": "あの楽しかった田舎での夏休みをもう一度… [タランボ]"}, "introductions": [{"type": "text", "title": "■プロローグ", "body": [{"intro": "「あ…また始まった」<br />\r\nドアの向こう、居間で両親達のイラついた声が聞こえてくる。<br />\r\n昨年から流行しはじめた病のせいで、パパの会社の業績がはかばかしくなかった。<br />\r\n……<br />\r\n「…こっちだって大変なの。お父さんがボケちゃったからって何も出来ないのよ」<br />\r\n電話の向こうのおばあちゃんにキツくあたるママの声が居間に響く。<br />\r\n<br />\r\n小学生の頃、遊びに行ったおじいちゃん家楽しかったな…<br />\r\nもうすぐ夏休み…パパもママも大変そうだからどこかに連れて行ってなんて言えない雰囲気…<br />\r\nそうだ、おじいちゃん家に遊びに行こう!<br />\r\n<br />\r\n「あの…ママ…私…おじいちゃんの様子見に行こうか?」<br />\r\nこうして、ヒロイン真優(まゆ)の田舎一人旅が決まった。<br />\r\n<br />\r\n～～～<br />\r\n小学生の頃の楽しかった思い出を胸に田舎へと向かう真優。<br />\r\n本人は気づいていないが、男達の欲望をかき立てる身体つきへと変化していた。<br />\r\n<br />\r\n「あのさ、おれの初恋の人って…真優ちゃんなんだ…」<br />\r\nいっしょに秘密基地を作って遊んだ男の子との再会<br />\r\n<br />\r\n「そうかぁ一人で、じいちゃんとこ来たのか(さすが都会の娘は発育が良いな　たまんねぇな)」<br />\r\nおじいちゃんとお菓子を買いに行った雑貨屋のおじさんの軽トラに乗せてもらって…<br />\r\n<br />\r\n「貴方がここに来たのはご先祖様のお導きですよ」<br />\r\nおばあちゃんが熱心に拝んでいた宗教の人に呼ばれて…<br />\r\n<br />\r\nさらにストーリーが進むと、その他の男達も真優の身体を狙い始め…<br />\r\n<br />\r\n真優の忘れられない夏休みが始まります。<br />\r\n<br />\r\n～～～"}]}, {"type": "image", "title": "■　ヒロイン", "body": [{"intro": "白石真優(しらいし　まゆ)　CV:赤月ゆむ<br />\r\n<br />\r\n明るい性格で、友達も多い。<br />\r\n奥手で、友達の恋バナを聞いて夢見る年頃。<br />\r\n基本しっかり者だけど、流されやすい一面も…", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ417000/RJ416433/19af53170a9cc9249b3a40ccedf289c0.jpg", "alt": "あの楽しかった田舎での夏休みをもう一度… [タランボ]", "title": "あの楽しかった田舎での夏休みをもう一度… [タランボ]"}, "position": "left"}]}, {"type": "image_list", "title": "■ゲーム内容", "body": [{"intro": "おじいちゃんおばあちゃんの住む村内を移動・会話して、村人達と交流しながら夏休みの一ヶ月間を過ごしていきます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ417000/RJ416433/b4dc3a3994ac053a85d8c8985b0685d9.jpg", "alt": "あの楽しかった田舎での夏休みをもう一度… [タランボ]", "title": "あの楽しかった田舎での夏休みをもう一度… [タランボ]"}}, {"intro": "また、山の雑木林にはカブトムシやクワガタムシ(野良化した世界中の虫がなぜか生息しています)がいるので、それを捕まえて図鑑コンプリートを目指すという遊び方も出来ます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ417000/RJ416433/d60d8c980aae8153990a8608bf62b4e4.jpg", "alt": "あの楽しかった田舎での夏休みをもう一度… [タランボ]", "title": "あの楽しかった田舎での夏休みをもう一度… [タランボ]"}}]}, {"type": "text", "title": "■エッチシチュエーション", "body": [{"intro": "村人からエッチなマッサージを受けたり、<br />\r\nひとけのない分校へと誘い込まれたり、<br />\r\n幼なじみの男の子とテントの中で汗まみれのエッチを繰り返したり、<br />\r\nあやしげな宗教団体の奥の部屋でカウンセリングを受けたり、<br />\r\n冷たいジュース(媚薬入り)を振舞われて、たまらずトイレで一人エッチをはじめたり、<br />\r\n雑木林の奥でテント生活している不審者に付きまとわれたり…等々<br />\r\n※断面差分有り"}]}, {"type": "text", "title": "■一押しポイント", "body": [{"intro": "・基本イベントCG51枚　差分合計878枚、立ち絵+表情差分多数<br />\r\n・ヒロインフルボイス　2500以上<br />\r\n・レベルアップ必要なしのお気楽RPG<br />\r\n・回想シーンはゲーム開始後、回想部屋にて即全オープン可能(体験版ではOFFにしています)<br />\r\n・エロステータス画面あり<br />\r\n・世界のカブトムシ・クワガタムシ20種類を昆虫採集<br />\r\n<br />\r\n・攻略情報テキストを同梱、エンディング一覧・エッチシーン手順・ムシ捕り情報などこれがあれば遊びつくせます。<br />\r\n<br />\r\nこのゲームはRPGツクールMZで作っています。<br />\r\n制作日誌がCi-enに載っていますので、ゲーム内容などについてはそちらもご参照下さい。<br />\r\n<a href=\"https://ci-en.dlsite.com/creator/216\" target=\"_blank\">https://ci-en.dlsite.com/creator/216</a>"}]}], "description": "街に住んでいるヒロインが田舎に遊びに行って、おじさん達と交流するRPGです。", "short_introduction": "街に住んでいるヒロインが田舎に遊びに行って、おじさん達と交流するRPGです。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ416433.html", "site_id": "maniax", "fetched_at": 1794955370}