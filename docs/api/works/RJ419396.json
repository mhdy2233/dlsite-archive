"dl_count": 719, "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01100815.html", "lang": ["ENG"]}, {"product_id": "RJ01356536", "edition_id": 16546, "display_label": "AI翻訳英語版", "dl_count": 213, "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01356536.html", "lang": ["ENG"]}, {"product_id": "RJ01356543", "edition_id": 16546, "display_label": "AI翻訳簡体中文版", "dl_count": 144, "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01356543.html", "lang": ["CHI_HANS"]}, {"product_id": "RJ01356550", "edition_id": 16546, "display_label": "AI翻訳繁体中文版", "dl_count": 310, "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01356550.html", "lang": ["CHI_HANT"]}, {"product_id": "RJ01404767", "edition_id": 16546, "display_label": "AI翻訳韓国語版", "dl_count": 249, "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01404767.html", "lang": ["KO_KR"]}], "rating": {"average": 4.54, "count": 3758}, "review_count": 39, "dl_count": 11972, "wishlist_count": 8297, "ranking": [{"category": "all", "period": "day", "rank": 1, "date": "2022-11-22"}, {"category": "all", "period": "week", "rank": 8, "date": "2022-11-27"}, {"category": "all", "period": "month", "rank": 27, "date": "2022-12-20"}, {"category": "game", "period": "day", "rank": 1, "date": "2022-11-21"}, {"category": "game", "period": "week", "rank": 4, "date": "2022-11-26"}, {"category": "game", "period": "month", "rank": 14, "date": "2022-12-07"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ420000/RJ419396_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ420000/RJ419396_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ420000/RJ419396_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ420000/RJ419396_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ420000/RJ419396_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ420000/RJ419396_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ420000/RJ419396_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ420000/RJ419396_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ420000/RJ419396_img_smp7.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ420000/RJ419396_img_smp8.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ420000/RJ419396_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ420000/RJ419396_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ420000/RJ419396_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ420000/RJ419396_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ420000/RJ419396_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ420000/RJ419396_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ420000/RJ419396_img_smp7_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ420000/RJ419396_img_smp8_100x100.jpg"], "alt": "叔母さんと一緒 ～僕と叔母さんのあまあまドスケベ寝取り同棲生活～ [レーゲ連合王国]"}, "introductions": [{"type": "text", "title": "ムチムチで人妻な叔母さんと一緒に同棲していき、あまあまでドスケベな関係になっていく寝取り同棲シミュレーション", "body": [{"intro": "◆CG数　エロ説明<br />\n<br />\n基本CG　16枚(立ち絵分無し　非エロCG1枚)<br />\n<br />\nおねショタ、同棲寝取り物です。<br />\nエロシーンは、お触りや日常での覗きのエロ、仲良くなってのあまあまエッチ、<br />\n睡眠○、性欲に負けた下品でドスケベエッチシーンなどがあります。<br />\n<br />\n本ゲームのボイスは、フルボイスではなく喘ぎ声やキス音のみとなります。<br />\n<br />\n◆システムなど<br />\n<br />\nRPGツクールMZで作成されたシミュレーションゲームです。<br />\n寝取り同棲シミュレーションゲームです。<br />\n3~4時間くらい遊べます。<br />\n<br />\nスキルやお触りシステム、危険日安全日などの機能があります。<br />\n基本、マウス操作で出来るようになっています。<br />\n<br />\n体験版から、製品版の引継ぎは一応できますが、<br />\nバグを引き起こす可能性があるのでおすすめはしません。<br />\nまた、動作確認の為、体験版のプレイを推奨します。<br />\n<br />\n◆ストーリー<br />\n<br />\n僕の両親は、転勤で遠くに引っ越すことになった。<br />\n本来なら、僕も行くべきなのだけど…。<br />\n新しい学校で、やっていけるか不安な僕は、<br />\n無理を言って、地元にとどまる事になった。<br />\n住む家は、学校の近くにある叔母さんの家になった。<br />\nこれから、僕は叔母さんと一緒に暮らすんだ…。<br />\n<br />\n初恋で、今でも好きな叔母さん…。<br />\nお母さんと違って、綺麗だし、優しいし、いい匂いがする、自慢の叔母さん…。<br />\nこれから一緒に、叔母さんと暮らせるなんて、夢みたいだ…。<br />\n叔母さんとの新しい同棲生活…。<br />\nテストもお手伝いも、エッチないたずらも、いっぱい楽しんじゃえ!<br />\n<br />\n◆主なエロシーン<br />\n寝てる叔父さんにばれないように、隣の叔母さんと泥酔セックス!<br />\n叔母さんのパンツをオカズにこっそりオナニー…。<br />\n一緒に入ったお風呂で、勃起したおちんちんを手コキされちゃう!<br />\n運動した後、むれむれのランニングウェアの叔母さんと青姦セックス!<br />\nトイレの覗きでおっきくなったおちんぽを、おしっこしたての叔母さんおまんこにぶち込み!<br />\n朝立ちちんぽを、叔母さんのひょっとこフェラで絞られる!<br />\n危険日に夜○いにきた叔母さんを、種付けプレスセックス!<br />\n托卵させた後、お腹の大きい叔母さんとボテ腹セックス!<br />\n<br />\nなどなど…。"}]}, {"type": "image", "title": "おさわりシステム", "body": [{"intro": "本ゲームは、睡眠○、お風呂、通常立ち絵にお触りが出来ます。<br />\n普段の立ち絵で叔母さんにおさわりしてみたり…、<br />\n叔母さんの身体を洗ったり…、<br />\n睡眠○でこっそりばれないようにおさわりしたり…、<br />\nなどが出来ます。<br />\n<br />\n判定は、基本的には「口、おっぱい、乳首、お腹、おまんこ、太もも」などです。<br />\n睡眠○では、スキルを覚えれば「お尻、アナル」がお触り出来るようになります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ420000/RJ419396/d754508bd697e40084e533181e3d42b3.jpg", "alt": "叔母さんと一緒 ～僕と叔母さんのあまあまドスケベ寝取り同棲生活～ [レーゲ連合王国]", "title": "叔母さんと一緒 ～僕と叔母さんのあまあまドスケベ寝取り同棲生活～ [レーゲ連合王国]"}, "position": "over"}]}, {"type": "image", "title": "コマンド式のエロシーン", "body": [{"intro": "叔母さんと仲良くなると、その都度、ボタンでやって欲しい事や、やりたい事などをやって、最後は任意で射精する感じになっています。<br />\n<br />\nまた、射精した差分も次のセックスに引継ぎ出来るようになっています。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ420000/RJ419396/b7b217a4e2acea8a672a80b2dbd8b051.jpg", "alt": "叔母さんと一緒 ～僕と叔母さんのあまあまドスケベ寝取り同棲生活～ [レーゲ連合王国]", "title": "叔母さんと一緒 ～僕と叔母さんのあまあまドスケベ寝取り同棲生活～ [レーゲ連合王国]"}, "position": "over"}]}, {"type": "image", "title": "出張システム", "body": [{"intro": "叔母さんは、既婚という設定なので、<br />\n当然叔父さんも、家に一緒にいます。<br />\n通常、20時くらいに帰ってきますが、<br />\n出張でいない事も、あります。<br />\n<br />\n叔父さんが隣で寝てるときに、こっそり叔母さんとセックスするも良し。<br />\n出張でいない間に、叔母さんにいたずらしまくるも良し。<br />\nどちらも、選べるようになっています。<br />\n<br />\n出張の頻度は神社で変えられます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ420000/RJ419396/20f09b4f635f23c04259321fb82ef908.jpg", "alt": "叔母さんと一緒 ～僕と叔母さんのあまあまドスケベ寝取り同棲生活～ [レーゲ連合王国]", "title": "叔母さんと一緒 ～僕と叔母さんのあまあまドスケベ寝取り同棲生活～ [レーゲ連合王国]"}, "position": "over"}]}, {"type": "image", "title": "安全日と危険日", "body": [{"intro": "本ゲームは、安全日と危険日の機能を採用してます。<br />\n<br />\n安全日に、中出ししまくっても問題ありませんが、<br />\n危険日に中出ししまくると、当然、叔母さんが孕んでしまいます。<br />\n<br />\n妊娠確率も、神社で変えることが出来ます。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ420000/RJ419396/4ae64288f891d468eecf88789976362c.jpg", "alt": "叔母さんと一緒 ～僕と叔母さんのあまあまドスケベ寝取り同棲生活～ [レーゲ連合王国]", "title": "叔母さんと一緒 ～僕と叔母さんのあまあまドスケベ寝取り同棲生活～ [レーゲ連合王国]"}, "position": "over"}]}, {"type": "image", "title": "一日の流れ", "body": [{"intro": "時間に沿って、叔母さんと一緒に過ごしていきます。<br />\n<br />\n一緒にゲームをしたり…、家事を手伝ったり…、お風呂に入ったり…、色々出来ます。<br />\nより仲良くなったら、エッチなことも出来るようになります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ420000/RJ419396/fd4da5be02cfee56367a5920bdefe878.jpg", "alt": "叔母さんと一緒 ～僕と叔母さんのあまあまドスケベ寝取り同棲生活～ [レーゲ連合王国]", "title": "叔母さんと一緒 ～僕と叔母さんのあまあまドスケベ寝取り同棲生活～ [レーゲ連合王国]"}, "position": "over"}]}], "description": "ムチムチで人妻な叔母さんと一緒に同棲していき、あまあまでドスケベな関係になっていく寝取り同棲シミュレーション", "short_introduction": "ムチムチで人妻な叔母さんと一緒に同棲していき、あまあまでドスケベな関係になっていく寝取り同棲シミュレーション", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ419396.html", "site_id": "maniax", "fetched_at": 1794955054}