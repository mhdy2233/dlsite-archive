{"id": "RJ426430", "title": "雪月花", "title_romaji": "setsugekka", "circle": {"id": "RG48462", "name": "ReJust", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG48462.html"}, "type": {"code": "RPG", "name": "ロールプレイング", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 2090, "official_jpy": 2090, "currencies": {"USD": 13.097462037726958, "EUR": 11.902212786507333, "GBP": 9.930637584944963, "TWD": 431.791417887321, "CNY": 87.46050676877367, "KRW": 17489.539748953976, "IDR": 239404.35280641465, "VND": 337096.7741935484, "THB": 443.8403873516108, "SEK": 132.2123748252456, "HKD": 102.77744993902199, "SGD": 16.879831750882758, "CAD": 18.7251656370812, "MYR": 53.63113582534212, "BRL": 74.52468228951234, "AUD": 19.41852211109996, "PHP": 837.1385083713851, "MXN": 242.96957648891524, "NZD": 23.789685520846138, "INR": 1230.4250559284117}}, "point": {"point_amount": 114, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1668870000, "file": {"type": "EXE", "size": 916684472}, "tags": [{"key": "502", "name": "男主人公"}, {"key": "017", "name": "歴史/時代物"}, {"key": "112", "name": "ノーマルプレイ"}, {"key": "123", "name": "和姦"}, {"key": "182", "name": "巨乳/爆乳"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [{"product_id": "RJ426430", "edition_id": 8710, "display_label": "日本語", "dl_count": 774, "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ426430.html", "lang": ["JPN"]}, {"product_id": "RJ01003130", "edition_id": 8710, "display_label": "英語", "dl_count": 74, "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01003130.html", "lang": ["ENG"]}, {"product_id": "RJ01004624", "edition_id": 8710, "display_label": "繁体中文", "dl_count": 183, "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01004624.html", "lang": ["CHI_HANT"]}], "rating": {"average": 4.14, "count": 255}, "review_count": 1, "dl_count": 774, "wishlist_count": 2468, "ranking": [{"category": "all", "period": "day", "rank": 23, "date": "2022-11-20"}, {"category": "game", "period": "day", "rank": 12, "date": "2022-11-20"}, {"category": "game", "period": "week", "rank": 29, "date": "2022-11-23"}, {"category": "game", "period": "month", "rank": 62, "date": "2022-12-12"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ427000/RJ426430_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ427000/RJ426430_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ427000/RJ426430_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ427000/RJ426430_img_smp2.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ427000/RJ426430_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ427000/RJ426430_img_smp2_100x100.jpg"], "alt": "雪月花 [ReJust]"}, "introductions": [{"type": "text", "title": "武侠小説風RPG", "body": [{"intro": "Q&amp;A<br />\n<a href=\"https://ci-en.dlsite.com/creator/13601\" target=\"_blank\">https://ci-en.dlsite.com/creator/13601</a><br />\n<br />\n武侠とは、武技を以って義侠を為す者たちのことである。<br />\n<br />\n　本作は武侠小説風のRPGです。<br />\n　武侠における世間は江湖と呼ばれ、中でも武芸者の界隈を武林と呼びます。<br />\n　主人公の竜星(リュウセイ)は新進気鋭の武侠者で、所属している千峰派でも一目置かれています。<br />\n　悪徳門派から逃れてきたヒイロという少女をリュウセイが保護するところから物語は始まります。<br />\n　師匠の燐明真人(リンメイシンジン)、姉弟子の宋雪姫(ソウセツキ)、そしてヒイロ。<br />\n　この3人のヒロインたちと修行の日々を送り、リュウセイは腕前を試すべく武林大会へ出場します。<br />\n<br />\n基本CG32枚<br />\nHCG数25　アニメーションあり"}]}, {"type": "image_list", "title": "キャラクター紹介", "body": [{"intro": "竜星(リュウセイ)<br />\n<br />\n主人公。<br />\n行き倒れていたところを千峰派の掌門、リンメイに拾われて門下生となる。<br />\n過去の事は何も話したがらないので、出自や経歴は不明。<br />\n類稀な武術の才能があり、リンメイからはとても気に入られている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ427000/RJ426430/0b1f32a4390303ca6069c6abb8a9a4dc.jpg", "alt": "雪月花 [ReJust]", "title": "雪月花 [ReJust]"}}, {"intro": "緋色(ヒイロ)<br />\nCV 誠樹ふぁん<br />\n<br />\n悪徳門派と噂される厚賦会から逃げ出してきた少女。<br />\n街の路地裏で追手に追われているところをリュウセイに助けられた。<br />\nリュウセイの提案で千峰派に身を寄せることになる。<br />\n他人に対して心を閉ざしていて、冷たい性格だと誤解されがち。<br />\n気を許したリュウセイに対しては綻んだ表情を見せることもある。<br />\n　緋薔薇とは通り名で、自称するのを恥ずかしがってリュウセイにはヒイロと名乗った。<br />\n　本名は獄紅玉と言い、厚賦会の掌門である獄綸傲の妾腹の娘である。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ427000/RJ426430/c0a3e995d871e601d12776acfc647f82.jpg", "alt": "雪月花 [ReJust]", "title": "雪月花 [ReJust]"}}, {"intro": "燐明真人(リンメイ)<br />\nCV 篠守ゆきこ<br />\n<br />\n女だてらに門派を纏める掌門を務めている実力者。<br />\n本名は雲春晞(ウンシュンキ)と言う。<br />\n一見すると優しくて美人なお姉さんだが、物事の本質を見極める能力に優れている。<br />\nリュウセイの才能に一目置いていて、その目覚ましい成長を彼自身以上に喜んでいる。<br />\nその為かは分からないが、リュウセイに対しては非常に甘く、リュウセイの頼みは軽々に受け入れてしまうところがある。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ427000/RJ426430/79676f23ac17bae92e04ac7841d0a717.jpg", "alt": "雪月花 [ReJust]", "title": "雪月花 [ReJust]"}}, {"intro": "宋雪姫(ソウセツキ)<br />\nCV 誠樹ふぁん<br />\n<br />\n門下生の少女、リュウセイにとっては姉弟子にあたる。<br />\n気の強い性格で事あるごとにリュウセイに食って掛かっている。<br />\n長年門派で修行をしてきた身であり、最近現れてリンメイに気に入られているリュウセイのことを快く思っていない。<br />\nしかしリュウセイの実力が本物であることも理解していて、嫉妬と葛藤に苦しんでいる。<br />\nリンメイには尊敬の念を抱いているが、いつまでも子ども扱いされることに困っている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ427000/RJ426430/a371d721e455bdff9c2fede3c8f97dd9.jpg", "alt": "雪月花 [ReJust]", "title": "雪月花 [ReJust]"}}]}], "description": "武侠小説風RPG", "short_introduction": "武侠小説風RPG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ426430.html", "site_id": "maniax", "fetched_at": 1794955076}