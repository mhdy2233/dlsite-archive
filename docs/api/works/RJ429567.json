{"id": "RJ429567", "title": "アムルとアイシャと小さな国の物語", "title_romaji": "amurutoaishatochiisanakuninomonogatari", "circle": {"id": "RG06739", "name": "鈴屋", "url": "https://www.dlsite.com/maniax/circle/profile/=/maker_id/RG06739.html"}, "type": {"code": "RPG", "name": "ロールプレイング", "category": "game"}, "category": "doujin", "age": "r18", "sex": 1, "price": {"jpy": 1100, "official_jpy": 1100, "currencies": {"USD": 6.8934010724878725, "EUR": 6.264322519214385, "GBP": 5.226651360497349, "TWD": 227.25864099332685, "CNY": 46.03184566777561, "KRW": 9205.020920502093, "IDR": 126002.29095074456, "VND": 177419.3548387097, "THB": 233.60020386926882, "SEK": 69.5854604343398, "HKD": 54.09339470474841, "SGD": 8.88412197414882, "CAD": 9.855350335305896, "MYR": 28.226913592285324, "BRL": 39.223516994480185, "AUD": 10.22027479531577, "PHP": 440.599214932308, "MXN": 127.87872446785012, "NZD": 12.52088711623481, "INR": 647.5921346991639}}, "point": {"point_amount": 60, "standard_point_rate": 6, "advance_point_rate": null, "advance_point_end_date": null}, "release": 1667574000, "file": {"type": "EXE", "size": 472858432}, "tags": [{"key": "502", "name": "男主人公"}, {"key": "048", "name": "寝取られ"}, {"key": "016", "name": "ファンタジー"}, {"key": "321", "name": "褐色/日焼け"}], "languages": ["JPN"], "translation": {"is_translation_agree": false, "is_volunteer": false, "is_original": true, "is_parent": false, "is_child": false, "is_translation_bonus_child": false, "original_workno": null, "parent_workno": null, "child_worknos": [], "lang": null, "production_trade_price_rate": 0}, "language_editions": [], "rating": {"average": 4.54, "count": 815}, "review_count": 12, "dl_count": 1985, "wishlist_count": 2296, "ranking": [{"category": "all", "period": "day", "rank": 11, "date": "2022-11-05"}, {"category": "all", "period": "week", "rank": 38, "date": "2022-11-11"}, {"category": "game", "period": "day", "rank": 4, "date": "2022-11-06"}, {"category": "game", "period": "week", "rank": 15, "date": "2022-11-11"}, {"category": "game", "period": "month", "rank": 38, "date": "2022-11-20"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ430000/RJ429567_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ430000/RJ429567_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ430000/RJ429567_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ430000/RJ429567_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ430000/RJ429567_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ430000/RJ429567_img_smp4.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ430000/RJ429567_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ430000/RJ429567_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ430000/RJ429567_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ430000/RJ429567_img_smp4_100x100.jpg"], "alt": "アムルとアイシャと小さな国の物語 [鈴屋]"}, "introductions": [{"type": "text", "title": "南方の小国ルーエルで、新たな王となった青年アムルのお話", "body": [{"intro": "■あらすじ<br />\n病没した父のあとを継ぎ、ルーエル王国の国王となったアムル<br />\nしかし、その即位の日<br />\n<br />\nかつて国を追放された兄ロレンスが軍を率い王都を急襲<br />\n瞬く間に敗れ去ったアムルは囚われの身となった<br />\n<br />\n地位も、名誉も、そして結婚相手であるアイシャまでも奪われたアムルに<br />\nロレンスはある命令を下す<br />\nそれは、王族しか入れない宝物庫から秘宝を持ち帰ることだった<br />\n<br />\n■システム<br />\n前半は画面に表示されたタイルをクリックして進んでいく形式で<br />\nマウスが必須になります<br />\n後半からフィールドを歩く従来の形式に変わります<br />\n回想モードはクリア後に開放されます<br />\n<br />\n■エロシーン(前半)<br />\nアムルは宝物庫で謎の老人に出会い、彼の力で精神を城に飛ばされ<br />\nアイシャとロレンスのセックスを無理やり見せられてしまいます<br />\nロレンスはアイシャを妻としてではなく、道具として利用することしか考えていません<br />\nやがて彼女を他人に抱かせ利益を得ようと画策します<br />\n<br />\n■エロシーン(後半)<br />\n王国を出たアムルは、オデットやメニーナといった女性と知り合い<br />\nともに旅をすることになります<br />\n彼女らはアムルとセックスすることもあれば、<br />\n敵によって凌○されてしまったり、自分から色仕掛けをしたりすることもあります"}]}, {"type": "image_list", "title": "登場人物", "body": [{"intro": "■アイシャ<br />\nルーエルにおいて特別な存在である神官の一族の娘<br />\nアムルとは相思相愛であったが<br />\n彼女を妻に娶ることが国王になる条件であるため<br />\nロレンスによって奪われてしまう<br />\n気が強く一度決めたことはやり抜く性格", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ430000/RJ429567/8944cdd8d2cf46fb8d41b68db0b5a4f1.jpg", "alt": "アムルとアイシャと小さな国の物語 [鈴屋]", "title": "アムルとアイシャと小さな国の物語 [鈴屋]"}}, {"intro": "■オデット<br />\n個人で移動娼館を営む娼婦<br />\n自分の仕事に誇りを持っており<br />\nまた、目的のためには身体を使うことも辞さない<br />\n普段はマイペースを崩さず明るい性格だが<br />\n怒るととても怖い", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ430000/RJ429567/bfbd9670ca262117f1879fd3ae188576.jpg", "alt": "アムルとアイシャと小さな国の物語 [鈴屋]", "title": "アムルとアイシャと小さな国の物語 [鈴屋]"}}, {"intro": "■メニーナ<br />\n通称、最強の軍師と呼ばれる少女<br />\n少々抜けたところがあるも<br />\nそのエキセントリックな作戦内容によって<br />\n南方諸国では名が通っている<br />\nおっぱいが大きい", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ430000/RJ429567/c2673076f71f4cdb7a558fe3dc3e56f5.jpg", "alt": "アムルとアイシャと小さな国の物語 [鈴屋]", "title": "アムルとアイシャと小さな国の物語 [鈴屋]"}}, {"intro": "■ロレンス<br />\nアムルの兄<br />\n5年前、父によって国を追放され<br />\n王位継承権をアムルに譲った<br />\n国を強くするためには手段を選ばず<br />\n貴族や王族の怠惰を許さない<br />\nアイシャに対して愛情はなく<br />\n政治の道具としてしか見ていない", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ430000/RJ429567/c2aecdbae468f88722914afb62eef2a2.jpg", "alt": "アムルとアイシャと小さな国の物語 [鈴屋]", "title": "アムルとアイシャと小さな国の物語 [鈴屋]"}}]}], "description": "地位も名誉も女も、すべてを奪われた男のお話", "short_introduction": "地位も名誉も女も、すべてを奪われた男のお話", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ429567.html", "site_id": "maniax", "fetched_at": 1794955292}