": "month", "rank": 98, "date": "2022-12-27"}, {"category": "game", "period": "day", "rank": 6, "date": "2022-12-11"}, {"category": "game", "period": "week", "rank": 13, "date": "2022-12-17"}, {"category": "game", "period": "month", "rank": 37, "date": "2023-01-03"}], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ435000/RJ434056_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ435000/RJ434056_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ435000/RJ434056_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ435000/RJ434056_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ435000/RJ434056_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ435000/RJ434056_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ435000/RJ434056_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ435000/RJ434056_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ435000/RJ434056_img_smp7.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ435000/RJ434056_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ435000/RJ434056_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ435000/RJ434056_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ435000/RJ434056_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ435000/RJ434056_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ435000/RJ434056_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ435000/RJ434056_img_smp7_100x100.jpg"], "alt": "Devil Make Love ～サキュバスの城に囚われて～ [BarrackBallad]"}, "introductions": [{"type": "text", "title": "概要", "body": [{"intro": "――あの城には強大なサキュバスがいるらしい。<br />\nそんな噂を聞きつけ、勇者であるあなたはサキュバスの支配する城を訪れます。<br />\n<br />\n城内でサキュバスと対峙したあなたですが、不意を突かれ、その身に魔法を受けてしまいます。<br />\nその魔法はあなたを昔の姿に戻してしまい、剣も魔法も使えない状態となり、無力化されてしまいます。<br />\n<br />\n「勇者の遺伝子を取り入れた強力な魔物を生み出すために、<br />\n　魔物娘たちと子作りしてもらうわ」<br />\n<br />\nサキュバスのその言葉の通り、勇者であるあなたが魔物娘たちに捕まってしまうと、<br />\n抵抗できない状態にされて無理矢理精液を搾られてしまいます。<br />\n<br />\n果たしてあなたは元の姿に戻り、<br />\n故郷で帰りを待つ恋人の元へ帰ることができるでしょうか。"}]}, {"type": "image_list", "title": "キャラクター紹介", "body": [{"intro": "・主人公(あなた)<br />\n主人公であるあなたが若返った姿。<br />\n勇者として女王を倒すためにサキュバスの城を訪れるが、力を失ってしまう。<br />\n<br />\n「こんなところで油を売ってる場合じゃないんだ」", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ435000/RJ434056/43297bd452987ce040650599f125435d.jpg", "alt": "Devil Make Love ～サキュバスの城に囚われて～ [BarrackBallad]", "title": "Devil Make Love ～サキュバスの城に囚われて～ [BarrackBallad]"}}, {"intro": "・女王サキュバス<br />\nサキュバスの城の城主。<br />\n主人公の年齢を奪った張本人。<br />\n部下に命じて主人公を襲わせている。<br />\n<br />\n「私に服従するなら奴○として飼ってあげてもいいわ」", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ435000/RJ434056/c45046c21fa9f5bfb23339b1d29c4706.jpg", "alt": "Devil Make Love ～サキュバスの城に囚われて～ [BarrackBallad]", "title": "Devil Make Love ～サキュバスの城に囚われて～ [BarrackBallad]"}}, {"intro": "・謎の修道女<br />\n主人公にアドバイスをくれる謎の人物。<br />\nアドバイスがあなたの助けになったりならなかったりする。<br />\n<br />\n「おねーさんにお任せ!」", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ435000/RJ434056/aa8e3116c2b7828119cfa62b030f8ba1.jpg", "alt": "Devil Make Love ～サキュバスの城に囚われて～ [BarrackBallad]", "title": "Devil Make Love ～サキュバスの城に囚われて～ [BarrackBallad]"}}, {"intro": "・恋人<br />\n故郷で主人公を待つ恋人、サーシャ。<br />\n恋人と再会できるか否かはあなた次第。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ435000/RJ434056/8e1fbc970df77f29f28e11d4f48ec284.jpg", "alt": "Devil Make Love ～サキュバスの城に囚われて～ [BarrackBallad]", "title": "Devil Make Love ～サキュバスの城に囚われて～ [BarrackBallad]"}}]}, {"type": "image", "title": "ゲーム内容", "body": [{"intro": "・全17シーン+α<br />\n　※2シーンのみAIを用いてイラストを出力、加筆修正を行っています<br />\n・ボイス収録時間2時間オーバー!<br />\n・エッチシーンは女性キャラフルボイス!<br />\n・総テキスト分量は約6万文字<br />\n・淫語責め多め<br />\n・当然逆転無し", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ435000/RJ434056/4bf1df0b11d9d77aaf9f0c5c6e62d3cd.jpg", "alt": "Devil Make Love ～サキュバスの城に囚われて～ [BarrackBallad]", "title": "Devil Make Love ～サキュバスの城に囚われて～ [BarrackBallad]"}, "position": "left"}]}, {"type": "image", "title": "", "body": [{"intro": "〇シチュエーション一例<br />\n・ドールの疑似性器で搾精<br />\n・アナルを指でいじられながら尻尾で搾精<br />\n・産卵管に精液を吸い上げられ卵に種付け<br />\n・魅了され腋を見せつけられながら強○自慰", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ435000/RJ434056/8f44d1a84177f7d4e3456ac4321fed94.jpg", "alt": "Devil Make Love ～サキュバスの城に囚われて～ [BarrackBallad]", "title": "Devil Make Love ～サキュバスの城に囚われて～ [BarrackBallad]"}, "position": "left"}]}, {"type": "image", "title": "", "body": [{"intro": "・CV<br />\n結姫うさぎ:修道女、尻尾サキュバス、サキュバス軍団(ピンク)<br />\nまどのことり:執事、ゴースト、サキュバス軍団(緑)<br />\n逢坂成美　:スライム、ケルベロス<br />\n佐藤みるく:女王サキュバス、小悪魔サキュバス、サキュバス軍団(青)<br />\n倉持ねりね:ドール、女王蜂<br />\n羽丘 蛍　 :ドラゴン、ワーキャット<br />\n花守このは:恋人、サキュバス軍団(黄)<br />\n雲八はち　:清楚系地雷サキュバス<br />\n仮ノ仮　　:見抜きサキュバス<br />\n凪雲ゆう　:褐色サキュバス<br />\n猫乃緒みみ:牧場主サキュバス", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ435000/RJ434056/4177014e78421ad78458ff4ce7724185.jpg", "alt": "Devil Make Love ～サキュバスの城に囚われて～ [BarrackBallad]", "title": "Devil Make Love ～サキュバスの城に囚われて～ [BarrackBallad]"}, "position": "left"}]}], "description": "サキュバスや魔物娘に追いかけられ、捕まると逆レ○プされるRPG", "short_introduction": "サキュバスや魔物娘に追いかけられ、捕まると逆レ○プされるRPG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ434056.html", "site_id": "maniax", "fetched_at": 1794954815}