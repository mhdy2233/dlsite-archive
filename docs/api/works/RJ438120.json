], "images": {"main": "https://img.dlsite.jp/modpub/images2/work/doujin/RJ439000/RJ438120_img_main.jpg", "thumb": "https://img.dlsite.jp/resize/images2/work/doujin/RJ439000/RJ438120_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ439000/RJ438120_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ439000/RJ438120_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ439000/RJ438120_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ439000/RJ438120_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ439000/RJ438120_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ439000/RJ438120_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ439000/RJ438120_img_smp7.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ439000/RJ438120_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ439000/RJ438120_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ439000/RJ438120_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ439000/RJ438120_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ439000/RJ438120_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ439000/RJ438120_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ439000/RJ438120_img_smp7_100x100.jpg"], "alt": "救えなかった女騎士 [kiki]"}, "introductions": [{"type": "text", "title": "特徴", "body": [{"intro": "・Hシーン数は25。すべてlive2dアニメ<br />\n・断面図表示(一部シーン)<br />\n・回想での淫乱度ゲージ表示(後半シーン)。淫乱度が変更されると、表情、セリフ、ボイス変化<br />\n・エロステータスあり<br />\n<br />\n・敵を倒すことで時間経過し、移動することでHシーンに移行する<br />\n・無敵設定にできるので、簡単にクリア可。クリア後Hシーン全開放<br />\n・武器は3種類、敵によっては耐性、弱点あり<br />\n・エンディング4種類(bad、normal、true、true2)<br />\n<br />\n■便利機能<br />\n・ボイスオフ<br />\n・メッセージスキップ<br />\n・メッセージウインドウ消去<br />\n・断面図の表示、非表示<br />\n・男の透明度変更<br />\n・WASDキーで移動可能、キャンセルにBackSpace追加<br />\n・回想が片手で閲覧可能(マウスホイールクリックでページ切り替え可)<br />\n<br />\n■体験版の注意点<br />\n　体験版から製品版へのセーブデータ引き継ぎは対応してません<br />\n<br />\n■その他、cienにて情報を公開してます。<br />\n　<a href=\"https://ci-en.dlsite.com/creator/9149\" target=\"_blank\">https://ci-en.dlsite.com/creator/9149</a><br />\n<br />\n一部背景にaiを利用してます"}]}, {"type": "image", "title": "ストーリー", "body": [{"intro": "「ゲヘ…ゲヘヘへ…」<br />\nこれまで魔王討伐の旅に出た勇者たちは、眠りながら笑みを浮かべ、死んでいった。<br />\n<br />\nその原因を追究することなく放置する国で、選ばれた主人公の勇者、それをサポートする女騎士の物語。<br />\n<br />\n勇者と旅を続けていた女騎士イリスは、途中、勇者とともに罠にかかる。<br />\n目が覚めると檻の中、自分の両手には枷がはまっている。<br />\n<br />\nそこに現れたのは、死んだと思っていた荷物持ちのバーガス(45)だった。<br />\n<br />\nイリスを救おうと勇者は動くが、そこで出会ったのは発言のおかしなイリス。さらに、姿の見えない何者かが勇者を苦しめていく。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ439000/RJ438120/fb2678be0b2ba05877782fbd36a91b7a.jpg", "alt": "救えなかった女騎士 [kiki]", "title": "救えなかった女騎士 [kiki]"}, "position": "left"}]}, {"type": "image", "title": "ヒロイン", "body": [{"intro": "イリス(20)<br />\n<br />\n勇者をサポートする女騎士。<br />\n<br />\n勇者のことを慕っているが、そのことは表に出していない。一方、荷物持ちのバーガスは、下着を盗むなどの理由で嫌っている。<br />\n<br />\n強気で、責任感が強く、自分の職業に誇りを持っている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ439000/RJ438120/4f09d1a53ca61dd1d476db1b2bcb6369.jpg", "alt": "救えなかった女騎士 [kiki]", "title": "救えなかった女騎士 [kiki]"}, "position": "left"}]}, {"type": "text_list", "title": "シチュエーション例", "body": [{"intro": "両手を拘束された状態で、キス、胸を揉まれ、中出しされる"}, {"intro": "両手を拘束された状態で、バックで突かれる"}, {"intro": "気持ちよさに抗うが、激しく絶頂してしまう"}, {"intro": "イキ疲れて気絶している状態で、胸を吸われ、正常位で中出しされる"}, {"intro": "勇者を救うため、寝ている勇者の近くで中出しされる"}, {"intro": "淫乱度が高まると、快楽に身を任せて射精を求めるようになる"}, {"intro": "正常位で射精を求め、妊娠してしまう"}]}], "description": "捕まった女騎士が寝取られる、時間経過アクションRPG", "short_introduction": "捕まった女騎士が寝取られる、時間経過アクションRPG", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ438120.html", "site_id": "maniax", "fetched_at": 1794953411}