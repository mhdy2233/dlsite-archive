/RJ01761501_img_main_240x240.jpg", "samples": ["https://img.dlsite.jp/modpub/images2/work/doujin/RJ01762000/RJ01761501_img_smp1.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01762000/RJ01761501_img_smp2.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01762000/RJ01761501_img_smp3.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01762000/RJ01761501_img_smp4.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01762000/RJ01761501_img_smp5.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01762000/RJ01761501_img_smp6.jpg", "https://img.dlsite.jp/modpub/images2/work/doujin/RJ01762000/RJ01761501_img_smp7.jpg"], "sample_thumbs": ["https://img.dlsite.jp/resize/images2/work/doujin/RJ01762000/RJ01761501_img_smp1_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01762000/RJ01761501_img_smp2_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01762000/RJ01761501_img_smp3_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01762000/RJ01761501_img_smp4_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01762000/RJ01761501_img_smp5_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01762000/RJ01761501_img_smp6_100x100.jpg", "https://img.dlsite.jp/resize/images2/work/doujin/RJ01762000/RJ01761501_img_smp7_100x100.jpg"], "alt": "イゼティア [双子星工作室]"}, "introductions": [{"type": "text", "title": "イゼティア", "body": [{"intro": "謎のダンジョンに誘拐された少女イゼティアは、再び日の光を見るために数々の障害を乗り越えなければなりません。ダンジョン内にはランダムにモンスターが現れ、少女はライトセーバーでそれらを倒さなければなりません。ダンジョン内では、魔法の羽、ブラシ、舌、鎖、電気ショック警棒で苦しめられるユニークなくすぐり危機にも遭遇します。各CGには異なる靴下のオプションがあります。15枚のCG + 5つの拘束アクション"}]}, {"type": "image", "title": "イゼティア", "body": [{"intro": "イゼティア", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01762000/RJ01761501/4ca2c8b7ed4cc2832b1a831611dd90a5.jpg", "alt": "イゼティア [双子星工作室]", "title": "イゼティア [双子星工作室]"}, "position": "right"}]}, {"type": "image_list", "title": "cg", "body": [{"intro": "足にヤムイモペーストを塗りつけられ、激しいかゆみに苦しむイゼティアは、邪悪なビデオカメラに撮影されている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01762000/RJ01761501/9bd470e81c3b6d9c57a89ee266f9b61f.jpg", "alt": "イゼティア [双子星工作室]", "title": "イゼティア [双子星工作室]"}}, {"intro": "壁に張り付いたイゼティアは、くすぐられる運命を待っている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01762000/RJ01761501/2af29dcb54019cc4879474274bc32840.jpg", "alt": "イゼティア [双子星工作室]", "title": "イゼティア [双子星工作室]"}}, {"intro": "目隠しをされ、体育館に閉じ込められた魅力的な少女は、くすぐられるのを待っている。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01762000/RJ01761501/695f9e00ed3e3c65ca95f74b245db678.jpg", "alt": "イゼティア [双子星工作室]", "title": "イゼティア [双子星工作室]"}}, {"intro": "自分の靴を手に持ったまま、道端でくすぐられることを強いられたかわいそうな少女。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01762000/RJ01761501/de160c81c35c44c5817a273697fdfbd9.jpg", "alt": "イゼティア [双子星工作室]", "title": "イゼティア [双子星工作室]"}}]}, {"type": "image", "title": "cg", "body": [{"intro": "各CGには、裸​​足以外にも異なる靴下のオプションがあります。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01762000/RJ01761501/ece3b4336d64f29391d09e7ffc12e71e.jpg", "alt": "イゼティア [双子星工作室]", "title": "イゼティア [双子星工作室]"}, "position": "left"}]}, {"type": "image", "title": "ゲーム內容", "body": [{"intro": "広大な3Dダンジョンマップを探索します。", "image_info": {"url": "//img.dlsite.jp/modpub/images2/parts/RJ01762000/RJ01761501/51a0cdb824a89dd67de3dd07ac6f224e.jpg", "alt": "イゼティア [双子星工作室]", "title": "イゼティア [双子星工作室]"}, "position": "left"}]}], "description": "謎のダンジョンに誘拐された少女イゼティアは、再び日の光を見るために数々の障害を乗り越えなければなりません。", "short_introduction": "謎のダンジョンに誘拐された少女イゼティアは、再び日の光を見るために数々の障害を乗り越えなければなりません。", "url": "https://www.dlsite.com/maniax/work/=/product_id/RJ01761501.html", "site_id": "maniax", "fetched_at": 1794937710, "local_images": {"main": "RJ01761501/main.jpg", "thumb": "RJ01761501/thumb.jpg", "samples": ["RJ01761501/smp1.jpg", "RJ01761501/smp2.jpg", "RJ01761501/smp3.jpg", "RJ01761501/smp4.jpg", "RJ01761501/smp5.jpg", "RJ01761501/smp6.jpg"]}}